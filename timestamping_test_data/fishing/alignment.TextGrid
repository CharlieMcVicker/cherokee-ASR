item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 345.885
        intervals: size = 26
        intervals [1]:
            xmin = 0.000
            xmax = 5.180
            text = ""
        intervals [2]:
            xmin = 5.180
            xmax = 31.610
            text = "1: sagwuga iga nvgi yotsii dogugotanv tsuweyv oginvsdi ayoluhvsgi ogagilvdodi nahna atsisgvnagesdv uweyvi utana ayoluhvsgi ogadolisvi wili mosi Bobby ale aya tsogasudodi doginvsv otsasuhvga ogelisvi"
        intervals [3]:
            xmin = 31.610
            xmax = 32.150
            text = ""
        intervals [4]:
            xmin = 32.150
            xmax = 66.170
            text = "2: gatsinohiselv anisoi hey unosdi idigvwatlvga udatlosv nasgi igvyi uniyvda atsadi nole wili unetsv hia nuwesv tlanv yidigvwatlvsgi nasgwu wutanv atsada uniyvda ale Bobby unetsv howa nigada idigvwatlvga unosdi nahna wugodv atsadi tsuniyvda nigada osi ogiyelvnv ale oganigisv ogiyolunvi uweyvi"
        intervals [5]:
            xmin = 66.170
            xmax = 66.930
            text = ""
        intervals [6]:
            xmin = 66.930
            xmax = 103.255
            text = "3: tsinasanesgv sudi asiladv doi nulistanvagwadanvtelv nahna agwatseli sudi doi nulistanvi aseno si nasgi utlinigida gesv agwalenvhv doi tsinasanesgv asiladv ale naanigisdi ulutsa ulenvhv adanvsgv asgwagenaditlv gadanvtesgv enegwule usdi ada yuwesi nasgino yiganisinega gelisgv"
        intervals [7]:
            xmin = 103.255
            xmax = 103.880
            text = ""
        intervals [8]:
            xmin = 103.880
            xmax = 118.855
            text = "4: nole asiladv ulenvhv adanvsanesgv ale agwadanvtelv atsadis gadaa sudi gelisgv dohiyuno tsiniyvhv atsadi ale agwelunv anisoi unadvgodi"
        intervals [9]:
            xmin = 118.855
            xmax = 119.095
            text = ""
        intervals [10]:
            xmin = 119.095
            xmax = 137.190
            text = "5: hey tsiniya atsada nigada widunakananv sudi asiladv agwatselii ale wili hia nuwesv hinasanagi nasgino nagwadvnelv ale tsiniyvhv tsulisdanali gadvi sudii"
        intervals [11]:
            xmin = 137.190
            xmax = 137.880
            text = ""
        intervals [12]:
            xmin = 137.880
            xmax = 173.510
            text = "6: gatsinohiselv anitsutsa nogwu itsagwiya aya igvyi tsiniya atsadi nogwuno Bobby unalvtsv nvdigalisdodi nasgi udulisgv igvyi uniyvdi atsadi agwadvnvno tsiniyvda tsulisdanali nahna atsadi digadvdodii ale agwadvnv uladitlv nahna ayoluhvsgi ogagilvi ale atsadi tsidvnv amayi wagwadonvtanvi nahna ugatsodv uladitlvi"
        intervals [13]:
            xmin = 173.510
            xmax = 174.290
            text = ""
        intervals [14]:
            xmin = 174.290
            xmax = 203.650
            text = "7: nigayotsaisv ogiyoluhv uweyv ale sigwu ogalewistanv nahna ganehvgwu ama ogalenvhv otsasuhvsgvi gelagwu iyv Bobby dayuwelunv ale hia nuwesv atsadi tsiniya Bobby uniyvhv osda igida atsati unoga utanvno nano  tsulisdanali nogwu osda uyelvsv nudigalisdodisgv"
        intervals [15]:
            xmin = 203.650
            xmax = 204.200
            text = ""
        intervals [16]:
            xmin = 204.200
            xmax = 221.105
            text = "8: wutanv atsadi uniyvhvi nogwu unosdiha dotsinvnelv wunesv atsadi digadvdodii udvnv degadvdv atsadi ale amai wudainvsvi uladitlv ogagilvdvi"
        intervals [17]:
            xmin = 221.105
            xmax = 221.950
            text = ""
        intervals [18]:
            xmin = 221.950
            xmax = 250.780
            text = "9: Bobby nogwu osda udanvdv unosdiha dotsinvnelv wutanv atsadi uniyvhvi oganigisv ogiyoluso gohiiyv ogilutsv sdaya egv uweyv ale utlanvdv iligwu nayadvv ogagilvdvi wugadvlehisdii nahna utana asidv amaya ugasadvi"
        intervals [19]:
            xmin = 250.780
            xmax = 251.450
            text = ""
        intervals [20]:
            xmin = 251.450
            xmax = 267.510
            text = "10: igano sdaya egv ama ale ogadvganv wili dayuwelunv Bobby tiniya atsadi degadvdvi ale widunisanesv atsadi si nidunadvtsvnagwu Ot utana asidvi"
        intervals [21]:
            xmin = 267.510
            xmax = 268.350
            text = ""
        intervals [22]:
            xmin = 268.350
            xmax = 295.500
            text = "11: oniyigwu sino Bobby winidiganasanesgvna atsadv degadvdvi amayi ogagilvdv dulvdvnistanv utana asidvi ale atsadi degadvdv dukawosdigalvtsv ogagilvdv ale asidvi Bobby sdaya wunasanesv atsadi degadvdvi aseno sagwu atsadi gadv degadvdvi nahna agwatseli tsulisdanali Bobby sdayi wunisanesv degadvdv udestanv nvtseli atsada"
        intervals [23]:
            xmin = 295.500
            xmax = 297.060
            text = ""
        intervals [24]:
            xmin = 297.060
            xmax = 325.335
            text = "12: igagwu utiyv atsadi tsuhanegalvnvi Bobby iga unalvtsv uyohuselv atsadi wuniyvhv atsadi degadvdv ale udesv tsulisdanali ale hia nuwesv  gado utseli hia ale amaya wudayanvsv wagwetlunv hey aya agwatseli atsadi wili ale mosi dunilosv ogagilvdv iga uniyetsasgv"
        intervals [25]:
            xmin = 325.335
            xmax = 326.030
            text = ""
        intervals [26]:
            xmin = 326.030
            xmax = 345.885
            text = "13: nahnagwu ulistinv ogiyolusv itsula aya ale Bobby ogininalvsv nvdigalisdodisgv noginigida gesv unosdi adela Bobby unawidvhv atsadi digadvdodi atsadi tsuhanegalvnv degadv si"
