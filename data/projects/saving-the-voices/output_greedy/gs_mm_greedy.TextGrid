            text = "chunk_182: Mary: O ᎪᎯᎩᏴ ᏥᎧᏃᎮᏍᎬ ᎡᎵᏏ ᏥᎨᎲ ᎩᎶ ᏧᏂᏲᏠᏎ ᎠᎮ ᎨᎮ ᏏᏓᏁᎳ ᎠᏍᎦᏯ ᎠᎨᏯᏅ ᎾᏅ ᎠᏍᎦᏯ ᎤᏥ ᎨᎮ ᏢᎾ ᏗᎾᎵᏍᎩᏍᎬ Ꮎ ᎠᏂᏴᏫᏯ ᏣᏅᎵᏍᎩᏍᎪ ᎤᏁᏅᏎ ᎠᏓᏟᏕ ᏅᎮ ᎨᎮ Ꮎ ᎠᎨᏯ ᎾᏅ ᎠᎦᏴᎵᎨ Ꮭ ᏳᏓᎸᏉᏕ Ꮎ ᎤᏥ ᎠᎨᏯ ᏍᎩᎾ ᎠᏍᎦᏯ ᎠᏓᎨᏗᎮ ᎤᏪᏅᏍᏗ Ꮎ ᎠᎨᏯ ᎮᏍᏗ ᏤᏅᏓ ᎢᏗᏁᏍᏗᏭ ᎠᏗᎮ ᏙᏅ Ꮲ ᏳᏬᎯᏳᏁ ᎤᏪᏅᏎ ᎾᎾ ᎠᎦᏴᎵᎨ ᎨᎲ Ꮎ ᎤᏪᏥ ᎠᏍᎦᏯ ᎤᏁᎳᎦ ᏪᎾ ᎠᏓᏙᏎᎮ Ꮎ ᎠᎦᏴᎵᎨ ᏍᎩᎾ ᎤᏪᏅᏎ Ꮎ ᎠᎦᏴᎵᎨ ᏗᎾᎵᏍᎩᏍᎬ I mean Ꮎ ᎠᎨᏯ ᎤᏍᏓᏴᎲᏍᎦ ᎤᏪᏅᏎ ᎤᎵᏍᎩᏒᏎ ᏍᎩᏃ ᏚᏂᏢᏂᏙᎴ ᏃᎾ ᎠᏍᎦᏯ ᎤᏥ ᎠᏍᎦᏯ ᏭᎾᏏᏁ ᎤᏅᏖ ᏂᏗᏛᏁᎵᏒ Ꮎ ᎤᏥ ᏍᎩᎾ ᏳᏍᏗ ᎠᏍᎦᎨ Ꮎ ᎤᏍᏓᏴᎲᏍᎦ ᎤᏪᏅᏍᏗ ᏍᎩᎾ ᏭᎩᏒᏁ Ꮓ ᎪᎱᏍᏗ ᎤᏛᏅᏙᏗ Ꮎ ᎠᎦᏴᎵᎨ ᎾᏅ ᏙᏗ ᏣᏃᏎ fireplace"
