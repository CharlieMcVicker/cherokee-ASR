item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 616.070
        intervals: size = 678
        intervals [1]:
            xmin = 8.260
            xmax = 14.845
            text = "020101: A-da-le-ni-s-gv yi-s-dv ka-no-he-dv, Tsi-sa Ga-lo-ne-dv U-ne-la-nv-hi U-we-tsi u-tse-li-ga."
        intervals [2]:
            xmin = 16.350
            xmax = 33.780
            text = "020102: Na-s-gi-ya hi-a tsi-ni-gv-nv tsi-go-we-la a-na-do-le-ho-s-gi-yi; Gv-ni-yu-quo, tsi-nv-li tsi-nv-si-da-s-di tsa-ka-dv i-gv-yi-di-tlv, na-s-gi da-tsa-dv-nv-i-s-da-ne-li tsa-lo-hi-s-di-yi i-gv-yi-di-tlv."
        intervals [3]:
            xmin = 35.090
            xmax = 46.140
            text = "020103: U-we-lu-ga gi-lo i-na-ge-i, hi-a ni-ga-we-ha; E-tsa-dv-nv-i-s-da-si Yi-ho-wa u-lo-hi-s-di-yi, du-nv-nv di-tsi-tsi-no-hi-s-da."
        intervals [4]:
            xmin = 47.150
            xmax = 64.230
            text = "020104: Tsa-ni da-da-wo-s-ge i-na-ge-i, a-le a-li-tsi-do-hv-s-ge ka-no-he-s-ge di-da-we-s-di ge-sv ga-ne-tli-yv-s-di-yi o-da-nv-dv u-gv-wa-li na-s-gi ga-yv-da-ti-ne-di-yi a-s-ga-nv-tsv-i."
        intervals [5]:
            xmin = 65.410
            xmax = 80.540
            text = "020105: A-le wi-gv-wa-lu-tse-le ni-gv-na-dv Tsu-di-yi a-le Tsi-lu-si-li-mi a-ne-hi, a-le ni-ga-dv na-s-gi du-na-wo-e Tso-da-ni u-we-yv-i, u-ni-s-ga-nv-tsv a-ni-no-hv-s-ge-i."
        intervals [6]:
            xmin = 81.750
            xmax = 94.280
            text = "020106: Tsa-ni-no u-nu-we ge-mi-li u-s-di-ye-nv-hi, ga-no-tsi-no u-da-tlo-s-de-i; v-le-no a-le wa-du-li-si i-na-ge e-hi a-li-s-da-yv-di-s-ge-i."
        intervals [7]:
            xmin = 95.110
            xmax = 114.410
            text = "020107: A-li-tsi-do-hv-s-ge-no hi-a ni-ga-we-s-ge-i; U-tli u-li-ni-gi-di-yu e-s-ga-quo a-yv o-ni da-ya-i, na-s-gi tsu-la-su-lo-gi-hi da-ka-ne-sa-dv v-tla ye-li yi-ni-go-i a-qua-di-sa-da-di-s-di-yi a-le di-gi-ka-ne-yv-di-yi."
        intervals [8]:
            xmin = 115.370
            xmax = 123.960
            text = "020108: A-yv u-do-hi-yu-hi a-ma de-tsv-ya-wo-s-ta-nv, na-s-gi-s-gi-ni Ga-lv-quo-di-yu A-da-nv-do do-da-tsa-wo-s-ta-ni."
        intervals [9]:
            xmin = 124.710
            xmax = 136.740
            text = "020109: Na-hi-yu-no hi-a nu-li-s-ta-ne-i, Tsi-sa Na-se-li-di tsu-lo-se na-s-gi Ge-li-li tsi-ga-du-ha, a-le Tsa-ni u-da-wo-e Tso-da-ni."
        intervals [10]:
            xmin = 138.050
            xmax = 154.390
            text = "020110: Gi-la-quo-no i-yv-dv tsu-hna-lu-sv a-ma-yi tsu-da-nv-sv, u-go-he ga-lv-lo-i u-li-s-du-i-dv ge-se-i, a-le A-da-nv-do gu-le-di-s-go-ni-hi na-s-gi-ya-i, tsu-tlo-a-si-di-se na-s-gi u-we-ya-lv-tse-i."
        intervals [11]:
            xmin = 155.210
            xmax = 164.805
            text = "020111: A-le hi-a nv-tsu-we-se ga-lv-la-di, ni-hi gv-ge-yu-i A-que-tsi, na-s-gi o-si-yu gv-ye-lv-i tsi-gi."
        intervals [12]:
            xmin = 165.960
            xmax = 170.270
            text = "020112: Gi-la-quo-no i-yv-dv A-da-nv-do i-na-ge wu-ti-nv-s-ta-ne-i."
        intervals [13]:
            xmin = 171.640
            xmax = 186.710
            text = "020113: Na-hna-no i-na-ge e-do-he nv-ga-s-go-hi tsu-sv-hi-dv, Se-da-ni u-go-li-ye-s-ge-i; a-le i-na-ge e-hna-i de-ge-la-di-do-he-i; a-le di-ni-ka-hna-wa-di-do-hi gv-wa-s-de-lv-hi-do-he-i."
        intervals [14]:
            xmin = 187.630
            xmax = 200.080
            text = "020114: Tsa-ni-no di-da-s-du-di-yi na-tsi-yv-ta-ne-i, Tsi-sa Ge-li-li u-lu-tse-i, a-li-tsi-do-hv-s-ge o-s-dv ka-no-he-dv U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv u-gv-wa-li,"
        intervals [15]:
            xmin = 201.090
            xmax = 216.390
            text = "020115: A-le hi-a ni-ga-we-s-ge-i, Hna-quo a-li-yi-lo-ga, a-le U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv e-s-ga-ni-yu da-ya-i; di-tsi-ne-tli-yv-na de-tsa-da-nv-dv-i, a-le i-tso-hi-yu-hv-ga o-s-dv ka-no-he-dv."
        intervals [16]:
            xmin = 217.870
            xmax = 233.400
            text = "020116: Ge-li-li-no v-da-li u-lo-di a-i-sv-i, du-go-he Sa-wa-ni a-le E-ni-di na-s-gi di-na-da-nv-tli, v-da-li a-ni-ga-ya-lu-v-s-ge-i; a-ni-ga-ya-lu-v-s-gi-ye-no ge-se-i."
        intervals [17]:
            xmin = 234.230
            xmax = 242.790
            text = "020117: Tsi-sa-no hi-a ni-du-we-se-le-i; S-gi-ni-s-da-wa-du-ga, yv-wi-no di-s-di-ga-ya-lu-v-s-gi nv-da-s-dv-yv-ne-li."
        intervals [18]:
            xmin = 243.530
            xmax = 249.280
            text = "020118: Gi-la-quo-no i-yv-dv du-ni-yo-se tsu-ni-ga-ya-lu-di, a-le gv-wa-s-da-wa-dv-se-i."
        intervals [19]:
            xmin = 250.530
            xmax = 268.620
            text = "020119: Na-hna-no wi-u-we-nv u-s-di-gi-dv, du-go-he Tsi-mi, Tse-qui-di u-we-tsi, Tsa-ni-no na-s-gi di-na-da-nv-tli, na-s-gi-no na-s-quo u-na-tsa-e tsi-yu-hi da-no-tlv-hi-si-s-ge tsu-ni-ga-ya-lu-di."
        intervals [20]:
            xmin = 269.560
            xmax = 285.020
            text = "020120: Gi-la-quo-no i-yv-dv na-s-gi wi-du-ya-nv-he-i; u-nv-de-tsv-no u-ni-do-da Tse-qui-di ge-ga-gu-yv-e-hi tsu-ni-nv-si-da-s-di i-tsu-la-ha tsi-yu-hi u-na-tsa-v-i, gv-wa-s-da-wa-dv-se-i."
        intervals [21]:
            xmin = 286.090
            xmax = 296.570
            text = "020121: Ge-qua-ni-no wu-ni-yv-le-i; gi-la-quo-no i-yv-dv di-ga-la-wi-i-s-di-yi wu-yv-lv du-de-yo-ne u-na-do-da-qua-s-gv i-ga."
        intervals [22]:
            xmin = 298.010
            xmax = 313.770
            text = "020122: U-ni-s-qua-ni-go-se-no nu-s-dv da-de-yo-hv-s-gv-i, du-de-yo-ne-ye-no u-li-ni-gi-dv tsu-ho na-s-gi-ya-i, v-tla-no di-no-we-li-s-gi da-na-de-yo-hv-s-gv na-s-gi-ya yi-ge-se-i."
        intervals [23]:
            xmin = 314.780
            xmax = 322.580
            text = "020123: Tsu-ni-la-wi-i-s-di-yi-no a-ya-e a-s-ga-ya ga-da-ha a-da-nv-do u-ya-i, a-le u-we-lu-ne,"
        intervals [24]:
            xmin = 323.610
            xmax = 343.780
            text = "020124: Hi-a nu-we-se-i, O-ga-ne-la-gi; ga-do di-ga-da-dv-do-di ni-hi, Tsi-sa, Na-se-li-di he-hi?  Tsi-go s-gi-dv-ta-ni-lv?  Gv-ga-ta-ha, ni-hi na-s-gi ge-sv-i; na-s-gi A-tsi-lv-quo-di U-ne-la-nv-hi u-tse-li-ga."
        intervals [25]:
            xmin = 344.500
            xmax = 351.100
            text = "020125: Tsi-sa-no u-s-ga-tse-i, hi-a nu-we-se-i; E-la-we hv-na, a-le hi-nu-go-i."
        intervals [26]:
            xmin = 351.950
            xmax = 358.340
            text = "020126: Ga-da-ha-no a-da-nv-do u-lv-de-s-ta-nv, a-le a-s-da-ya u-we-lu-nv, u-nu-go-tse-i."
        intervals [27]:
            xmin = 359.200
            xmax = 382.260
            text = "020127: Ni-ga-dv-no u-ni-s-qua-ni-go-se-i; a-le u-nv-sv ge-sv du-na-da-dv-dv-ne-i, hi-a na-ni-we-s-ge-i; Ga-do u-ye-lv-di hi-a?  Ga-do u-s-di hi-a i-tse di-de-yo-di ge-sv-i?  U-li-ni-gi-dv-ye-no u-hv gv-di de-ka-ne-tse-ho a-ni-ga-da-ha di-da-nv-do, a-le gv-wo-hi-yu-hv-s-go-i."
        intervals [28]:
            xmin = 383.420
            xmax = 391.665
            text = "020128: Gi-la-quo-no i-yv-dv na-s-gi de-ga-no-tsa-lv du-ye-li-se Ge-li-li na-hna gv-wa-du-wi-dv ge-sv-i."
        intervals [29]:
            xmin = 392.650
            xmax = 405.670
            text = "020129: Gi-la-quo-no i-yv-dv di-ga-la-wi-i-s-di-yi tsu-ni-nu-go-tsv, Sa-wa-ni a-le E-ni-di a-ni-ne-lv wu-ni-yv-le-i, a-ne-he Tsi-mi a-le Tsa-ni."
        intervals [30]:
            xmin = 406.630
            xmax = 415.505
            text = "020130: Sa-wa-ni-no u-da-li-i u-tsi ga-nv-ge u-tlv-ge u-di-le-hv-s-ge-i; gi-la-quo-no i-yv-dv gv-wa-no-ne-le-i."
        intervals [31]:
            xmin = 416.150
            xmax = 427.020
            text = "020131: U-lu-tsv-no a-le u-wo-ya-ne-sv, du-le-ta-ne-i; u-di-le-hv-s-gv-no gi-la-quo i-yv-dv u-di-wa-se-i, a-le du-s-de-lv-hi-do-le-i."
        intervals [32]:
            xmin = 427.760
            xmax = 436.110
            text = "020132: U-sv-no hna-quo nv-do wu-de-li-tsv, de-gv-wa-ti-no-he-le ni-ga-dv tsu-ni-tlv-gi, a-le a-ni-s-gi-na di-gv-wa-ni-ya-i;"
        intervals [33]:
            xmin = 436.990
            xmax = 442.145
            text = "020133: Ni-ga-dv-no ga-du-hv a-ne-hi u-na-da-tli-sa-he ga-lo-hi-s-di-yi."
        intervals [34]:
            xmin = 443.170
            xmax = 464.270
            text = "020134: U-ni-tsa-ti-no de-u-nv-wa-ne tsu-ni-tlv-gi tsu-da-le-nv-dv v-yu-gi u-ne-hi; a-le u-ni-tsa-ti a-ni-s-gi-na du-nu-go-wi-se-i; a-le v-tla wa-ni-ne-gi yi-de-li-se-he a-ni-s-gi-na, u-di-ga-li-s-do-di-s-ge gv-wo-li-gv-i."
        intervals [35]:
            xmin = 465.370
            xmax = 479.700
            text = "020135: Su-na-le-no, a-si go-hi-di-yu gv-wa-gi-tsv-di ge-sv u-di-dv-he u-nu-go-tse-i, a-le i-na-ge wu-lo-se-i, a-le na-hna u-da-do-li-s-ta-ne-i."
        intervals [36]:
            xmin = 480.500
            xmax = 485.090
            text = "020136: Sa-wa-ni-no a-le na-s-gi a-ne-hi, gv-wa-s-da-wa-dv-se-i."
        intervals [37]:
            xmin = 486.190
            xmax = 493.870
            text = "020137: Wi-gv-wa-wa-dv-hv-no, hi-a ni-gv-wa-we-se-le-i, ni-ga-dv-quo yv-wi ge-tsa-yo-se."
        intervals [38]:
            xmin = 494.600
            xmax = 506.305
            text = "020138: Hi-a-no ni-du-we-se-le-i, Di-so-i do-di-ga-du-hv wi-di-lo-hi, na-hna na-s-quo ga-li-tsi-do-ni-do-lv-ha; na-s-gi-ye-no i-yu-s-di a-gi-lu-tsi-lv."
        intervals [39]:
            xmin = 507.570
            xmax = 516.370
            text = "020139: A-li-tsi-do-ni-do-he-no tsu-ni-la-wi-i-s-di-yi ni-gv-na-dv Ge-li-li, a-le a-ni-s-gi-na de-ga-nu-go-wi-s-ge-i."
        intervals [40]:
            xmin = 517.240
            xmax = 531.030
            text = "020140: A-da-ye-s-gi-no u-tlv-gi u-lu-tse-le-i, u-da-do-li-s-da-ne-le du-li-ni-qua-nv-ne-le-i, a-le hi-a nu-we-se-le-i, I-yu-no o-si-yu yi-tsa-ye-lv-nv, ye-li-quo yi-s-gi-nv-ga-lv."
        intervals [41]:
            xmin = 531.710
            xmax = 543.730
            text = "020141: Tsi-sa-no, ga-do-li-gv u-do-ya-nv-hi-de-i, a-le u-sv-ni-le-i, a-le hi-a nu-we-se-le-i, O-si-yu tsi-ye-lv-nv; tsa-da-nv-ga-lv-dv ge-se-s-di."
        intervals [42]:
            xmin = 544.670
            xmax = 553.085
            text = "020142: U-ne-tsv-quo-no gi-la-quo i-yv-dv a-da-ye-s-gi u-tlv-gv u-li-dv-ta-ne-i, a-le u-da-nv-ga-lv-dv ge-se-i."
        intervals [43]:
            xmin = 553.990
            xmax = 559.120
            text = "020143: U-li-ni-gi-dv-no u-ne-tse-lv, gi-la-quo i-yv-dv u-ne-tse-le u-da-nv-s-di-yi;"
        intervals [44]:
            xmin = 559.870
            xmax = 585.920
            text = "020144: A-le hi-a nu-we-se-le-i, He-ya-ta-he-s-di tle-s-di gi-lo go-hu-s-di tsi-hi-no-ne-li; he-na-quo-s-gi-ni, gv-ni-ge-sv wi-ni-ya-dv-ni-si a-tsi-lv-ge-lo-hi, a-le wa-li-s-go-lv-da tsa-da-nv-ga-lv-hv u-gv-wa-li, na-s-gi Mo-si u-ne-tsv a-li-s-go-lv-do-di-yi, na-s-gi u-na-do-hi-yu-na-ne-di-yi."
        intervals [45]:
            xmin = 586.835
            xmax = 616.070
            text = "020145: A-se-no u-nu-go-tsv, u-le-nv-he u-tsa-ti du-ye-li-hi-s-ta-ne-i, a-le du-no-tsa-la-ne na-s-gi, na-s-gi-no i-yu-s-di Tsi-sa v-tla hna-quo gv-ni-ge-sv wi-gv-wa-yv-s-di yi-ge-se ga-du-hv-i, do-yi-di-tlv-quo-s-gi-ni i-na-ge de-ge-sa-di-sv e-do-he-i; ni-gv-na-dv-quo-no ni-do-da-yu-ni-lo-sv-hi gv-wa-lu-tse-he-i."
        intervals [46]:
            xmin = 616.070
            xmax = 616.070
            text = "020201: Ta-li-ne-no i-lv-s-gi wi-nu-sv-lv Ge-qua-ni wu-yv-le-i; du-no-tsa-lo-tse-no ga-li-tso-de a-ya-v-i."
        intervals [47]:
            xmin = 616.070
            xmax = 616.070
            text = "020202: Gi-la-quo-no i-yv-dv u-ni-tsa-ti du-ni-la-wi-tso-le-i, na-s-gi i-yu-s-di v-tla yu-dla-nv-de, v-tla na-s-quo ga-lo-hi-s-di-yu-lo-di; ka-no-he-dv-no du-li-tsi-do-ne-le-i."
        intervals [48]:
            xmin = 616.070
            xmax = 616.070
            text = "020203: Gv-wa-lu-tse-le-no gi-lo i-yu-s-di u-lv-da-lv-v-s-gi a-ni-ne-he-i, na-s-gi nv-gi i-ya-ni-dv gv-wa-no-le-i."
        intervals [49]:
            xmin = 616.070
            xmax = 616.070
            text = "020204: U-ni-nu-lv-nv-no ga-do-gv na-v u-ni-lu-hi-s-di-yi a-ni-ne-nu-lv i-yu-s-di, u-nv-ne-se na-hna a-ya-v-i; u-nv-ne-sv-no, e-la-di nu-nv-ne-le a-tse-s-do na-hna u-lv-da-lv-v-s-gi ga-nv-gv-i."
        intervals [50]:
            xmin = 616.070
            xmax = 616.070
            text = "020205: Tsi-sa-no u-go-hv u-no-hi-yu-sv-i, hi-a nu-we-se-le u-lv-da-lv-v-s-gi, A-ya-tsi, tsa-s-ga-nv-tsv e-tsa-do-li-gi."
        intervals [51]:
            xmin = 616.070
            xmax = 616.070
            text = "020206: A-se-no na-hna a-ni-ne gi-lo i-yu-na-s-di di-no-we-li-s-gi, hi-a nu-s-de a-na-da-nv-te-s-ge do-tsu-na-da-nv-dv-i,"
        intervals [52]:
            xmin = 616.070
            xmax = 616.070
            text = "020207: Ga-do-no hi-a a-s-ga-ya hi-a ni-ga-we-ha i-a-so-tlv-i-s-di-ha?  Ga-go ye-li a-s-ga-nv-tsv gv-wa-da-do-li-s-di, sa-quo-quo u-wa-sv, na-s-gi U-ne-la-nv-hi?"
        intervals [53]:
            xmin = 616.070
            xmax = 616.070
            text = "020208: Gi-la-quo-no i-yv-dv Tsi-sa tsu-da-nv-dv u-do-le-ho-sv nu-s-dv a-na-da-nv-te-s-gv do-tsu-na-da-nv-dv-i, hi-a ni-du-we-se-le-i; Ga-do-no na-s-gi hi-a ni-u-s-di i-tsa-da-nv-te-ha do-di-tsa-da-nv-dv-i?"
        intervals [54]:
            xmin = 616.070
            xmax = 616.070
            text = "020209: Ga-do u-s-di u-tli a-hi-di-yu?  Tsi-go hi-a yi-na-ga-we-se u-lv-da-lv-v-s-gi, tsa-s-ga-nv-tsv e-tsa-do-li-gi; hi-a-ge yi-na-ga-we-a, Ta-le-hv-ga, a-le hi-na-gi tsa-tse-s-do, a-le he-da?"
        intervals [55]:
            xmin = 616.070
            xmax = 616.070
            text = "020210: A-se-no i-tsa-do-le-ho-hi-s-di-yi yv-wi U-we-tsi u-hv-i gv-wa-da-do-li-s-di ge-sv a-s-ga-nv-tsv-i a-ni e-lo-hi (hi-a nu-we-se-le u-lv-da-lv-v-s-gi,)"
        intervals [56]:
            xmin = 616.070
            xmax = 616.070
            text = "020211: Gv-yo-se-ha, Ta-le-hv-ga, a-le hi-na-gi tsa-tse-s-do, a-le di-tse-nv-sv wi-lo-hi."
        intervals [57]:
            xmin = 616.070
            xmax = 616.070
            text = "020212: Gi-la-quo-no i-yv-dv du-le-ne-i, u-ne-sv-no a-tse-s-do, u-nu-go-tse ni-ga-dv a-ni-ga-ta-hv-i; na-s-gi i-yu-s-di ni-ga-dv u-ni-s-qua-ni-go-se-i, a-le U-ne-la-nv-hi u-ni-lv-quo-ta-ne hi-a nu-ni-we-se-i; v-tla i-lv-hi-yu na-s-gi i-yu-s-di yo-gi-go-ho-i."
        intervals [58]:
            xmin = 616.070
            xmax = 616.070
            text = "020213: Ta-li-ne-no u-nu-go-tse v-da-li u-lo-di u-we-do-le-i; a-le ni-ga-dv u-ni-tsa-ti wi-gv-wa-lu-tse-le-i, a-le na-s-gi du-we-yo-ne-i."
        intervals [59]:
            xmin = 616.070
            xmax = 616.070
            text = "020214: A-i-sv-no, Li-wi E-li-qui u-we-tsi u-go-he u-wo-le a-ye-li a-de-lv a-gi-s-di-yi, a-le hi-a nu-we-se-le-i, S-gi-s-da-wa-du-ga.  Du-le-nv-no u-s-da-wa-dv-se-i."
        intervals [60]:
            xmin = 616.070
            xmax = 616.070
            text = "020215: Hi-a-no nu-li-s-ta-ne-i, na-s-gi [Tsi-sa] ga-nv-gv a-li-s-da-yv-hv-s-gv na-s-gi ga-ne-lv-i, u-ni-tsa-te a-de-lv a-ni-gi-si-do-hi a-le a-ni-s-ga-na i-tsu-la-ha da-ni-nv-ge Tsi-sa a-le gv-wa-s-da-wa-di-do-hi; u-ni-tsa-te-ye-no, a-le gv-wa-s-da-wa-di-do-he-i."
        intervals [61]:
            xmin = 616.070
            xmax = 616.070
            text = "020216: Di-no-we-li-s-gi-no a-le A-ni-qua-li-si gv-wa-go-hv i-tsu-la-ha a-na-li-s-da-yv-hv-s-gv a-de-lv a-ni-gi-si-do-hi a-le a-ni-s-ga-na, hi-a ni-du-ni-we-se-le gv-wa-s-da-wa-di-do-hi, Ga-do-no i-tsu-la-ha tsa-na-li-s-da-yv-hv-s-ga a-le i-tsu-la-ha tsa-na-di-ta-s-ga a-de-lv a-ni-gi-si-do-hi a-le a-ni-s-ga-na-i."
        intervals [62]:
            xmin = 616.070
            xmax = 616.070
            text = "020217: Tsi-sa-no na-s-gi u-dv-ga-nv hi-a ni-du-we-se-le-i, Na-s-gi ni-du-ni-tlv-gv-na v-tla u-du-lv-di yi-nu-na-li-s-da-ne-ho di-da-nv-wi-s-gi, tsu-ni-tlv-gi-s-gi-ni; v-tla u-na-da-nv-ti yi-di-tsi-ya-nv-hi-lv, a-ni-s-ga-na-s-gi-ni du-na-da-nv-dv tsu-ni-ne-tli-yv-s-di-yi."
        intervals [63]:
            xmin = 616.070
            xmax = 616.070
            text = "020218: Tsa-ni-no gv-wa-s-da-wa-di-do-hi a-le A-ni-qua-li-si gv-wa-ni-s-da-wa-di-do-hi a-ma-tli a-nv-s-gi ge-se-i; u-ni-lu-tse-no a-le hi-a ni-gv-wa-we-se-le-i, Ga-do-no Tsa-ni gv-wa-s-da-wa-di-do-hi, a-le A-ni-qua-li-si gv-wa-ni-s-da-wa-di-do-hi a-ma-tli tsa-nv-s-go-i, ni-hi-no ge-tsa-s-da-wa-di-do-hi a-ma-tli na-nv-s-gv-na tsi-ge-so-i?"
        intervals [64]:
            xmin = 616.070
            xmax = 616.070
            text = "020219: Tsi-sa-no hi-a ni-du-we-se-le-i, Tsi-go de-ge-ga-tsv-s-di-s-gv a-ni-ga-ta-hi ye-li a-ma-tli ya-nv-na a-de-sv-hv-s-gi u-ne-la-di-do-hv i-go-hi-dv?  I-go-hi-dv a-de-sv-hv-s-gi u-ne-la-di-do-hv, v-tla ye-li a-ma-tli yv-gv-nv-na."
        intervals [65]:
            xmin = 616.070
            xmax = 616.070
            text = "020220: Dv-s-qua-lv-hi-s-gi-ni na-hi-yu ge-tsi-ya-nv-e-di-yi a-de-sv-hv-s-gi, na-hi-yu-no hna-quo a-ma-tli dv-nv-ni."
        intervals [66]:
            xmin = 616.070
            xmax = 616.070
            text = "020221: V-tla a-le gi-lo u-we-ti a-nu-wo i-tse a-gv-ha-lv-dv yi-ga-li-s-tlv-di-s-go-i, i-tse-ye-no a-gv-ha-lv-dv ga-la-s-tlv-ta-nv-hi yv-ga-tsa-ga-lv-do-da u-we-ti, na-s-gi-no u-da-tsa-de-lv-hv u-tli e-quo-hi-yu yi-nv-ga-li-s-da."
        intervals [67]:
            xmin = 616.070
            xmax = 616.070
            text = "020222: V-tla a-le gi-lo i-tse gi-ga-ge--a-di-ta-s-di tsu-we-ti di-su-tlv-dv yi-da-tli-s-di-s-go-i; i-tse-ye-no gi-ga-ge--a-de-ta-s-di yi-do-ga-tsa-ga-lv di-su-tlv-dv, a-le gi-ga-ge--a-di-ta-s-di ya-tse-wo-gi, a-le di-su-tlv-dv yi-da-yo-gi; i-tse-s-gi-ni gi-ga-ge--a-di-ta-s-di, di-tse di-su-tlv-dv di-tli-s-do-di ge-so-i."
        intervals [68]:
            xmin = 616.070
            xmax = 616.070
            text = "020223: Hi-a-no nu-li-s-ta-ne-i, na-s-gi tlo-ge-si u-tsa-le-s-di da-wi-sv u-lo-se u-na-do-da-qua-s-gv i-ga; gv-wa-s-da-wa-di-do-hi-no u-na-le-nv-he a-na-i-sv u-ni-s-gu-de-s-ta-nv-se u-tsa-le-s-di."
        intervals [69]:
            xmin = 616.070
            xmax = 616.070
            text = "020224: A-ni-qua-li-si-no hi-a ni-gv-wa-we-se-le-i, Gv-ni-yu-quo, ga-do-no u-na-do-da-qua-s-gv i-ga ni-du-yu-go-dv-na ge-sv na-na-dv-ne-ha."
        intervals [70]:
            xmin = 616.070
            xmax = 616.070
            text = "020225: Hi-a-no ni-du-we-se-le-i, tla-s-go yi-tsi-go-li-ye-o De-wi nu-dv-ne-lv tsu-ni-gv-se-he i-yu, a-le a-go-nu tsu-yo-si-s-ge-i, u-wa-sv, a-le na-s-gi tsa-ne-he-i?"
        intervals [71]:
            xmin = 616.070
            xmax = 616.070
            text = "020226: Na-s-gi U-ne-la-nv-hi u-tse-li a-da-ne-lv tsu-yv-le na-hi-yu tse-he E-qua-yi-da nu-gv-wi-yu-sv a-tsi-lv--ge-lo-hi, a-le tsu-ge a-ga-do-di ga-du, na-s-gi gv-gi-s-di ni-ge-sv-na tsi-ge-se a-tsi-lv-a-ne-lo-hi u-nv-sv, a-le na-s-quo tsi-du-ne-le na-s-gi a-ne-hi."
        intervals [72]:
            xmin = 616.070
            xmax = 616.070
            text = "020227: A-le hi-a ni-du-we-se-le-i, u-na-do-da-qua-s-gv u-do-tlv-ne yv-wi nv-di-ga-li-s-do-di-s-ge-i; v-tla-no u-na-do-da-qua-s-gv yi-nv-di-ga-li-s-do-di-s-ge yv-wi yi-ge-go-tlv-ne-i."
        intervals [73]:
            xmin = 616.070
            xmax = 616.070
            text = "020228: Na-s-gi i-yu-s-di na-s-quo yv-wi U-we-tsi u-na-do-da-qua-s-gv U-gv-wi-yu-hi."
        intervals [74]:
            xmin = 616.070
            xmax = 616.070
            text = "020301: Ta-li-ne-no wu-yv-le di-ga-la-wi-i-s-di-yi; na-hna-no e-do-he a-s-ga-ya u-wo-ye-ni u-wa-i-se-lv-hi."
        intervals [75]:
            xmin = 616.070
            xmax = 616.070
            text = "020302: Gv-wa-ya-wi-se-no u-na-du-li-s-ge u-na-do-le-ho-hi-s-di-yi gv-wa-da-nv-wo-di ge-sv u-na-do-da-qua-s-gv i-ga, na-s-gi gv-wa-ye-i-li-da-s-di-yi."
        intervals [76]:
            xmin = 616.070
            xmax = 616.070
            text = "020303: Hi-a-no nu-we-se-le a-s-ga-ya u-wo-ye-ni u-wa-i-se-lv-hi; A-ye-li ha-le-hv-ga."
        intervals [77]:
            xmin = 616.070
            xmax = 616.070
            text = "020304: Hi-a-no ni-du-we-se-le-i, Du-yu-go-di-s-go o-s-dv di-ga-lv-wi-s-da-ne-di-yi u-na-do-da-qua-s-gv i-ga, u-yo-ge di-ga-lv-wi-s-da-ne-di-yi?  Gv-nv gi-lo a-s-de-lv-e-di-yi, a-hi-s-di-yi-ge?  E-la-we-quo-no u-nv-se-i."
        intervals [78]:
            xmin = 616.070
            xmax = 616.070
            text = "020305: U-so-nv-tse-hi-no de-u-ka-hna-nv na-s-gi gv-wa-du-wi-dv nu-na-dv-nv, u-de-ya-ta-ne-hv di-s-da-yi-yu ge-sv tsu-ni-na-wi, hi-a nu-we-se-le a-s-ga-ya; Ha-do-ya-nv-hi-dv.  U-do-ya-nv-hi-de-no, u-wo-ye-ni-no gv-wa-no-s-dv nu-li-s-ta-ne na-s-gi-ya so-i nu-s-dv-i."
        intervals [79]:
            xmin = 616.070
            xmax = 616.070
            text = "020306: A-ni-qua-li-si-no u-ni-nu-go-tsv, gi-la-quo i-yv-dv wu-na-li-no-he-le E-lo-dv gv-wa-s-de-li-s-gi gv-wa-tlu-di-s-gv, na-s-gi i-yu-nv-ne-di-yi u-ni-hi-s-di-yi."
        intervals [80]:
            xmin = 616.070
            xmax = 616.070
            text = "020307: Tsi-sa-no u-da-nv-se du-ti-nv-se gv-wa-s-da-wa-di-do-hi v-da-li wu-ni-lo-se-i; u-ni-tsa-ti-no gv-wa-s-da-wa-dv-se-i, nv-da-yu-ni-lo-sv-hi Ge-li-li, a-le Tsu-di-yi,"
        intervals [81]:
            xmin = 616.070
            xmax = 616.070
            text = "020308: A-le Tsi-lu-si-li-mi, a-le I-do-mi-yi, a-le Tso-da-ni i-s-go-ni-di-tlv; a-le Da-ya a-le Sa-do-ni na-v di-ne-hi, u-tsa-ti a-ni-go-di-yu, na-s-gi u-na-dv-ga-nv ni-ga-v u-s-qua-ni-go-di de-u-lv-wi-s-da-ne-lv, gv-wa-lu-tse-le-i."
        intervals [82]:
            xmin = 616.070
            xmax = 616.070
            text = "020309: Du-ne-tse-le-no gv-wa-s-da-wa-di-do-hi, na-s-gi tsi-yu u-ga-ti-di-s-di-yi, u-ni-tsa-ti ge-sv i-yu-s-di, na-s-gi gv-wa-ne-nu-la-s-do-di-yi ni-ge-sv-na."
        intervals [83]:
            xmin = 616.070
            xmax = 616.070
            text = "020310: U-ni-tsa-te-ye-no du-nv-wa-ne-i; na-s-gi i-yu-s-di gv-wa-ne-nu-la-s-di-s-ge gv-wa-no-tli-s-do-di-yi u-na-du-li-s-ge-i, ni-ga-dv go-hu-s-di di-na-li-s-di-s-gi."
        intervals [84]:
            xmin = 616.070
            xmax = 616.070
            text = "020311: A-le di-ga-da-ha di-da-nv-do, i-yu-no gv-wa-go-wa-dv, e-la-di gv-wa-da-nv-ne-he, a-le a-ne-lu-hv-s-ge, hi-a na-ni-we-s-ge-i, U-ne-la-nv-hi U-we-tsi ni-hi."
        intervals [85]:
            xmin = 616.070
            xmax = 616.070
            text = "020312: U-li-ni-gi-dv-no du-ne-tse-le na-s-gi gv-ni-ge-sv i-gv-wa-ne-di-yi ni-ge-sv-na."
        intervals [86]:
            xmin = 616.070
            xmax = 616.070
            text = "020313: U-hna-lu-se-no o-da-lv-i, a-le du-ya-nv-he na-s-gi u-du-li-s-gv tsu-ya-nv-di-yi; a-le gv-wa-lu-tse-he-i."
        intervals [87]:
            xmin = 616.070
            xmax = 616.070
            text = "020314: A-le du-su-ye-se ta-la-du i-ya-ni-dv, na-s-gi gv-wa-s-da-wa-di-da-s-di-yi, a-le na-s-gi tsu-nv-s-di-yi u-na-li-tsi-do-ni-da-s-di-yi,"
        intervals [88]:
            xmin = 616.070
            xmax = 616.070
            text = "020315: A-le tsu-li-s-go-lv-da-ne-di-yi du-ni-tlv-gv tsu-ni-nv-wo-di-yi, a-le a-ni-s-gi-na tsu-ni-nu-go-wi-s-di-yi;"
        intervals [89]:
            xmin = 616.070
            xmax = 616.070
            text = "020316: Sa-wa-ni-no Qui-da du-wo-e-i."
        intervals [90]:
            xmin = 616.070
            xmax = 616.070
            text = "020317: A-le Tsi-mi Tse-qui-di u-we-tsi, a-le Tsa-ni Tsi-mi di-na-da-nv-tli; a-le na-s-gi Quo-a-na-tsi du-wo-e-i, na-s-gi a-yv-da-qua-lo-s-gi tsu-we-tsi ga-dv-ga;"
        intervals [91]:
            xmin = 616.070
            xmax = 616.070
            text = "020318: A-le E-ni-di, a-le Qui-li-gi, a-le Qua-do-la-mi, a-le Ma-du, a-le Da-mi, a-le Tsi-mi E-li-qui u-we-tsi, a-le Da-di-ya, a-le Sa-wa-ni A-ge-na-ni-di,"
        intervals [92]:
            xmin = 616.070
            xmax = 616.070
            text = "020319: A-le Tsu-da-si I-s-ga-la-di, na-s-gi s-quo tsu-lo-nu-he-le-i; a-da-ne-lv-no wu-ni-lo-se-i."
        intervals [93]:
            xmin = 616.070
            xmax = 616.070
            text = "020320: U-ni-tsa-ti-no ta-li-ne du-ni-la-wi-tso-le-i, s-gi i-yu-s-di na-s-quo ni-u-tli-s-de ga-du u-ni-gi-s-di-yi."
        intervals [94]:
            xmin = 616.070
            xmax = 616.070
            text = "020321: Go-hu-s-di-no tsu-wa-nv u-na-dv-ga-nv, u-ne-nv-se gv-wa-ni-yv-hv-se-i; hi-a-ye-no na-ni-we-s-ge-i, u-lv-no-ti-ha."
        intervals [95]:
            xmin = 616.070
            xmax = 616.070
            text = "020322: Di-no-we-li-s-gi-no Tsi-lu-si-li-mi nv-da-yu-ni-lo-sv-hi, hi-a na-ni-we-s-ge-i, Que-li-tsi-qua u-we-ha, a-le u-gv-wi-yu-hi a-ni-s-gi-na u-na-tse-li-ga gv-di-ha de-ga-nu-go-wi-s-ga a-ni-s-gi-na."
        intervals [96]:
            xmin = 616.070
            xmax = 616.070
            text = "020323: Na-s-gi-no wi-du-ya-nv-hv, hi-a ni-du-we-se-le du-tli-lo-s-da-ne-le-i, Ga-do yi-ga-li-s-do-da Se-da-ni yi-ga-nu-go-wa Se-da-ni?"
        intervals [97]:
            xmin = 616.070
            xmax = 616.070
            text = "020324: I-yu a-le a-ye-li go-tlv-sv ta-li yi-nu-da-a, u-wa-sv-quo ya-da-tlu-di-ha, v-tla ye-li yi-ni-gv-wa-s-di-quo na-s-gi a-ye-li go-tlv-sv-i."
        intervals [98]:
            xmin = 616.070
            xmax = 616.070
            text = "020325: I-yu a-le si-da-ne-lv ge-sv ta-li yi-nu-da-a, u-wa-sv-quo ya-da-tlu-di-ha, na-s-gi si-da-ne-lv ge-sv v-tla ye-li yi-ni-gv-wa-s-di-quo."
        intervals [99]:
            xmin = 616.070
            xmax = 616.070
            text = "020326: I-yu a-le Se-da-ni yi-du-le-nv u-wa-sv yi-du-da-ga-ti-le-nv, a-le ta-li yi-nu-da-a, v-tla ye-li yi-ni-gv-wa-s-di-quo, yi-wa-s-ta-quo-s-gi-ni e-hv-i."
        intervals [100]:
            xmin = 616.070
            xmax = 616.070
            text = "020327: V-tla gi-lo u-li-ni-gi-dv a-s-ga-ya ga-ne-lv yv-gv-yv-ha, a-le yv-gv-wo-nv u-hna-v-i, gv-ni i-gv-yi yu-lv-lv na-s-gi u-li-ni-gi-dv a-s-ga-ya; gi-la hna-quo ya-wo-nv ga-ne-lv u-hna-v-i."
        intervals [101]:
            xmin = 616.070
            xmax = 616.070
            text = "020328: U-do-hi-yu-hi-ya i-tsv-yo-se-ha, Ni-ga-v a-s-ga-nv-i-s-di ge-sv, ga-ge-tsi-do-li-s-di-quo ge-se-s-di yv-wi tsu-ne-tsi, a-le a-so-tlv-i-s-do-di ge-sv, ni-ga-v gv-wa-ni-so-tlv-i-s-do-di ge-sv-i;"
        intervals [102]:
            xmin = 616.070
            xmax = 616.070
            text = "020329: Gi-lo-s-gi-ni Ga-lv-quo-di-yu A-da-nv-do a-so-tlv-i-s-di-s-ge-s-di, v-tla i-lv-hi-yu ga-ye-tsi-do-li-s-di yi-ge-se-s-di, di-ga-ye-gu-go-da-ne-di-quo-s-gi-ni wi-na-s-dv-na u-s-dv-di-s-di-yi;"
        intervals [103]:
            xmin = 616.070
            xmax = 616.070
            text = "020330: Nv-di-ga-li-s-do-di-s-ge-i, ga-da-ha a-da-nv-do u-ya-a, u-na-dv-nv-i."
        intervals [104]:
            xmin = 616.070
            xmax = 616.070
            text = "020331: Hna-quo-no gv-wa-lu-tse-le a-na-li-nv-tli, a-le u-tsi, a-le do-yi-di-tlv da-ni-do-ge, u-na-da-nv-se wi-gv-wa-ya-ni-s-ge-i."
        intervals [105]:
            xmin = 616.070
            xmax = 616.070
            text = "020332: U-ni-tsa-ti-no a-ni-ne gv-wa-da-tlu-wi-s-de-i; hi-a-no ni-gv-wa-we-se-le-i, Gv-ni-yu-quo, tsa-tsi a-le i-tsa-li-nv-tli do-yi-di-tlv di-ge-tsa-yo-ha."
        intervals [106]:
            xmin = 616.070
            xmax = 616.070
            text = "020333: Du-ne-tse-le-no hi-a nu-we-se-i, Ga-go e-tsi, a-le o-tsa-li-nv-tli?"
        intervals [107]:
            xmin = 616.070
            xmax = 616.070
            text = "020334: Gv-wa-du-wi-dv-no du-ka-hna-ni-do-lv u-wo-lv na-v a-ni-ni du-ka-na-nv hi-a nu-we-se-i; Gv-ni-yu-quo e-tsi, a-le o-tsa-li-nv-tli?"
        intervals [108]:
            xmin = 616.070
            xmax = 616.070
            text = "020335: Gi-lo-ye-no U-ne-la-nv-hi u-du-li-s-gv na-dv-ne-he-s-di, na-s-gi tso-s-da-da-nv-tli, a-le v-gi-do, a-le e-tsi."
        intervals [109]:
            xmin = 616.070
            xmax = 616.070
            text = "020401: Ta-li-ne-no u-le-nv-he du-de-yo-ne v-da-lu-lo-di; u-ni-tsa-ti-no gv-wa-da-tlu-wi-s-ta-ne-i, na-s-gi i-yu-s-di tsi-yu-hi u-tsa-ne-i, a-le v-da-li a-ta-lv u-we-ne-i; ni-ga-dv-no u-ni-tsa-ti ge-sv v-da-lu-lo-di do-yi ge-sv a-ni-do-na-e-i."
        intervals [110]:
            xmin = 616.070
            xmax = 616.070
            text = "020402: A-le u-tsa-te tsu-da-le-nv-dv du-we-yo-ne du-tli-lo-s-da-ne-le-i, a-le hi-a ni-du-we-se-le da-de-yo-hv-s-gv-i,"
        intervals [111]:
            xmin = 616.070
            xmax = 616.070
            text = "020403: I-tsa-dv-da-s-da; Gv-ni-yu-quo, a-wi-s-gi u-wi-sv-se-i;"
        intervals [112]:
            xmin = 616.070
            xmax = 616.070
            text = "020404: Hi-a-no nu-li-s-ta-ne a-wi-s-gv-i, na-s-gi i-ga-dv nv-no-hu-lo-di u-la-ge-ya-dv-tse-i, tsi-s-qua-no ga-lv-lo-i a-ni-no-hi-i-do-hi u-ni-lu-tse a-le u-ni-go-ne-i."
        intervals [113]:
            xmin = 616.070
            xmax = 616.070
            text = "020405: I-ga-dv-no nv-yo-hi ge-sv u-la-ge-ya-dv-tse-i, na-hna ga-yo-li-yu ge-sv ga-da; a-le gi-la-quo i-yv-dv di-u-li-ye-ne-i, nv-di-ga-li-s-do-di-s-ge sa-ge-i-yu ge-sv ga-da;"
        intervals [114]:
            xmin = 616.070
            xmax = 616.070
            text = "020406: A-se-no nv-do i-ga--e-hi tsu-ka-lv-tsv u-le-yv-se-i; a-le ni-du-hna-s-de-tlv-na ge-sv i-yu-s-di, u-hna-s-gv-tse-quo."
        intervals [115]:
            xmin = 616.070
            xmax = 616.070
            text = "020407: I-ga-dv-no a-nu-ga-lv-hi u-la-ge-ya-dv-tse-i; a-nu-ga-lv-no tsu-dv-se-i, a-le u-ne-nu-la-s-ta-ne-i, a-le nu-na-nu-go-wi-sv-na ge-se u-ga-ta."
        intervals [116]:
            xmin = 616.070
            xmax = 616.070
            text = "020408: I-ga-dv-no o-sv ga-do-hi u-la-ge-ya-dv-tse-i, a-le u-li-ye-ne-i, a-le a-dv-s-ge-i, a-le ka-ne-quo-ge-i, a-le u-ga-ta-ta-ne-i, i-ga-dv tso-a-s-go-hi i-yu-wa-gu-di, i-ga-dv-no su-da-li-s-go-hi, i-ga-dv-no a-s-go-hi-tsu-qui."
        intervals [117]:
            xmin = 616.070
            xmax = 616.070
            text = "020409: Hi-a-no ni-du-we-se-le-i, gi-lo de-ga-li-lu-ge-s-di u-dv-go-di-yi, wa-dv-gv-ga."
        intervals [118]:
            xmin = 616.070
            xmax = 616.070
            text = "020410: U-wa-sv-no ge-se-i, na-s-gi gv-wa-s-da-wa-di-de-gi a-le ta-la-du i-ya-ni-dv gv-wa-dv-dv-ne ga-dv-gv na-s-gi da-tli-lo-s-dv-i."
        intervals [119]:
            xmin = 616.070
            xmax = 616.070
            text = "020411: Hi-a-no ni-du-we-se-le-i.  Ni-hi e-tsi-ne-lv i-tso-li-s-di-yi u-de-li-dv ge-sv U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv-i; na--s-gi-ni do-yi-di-tlv a-ne-do-hi hi-a na-s-gi ni-ga-dv de-ge-ga-tli-lo-s-da-ne-ho-i;"
        intervals [120]:
            xmin = 616.070
            xmax = 616.070
            text = "020412: Na-s-gi a-ni-go-wa-di-s-gv u-ni-go-wa-dv-di-yi, a-le gv-wa-na-do-le-ho-hi-s-di ni-ge-sv-na i-yu-li-s-do-di-yi; a-le a-na-dv-gi-s-gv u-na-dv-go-di-yi, a-le gv-wa-no-li-s-di ni-ge-sv-na i-yu-li-s-do-di-yi; na-s-gi tsu-na-da-ne-tli-yv-e-di-yi ni-ge-sv-na du-na-da-nv-dv, a-le u-ni-s-ga-nv-tsv ga-ge-tsi-ne-di-yi ni-ge-sv-na."
        intervals [121]:
            xmin = 616.070
            xmax = 616.070
            text = "020413: A-le hi-a ni-du-we-se-le-i, Tla-s-go yi-tso-li-ga hi-a na-s-gi da-tli-lo-s-dv-i?  Ga-do-no yi-ga-li-s-do-da yi-de-tso-li-gi ni-ga-dv da-tli-lo-s-dv-i?"
        intervals [122]:
            xmin = 616.070
            xmax = 616.070
            text = "020414: Na-s-gi a-wi-s-gi ka-no-he-dv a-wi-s-go-i."
        intervals [123]:
            xmin = 616.070
            xmax = 616.070
            text = "020415: Hi-a-no na-s-gi nv-no-hu-lo-di na-hna ka-no-he-dv tsi-ge-tsi-wi-se-le-i; hna-quo-no a-na-dv-gv-ga, A-s-gi-na ga-lu-go gi-la-quo i-yv-dv, a-le a-gi-s-go ka-no-he-dv tsu-ni-na-wi-yi a-wi-sv-hi."
        intervals [124]:
            xmin = 616.070
            xmax = 616.070
            text = "020416: Hi-a-no na-s-gi na-s-quo nv-yo-hi tsi-ge-tsi-wi-se-le-i; na-s-gi hna-quo ka-no-he-dv a-na-dv-gv-ga gi-la-quo i-yv-dv u-na-li-he-li-tsv-hi da-na-da-ni-lv-go-i;"
        intervals [125]:
            xmin = 616.070
            xmax = 616.070
            text = "020417: A-le v-tla yi-du-ni-hna-s-de-tlo-i, tle-ga-quo-s-gi-ni da-ni-ka-hna-wa-de-go-i; hna-quo-no, a-gi-li-ya a-le u-de-ya-do-di a-li-ye-i-lo-ga ka-no-he-dv dv-li-ye-i-lv-s-da, gi-la-quo i-yv-dv du-no-de-hi-ho-i."
        intervals [126]:
            xmin = 616.070
            xmax = 616.070
            text = "020418: A-le hi-a a-nu-ga-lv-hi tsi-ge-tsi-wi-se-le-i; na-s-gi hi-a ka-no-he-dv tsa-na-dv-gi-s-go-i,"
        intervals [127]:
            xmin = 616.070
            xmax = 616.070
            text = "020419: U-we-li-hi-s-di-no e-lo-hi e-hi, a-le ge-nv-i-s-di ge-sv u-da-li-da-s-di ge-sv-i, a-le tsu-da-le-nv-dv go-hu-s-di a-du-lv-di ge-sv, a-ni-yv-hi-hv a-ni-ne-nu-la-s-di-s-go ka-no-he-dv, a-le na-s-gi na-ga-ta-dv-s-gv-na-quo ge-so-i."
        intervals [128]:
            xmin = 616.070
            xmax = 616.070
            text = "020420: Hi-a-no na-s-gi o-sv ga-do-hi tsi-ge-tsi-wi-se-le-i; na-s-gi a-na-dv-gi-s-gi ka-no-he-dv, a-le di-na-da-ni-lv-gi, a-le a-ni-ga-ta-dv-s-gi, i-ga-dv tso-a-s-go-hi i-yu-wa-gu-di, i-ga-dv-no su-da-la-s-go-hi, i-ga-dv-no a-s-go-hi-tsu-qui."
        intervals [129]:
            xmin = 616.070
            xmax = 616.070
            text = "020421: Hi-a-no ni-du-we-se-le-i, A-tsv-s-do-di-s-go a-ni-no-hi-ho a-tli-lo-s-di ga-ka-hv ha-wi-ni-di-tlv u-ni-go-di-yi, a-le ga-ni-tlv-wi-quo?  V-tla-no u-ni-go-di-yi a-tsv-s-do-di ga-go-di-yi?"
        intervals [130]:
            xmin = 616.070
            xmax = 616.070
            text = "020422: V-tla-ye-no go-hu-s-di yi-gv-s-ga-la na-s-gi gv-ni-ge-sv i-gv-ne-di ni-ge-sv-na; v-tla a-le go-hu-s-di u-de-li-dv yi-ni-gv-no, na-s-gi a-se gv-ni-ge-sv i-yu-li-s-do-di ni-ge-sv-na."
        intervals [131]:
            xmin = 616.070
            xmax = 616.070
            text = "020423: Gi-lo de-ga-li-lu-ge-s-di u-dv-go-di-yi wa-dv-gv-ga."
        intervals [132]:
            xmin = 616.070
            xmax = 616.070
            text = "020424: Hi-a-no ni-du-we-se-le-i, I-tse-ya-ta-he-s-di nu-s-dv i-tsa-dv-gi-s-gv-i; nu-s-dv i-tsa-da-tli-lo-sv-hv, na-s-gi-ya e-tsa-li-na-lo-e-di ge-se-s-di; ni-hi-no i-tsa-dv-gi-s-gi e-tsi-ne-quo-e-di e-tsi-ne-di ge-se-s-di."
        intervals [133]:
            xmin = 616.070
            xmax = 616.070
            text = "020425: Gi-lo-ye-no u-he-s-di, na-s-gi a-tsi-ne-di ge-se-s-di; gi-lo-no nu-hv-na ge-se-s-di, na-s-gi a-tsi-gi-sv-di ge-se-s-di na-s-quo u-hv-i."
        intervals [134]:
            xmin = 616.070
            xmax = 616.070
            text = "020426: Hi-a-no nu-we-se-i, U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv na-s-gi-ya-quo gi-lo a-s-ga-ya u-ga-ta yu-wi-sv ga-do-hi;"
        intervals [135]:
            xmin = 616.070
            xmax = 616.070
            text = "020427: A-le yu-lv-nv, a-le ya-di-di-ha di-gv-wa-gi-tsv-di, a-le u-ga-ta yu-li-ye-nv, a-le yu-dv-sv, nu-li-s-do-ta-nv nu-do-le-ho-sv-na."
        intervals [136]:
            xmin = 616.070
            xmax = 616.070
            text = "020428: Ga-do-hi-ye-no u-wa-sv-quo ga-na-nu-go-wi-s-go u-ga-ta-ta-nv-hi; i-gv-yi-yi ge-sv u-ga-lo-gv, hna-quo-no u-s-gu-da-dv-i, o-ni-no u-ka-li-tsv-hi u-ga-ta-dv u-s-gu-da-dv-i."
        intervals [137]:
            xmin = 616.070
            xmax = 616.070
            text = "020429: Hna-quo-no a-ga-dv-na-gi gi-la-quo i-yv-dv a-s-gu-de-s-go-i, a-s-gu-de-s-di-yi-ye-no u-li-ye-i-lo-lo-i."
        intervals [138]:
            xmin = 616.070
            xmax = 616.070
            text = "020430: Hi-a-no nu-we-se-i, Ga-do do-da-da-tse-la-s-ta-ni U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv-i?  Ga-do-ge da-tli-lo-s-dv do-da-da-tli-lo-s-ta-ni?"
        intervals [139]:
            xmin = 616.070
            xmax = 616.070
            text = "020431: A-tsi-lv--u-ga-ta na-s-gi-ya-i, na-s-gi ga-do-hi tsa-wi-so-i, tsi-wu-da-go-na-dv-di u-s-di-gi-yu e-s-ga-quo ni-ga-v u-ga-ta ga-do-hi da-ha-dv-i."
        intervals [140]:
            xmin = 616.070
            xmax = 616.070
            text = "020432: A-se-no a-wi-sv-hi tsi-ge-so-i, di-dv-s-go-i, a-le u-tli e-quo-hi-yu ni-ga-li-s-di-s-go e-s-ga-quo ni-ga-v u-ye-hna-v-i, a-le tse-quo-hi-yu da-yi-tlv-s-go-i; a-le tsi-s-qua u-dla-nv-dv a-ni-no-hi-li-do-hi ye-li-quo u-da-wa-di-s-dv ha-wi-ni-di-tlv a-na-ha-di-s-go-i."
        intervals [141]:
            xmin = 616.070
            xmax = 616.070
            text = "020433: Na-s-gi nu-we-se u-tsa-te du-tli-lo-s-da-ne-le-i, ka-no-he-dv du-li-tsi-do-ne-le-i, na-s-gi ye-li gv-wa-na-dv-go-di ni-ga-li-s-di-s-gv-i."
        intervals [142]:
            xmin = 616.070
            xmax = 616.070
            text = "020434: Ni-da-tli-lo-s-da-ne-hv-na-s-gi-ni v-tla yi-du-wo-ne-ta-ne-i; u-nv-sv-no ge-se-i, ni-ga-dv na-s-gi du-wo-si-sa-ne-le gv-wa-s-da-wa-di-do-hi."
        intervals [143]:
            xmin = 616.070
            xmax = 616.070
            text = "020435: Na-hi-yu-quo-no i-ga, u-sv nu-li-s-ta-nv, hi-a ni-du-we-se-le-i, Di-di-so-gi s-go-na wi-di-lo-hi."
        intervals [144]:
            xmin = 616.070
            xmax = 616.070
            text = "020436: Du-ni-ye-li-hi-s-ta-nv-no u-ni-tsa-ti nv-wa-dv-ne-quo tsi-yu-hi u-tsa-v gv-wa-ti-na-wi-dv-he-i; a-le na-s-quo ni-di-gv-wa-da-le tsu-s-di tsi-yu u-na-li-go-wa-di-se-i."
        intervals [145]:
            xmin = 616.070
            xmax = 616.070
            text = "020437: U-tsa-ti-no u-yi-lo-le u-no-le, a-le da-li-s-di-la-ne-gv tsi-yu-hi a-tli-ge-i, a-le hna-quo a-ka-li-wo-hi ge-se-i."
        intervals [146]:
            xmin = 616.070
            xmax = 616.070
            text = "020438: Tsi-yu-hi-no o-ni-di-tlv u-tsa-e ga-li-he-i, a-gu-s-do u-gu-s-da-e-i; gv-wa-ye-s-ta-ne-no, a-le hi-a ni-gv-wa-we-se-le-i, Ta-de-yo-hv-s-gi, tla-s-go go-hu-s-di ye-li-ha tsv-da-yo-tsa-di-sv-ni?"
        intervals [147]:
            xmin = 616.070
            xmax = 616.070
            text = "020439: Du-le-ne-no, u-no-le u-s-ga-tse-i, a-le hi-a nu-we-se-le v-da-li, Do-quo; u-da-tsi-na-s-dv-hi hna-li-s-da.  Ga-no-lv-v-s-gv-no u-su-li-go-tse-i, a-le u-tsa-ti u-da-tsi-na-s-dv-hi nu-li-s-ta-ne-i."
        intervals [148]:
            xmin = 616.070
            xmax = 616.070
            text = "020440: Hi-a-no ni-du-we-se-le-i, Ga-do-no ni-tsi-s-ga-sv-na?  Ga-do di-ga-li-s-do-di ni-tso-hi-yu-sv-na i-gi?"
        intervals [149]:
            xmin = 616.070
            xmax = 616.070
            text = "020441: U-tsa-ti-no u-ni-s-ga-le-i, a-le hi-a ni-du-na-da-we-se-le-i, Ga-do u-s-di hi-a a-s-ga-ya, na-s-quo-ye-no u-no-le a-le v-da-li i-gv-wo-hi-yu-hv-s-ga."
        intervals [150]:
            xmin = 616.070
            xmax = 616.070
            text = "020501: I-s-go-ni-di-tlv-no v-da-li wu-ni-lu-tse A-ni-ge-de-li u-na-tse-li-go-hi."
        intervals [151]:
            xmin = 616.070
            xmax = 616.070
            text = "020502: Tsi-yu-hi-no u-tsa-i-sv gi-la-quo i-yv-dv du-tlo-se a-s-ga-ya da-da-ni-sa-hv nv-da-yu-lo-sv-hi ga-da-ha a-da-nv-do u-ya-i,"
        intervals [152]:
            xmin = 616.070
            xmax = 616.070
            text = "020503: Na-s-gi da-da-ni-sa-hv-quo e-he-i; v-tla a-le na-s-quo tsu-da-de-sv-dv gv-di gi-lo gv-wa-lv-s-di yi-ge-se-i."
        intervals [153]:
            xmin = 616.070
            xmax = 616.070
            text = "020504: Ya-no-gi-yu-ye-no tsa-tsi-nv-tlo-lv-hi ge-se-i, a-le tsu-da-de-sv-dv tsa-ga-lv-s-ta-nv-hi ge-se-i, tsu-da-de-sv-dv-no da-ga-li-s-ge-i, a-le di-ga-nv-tlo-s-di da-s-qua-li-s-ge-i; v-tla a-le gi-lo gv-wa-da-nv-ti-so-di yi-ge-se-i."
        intervals [154]:
            xmin = 616.070
            xmax = 616.070
            text = "020505: A-le ni-go-hi-lv, sv-no-yi a-le i-ga, ga-du-si a-le da-da-ni-sa-hv-i, u-we-lu-ge-i, a-le nv-ya gv-di a-da-ye-lo-he-i."
        intervals [155]:
            xmin = 616.070
            xmax = 616.070
            text = "020506: A-se-no i-nv-hi-yu wu-go-hv Tsi-sa, du-s-qua-lv-ta-ne a-le u-da-do-li-s-da-ne-le-i,"
        intervals [156]:
            xmin = 616.070
            xmax = 616.070
            text = "020507: A-le a-s-da-ya u-we-lu-ne hi-a nu-we-se-i; Ga-do di-gi-na-da-dv-do-di ni-hi Tsi-sa, wa-s-dv ga-lv-la-di-yu e-hi U-ne-la-nv-hi U-we-tsi?  Gv-ne-tse-ha, U-ne-la-nv-hi gv-ne-i-s-da-ne-ha, na-s-gi s-gi-gi-li-yo-i-s-do-di-yi ni-ge-sv-na."
        intervals [157]:
            xmin = 616.070
            xmax = 616.070
            text = "020508: Hi-a-ye-no nu-we-se-le-i, E-hi-nu-go-i na-s-gi na a-s-ga-ya, ni-hi hi-ga-da-ha a-da-nv-do."
        intervals [158]:
            xmin = 616.070
            xmax = 616.070
            text = "020509: U-dv-dv-ne-no, Ga-do de-tsa-do-v?  U-wo-se-le-i.  Hi-a-no nu-we-se-le-i, Su-na-da-tlu-gi da-qua-do-v; o-gi-tsa-ta-ye-no."
        intervals [159]:
            xmin = 616.070
            xmax = 616.070
            text = "020510: A-le u-tsa-ti u-s-di-ye-ta-ne na-hna ge-sv tsu-nu-go-wi-s-di-yi ni-ge-sv-na ge-sv-i."
        intervals [160]:
            xmin = 616.070
            xmax = 616.070
            text = "020511: Na-hna-no o-da-lu-lo-di u-ni-tsa-ti su-na-da-tlu-gi si-qua a-na-li-s-da-yv-ni-do-he-i."
        intervals [161]:
            xmin = 616.070
            xmax = 616.070
            text = "020512: Ni-ga-dv-no a-ni-s-gi-na gv-wa-s-di-ye-ta-ne hi-a na-ni-we-s-ge-i, U-ne-la-gi si-qua di-ne-do-hv wo-tsi-lo-hi, na-s-gi wi-do-tsi-yv-si."
        intervals [162]:
            xmin = 616.070
            xmax = 616.070
            text = "020513: Gi-la-quo-no i-yv-dv Tsi-sa du-li-s-go-lv-da-ne-le-i.  Di-ga-da-ha-no di-da-nv-do u-ni-nu-go-tsv, si-qua wi-du-ni-yv-se-le-i; su-na-da-tlu-gi-no u-na-ne-lu-gi-se u-ni-ga-so-a-se ga-ne-tlu-gi ge-sv v-da-li wu-na-li-ta-di-nv-se-i, (ta-li i-ya-ga-yv-li i-yv-dv na-ni-e-i,) a-le v-da-li du-ni-gv-tse-i."
        intervals [163]:
            xmin = 616.070
            xmax = 616.070
            text = "020514: Di-ni-ga-ti-ya-no u-na-li-se-i, a-le ga-du-hv wu-ni-no-ne-i, a-le i-yv-dv da-ne-wa-di-sv-i.  U-ni-nu-go-tse-no u-na-ga-ta-nv-se na-s-gi nu-li-s-ta-nv-i."
        intervals [164]:
            xmin = 616.070
            xmax = 616.070
            text = "020515: Tsi-sa-no gv-wa-lu-tse-le-i, a-le gv-wa-go-he na-s-gi a-ni-s-gi-na gv-wa-yv-lv-hi, na-s-gi su-na-da-tlu-gi gv-wa-yv-lv-hi, u-wo-le-i, a-le du-nu-we-i, a-le do-hi u-da-nv-te-i; a-le a-ni-s-ga-i-he-i."
        intervals [165]:
            xmin = 616.070
            xmax = 616.070
            text = "020516: Na-s-gi-no u-ni-go-hv-hi, gv-wa-ni-no-ne-le nu-li-s-da-ne-lv a-ni-s-gi-na gv-wa-yv-lv-hi, a-le na-s-quo si-qua nu-na-li-s-da-ne-lv-i."
        intervals [166]:
            xmin = 616.070
            xmax = 616.070
            text = "020517: A-le u-na-le-nv-he gv-wa-ta-yo-se-le u-da-nv-s-di-yi u-na-tse-li-go-hi."
        intervals [167]:
            xmin = 616.070
            xmax = 616.070
            text = "020518: Tsi-yu-hi-no u-tsa-nv na-s-gi a-ni-s-gi-na gv-wa-yv-lv-hi u-ta-yo-se-le u-ne-la-gi u-we-li-se-di-yi u-s-da-wa-di-da-s-di-yi."
        intervals [168]:
            xmin = 616.070
            xmax = 616.070
            text = "020519: A-se-no v-tla yu-li-s-go-lv-da-ne-le-i Tsi-sa, hi-a-quo-s-gi-ni nu-we-se-le-i, Tsi-he-na di-tse-nv-sv go-hu-s-di di-tsv-na di-ne-hv-i, a-le wi-di-no-hv-si ni-ga-v u-s-qua-ni-go-di U-gv-wi-yu-hi ni-tsa-dv-ne-lv-i, a-le tsa-do-li-tsv-i."
        intervals [169]:
            xmin = 616.070
            xmax = 616.070
            text = "020520: U-ni-gi-se-no, a-le u-le-nv-he du-no-tsa-la-ne A-s-go-hi--i-ga-du-gi-yi, ni-ga-v u-s-qua-ni-go-di Tsi-sa nu-dv-ne-lv-i; a-le ni-ga-dv yv-wi u-ni-s-qua-ni-go-se-i."
        intervals [170]:
            xmin = 616.070
            xmax = 616.070
            text = "020521: Tsi-sa-no ta-li-ne tsi-yu-hi do-u-we-so-tsv i-s-go-na wi-u-lu-tsv, u-ni-tsa-ti yv-wi gv-wa-da-tlu-wi-s-ta-ne-i; a-le v-da-li u-lo-di e-do-he-i."
        intervals [171]:
            xmin = 616.070
            xmax = 616.070
            text = "020522: A-le gv-ni-yu-quo u-lu-tse gi-lo i-yu-s-di nu-gv-wi-yu-sa-de-gi di-ga-la-wi-i-s-di-yi, Tse-la tsu-do-i-dv; u-go-hv-no [Tsi-sa] du-la-s-gv u-da-nv-ne-i,"
        intervals [172]:
            xmin = 616.070
            xmax = 616.070
            text = "020523: A-le u-tsa-ti u-s-di-ye-ta-ne-i, hi-a nu-we-se-i; A-que-tsi a-ge-yu-tsa hna-quo a-yo-hu-s-ga; a-se-no i-ne-na, hi-ya-si-ta-dv-ha, na-s-gi u-di-wi-s-di-yi, gv-ne-s-di-no."
        intervals [173]:
            xmin = 616.070
            xmax = 616.070
            text = "020524: U-ne-nv-se-no; a-le u-ni-tsa-te yv-wi gv-wa-s-da-wa-dv-se-i, a-le gv-wa-ne-nu-la-s-di-s-ge-i."
        intervals [174]:
            xmin = 616.070
            xmax = 616.070
            text = "020525: Gi-lo-no i-yu-s-di a-ge-yv ta-la-du tsu-de-ti-yv-dv gv-wa-da-le-nv-dv gi-gv u-we-nv-e-he-i,"
        intervals [175]:
            xmin = 616.070
            xmax = 616.070
            text = "020526: A-le a-ni-go-di-yu a-ni-ga-na-ga-ti u-tsa-ti gv-wa-gi-lv-nv-hi ge-se-i, a-le go-hu-s-di u-hv ni-ga-dv u-sv-nv-hi ge-se a-gu-yi-s-gv-i, a-se-no v-tla o-si-yu yi-nu-li-s-da-ne-he-i, ka-ne-quo-ge-quo-s-gi-ni u-tlv-gv-i;"
        intervals [176]:
            xmin = 616.070
            xmax = 616.070
            text = "020527: Na-s-gi u-dv-ga-nv Tsi-sa a-tsi-no-he-s-gv-i, o-ni-di-tlv u-nv-ti-dv nu-na-dv-nv u-lu-hi-s-ta-ne, a-le u-sv-ni-le u-nu-wv-i."
        intervals [177]:
            xmin = 616.070
            xmax = 616.070
            text = "020528: Hi-a-ye-no nu-we-se-i, Tsu-nu-wo-quo na-s-quo yi-da-qua-sv-ni-lv, ya-qua-di-wi."
        intervals [178]:
            xmin = 616.070
            xmax = 616.070
            text = "020529: Gi-la-quo-no i-yv-dv gi-gv u-we-nv-e-hv u-yo-hi-s-ta-ne-i; u-do-le-ho-se-no a-ye-lv u-di-wa-sv na-s-gi u-tlv-gv-i."
        intervals [179]:
            xmin = 616.070
            xmax = 616.070
            text = "020530: Tsi-sa-no gi-la-quo i-yv-dv u-do-le-ho-sv u-wa-sv ge-sv u-da-nv-wo-di ge-sv u-nu-go-tsv-i, u-ga-ta-hv-se na-hna u-nv-ti-dv a-ni-do-na-v-i, a-le hi-a nu-we-se-i, Ga-go da-sv-ni-ga di-qua-nu-wo?"
        intervals [180]:
            xmin = 616.070
            xmax = 616.070
            text = "020531: Gv-wa-s-da-wa-di-do-hi-no hi-a ni-gv-wa-we-se-le-i, De-gi-go-wa-di-ha u-ni-tsa-ti ge-tsa-ne-nu-la-s-di-s-gv, tsi-go-no Ga-go a-qua-sv-ni-ga i-ha-di-ha?"
        intervals [181]:
            xmin = 616.070
            xmax = 616.070
            text = "020532: Gv-wa-du-wi-dv-no u-ga-te-no-le u-go-wa-dv-di-yi na-s-gi hi-a i-yu-dv-ne-lv-hi."
        intervals [182]:
            xmin = 616.070
            xmax = 616.070
            text = "020533: Na-s-gi-no a-ge-yv a-s-ga-i-he a-le u-we-na-wi-s-ge-i, a-ga-ta-he nu-li-s-da-ne-lv-i, u-lu-tse a-le e-la-di u-da-nv-ne-le-i, a-le ni-ga-dv du-yu-go-dv u-no-ne-le-i."
        intervals [183]:
            xmin = 616.070
            xmax = 616.070
            text = "020534: Hi-a-no nu-we-se-le-i, A-que-tsi, tso-hi-yu-sv tsa-di-wi-s-da; nv-wa-do-hi-ya-dv tsi-he-na, a-le tsa-di-wa-sv-hi ge-se-s-di tsa-tlv-gv-i."
        intervals [184]:
            xmin = 616.070
            xmax = 616.070
            text = "020535: A-si-quo ka-ne-ge-i, nu-gv-wi-yu-sa-de-gi di-ga-la-wi-i-s-di-yi ga-ne-lv nv-da-yu-na-da-le-nv-hi u-ni-lu-tse hi-a nu-ni-we-se-i, U-yo-hu-sv tse-tsi; ga-do-no a-si-quo i-hi-ya-de-ya-do-di-ha di-de-yo-hv-s-gi?"
        intervals [185]:
            xmin = 616.070
            xmax = 616.070
            text = "020536: U-dv-ga-nv-quo-no Tsi-sa nu-s-dv u-ni-wo-ni-sv-i, hi-a nu-we-se-le nu-gv-wi-yu-sa-de-gi di-ga-la-wi-i-s-di-yi, Tle-s-di yi-s-ga-i-he-s-di, tso-hi-yu-se-s-di-quo."
        intervals [186]:
            xmin = 616.070
            xmax = 616.070
            text = "020537: V-tla a-le gi-lo yu-li-s-go-lv-da-ne-le gv-wa-s-da-wa-dv-s-di-yi, Qui-da, a-le Tsi-mi, a-le Tsa-ni Tsi-mi di-na-da-nv-tli u-nv-sv."
        intervals [187]:
            xmin = 616.070
            xmax = 616.070
            text = "020538: U-lu-tse-no ga-ne-lv nu-gv-wi-yu-sa-de-gi di-ga-la-wi-i-s-di-yi, a-le du-ga-he u-na-da-su-ye-dv yv-wi, a-le u-tsa-ti da-na-tlo-yi-hv a-le da-ni-yv-gv-i."
        intervals [188]:
            xmin = 616.070
            xmax = 616.070
            text = "020539: U-ye-lv-no hi-a ni-du-we-se-le-i, Ga-do-no i-tsa-da-no-yv-li-s-di-ha, a-le do-tsa-tlo-yi-ha?  V-tla yu-yo-hu-sv a-ge-yu-tsa, ga-li-ha-quo-s-gi-ni."
        intervals [189]:
            xmin = 616.070
            xmax = 616.070
            text = "020540: I-gv-wa-do-tlv-ta-ne-quo-no.  Ni-ga-dv-no du-nu-go-wi-so-nv, hi-a na-s-gi a-ge-yu-tsa u-do-da a-le u-tsi a-le na-s-gi a-ne-hi du-ti-nv-se, a-le wu-yv-le na-hna a-ge-yu-tsa di-so-nv-i."
        intervals [190]:
            xmin = 616.070
            xmax = 616.070
            text = "020541: U-wo-ya-ne-sv-no a-ge-yu-tsa, hi-a nu-we-se-le-i, Ta-li-da Gu-mi; na-s-gi a-ne-tlv-ta-nv-hi hi-a nu-s-di ga-dv-ga; Hi-ge-yu-tsa, gv-yo-se-ha, Ta-le-hv-ga."
        intervals [191]:
            xmin = 616.070
            xmax = 616.070
            text = "020542: Gi-la-quo-no i-yv-dv a-ge-yu-tsa du-le-ne-i, a-le u-we-do-le-i; ta-la-du-ye-no i-yu-de-ti-yv-dv ge-se-i.  U-tsa-ta-nv-hi-no u-ni-s-qua-ni-go-se-i."
        intervals [192]:
            xmin = 616.070
            xmax = 616.070
            text = "020543: U-li-ni-gi-dv-no du-ne-tse-le du-nv-s-da-de-le gi-lo u-do-le-ho-hi-s-di-yi na-s-gi; a-le u-ne-tse-go-hu-s-di u-li-s-da-yv-di u-ni-ne-di-yi."
        intervals [193]:
            xmin = 616.070
            xmax = 616.070
            text = "020601: U-nu-go-tse-no na-hna-ni, a-le u-wa-sv u-tse-li-go-hi wu-lu-tse-i; gv-wa-s-da-wa-di-do-hi-no gv-wa-s-da-wa-dv-se-i."
        intervals [194]:
            xmin = 616.070
            xmax = 616.070
            text = "020602: U-na-do-da-qua-s-gv-no u-li-ye-lo-lv, u-le-nv-he du-de-yo-ne di-ga-la-wi-i-s-di-yi; u-ni-tsa-ti-no gv-wa-dv-ga-ne-lv u-ni-s-qua-ni-go-se-i, hi-a na-ni-we-s-ge-i, Ha-tlv a-gi-ha hi-a a-s-ga-ya hi-a na-s-gi i-gv-wa-dv-ne-di tsi-gi?  A-le ga-do u-s-di a-ga-do-v-hi-s-di na-s-gi a-tsi-ne-lv-hi tsi-gi, na-s-gi i-yu-s-di u-s-qua-ni-go-di tsi-du-lv-wi-s-da-ne-ha?"
        intervals [195]:
            xmin = 616.070
            xmax = 616.070
            text = "020603: Tla-s-go na-s-gi hi-a di-ne-s-ge-s-gi yi-gi, Me-li u-we-tsi, Tsi-mi, a-le Tso-si, a-le Tsu-da, a-le Sa-wa-ni a-na-li-nv-tli?  A-le tsu-do tla-s-go a-ni yi-ge-ga-da-su-ya?  V-gv-wa-so-nv-tse-lv-gi-no."
        intervals [196]:
            xmin = 616.070
            xmax = 616.070
            text = "020604: Tsi-sa-no hi-a ni-du-we-se-le-i; a-do-le-ho-s-gi v-tla na-tsi-lv-quo-dv-na yi-ge-so-i, u-tse-li-go-hi-s-gi-ni-no-nv u-wa-sv, a-le tsu-yv-wi a-ne-hv-i, a-le u-wa-sv ga-ne-lv-i."
        intervals [197]:
            xmin = 616.070
            xmax = 616.070
            text = "020605: A-le na-hna v-tla go-hu-s-di u-s-qua-ni-go-di di-gv-wa-lv-wi-s-da-ne-di yi-ge-se-i, u-wa-sv-s-gi-ni-no-nv i-lv-s-gi i-ya-ni-dv tsu-ni-tlv-gi du-si-ta-dv a-le du-nv-wa-nv-i."
        intervals [198]:
            xmin = 616.070
            xmax = 616.070
            text = "020606: A-le u-s-qua-ni-go-se na-no-hi-yu-hv-s-gv-na ge-sv-i.  A-le u-we-do-le u-du-wi-dv de-ga-du-wa-di-sv-i da-de-yo-hv-s-ge-i."
        intervals [199]:
            xmin = 616.070
            xmax = 616.070
            text = "020607: Ta-la-du-no i-ya-ni-dv wi-du-ya-nv-he-i, a-le du-nv-si-do-le ta-li-ha tsu-li-go-nv-dv, a-le du-li-s-go-lv-da-ne-le tsu-ni-nu-go-wi-s-di-yi di-ga-da-ha di-da-nv-do;"
        intervals [200]:
            xmin = 616.070
            xmax = 616.070
            text = "020608: A-le du-ne-tse-le na-s-gi go-hu-s-di u-ni-yv-s-di-yi ni-ge-sv-na u-na-li-s-de-lv-do-di a-ne-do-hv-i, a-do-la-nv-s-di u-wa-sv; v-tla de-ga-lo-di, a-le ga-du, a-le v-tsa-yi du-na-da-tlo-hv-i;"
        intervals [201]:
            xmin = 616.070
            xmax = 616.070
            text = "020609: Tsu-na-la-su-lv-di-yi-s-gi-ni; a-le tle-s-di ta-li yi-di-tsa-nu-wo-s-ge-s-di."
        intervals [202]:
            xmin = 616.070
            xmax = 616.070
            text = "020610: A-le hi-a ni-du-we-se-le-i, a-da-ne-lv i-lv-hi-tlv i-tsi-yv-hi-he-s-di, na-hna-quo i-tsa-nv-v-s-ge-s-di gv-ni v-tsa-ni-gi na-hna-ni."
        intervals [203]:
            xmin = 616.070
            xmax = 616.070
            text = "020611: A-le gi-lo ni-di-tsa-da-ni-lv-gv-na a-le ni-tsa-dv-da-s-da-ne-hv-na i-ge-se-s-di, hna-quo na-hna i-tsa-ni-gi-s-ge-s-di, di-tsa-la-si-de-ni go-s-du de-tsi-nv-go-v-di-s-ge-s-di, na-s-gi go-hi-yu-di-s-gi u-na-tlu-di-s-gi.  U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, e-s-ga-quo i-ga-i u-ni-gi-li-yo-i-s-di ge-se-s-di So-da-mi, a-le Go-ma-li, di-gu-go-do-di-yi i-ga ge-se-s-di, u-tli-hi-yu na-hna ga-du-hv-i."
        intervals [204]:
            xmin = 616.070
            xmax = 616.070
            text = "020612: U-ni-nu-go-tse-no, wu-na-li-tsi-do-ne na-s-gi yv-wi a-se tsu-ni-ne-tli-yv-s-di ge-sv du-na-da-nv-dv-i."
        intervals [205]:
            xmin = 616.070
            xmax = 616.070
            text = "020613: U-ni-tsa-ti-no du-ni-nu-go-wi-se a-ni-s-gi-na, a-le go-i du-ni-lo-ne-ta-ne u-ni-tsa-ti tsu-ni-tlv-gi, a-le du-ni-nv-wa-ne-i."
        intervals [206]:
            xmin = 616.070
            xmax = 616.070
            text = "020614: E-lo-dv-no u-gv-wi-yu-hi u-dv-ga-ne na-s-gi a-tsi-no-he-s-gv-i; du-no-tsa-lo-tse-ye-no na-s-gi du-do-v-i; a-le hi-a nu-we-se E-lo-dv, Tsa-ni Di-da-wo-s-gi da-le-hi-sa u-yo-hu-sv-i, a-le na-s-gi nv-di-ga-li-s-do-di-ha u-s-qua-ni-go-di tsi-de-u-lv-wi-s-da-ne-ha."
        intervals [207]:
            xmin = 616.070
            xmax = 616.070
            text = "020615: I-ga-dv-no hi-a na-ni-we-s-ge-i, I-la-ya hi-a.  I-ga-dv-no hi-a na-ni-we-s-ge-i, a-do-le-ho-s-gi hi-a, a-le gi-lo a-na-do-le-ho-s-gi ge-sv na-s-gi-ya-i."
        intervals [208]:
            xmin = 616.070
            xmax = 616.070
            text = "020616: E-lo-dv-s-gi-ni u-dv-ga-nv, hi-a nu-we-se-i; Tsa-ni hi-a, na-s-gi a-yv tsi-tsi-s-gu-de-sv-gi; na-s-gi du-le-hi-sa-nv u-yo-hu-sv-i."
        intervals [209]:
            xmin = 616.070
            xmax = 616.070
            text = "020617: E-lo-dv-ye-no u-wa-sv u-da-nv-sv-hi ge-se wu-ni-yv-hv-hi ge-se Tsa-ni, a-le di-da-s-du-di-yi u-lv-lv-hi ge-se-i, a-s-dv-di-s-di-s-ge E-lo-di-si, u-nv-tli Qui-li-gi u-da-li-i; na-s-gi-ye-no a-da-ye-he-i."
        intervals [210]:
            xmin = 616.070
            xmax = 616.070
            text = "020618: Tsa-ni-ye-no hi-a i-yu-we-se-lv-hi ge-se E-lo-dv, v-tla yi-du-yu-go-di e-tsa-nv-tli u-da-li-i tsa-da-ye-ha."
        intervals [211]:
            xmin = 616.070
            xmax = 616.070
            text = "020619: Na-s-gi i-yu-s-di E-lo-di-si a-s-ga-ge [Tsa-ni] a-le yu-le-i; a-se-no v-tla na-s-gi i-gv-wa-dv-ne-di yi-ge-se-i."
        intervals [212]:
            xmin = 616.070
            xmax = 616.070
            text = "020620: E-lo-dv-ye-no u-lv-quo-di-yu ge-se Tsa-ni, a-ga-ta-he-ye-no u-da-nv-ti-yu a-le na-s-ga-nv-na ge-sv a-s-ga-ya, a-le u-ga-sa-ya-s-di-yu ge-se-i; na-s-gi-no u-dv-ga-nv [a-li-tsi-do-hv-s-gv,] u-tsa-te du-lv-wi-s-da-ne-le-i, a-le u-li-he-li-tsv-hi a-dv-da-s-da-ne-he-i."
        intervals [213]:
            xmin = 616.070
            xmax = 616.070
            text = "020621: A-hi-dv-no na-s-gi i-gv-dv-ne-di ge-sv u-s-qua-lv-hv, na-s-gi E-lo-dv u-de-nv i-yu i-ga u-dv-nv-i-s-ta-ne gv-wa-li-s-da-yv-na-ne-di-yi tsu-tse-li u-ni-gv-wi-yu-hi, a-le a-ni-s-ga-ye-gv-s-da, a-le di-ge-ga-ne-lo-di Ge-li-li a-ne-hi,"
        intervals [214]:
            xmin = 616.070
            xmax = 616.070
            text = "020622: Na-s-gi-no E-lo-di-si u-we-tsi a-dv u-yv-li-lv, a-le u-li-s-gi-sv, a-le E-lo-dv a-le na-s-gi i-tsu-la-ha a-ni-ni-dla-i o-si-yu u-ni-ye-lv-nv, u-gv-wi-yu-hi hi-a nu-we-se-le a-dv, S-gi-ta-yo-si i-yu-s-di-quo he-li-s-gv-i, da-gv-ne-li-no."
        intervals [215]:
            xmin = 616.070
            xmax = 616.070
            text = "020623: U-se-li-da-ne-le-no [hi-a nu-we-se-i,] I-yu-s-di-quo he-li-s-gv s-gi-ta-yo-si, da-gv-ne-li-no, na-s-quo a-ye-li i-yv-dv yi-gi na-hna a-gi-gv-wi-yu-hi ge-sv-i."
        intervals [216]:
            xmin = 616.070
            xmax = 616.070
            text = "020624: U-nu-go-tsv-no hi-a wi-nu-we-se-le u-tsi, ga-do da-tsi-ta-yo-li?  Hi-a-no nu-we-se-le-i, Tsa-ni Di-da-wo-s-gi a-s-go-li."
        intervals [217]:
            xmin = 616.070
            xmax = 616.070
            text = "020625: I-gv-we-nv-dv-quo-no u-li-s-di u-yv-li-le u-gv-wi-yu-hi a-ya-v-i, a-le u-ta-yo-le hi-a nu-we-se-i, A-qua-du-li gi-la-quo i-yv-dv s-gi-ne-di-yi, a-te-li-do-gi-hi, Tsa-ni di-da-wo-s-gi u-s-go."
        intervals [218]:
            xmin = 616.070
            xmax = 616.070
            text = "020626: U-gv-wi-yu-hi-no u-tsa-ti tla-quo u-ye-lv-ne-i; a-se-no u-se-li-ta-nv-i, a-le na-s-gi i-tsu-la-ha u-na-ni-dla-nv-hi nv-tsu-li-s-do-ta-ne, v-tla gv-wa-ge-yu-do-di yi-ge-se-i."
        intervals [219]:
            xmin = 616.070
            xmax = 616.070
            text = "020627: Gi-la-quo-no i-yv-dv u-gv-wi-yu-hi u-nv-se a-ya-wi-s-gi, a-le u-ne-tse u-s-go u-ni-yo-hi-s-di-yi; u-we-nv-se-no, a-le wu-s-gu-de-se di-da-s-du-di-yi a-ya-v-i,"
        intervals [220]:
            xmin = 616.070
            xmax = 616.070
            text = "020628: A-le u-yo-le u-s-go a-te-li-do-gi-hi ga-lo-de-i, a-le a-dv u-ne-le-i; a-dv-no u-tsi u-ne-le-i."
        intervals [221]:
            xmin = 616.070
            xmax = 616.070
            text = "020629: Gv-wa-s-da-wa-di-do-hi-no u-na-dv-ga-nv, u-ni-lu-tse a-le u-ni-ne-se a-ye-lv-i, a-le a-tse-li-s-dv u-ni-nv-ne-i."
        intervals [222]:
            xmin = 616.070
            xmax = 616.070
            text = "020630: Ge-tsi-nv-si-dv-no u-na-da-tli-sa-ne Tsi-sa e-do-hv-i, a-le gv-wa-no-ne-le ni-ga-dv nu-na-dv-ne-li-do-lv, a-le na-s-quo nu-s-dv du-na-de-yo-nv-i."
        intervals [223]:
            xmin = 616.070
            xmax = 616.070
            text = "020631: Hi-a-no ni-du-we-se-le-i, I-de-na i-tsv-sv-quo i-yv-dv wi-di-lo-hi i-na-ge di-ge-sv-i, a-le tle-ga i-tsa-tsa-we-so-lv-s-da; u-ni-tsa-te-ye-no a-ni-lu-ge a-le da-ne-ge-i, v-tle-no ya-dla-nv-da-di-s-ge na-s-quo u-na-li-s-da-yv-di-yi i-go-hi-dv."
        intervals [224]:
            xmin = 616.070
            xmax = 616.070
            text = "020632: Tsi-yu-hi-no u-na-tsa-e-i, u-na-ni-gi-se i-na-ge wu-ni-lo-se u-de-li-dv."
        intervals [225]:
            xmin = 616.070
            xmax = 616.070
            text = "020633: Yv-wi-no gv-wa-ni-go-he a-na-ni-gi-s-gv-i, a-le u-ni-tsa-te gv-wo-li-ge-i, a-le e-la-di-quo du-ni-s-qua-lv-ta-ne na-hna i-di-tlv wu-ni-lo-se de-ga-du-wa-di-sv ni-do-da-yu-ni-lo-sv-hi, de-gv-wa-ni-gi-ye-no, a-le wi-gv-wa-da-tli-sa-ne-le-i."
        intervals [226]:
            xmin = 616.070
            xmax = 616.070
            text = "020634: Tsi-sa-no u-tsa-i-sv, du-go-he u-ni-tsa-ti yv-wi, a-le du-we-do-li-tse-i, nv-di-ga-li-s-do-di-s-ge a-wi u-ni-no-de-na da-na-tse-la-gv ne-hv-na tsi-ge-so u-ni-ga-ti-ya; u-le-nv-he-no u-tsa-ti tsu-da-le-nv-dv du-we-yo-ne-i."
        intervals [227]:
            xmin = 616.070
            xmax = 616.070
            text = "020635: Hna-quo-no u-lo-so-ni-de-na ge-se i-ga, gv-wa-s-da-wa-di-do-hi gv-wa-lu-tse-le, hi-a nu-ni-we-se-i, A-ni i-na-ge-i, a-le hna-quo u-lo-so-ni-di i-ga."
        intervals [228]:
            xmin = 616.070
            xmax = 616.070
            text = "020636: Ti-ye-li-hi-s-da, na-s-gi da-da-ne-la-di-sv gv-wa-du-wi-dv wa-ni-lo-hi, a-le de-ga-du-wa-di-sv-i, a-le wu-ni-wa-hi ga-du, v-tle-ye-no go-hu-s-di ya-ni-ye u-na-li-s-da-yv-di."
        intervals [229]:
            xmin = 616.070
            xmax = 616.070
            text = "020637: Du-ne-tse-le-no hi-a ni-du-we-se-le-i, Ni-hi di-tse-la-s-da.  Hi-a-no ni-gv-wa-we-se-le-i, Tsi-go da-yo-tse-si ta-li-tsu-qui a-ni-gi-si tsu-gv-wa-lo-di ga-du wv-da-yo-gi-wa-si, a-le do-da-yo-tse-la-s-ta-ni?"
        intervals [230]:
            xmin = 616.070
            xmax = 616.070
            text = "020638: Hi-a-no ni-du-we-se-le-i, I-la-go ga-du de-tsi-ye-ha?  Wi-tsa-ga-ta.  U-na-do-le-ho-sv-no, hi-a nu-hi-we-se-i, Hi-s-gi, ta-li-no a-tsa-di."
        intervals [231]:
            xmin = 616.070
            xmax = 616.070
            text = "020639: Du-ne-tse-le-no u-na-ni-tlv-di-yi ni-ga-dv i-tse ka-ne-s-go-hi ge-sv tsu-na-da-tlu-nv-dv."
        intervals [232]:
            xmin = 616.070
            xmax = 616.070
            text = "020640: U-na-ni-tlv-ne-no o-s-dv du-na-da-nv-hna-ne-i a-s-go-hi-tsu-qui, a-le hi-s-ga-s-go-hi tsu-na-da-tlu-nv-dv."
        intervals [233]:
            xmin = 616.070
            xmax = 616.070
            text = "020641: Hi-s-gi-no ga-du du-gi-sv a-le ta-li a-tsa-di du-ne-sv, ga-lv-la-di wi-du-ka-hna-ne-i, a-le u-li-he-li-tse-i, a-le du-gv-ha-lu-ye ga-du, a-le gv-wa-s-da-wa-di-do-hi du-ne-le tsu-ni-ne-di-yi; ta-li-no a-tsa-di ni-ga-dv du-ya-do-he-le-i."
        intervals [234]:
            xmin = 616.070
            xmax = 616.070
            text = "020642: Ni-ga-dv-no u-na-li-s-da-yv-ne-i; a-le du-no-lv-se-i."
        intervals [235]:
            xmin = 616.070
            xmax = 616.070
            text = "020643: U-nu-te-se-no u-li-gv-ha-lu-yv-hi ta-la-du di-ka-li-i ta-lu-tsa, a-le na-s-quo a-tsa-di."
        intervals [236]:
            xmin = 616.070
            xmax = 616.070
            text = "020644: Na-s-gi-no na ga-du tsu-ni-gv-hi hi-s-gi i-ya-ga-yv-li i-yv-dv na-ni-e a-ni-s-ga-ya."
        intervals [237]:
            xmin = 616.070
            xmax = 616.070
            text = "020645: Gi-la-quo-no i-yv-dv du-nv-wi-s-ta-ne gv-wa-s-da-wa-di-do-hi tsi-yu-hi u-na-tso-di-yi, a-le i-gv-yi tsu-ni-so-hi-s-di-yi, Que-tsa-yi-di wu-ni-lu-hi-s-di-yi, a-si-quo u-wa-sv da-ye-li-hi-s-di-s-gv u-ni-tsa-ti."
        intervals [238]:
            xmin = 616.070
            xmax = 616.070
            text = "020646: Du-ye-li-hi-s-ta-nv-no, o-da-lv wu-lo-se u-da-do-li-s-ta-nv-se-i."
        intervals [239]:
            xmin = 616.070
            xmax = 616.070
            text = "020647: U-sv-no nu-li-s-ta-nv tsi-yu v-da-li a-ye-li a-ni-ni-se-i, u-wa-sv-no do-yi e-do-he-i."
        intervals [240]:
            xmin = 616.070
            xmax = 616.070
            text = "020648: Du-go-he-no a-ni-gi-li-yo-gv a-ni-ga-we-hi-hv-i; wa-ni-ga-dv-no i-di-si di-ga-no-lv-di-s-ge-i.  Nv-gi-ne-no i-yv-dv a-ni-ya-wi-s-gv sv-no-yi du-lu-tse-le-i, v-da-li ga-du-i a-i-se-i, a-le yi-du-lo-hi-se-le-i."
        intervals [241]:
            xmin = 616.070
            xmax = 616.070
            text = "020649: A-se-no wi-gv-wa-go-hv v-da-li ga-du-i a-i-sv-i, u-tse-lv-nv-hi u-ne-li-se-i, a-le u-ne-lu-ne-i."
        intervals [242]:
            xmin = 616.070
            xmax = 616.070
            text = "020650: (Ni-ga-dv-ye-no gv-wa-go-he-i, a-le u-na-de-ya-ta-ne-le-i.)  Gi-la-quo-no i-yv-dv du-li-no-he-ta-ne-i, a-le hi-a ni-du-we-se-le-i, U-ga-li-s-di-quo i-tsa-da-nv-da-da; a-yv-quo; tle-s-di yi-tsi-s-ga-i-he-s-di."
        intervals [243]:
            xmin = 616.070
            xmax = 616.070
            text = "020651: U-gi-la-wi-se-no wi-du-tsa-ne-le tsi-yu-hi; ga-no-lv-v-s-gv-no u-se-li-go-tse-i; a-le u-lo-sv-s-ta-nv-hi u-na-da-nv-te-ta-ne do-tsu-na-da-nv-dv-i, a-le u-ni-s-qua-ni-go-se-i."
        intervals [244]:
            xmin = 616.070
            xmax = 616.070
            text = "020652: V-tla-ye-no yi-du-na-da-nv-te-le ga-du; tsu-ni-na-wi-ye-no di-s-da-yi-yu ge-se-i."
        intervals [245]:
            xmin = 616.070
            xmax = 616.070
            text = "020653: Du-ni-so-tsv-no, Ge-ni-si-la-di wu-ni-lu-tse-i, a-le u-ni-ta-la-de-i."
        intervals [246]:
            xmin = 616.070
            xmax = 616.070
            text = "020654: Tsi-yu-hi-no u-na-tsa-i-sv gi-la-quo i-yv-dv gv-wo-li-tse-i."
        intervals [247]:
            xmin = 616.070
            xmax = 616.070
            text = "020655: A-le na-hna gv-wa-du-wi-dv u-ne-do-le-i, a-le tsu-ni-tlv-gi du-ni-ni-do-le di-tse-s-do-gi-hi du-ni-tlv-de, wi-da-ni-no-hi-he a-na-dv-gv-ga na-hna e-do-hv-i."
        intervals [248]:
            xmin = 616.070
            xmax = 616.070
            text = "020656: A-le i-lv-hi-tlv wi-ga-lu-gi, tsu-s-di de-ga-du-hv, a-le tsu-dv-na de-ga-du-hv, a-le i-yv-dv di-da-ne-lo-hi ge-sv-i, tsu-ni-tlv-gi de-ga-la-nv-dv da-ni-nv-v-s-ge-i, a-le gv-wa-ta-yo-se-he u-na-sv-ni-s-di-yi, ga-da-lu-ya-dv-quo na-s-quo u-nu-wv-i; na-ni-v-no na-s-gi gv-wa-sv-ni-lv-hi du-na-di-wa-s-ge-i."
        intervals [249]:
            xmin = 616.070
            xmax = 616.070
            text = "020701: De-gv-wa-la-wi-tso-le-no A-ni-qua-li-si, a-le gi-lo i-yu-na-s-gi di-no-we-li-s-gi, Tsi-lu-si-li-mi nv-da-yu-ni-lo-sv-hi."
        intervals [250]:
            xmin = 616.070
            xmax = 616.070
            text = "020702: Du-ni-go-hv-no i-ga-dv gv-wa-s-da-wa-di-do-hi ga-du a-ni-gi-s-gv di-ga-da-ha tsu-no-ye-ni gv-di, (na-s-gi ni-du-na-su-le-hv-na ga-dv-ga,) u-ni-so-nv-tse-le-i."
        intervals [251]:
            xmin = 616.070
            xmax = 616.070
            text = "020703: A-ni-qua-li-si-ye-no, a-le na-ni-v-quo A-ni-tsu-si, i-yu-no o-s-dv ni-du-na-su-le-hv-na yi-gi, v-tla yi-na-li-s-da-yv-hv-s-go-i, da-ni-ka-hna-wa-de-go nu-ni-we-sv e-ti u-na-de-nv-hi."
        intervals [252]:
            xmin = 616.070
            xmax = 616.070
            text = "020704: A-le ga-no-do-di-yi dv-ni-lo-hi, i-yu-no ni-du-na-su-le-hv-na yi-gi, v-tla yv-gv-na-li-s-da-yv-hv-ga.  A-le u-tsa-ta nu-da-le go-hu-s-di tsu-ni-ka-hna-wa-dv-s-di nu-nv-ne-lv, na-s-gi tsu-li-s-qui-di di-gu-hi-lo-v-i a-le di-te-li-do, a-le v-tsa-yi-di-go-tlv-ta-nv-hi di-te-li-do, a-le di-ni-tlv-di-yi."
        intervals [253]:
            xmin = 616.070
            xmax = 616.070
            text = "020705: Hna-quo-no A-ni-qua-li-si a-le di-no-we-li-s-gi i-gv-wa-dv-dv-ne hi-a ni-gv-wa-we-se-le-i; Ga-do-no ge-tsa-s-da-wa-di-do-hi v-tla yi-da-ni-ka-hna-wa-de-ga e-ti u-na-de-nv-hi u-ni-ne-tsv-i, na-s-gi ni-du-na-su-le-hv-na-quo tsa-na-li-s-da-yv-hv-s-ga?"
        intervals [254]:
            xmin = 616.070
            xmax = 616.070
            text = "020706: Du-ne-tse-lv-no hi-a ni-du-we-se-le-i, I-sa-ya ye-li-quo nu-we-sv u-do-le-ho-sv ni-hi i-tsa-tlo-na-s-di i-tsi-ne-i-s-di-s-gv-i, hi-a tsi-ni-gv-nv tsi-go-we-la, Hi-a na-s-gi yv-wi gv-gi-lv-quo-di-ha du-ni-ha-ne-ga-lv da-nv-di-ha, tsu-ni-na-wi-s-gi-ni i-nv-hi-yu ni-du-nv-hna-de-ga a-yv na-qua-dv-nv-i."
        intervals [255]:
            xmin = 616.070
            xmax = 616.070
            text = "020707: A-se-no, a-se-quo-quo gv-gi-lv-quo-di-ha tsi-da-na-de-yo-hv-s-ga da-na-de-yo-hv-s-gv yv-wi-quo u-ni-ne-tsv-hi."
        intervals [256]:
            xmin = 616.070
            xmax = 616.070
            text = "020708: I-yv-dv-ye-no ni-tsv-ne U-ne-la-nv-hi u-ne-tsv-hi, yv-wi u-ni-ne-tsv di-ka-hna-wa-dv-s-di ni-tsv-ne-ha, na-s-gi di-te-li-do a-le tsu-li-s-qui-di di-gu-hi-lo-v-i; a-le u-tsa-ta nu-da-le-ha na-s-gi-ya u-tlo-yi de-tsi-lv-wi-s-da-ne-ho-i."
        intervals [257]:
            xmin = 616.070
            xmax = 616.070
            text = "020709: A-le hi-a ni-du-we-se-le-i, o-si-quo ni-tsa-dv-ne-ha tsi-tsi-yo-i-se-ha U-ne-la-nv-hi u-ne-tsv, na-s-gi i-tsa-tse-li di-ka-hna-wa-dv-s-di i-tsi-s-qua-ni-go-do-di-yi."
        intervals [258]:
            xmin = 616.070
            xmax = 616.070
            text = "020710: Mo-si-ye-no hi-a nu-we-se-i, Hi-lv-quo-de-s-di tsa-do-da a-le tsa-tsi; a-le, Gi-lo a-s-gi nv-di-s-ge-s-di u-do-da a-le u-tsi, a-se u-yo-hu-hi-s-di ge-se-s-di."
        intervals [259]:
            xmin = 616.070
            xmax = 616.070
            text = "020711: Ni-hi-s-gi-ni hi-a ni-tsi-we-ha, I-yu-no gi-lo hi-a ni-ga-we-se-he-s-di u-do-da a-le u-tsi, Go-qua-ni, (na-s-gi ga-dv-gv, a-qua-li-s-go-lv-ta-nv-hi,) ni-ga-v ge-tsa-li-s-de-lv-do-di ge-sv a-yv gv-s-de-li-s-gv-i; [na-s-gi u-du-da-le-dv ge-se-s-di.]"
        intervals [260]:
            xmin = 616.070
            xmax = 616.070
            text = "020712: A-le v-tla hna-quo u-ne-la-gi go-hu-s-di wi-da-dv-ni-si u-do-da a-le u-tsi ye-tse-li-se-ho-i;"
        intervals [261]:
            xmin = 616.070
            xmax = 616.070
            text = "020713: Na-s-gi U-ne-la-nv-hi u-tse-li ka-no-he-dv a-se-quo ni-tsv-ne-ho i-tsv-di-s-go ni-hi i-tsi-ne-tsv-i; a-le u-tsa-ti i-yu-da-le-gi na-s-gi i-yu-s-di-da-ni ni-tsa-dv-ne-ho-i."
        intervals [262]:
            xmin = 616.070
            xmax = 616.070
            text = "020714: Ni-ga-dv-no yv-wi wi-du-ya-nv-hv, hi-a ni-du-we-se-le-i, S-gi-ya-dv-da-s-da-si ni-tsi-v-i, a-le i-tso-li-gi;"
        intervals [263]:
            xmin = 616.070
            xmax = 616.070
            text = "020715: V-tla-no go-hu-s-di yv-wi-hi do-yi-di-tlv e-hi, u-yv-ha, na-s-gi ga-da-ha yi-nu-wa-ne-ho-i; na-s-gi-ni nv-da-yu-nu-go-tsv-hi, na-s-gi ga-da-ha nu-wa-ne-ho yv-wi."
        intervals [264]:
            xmin = 616.070
            xmax = 616.070
            text = "020716: Gi-lo de-ga-li-lu-ge-s-di u-dv-go-di-yi, na-s-gi wa-dv-gv-ga."
        intervals [265]:
            xmin = 616.070
            xmax = 616.070
            text = "020717: Ga-li-tso-de-no wu-yv-lv du-da-nv-e-lv yv-wi, gv-wa-s-da-wa-di-do-hi gv-wa-dv-dv-ne da-tli-lo-s-dv u-gv-wa-li."
        intervals [266]:
            xmin = 616.070
            xmax = 616.070
            text = "020718: Hi-a-no ni-du-we-se-le-i, Na-s-quo-s-go ni-hi na-s-gi i-ga-i ni-tso-li-gv-na i-gi?  Tla-s-go yi-tsi-go-wa-ti-ha, na-s-gi go-hu-s-di do-yi-di-tlv e-hi na-s-gi yu-yv-hi-ha yv-wi ga-da-ha i-gv-wa-ne-di ni-ge-sv-na ge-sv-i;"
        intervals [267]:
            xmin = 616.070
            xmax = 616.070
            text = "020719: Na-s-gi u-na-wi-yi wi-na-yv-hi-hv-na ge-sv i-yu-s-di, u-s-quo-li-yi-quo-s-gi-ni, a-le wi-ga-lo-hi-s-di-s-gv-quo, na-s-gi-no ga-nv-ga-li-s-gv ni-ga-v a-li-s-da-yv-di?"
        intervals [268]:
            xmin = 616.070
            xmax = 616.070
            text = "020720: Hi-a-no nu-we-se-i, Na-s-gi na yv-wi-hi u-nu-go-tsv-hi na-s-gi ga-da-ha nu-wa-ne-ho yv-wi."
        intervals [269]:
            xmin = 616.070
            xmax = 616.070
            text = "020721: Ha-wi-ni-ye-no nv-da-yu-da-le-nv-hi, yv-wi u-na-wi-yi, di-da-le-hv-s-ga u-yo a-da-nv-te-di ge-sv-i, a-da-yo-ne-di ge-sv-i, u-de-li-dv di-ni-si-di ge-sv-i, a-da-hi-s-di ge-sv-i,"
        intervals [270]:
            xmin = 616.070
            xmax = 616.070
            text = "020722: Ga-no-s-gi-dv ge-sv-i, tsu-gv-wa-lo-di a-gv-v-hi-s-di ge-sv-i, u-yo i-ya-dv-ne-di ge-sv-i, ga-lo-nu-he-dv ge-sv-i, a-li-so-tlv-i-s-do-di ge-sv-i, a-dv-yu-ge-di ge-sv-i, a-da-so-tlv-i-s-do-di-yi, a-tlv-quo-do-di-yi, a-li-s-ga-hna-wi-s-di ge-sv-i."
        intervals [271]:
            xmin = 616.070
            xmax = 616.070
            text = "020723: Hi-a na-s-gi ni-ga-dv u-yo-i ha-wi-ni di-da-le-hv-s-go-i, a-le ga-da-ha nu-wa-ne-ho yv-wi."
        intervals [272]:
            xmin = 616.070
            xmax = 616.070
            text = "020724: Na-hna-no du-le-nv, Ta-ya a-le Sa-do-ni a-s-dv wu-lu-tse-i, a-le a-da-ne-lv wu-yv-lv, v-tla yu-du-li-s-ge gi-lo u-do-le-ho-hi-s-di-yi; a-se-no v-tla gv-wa-di-s-ga-lo-di yi-ge-se-i."
        intervals [273]:
            xmin = 616.070
            xmax = 616.070
            text = "020725: Gi-lo-ye-no i-yu-s-di a-ge-yv na-s-gi u-we-tsi a-dv-nu-tsa ga-da-ha a-da-nv-do u-ya-i, u-dv-ga-nv a-tsi-no-he-s-gv-i, u-lu-tse a-le du-la-s-gv u-da-nv-ne-i:"
        intervals [274]:
            xmin = 616.070
            xmax = 616.070
            text = "020726: (Na-s-gi na a-ge-yv A-go-i ge-se-i, A-sa-lo-qui-ni-si ge-se-i;) a-le na-s-gi u-s-di-ye-ta-ne na-s-gi u-we-tsi a-dv-nu-tsa a-s-gi-na u-nu-go-wi-se-di-yi."
        intervals [275]:
            xmin = 616.070
            xmax = 616.070
            text = "020727: A-se-no Tsi-sa hi-a ni-u-we-se-le-i, I-gv-yi di-ni-yo-li wi-da-no-lv-hi; v-tla-ye-no o-si-yu yi-gi, di-ni-yo-li tsu-na-tse-li ga-du di-gi-e-di-yi, a-le gi-li wi-da-di-ne-di-yi."
        intervals [276]:
            xmin = 616.070
            xmax = 616.070
            text = "020728: Na-s-gi-no u-ne-tse hi-a nu-we-se-le-i, U-do-hi-yu-hi, Tsa-gv-wi-yu-hi; a-se-no gi-li ga-s-gi-lv ha-wi-ni-di-tlv di-ni-yo-li u-ni-nv-go-a-hi-se-lv-hi ga-du a-na-li-s-da-yv-di-s-go-i."
        intervals [277]:
            xmin = 616.070
            xmax = 616.070
            text = "020729: Hi-a-no nu-we-se-le-i, Na-s-gi hi-a tsi-ni-wi wi-ni-ga-li-s-do-da, tsi-he-na; a-s-gi-na tse-tsi-yi a-ya-v u-nu-go-gi."
        intervals [278]:
            xmin = 616.070
            xmax = 616.070
            text = "020730: Na-s-gi-no tsu-we-nv-sv wi-u-lu-tsv, u-do-le-ho-se a-s-gi-na u-nu-go-tsv-i, u-we-tsi-no a-tse-s-do-gi-hi ga-nv-gv-i."
        intervals [279]:
            xmin = 616.070
            xmax = 616.070
            text = "020731: A-le ta-li-ne Ta-ya a-le Sa-do-ni a-s-dv u-ni-gi-sv Ge-li-li v-da-lv wu-lu-tse-i, a-ye-li u-lo-se A-s-go-hi--di-ga-du-gi-yi s-ga-du-gi ge-sv-i."
        intervals [280]:
            xmin = 616.070
            xmax = 616.070
            text = "020732: I-gv-wa-ti-no-he-le-no gi-lo tsu-li-e-na, a-le ga-ni-la ga-wo-ni-s-gi; a-le i-gv-wa-s-di-ye-ta-ne na-s-gi u-si-ta-di-s-di-yi."
        intervals [281]:
            xmin = 616.070
            xmax = 616.070
            text = "020733: I-yv-dv-no wu-ti-nv-s-ta-nv u-da-ye-li-lv u-ni-tsa-ti a-ne-do-hv-i, de-ga-ye-sa-dv di-ga-le-ni du-so-na-de-i, a-le du-li-tsi-s-que-i, a-le ga-no-go u-sv-ni-le-i;"
        intervals [282]:
            xmin = 616.070
            xmax = 616.070
            text = "020734: Ga-lv-la-di-no wi-du-ka-hna-nv u-li-ye-ta-ne-i, a-le hi-a nu-we-se-le-i, E-que-da, na-s-gi ga-dv-gv ha-li-s-du-i."
        intervals [283]:
            xmin = 616.070
            xmax = 616.070
            text = "020735: Gi-la-quo-no i-yv-dv di-ga-le-ni du-li-s-du-i-se-i, a-le ga-no-go u-lv-s-da-ne-lv-hi du-li-ka-ne-yv-he, a-le o-s-dv u-wo-ni-se-i."
        intervals [284]:
            xmin = 616.070
            xmax = 616.070
            text = "020736: Du-nv-s-da-de-le-no gi-lo u-ni-no-ne-di-yi; a-se-no de-ga-nv-s-da-di-si u-tli-quo i-ga-i da-ni-ye-li-hi-s-di-s-ge-i;"
        intervals [285]:
            xmin = 616.070
            xmax = 616.070
            text = "020737: A-le u-lo-sv-s-ta-nv-hi u-ni-s-qua-ni-go-se-i, hi-a na-ni-we-s-ge-i, Ni-ga-dv o-si-yu de-u-lv-wi-s-da-si; u-na-dv-go-di-yi ni-de-gv-ne tsu-ni-li-e-na, tsu-nv-ge-wi-no u-ni-wo-ni-hi-s-di-yi."
        intervals [286]:
            xmin = 616.070
            xmax = 616.070
            text = "020801: Na-hi-yu-no u-ni-tsa-ti ge-sv yv-wi tsu-qui-ya ge-sv i-yu-s-di, a-le nu-ni-hv-na ge-sv u-na-li-s-da-yv-di, Tsi-sa wi-du-ya-nv-hv gv-wa-s-da-wa-di-do-hi, hi-a ni-du-we-se-le-i;"
        intervals [287]:
            xmin = 616.070
            xmax = 616.070
            text = "020802: Ga-tsi-ya-do-li-ga u-ni-tsa-ti ge-sv-i, nv-di-ga-li-s-do-di hna-quo tso-i i-ga i-tsu-la-ha o-ge-do-lv-i a-le nu-ni-hv-na ge-sv u-na-li-s-da-yv-di;"
        intervals [288]:
            xmin = 616.070
            xmax = 616.070
            text = "020803: I-yu-no yi-ga-tsi-ya-ni-gi-s-di-ha do-tsu-ne-nv-sv ya-ne-ga nu-na-li-s-da-yv-nv-na, wa-na-i-sv-quo yi-da-ni-wa-na-ga-lo-gi; i-ga-dv-ye-no i-nv-hi-yu do-tsu-ne-nv."
        intervals [289]:
            xmin = 616.070
            xmax = 616.070
            text = "020804: Gv-wa-s-da-wa-di-do-hi-no hi-a ni-gv-wa-we-se-le-i, Ha-tlv yi-da-gi gi-lo na-s-gi i-ga-i ga-du a-ni i-na-ge-i, hi-a na-s-gi ye-li gv-wa-ni-dv-da-ne-di."
        intervals [290]:
            xmin = 616.070
            xmax = 616.070
            text = "020805: Du-dv-dv-ne-no hi-a nu-we-se-i; I-la-go ga-du de-tsi-ye-ha?  Hi-a-no nu-ni-we-se-i, Ga-li-quo-gi."
        intervals [291]:
            xmin = 616.070
            xmax = 616.070
            text = "020806: Du-ne-tse-le-no u-ni-tsa-ti ga-do-hi u-na-ni-tlv-di-yi; ga-li-quo-gi-no ga-du du-gi-sv, a-le u-li-he-li-tsv, du-gv-ha-lu-ye-i, a-le gv-wa-s-da-wa-di-do-hi du-ne-le na-s-gi i-gv-yi-di-tlv tsu-ni-ne-di-yi; i-gv-yi-di-tlv-no du-ni-ne-le u-ni-tsa-ti yv-wi."
        intervals [292]:
            xmin = 616.070
            xmax = 616.070
            text = "020807: A-le i-lv-s-gi tsu-na-s-di a-tsa-di da-ni-ne-he-i, u-li-he-li-tsv-no u-ne-tse na-s-gi na-s-quo i-gv-yi-di-tlv tsu-ni-nv-di-yi."
        intervals [293]:
            xmin = 616.070
            xmax = 616.070
            text = "020808: U-na-li-s-da-yv-ne-no, a-le du-no-lv-se-i; u-nu-te-se-no u-li-gv-ha-lu-yv-hi u-ti-yv-hi ga-li-quo-gi i-ya-ka-li-i ta-lu-tsa."
        intervals [294]:
            xmin = 616.070
            xmax = 616.070
            text = "020809: U-na-li-s-da-yv-nv-hi-no nv-gi i-ya-ga-yv-li i-yv-dv na-ni-e-i; du-ye-li-hi-s-ta-ne-no."
        intervals [295]:
            xmin = 616.070
            xmax = 616.070
            text = "020810: I-gv-we-nv-dv-no tsi-yu-hi u-tsa-ne a-ne-he gv-wa-s-da-wa-di-do-hi, a-le Da-li-mi-nu-da a-s-dv wu-lu-tse-i."
        intervals [296]:
            xmin = 616.070
            xmax = 616.070
            text = "020811: A-ni-qua-li-si-no u-ni-lu-tse a-le u-na-le-nv-he gv-wa-dv-dv-he-lv-ne-i, gv-wa-ta-yo-se-le tsu-na-nu-go-wi-se-di-yi u-ye-lv-dv ga-lv-la-di nv-da-yu-lo-sv-hi, gv-wa-go-li-ye-s-ge-i."
        intervals [297]:
            xmin = 616.070
            xmax = 616.070
            text = "020812: U-da-nv-do-gi-hi-no ha-wi-ni u-li-ye-ta-ne-i, a-le hi-a nu-we-se-i, Ga-do-no go-hi hi-a tsa-ne-ha u-ye-lv-dv u-ni-yo-ha?  u-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, v-tla gv-ni-ge-sv i-ge-gv-ne-di yi-ge-se-s-di u-ye-lv-dv hi-a go-hi tsa-ne-ha."
        intervals [298]:
            xmin = 616.070
            xmax = 616.070
            text = "020813: Du-da-nv-e-lv-no, a-le ta-li-ne tsi-yu-hi u-tsa-nv, a-s-go-na wu-lo-se-i."
        intervals [299]:
            xmin = 616.070
            xmax = 616.070
            text = "020814: [Gv-wa-s-da-wa-di-do-hi-no] u-nv-ge-wi-sv-hi ge-se ga-du tsu-na-de-nv-di-yi, v-tla a-le yu-lo-sv-s-de sa-quo ga-du u-ni-lv tsi-yu-hi."
        intervals [300]:
            xmin = 616.070
            xmax = 616.070
            text = "020815: Du-ne-tse-le-no hi-a nu-we-se-i, I-tsi-ya-wi-s-ge-s-di, A-ni-qua-li-si u-na-tse-li a-go-do-di i-tse-ya-do-tse-he-s-di, a-le e-lo-di u-tse-li a-go-do-di."
        intervals [301]:
            xmin = 616.070
            xmax = 616.070
            text = "020816: U-nv-sv-no ge-sv u-na-li-no-he-le, hi-a nu-ni-we-se-i, Nv-di-ga-li-s-do-di-ha ga-du ni-di-di-ye-hv-na ge-sv-i."
        intervals [302]:
            xmin = 616.070
            xmax = 616.070
            text = "020817: Tsi-sa-no u-do-le-ho-sv hi-a ni-du-we-se-le-i, Ga-do-no i-tsa-li-no-he-ha ga-du ni-di-tsi-ye-hv-na ge-sv i-yu-s-di?  A-si-quo-s-go ni-tsa-do-le-ho-s-gv-na i-gi, a-le ni-tso-li-gv-na i-gi?  A-si-quo-s-go a-s-da-ya ni-de-tsv-nv di-tsi-na-wi?"
        intervals [303]:
            xmin = 616.070
            xmax = 616.070
            text = "020818: De-tsi-ka-nv-s-go, ni-tsi-go-wa-ti-s-gv-na-no i-gi?  De-tsi-li-lu-ga-s-go, ni-tsa-dv-gi-s-gv-na-no i-gi?  A-le ni-tsa-nv-da-di-s-gv-na-s-go i-gi?"
        intervals [304]:
            xmin = 616.070
            xmax = 616.070
            text = "020819: Hi-s-gi ga-du da-gi-gv-ha-lu-yv hi-s-gi i-ya-ga-yv-li de-tsi-ne-lv, i-la-go i-ya-ka-li-i ta-lu-tsa u-li-gv-ha-lu-yv-hi i-tsu-te-se-i?  Ta-la-du i-gv-wo-se-le-i."
        intervals [305]:
            xmin = 616.070
            xmax = 616.070
            text = "020820: Ga-li-quo-gi-no [ga-du] nv-gi i-ya-ga-yv-li de-tsi-ne-lv, i-la-go i-ya-ka-li-i ta-lu-tsa u-li-gv-ha-lu-yv-hi i-tsu-te-se-i?  Ga-li-quo-gi u-na-dv-ne-i."
        intervals [306]:
            xmin = 616.070
            xmax = 616.070
            text = "020821: Hi-a-no ni-du-we-se-le-i, Ga-do ga-li-s-do-di-ha ni-tso-li-gv-na tsi-gi?"
        intervals [307]:
            xmin = 616.070
            xmax = 616.070
            text = "020822: Que-tsa-yi-di-no wu-lu-tse-i; di-ge-wi-no a-s-ga-ya gv-wa-ti-no-he-le-i, a-le u-ni-ta-yo-se-le na-s-gi u-sv-ni-s-di-yi."
        intervals [308]:
            xmin = 616.070
            xmax = 616.070
            text = "020823: Di-ge-wi-no u-wo-ya-ne-sv, ga-du-hv u-nu-go-wi-se-i; di-ga-do-li-no du-li-tsi-s-quv, a-le du-si-ta-dv, go-hu-s-di-s-go hi-go-wa-dv-di-ha?  U-wo-se-le-i."
        intervals [309]:
            xmin = 616.070
            xmax = 616.070
            text = "020824: Du-ka-hna-nv-no, hi-a nu-we-se-i, Yv-wi ga-tsi-go-wa-ti-ha a-ne-gi-ha de-tlu-gv na-s-gi-ya-i."
        intervals [310]:
            xmin = 616.070
            xmax = 616.070
            text = "020825: Hna-quo-no ta-li-ne di-ga-do-li du-si-ta-de-i, a-le tsu-ka-no-di-yi nu-wa-ne-le-i; a-le u-di-wa-se-i, a-le na-ni-v o-si-yu da-go-wa-di-s-ge-i."
        intervals [311]:
            xmin = 616.070
            xmax = 616.070
            text = "020826: A-le u-ne-tse-le tsu-we-nv-sv wu-lo-hi-s-di-yi, hi-a nu-we-se-i, Tle-s-di di-ga-du-hv wi-tsa-yv-lv-gi, a-le tle-s-di gi-lo ga-du-hv e-hi hi-no-ne-lv-gi."
        intervals [312]:
            xmin = 616.070
            xmax = 616.070
            text = "020827: Tsi-sa-no u-nu-go-tse a-le na-s-gi gv-wa-s-da-wa-di-do-hi, Si-sa-li-yi Qui-li-gi de-ga-du-hv wu-ni-lo-se-i; wa-na-i-sv-no du-dv-dv-ne gv-wa-s-da-wa-di-do-hi, hi-a ni-du-we-se-le-i, Ga-go gv-quo-se-ho yv-wi?"
        intervals [313]:
            xmin = 616.070
            xmax = 616.070
            text = "020828: Hi-a-no nu-ni-we-se-i, Tsa-ni Di-da-wo-s-gi; i-ga-dv-s-gi-ni I-la-ya [a-na-di-ha;] i-ga-dv-no, Gi-lo i-yu-s-di a-na-do-le-ho-s-gi."
        intervals [314]:
            xmin = 616.070
            xmax = 616.070
            text = "020829: Hi-a-no ni-du-we-se-le-i, Ni-hi-na-no ga-go s-gi-yo-se-ha?  Qui-da-no u-ne-tsv hi-a nu-we-se-le-i, Ga-lo-ne-dv ni-hi."
        intervals [315]:
            xmin = 616.070
            xmax = 616.070
            text = "020830: Du-ne-tse-le-no na-s-gi gi-lo u-ni-no-ne-di-yi ni-ge-sv-na."
        intervals [316]:
            xmin = 616.070
            xmax = 616.070
            text = "020831: U-le-nv-he-no du-we-yo-ne-i, na-s-gi yv-wi U-we-tsi u-tsa-ti tsu-da-le-nv-dv u-gi li-yo-i-s-di-yi; a-le gv-wa-yo-i-se-di ge-sv di-ni-la-wi-gi, a-le nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le di-no-we-li-s-gi, a-le a-tsi-i-s-di-yi ge-sv-i, tso-i-ne-no i-ga tsu-le-hi-so-di ge-sv-i."
        intervals [317]:
            xmin = 616.070
            xmax = 616.070
            text = "020832: Na-s-gi-no hi-a gv-ni-ge-sv nu-we-se-i.  Qui-da-no u-ya-nv-hv u-le-nv-he u-gv-s-go-lv-ne-i."
        intervals [318]:
            xmin = 616.070
            xmax = 616.070
            text = "020833: A-se-no u-ga-ta-hv-sv, a-le gv-wa-s-da-wa-di-do-hi du-ka-hna-nv, Qui-da u-gv-s-go-lv-ne-i, hi-a nu-we-se-i, A-qua-so-ha-dv ha-le-hv-ga Se-da-ni; v-tla-ye-no U-ne-la-nv-hi u-tse-li ge-sv o-si-yu yi-tsa-ye-lv-ha, yv-wi-s-gi-ni u-na-tse-li ge-sv-i."
        intervals [319]:
            xmin = 616.070
            xmax = 616.070
            text = "020834: Wi-du-ya-nv-hv-no yv-wi, a-le na-s-quo gv-wa-s-da-wa-di-do-hi, hi-a ni-du-we-se-le-i, Gi-lo u-du-li-s-ge-s-di a-gi-s-da-wa-dv-s-di-yi, u-wa-sv a-da-da-yi-he-s-di, a-le u-wa-sv u-tse-li tsu-da-na-wa-dv a-yi-s-ge-s-di, a-le a-gi-s-da-wa-de-ge-s-di."
        intervals [320]:
            xmin = 616.070
            xmax = 616.070
            text = "020835: Gi-lo-ye-no u-du-li-s-ge-s-di gv-nv u-s-de-lv-di-yi, na-s-gi u-yo-hu-se-he-s-di; gi-lo-s-gi-ni gv-nv u-yo-hu-se-he-s-di a-yv a-le o-s-dv ka-no-he-dv nv-di-ga-li-s-do-di-s-ge-s-di, na-s-gi a-tsi-s-de-lv-di ge-se-s-di."
        intervals [321]:
            xmin = 616.070
            xmax = 616.070
            text = "020836: Ga-do-ye-no yu-ne-quo-tsi yv-wi, i-yu-no ni-gv-na-dv e-lo-hi u-tse-li yi-nu-li-s-ta-nv, u-wa-sv-no u-da-nv-do yu-yo-hu-se-lv?"
        intervals [322]:
            xmin = 616.070
            xmax = 616.070
            text = "020837: A-le ga-do ya-hv-ga yv-wi yi-ga-ne-tli-yv-s-da u-da-nv-do?"
        intervals [323]:
            xmin = 616.070
            xmax = 616.070
            text = "020838: Gi-lo-ye-no a-qua-de-ho-s-ge-s-di a-yv, a-le a-yv tsi-ne-gv-i, u-da-su-yv a-ni di-na-da-yo-ne-hi a-le a-ni-s-ga-na a-ne-hv-i, na-s-gi na-s-quo yv-wi U-we-tsi u-de-ho-hi-s-di ge-se-s-di, ga-lu-tsv-ha u-nu-wo-s-de-s-di ga-lv-quo-di-yu ge-sv U-do-da u-tse-li-ga, a-ne-he-s-di ge-tsi-lv-quo-di di-ni-ka-hna-wa-di-do-hi."
        intervals [324]:
            xmin = 616.070
            xmax = 616.070
            text = "020901: Hi-a-no ni-du-we-se-le-i, U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, na-s-gi gi-lo a-ni tsi-da-ni-do-ga, v-tla yv-dv-na-do-le-ho-si a-yo-hu-hi-s-di ge-sv-i, gv-ni u-ni-go-hv-hi ge-se-s-di U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv u-li-ni-gi-di-yu ge-sv ga-lu-tsv-ha."
        intervals [325]:
            xmin = 616.070
            xmax = 616.070
            text = "020902: Su-da-li-no wi-nu-sv-lv Tsi-sa du-ti-nv-se Qui-da, a-le Tsi-mi, a-le Tsa-ni, i-nv-no i-ga-ti o-da-lv du-hna-lu-ta-ne i-yv-dv u-nv-sv ge-sv-i; a-le u-da-ne-tli-yv-se a-ni-ga-ta-hv-i."
        intervals [326]:
            xmin = 616.070
            xmax = 616.070
            text = "020903: Tsu-nu-wo-no du-ta-lu-gi-s-ge-i, u-tsa-ti tsu-ne-gi-yu ge-se-i v-no-tsi tsi-nu-ne-gi-yv na-s-gi-ya-i; na-s-gi v-tla gi-lo di-gv-gi-lo-s-gi a-ni e-lo-hi e-hi na-s-gi i-tsu-ne-gv yi-ni-do-ga-gv-ga."
        intervals [327]:
            xmin = 616.070
            xmax = 616.070
            text = "020904: Gv-ni-ge-sv-no ni-gv-wa-na-dv-ne-le I-la-ya a-le Mo-si; Tsi-sa-no gv-wa-li-no-he-di-s-ge-i."
        intervals [328]:
            xmin = 616.070
            xmax = 616.070
            text = "020905: Qui-da-no u-ne-tsv hi-a nu-we-se-le Tsi-sa, Ta-de-yo-hv-s-gi, o-si-yu a-ni tsi-de-do-ha; a-le tso-i wi-do-tsi-li-tso-dv-ga; sa-quo ni-hi tsa-tse-li-ga, sa-quo-no Mo-si u-tse-li-ga, sa-quo-no I-la-ya u-tse-li-ga."
        intervals [329]:
            xmin = 616.070
            xmax = 616.070
            text = "020906: V-tla-ye-no ya-ga-ta-he i-yu-we-s-di-yi; u-tsa-ti-ye-no a-ni-s-ga-i-he-i."
        intervals [330]:
            xmin = 616.070
            xmax = 616.070
            text = "020907: U-lo-gi-lv-no u-nu-tlv-ta-ne-i; ka-ne-gv-no u-lo-gi-lv tsu-na-nu-go-tse-i, hi-a ni-ga-we-s-ge-i, Hi-a na-s-gi tsi-ge-yu-i A-que-tsi; na-s-gi e-tsa-dv-da-s-da-si."
        intervals [331]:
            xmin = 616.070
            xmax = 616.070
            text = "020908: Gi-la-quo-no i-yv-dv du-na-ka-hna-ni-do-lv, v-tla hna-quo gi-lo yu-ni-go-he-i, Tsi-sa u-wa-sv, a-le u-nv-sv."
        intervals [332]:
            xmin = 616.070
            xmax = 616.070
            text = "020909: Tsu-ni-ga-so-a-si-di-sv-no o-da-lv-i, du-ne-tse-le na-s-gi gi-lo u-ni-no-ne-di-yi ni-ge-sv-na nu-s-dv u-ni-go-hv-i, gv-ni yv-wi U-we-tsi u-yo-hu-sv tsu-le-hi-sa-nv-hi ge-se-s-di du-wo-se-le-i."
        intervals [333]:
            xmin = 616.070
            xmax = 616.070
            text = "020910: Na-s-gi-no nu-we-sv u-na-ga-sa-ya-s-ta-ne-i, da-na-da-dv-dv-hv-s-ge ga-dv-gv a-yo-hu-sv di-le-hi-so-di ge-sv-i."
        intervals [334]:
            xmin = 616.070
            xmax = 616.070
            text = "020911: Gv-wa-dv-dv-ne-no hi-a nu-ni-we-se-i, ga-do-no di-no-we-li-s-gi I-la-ya i-gv-yi da-ga-lu-tsi tsa-na-di-s-go-i?"
        intervals [335]:
            xmin = 616.070
            xmax = 616.070
            text = "020912: U-ne-tsv-no hi-a ni-du-we-se-le-i, I-la-ya u-do-hi-yu-hi i-gv-yi u-lu-hi-s-di, a-le ni-ga-dv u-wo-tlv-hi-so-di; a-le na-s-quo hi-a ni-gv-nv-go-we-la yv-wi U-we-tsi a-tsi-no-he-s-gv-i, na-s-gi u-tsa-ti tsu-da-le-nv-dv u-gi-li-yo-i-s-di ge-se-s-di, a-le a-se-quo da-ye-tsi-ye-lv-ni."
        intervals [336]:
            xmin = 616.070
            xmax = 616.070
            text = "020913: A-se-no hi-a ni-tsv-we-se-ha, I-la-ya u-do-hi-yu-hi u-lu-tsv, a-le nu-s-dv u-na-du-li-s-gv ni-gv-wa-ne-lv, na-s-gi-ya ni-gv-nv go-we-lv na-s-gi a-tsi-no-he-s-gv-i."
        intervals [337]:
            xmin = 616.070
            xmax = 616.070
            text = "020914: Gv-wa-s-da-wa-di-do-hi-no a-ne-do-hv u-lu-tsv, u-ni-tsa-ti du-go-he gv-wa-na-da-tlu-wi-s-de-i, a-le di-no-we-li-s-gi gv-wa-na-dv-dv-he-lv-i-s-ge-i."
        intervals [338]:
            xmin = 616.070
            xmax = 616.070
            text = "020915: Gi-la-quo-no i-yv-dv ni-ga-dv yv-wi, gv-wa-go-hv, u-tsa-ti u-ni-s-qua-ni-go-se-i; gv-wa-di-tla-o-he-lv-no gv-wa-yo-li-le-i."
        intervals [339]:
            xmin = 616.070
            xmax = 616.070
            text = "020916: Du-dv-dv-ne-no di-no-we-li-s-gi, ga-do de-tsa-dv-dv-he-lv-v-s-ga du-wo-se-le-i?"
        intervals [340]:
            xmin = 616.070
            xmax = 616.070
            text = "020917: A-si-yv-wi-no na-s-gi u-ni-tsa-ti ge-sv ge-la u-ne-tsv hi-a nu-we-se-i, Ta-de-yo-hv-s-gi, gv-ya-ti-no-hi-si a-que-tsi, u-wa-ge-wi a-da-nv-do u-we-i;"
        intervals [341]:
            xmin = 616.070
            xmax = 616.070
            text = "020918: I-lv-hi-tlv-no u-yi-lo-hi-si u-gi-lv-s-go-i; a-le da-ha-wo-i-ho-i, a-le de-ga-lv-da-gi-s-go de-ga-nu-do-gv-i, a-le u-lv-de-hi-ho-i; ge-tsa-s-da-wa-di-do-hi-no ga-tsi-ta-yo-se-lv u-ni-nu-go-wi-s-di-yi; a-se-no u-ni-nu-lv-nv-quo."
        intervals [342]:
            xmin = 616.070
            xmax = 616.070
            text = "020919: U-ne-tse-lv-no, hi-a nu-we-se-i, Yo!  ni-tso-hi-yu-sv-na go-hi tsi-tse-ha!  i-la-go i-go-hi-dv i-tsv-ye-la-di-do-he-s-di?  I-la-go i-go-hi-dv u-ne-la-gi i-tsv-ye-li-se-he-s-di?  A-ni hi-ya-ti-no-ga."
        intervals [343]:
            xmin = 616.070
            xmax = 616.070
            text = "020920: U-na-ti-no-he-le-no; u-go-hv-no gi-la-quo i-yv-dv a-da-nv-do u-gi-lv-ne-i; e-la-di-no u-nv-tse-i, a-le da-ha-wo-i-hv a-li-di-sv-ni-he-i."
        intervals [344]:
            xmin = 616.070
            xmax = 616.070
            text = "020921: U-dv-dv-ne-no u-do-da, I-la-go ni-go-hi-gi na-s-gi hi-a i-gv-wa-li-s-da-ne-lv-hi?  U-wo-se-le-i.  A-yo-li-quo ge-sv-i, u-dv-ne-i;"
        intervals [345]:
            xmin = 616.070
            xmax = 616.070
            text = "020922: Ya-no-gi-yu-no a-tsi-lv-yi a-le a-su-yi u-da-e-go-i, na-s-gi u-hi-s-di-yi; i-yu-s-gi-ni-no-nv go-hu-s-di ge-tsa-dv-ne-di ge-se-s-di, s-gi-s-do-li-gi, a-le s-gi-s-de-lv."
        intervals [346]:
            xmin = 616.070
            xmax = 616.070
            text = "020923: Tsi-sa-no hi-a nu-we-se-le-i, I-yu-no ge-tso-hi-yu-di ge-se-s-di, ni-ga-di-yu go-hu-s-di i-ga-ye-ga-dv-ne-di go-hi-yu-hv-s-gi."
        intervals [347]:
            xmin = 616.070
            xmax = 616.070
            text = "020924: Gi-la-quo-no i-yv-dv a-yo-li u-do-da u-we-lu-ne-i, a-le di-gv-ga-sa-wo-i-hi hi-a nu-we-se-i, Tsa-gv-wi-yu-hi, go-i-yu-hv-s-ga; s-gi-s-de-lv-si na-quo-hi-yu-sv-na ge-sv-i."
        intervals [348]:
            xmin = 616.070
            xmax = 616.070
            text = "020925: Tsi-sa-no u-go-hv na-s-gi u-ni-tsa-ti a-na-ne-lu-gi-s-gv a-na-da-tli-si-s-gv-i, u-s-ga-tse ga-da-ha a-da-nv-do, hi-a nu-we-se-le-i, Tsv-ge-wa a-le di-tsa-li-e-na a-da-nv-do, gv-ne-tse-ha, e-hi-nu-go-i, a-le tle-s-di hna-quo i-lv-hi-yu tsi-hi-yv-li."
        intervals [349]:
            xmin = 616.070
            xmax = 616.070
            text = "020926: [A-da-nv-do-no] u-we-lu-nv, a-le u-tsa-ti u-gi-lv-nv, u-nu-go-tse-i; a-le u-yo-hu-sv-hi-quo na-s-gi-ya ge-se-i; na-s-gi i-yu-s-di u-ni-tsa-te, a-yo-hu-hi, a-na-di-s-ge-i."
        intervals [350]:
            xmin = 616.070
            xmax = 616.070
            text = "020927: A-se-no tsi-sa u-wo-ya-ne-sv, du-le-ta-ne-i, a-le du-le-ne-i."
        intervals [351]:
            xmin = 616.070
            xmax = 616.070
            text = "020928: Ga-li-tso-de-no wi-u-yv-lv, gv-wa-s-da-wa-di-do-hi u-nv-sv ge-sv gv-wa-dv-dv-ne-i, Ga-do-no a-yv v-tla ga-yo-tsi-nu-go-wi-s-di yi-ge-se-i?  U-na-dv-ne-i."
        intervals [352]:
            xmin = 616.070
            xmax = 616.070
            text = "020929: Hi-a-no ni-du-we-se-le-i, Hi-a na-s-gi i-yu-s-di v-tla yv-ga-ye-ga-nu-go-wa, gv-ni a-da-do-li-s-ta-nv-hi a-le a-ma-tli gv-nv-hi tsi-ge-so-i."
        intervals [353]:
            xmin = 616.070
            xmax = 616.070
            text = "020930: U-na-ni-gi-sv-no na-hna-ni, Ge-li-li a-ye-li u-ni-lo-se-i; v-tla-no yu-du-li-s-ge gi-lo u-do-le-ho-hi-s-di-yi."
        intervals [354]:
            xmin = 616.070
            xmax = 616.070
            text = "020931: Du-we-yo-ne-ye-no gv-wa-s-da-wa-di-do-hi, a-le hi-a ni-du-we-se-le-i, yv-wi U-we-tsi da-tsi-yo-hi de-ge-tsi-yo-hi-si yv-wi. a-le da-gv-wa-li; a-le o-ni hna-quo a-tsi-lv-hi ge-se-s-di, do-dv-a-le-hi-sa-ni tso-i-ne i-ga."
        intervals [355]:
            xmin = 616.070
            xmax = 616.070
            text = "020932: A-se-no v-tla yu-no-li-tse na-s-gi nu-we-sv a-le a-ni-s-ga-i-he u-na-dv-dv-di-yi."
        intervals [356]:
            xmin = 616.070
            xmax = 616.070
            text = "020933: Ge-qua-ni-no u-lu-tsi-le-i; ga-li-tso-ga-no a-ya-v du-dv-dv-ne, Ga-do na-s-gi tsi-tsi-no-he-s-gv i-tsv-sv ge-sv a di-da-i-sv-i."
        intervals [357]:
            xmin = 616.070
            xmax = 616.070
            text = "020934: A-se-no e-la-we-yi-quo u-nv-se-i; di-na-i-sv-no a-ni-no-he-s-ge u-nv-sv ge-sv na-s-gi u-tli a-tsi-lv-quo-di-yu ge-sv-i."
        intervals [358]:
            xmin = 616.070
            xmax = 616.070
            text = "020935: U-we-nv-no, ta-la-du i-ya-ni-dv wi-du-ya-nv-he-i, a-le hi-a ni-du-we-se-le-i, i-yu-no gi-lo i-gv-yi i-yu-li-s-do-di-yi u-du-li-s-ge-s-di, na-s-gi o-ni-yi a-ga-le-do-di ge-se-s-di na-ni-v-i, a-le na-ni-v gv-wa-nv-si-do-hi ge-se-s-di."
        intervals [359]:
            xmin = 616.070
            xmax = 616.070
            text = "020936: A-yo-li-no wu-ya-nv-hv, a-ni-nv a-ye-li u-we-ka-ne-i; u-nu-lo-lv-no hi-a ni-du-we-se-le-i,"
        intervals [360]:
            xmin = 616.070
            xmax = 616.070
            text = "020937: Gi-lo a-si-yv-wi hi-a i-yu-na-s-di di-ni-yo-li da-da-ni-lv-ge-s-di a-yv a-yv da-qua-do-v nv-di-ga-li-s-do-di-s-ge-s-di, a-yv da-qua-da-ni-lv-ge-s-di; gi-lo-no a-yv da-qua-da-ni-lv-ge-s-di, v-tla a-yv yi-da-qua-da-ni-lv-ge-s-di, nv-dv-gi-nv-si-dv-s-gi-ni da-da-ni-lv-ge-s-di."
        intervals [361]:
            xmin = 616.070
            xmax = 616.070
            text = "020938: Tsa-ni-no u-ne-tse-le-i, hi-a nu-we-se-i, Ta-de-yo-hv-s-gi, o-tsi-go-hv-gi a-si-yv-wi a-ni-s-gi-na de-ga-nu-go-wi-s-gv-gi de-tsa-do-v gv-di-s-gv-gi; v-tla-no yi-gi-s-da-wa-di-do-ha; o-tsi-nv-s-da-de-lv-gi-no ni-gi-s-da-wa-de-gv-na ge-sv i-yu-s-di."
        intervals [362]:
            xmin = 616.070
            xmax = 616.070
            text = "020939: A-se-no tsi-sa hi-a nu-we-se-i, Tle-s-di e-tsi-nv-s-da-de-lv-gi; v-tla-ye-no ye-ha gi-lo da-qua-do-v gv-di-s-gi u-s-qua-ni-go-di tsu-lv-wi-s-da-ne-hi, na-s-gi i-gv-we-nv-dv u-so-nv gv-gi-ne-i-s-do-di."
        intervals [363]:
            xmin = 616.070
            xmax = 616.070
            text = "020940: Gi-lo-ye-no na-s-gi ni-ga-tlu-di-s-gv-na tsi-ge-so, na-s-gi i-ga-li-go-ne-hi ge-so-i."
        intervals [364]:
            xmin = 616.070
            xmax = 616.070
            text = "020941: Gi-lo-ye-no a-ma u-li-s-qui-di a-ka-li-i i-tsa-di-ta-s-di i-tsi-ne-ne-hi a-yv da-qua-do-v nv-di-ga-li-s-do-di-s-ge-s-di, Ga-lo-ne-dv e-tsa-tse-li ge-sv i-yu-s-di, u-do-hi-yu-hi-ya i-tsv-yo-se-ha, v-tla u-yo-hu-se-di yi-ge-se-s-di a-ga-gu-yv-e-di ge-sv-i."
        intervals [365]:
            xmin = 616.070
            xmax = 616.070
            text = "020942: A-le gi-lo a-si-yv-wi hi-a tsu-na-s-di ge-sv na-s-gi tsi-gv-quo-hi-yu-hv-s-ga do-go-de-s-di-s-ge-s-di, u-tli o-si-yu i-yu-li-s-da-ne-di a-s-do-s-gi nv-ya ya-tsi-ya-tla-nv, a-le a-me-quo-hi yi-wa-ga-da-i-nv."
        intervals [366]:
            xmin = 616.070
            xmax = 616.070
            text = "020943: I-yu a-le tso-ye-ni de-tso-de-s-di-s-ge-s-di, hi-s-qua-li-s-ge-s-di; u-tli o-si-yu i-tsa-li-s-da-ne-di tsa-go-la-ni gv-ni-dv di-ge-sv yi-wi-tsa-yv-lv, a-no i-tsu-la di-ge-ho-ya-di tsv-s-gi-no yi-wi-tsa-yv-lv, na-hna a-tsi-lv-yi ga-gv-dla-di-s-di ni-ge-sv-na;"
        intervals [367]:
            xmin = 616.070
            xmax = 616.070
            text = "020944: Na-hna u-na-tse-li tsi-s-go-yv ni-ga-li-wo-gv-na di-ge-sv-i, a-le a-tsi-lv ni-gv-tlo-s-gv-na di-ge-sv-i."
        intervals [368]:
            xmin = 616.070
            xmax = 616.070
            text = "020945: I-yu a-le tsa-la-si-de-ni do-tso-de-s-di-s-ge-s-di, hi-s-qua-li-s-ge-s-di; u-tli-ye-no o-si-yu i-tsa-li-s-da-ne-di hi-yo-u-li gv-ni-dv di-ge-sv yi-wi-tsa-yv-lv, a-no i-tsu-la di-ge-tsa-la-s-gi tsv-s-gi-no yi-we-tsa-da-i-nv, na-hna a-tsi-lv-yi ga-gv dla-di-s-di ni-ge-sv-na;"
        intervals [369]:
            xmin = 616.070
            xmax = 616.070
            text = "020946: Na-hna u-na-tse-li tsi-s-go-yv ni-ga-li-wo-gv-na di-ge-sv-i, a-le a-tsi-lv ni-gv-tlo-s-gv-na."
        intervals [370]:
            xmin = 616.070
            xmax = 616.070
            text = "020947: I-yu a-le hi-ga-do-li do-tso-de-s-di-s-ge-s-di, ha-da-ga-te-do-i-s-ge-s-di; u-tli-ye-no o-si-yu i-tsa-li-s-da-ne-di sa-quo-quo yi-ka-nv U-ne-la-nv-hi u-tse-li-go-hi yi-wi-tsa-yv-lv a-no i-tsu-la yi-ti-ka-nv tsv-s-gi-no a-tsi-lv-yi yi-we-tsa-da-i-nv;"
        intervals [371]:
            xmin = 616.070
            xmax = 616.070
            text = "020948: Na-hna u-na-tse-li tsi-s-go-yv ni-ga-li-wo-gv-na di-ge-sv-i, a-le a-tsi-lv ni-gv-tlo-s-gv-na di-ge-sv-i."
        intervals [372]:
            xmin = 616.070
            xmax = 616.070
            text = "020949: Na-ni-v-ye-no a-tsi-lv gv-di ~a-ma ge-tsi-nv-tla-ye-di ge-se-s-di, a-le ni-ga-v a-tsi-lv--ge-la-s-di ~a-ma ga-nv-li-ye-di ge-se-s-di."
        intervals [373]:
            xmin = 616.070
            xmax = 616.070
            text = "020950: -A-ma o-si-yu; a-se-no ~a-ma yu-tsi-s-go-lv ga-do yi-tsv-ga nu-tsi-s-go-lv-na yi-ni-tsv-ga?  ~A-ma i-tsi-lo-tsv-hi ge-se-s-di, a-le do-hi-yi ni-tsv-ne-s-di i-tse-hv-i."
        intervals [374]:
            xmin = 616.070
            xmax = 616.070
            text = "021001: Na-hna-no du-le-nv, Tsu-di-yi ga-da a-hv-i u-lu-tse-i, Tso-da-ni a-s-go-ni-di-tlv tsu-lo-hi-s-ta-ne-i; a-le u-ni-tsa-ti yv-wi ta-li-ne i-gv-wa-da-tli-sa-ne-le-i; a-le i-yu-dv-ne-di ge-sv nu-dv-ne-le-i, ta-li-ne du-we-yo-ne-i."
        intervals [375]:
            xmin = 616.070
            xmax = 616.070
            text = "021002: A-ni-qua-li-si-no gv-wa-lu-tse-lv gv-wa-dv-dv-ne-i, hi-a nu-ni-we-se-i, Du-yu-go-di-s-go a-s-ga-ya u-da-i-nv-di-yi u-da-li-i?  Gv-wa-go-li-ye-s-ge-i."
        intervals [376]:
            xmin = 616.070
            xmax = 616.070
            text = "021003: U-ne-tsv-no hi-a ni-su-we-se-le-i, Ga-do u-s-de i-tsi-ne-tse-le Mo-si?"
        intervals [377]:
            xmin = 616.070
            xmax = 616.070
            text = "021004: Hi-a-no nu-ni-we-se-i, Mo-si u-li-s-go-lv-ta-ne go-we-lo-di-yi do-ga-le-nv-hv-i, a-le a-da-i-nv-di-yi."
        intervals [378]:
            xmin = 616.070
            xmax = 616.070
            text = "021005: Tsi-sa-no u-ne-tsv, hi-a ni-du-we-se-le-i, Di-s-da-yi-yu ge-sv i-yu-s-di di-tsi-na-wi hi-a na-s-gi di-ka-hna-wa-dv-s-di i-tso-we-la-ne-le-i;"
        intervals [379]:
            xmin = 616.070
            xmax = 616.070
            text = "021006: Di-da-le-ni-s-gv-s-gi-ni u-we-tlv-nv-nv-i, U-ne-la-nv-hi a-s-ga-ya a-le a-ge-yv du-wo-tlv-ne-i."
        intervals [380]:
            xmin = 616.070
            xmax = 616.070
            text = "021007: Na-s-gi i-yu-s-di a-s-ga-ya de-gv-de-ge-s-di u-do-da a-le u-tsi, a-le u-da-li-i a-dla-wa-s-di-s-ge-s-di;"
        intervals [381]:
            xmin = 616.070
            xmax = 616.070
            text = "021008: Na-s-gi-no a-ni-ta-li sa-quo-quo ge-se-s-di u-ni-que-da-lv-i; na-s-gi-no v-tla hna-quo a-ni-ta-li yi-gi, sa-quo-quo-s-gi-ni u-ni-que-da-lv-i."
        intervals [382]:
            xmin = 616.070
            xmax = 616.070
            text = "021009: Na-s-gi i-yu-s-di U-ne-la-nv-hi tsu-wu-da-ta-nv-hi tle-s-di yv-wi tsu-ga-le-nv-ta-nv-gi."
        intervals [383]:
            xmin = 616.070
            xmax = 616.070
            text = "021010: Ga-li-tso-de-no a-ni-ya-v gv-wa-s-da-wa-di-do-hi ta-li-ne i-gv-wa-dv-dv-ne na-s-gi u-gv-wa-li."
        intervals [384]:
            xmin = 616.070
            xmax = 616.070
            text = "021011: Hi-a-no ni-du-we-se-le-i, Gi-lo u-da-li-i a-da-e-ge-s-di, a-le nv-wa-da-le a-da-ye-ge-s-di, na-s-gi a-da-yo-ne-he-s-di a-s-ga-nv-tse-he-s-di na-s-gi."
        intervals [385]:
            xmin = 616.070
            xmax = 616.070
            text = "021012: I-yu a-le a-ge-yv u-ye-hi a-da-e-ge-s-di, a-le nv-wa-da-le da-na-tse-ge-s-di, na-s-gi a-da-yo-ne-he-s-di."
        intervals [386]:
            xmin = 616.070
            xmax = 616.070
            text = "021013: Tsu-na-s-di-no di-ni-yo-li de-gv-wa-ti-no-he-le-i, na-s-gi tsu-sv-ni-s-di-yi; gv-wa-s-da-wa-di-do-hi-no du-ni-gv-s-go-lv-ne na-s-gi tsu-na-ti-no-lv-hi."
        intervals [387]:
            xmin = 616.070
            xmax = 616.070
            text = "021014: Tsi-sa-s-gi-ni u-go-hv u-tsa-ti sv-s-ga u-ye-lv-ne-i, a-le hi-a ni-du-we-se-le-i, U-ne-la-gi de-tse-li-se-he-s-di tsu-na-s-di di-ni-yo-li gv-gi-lu-tse-di-yi, a-le tle-s-di yi-di-tsi-nv-s-da-de-he-s-di; na-s-gi-ye-no nu-na-s-di U-ne-la-nv-hi u-tse-li-go-hi."
        intervals [388]:
            xmin = 616.070
            xmax = 616.070
            text = "021015: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, i-yu-no gi-lo U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv ni-da-da-ni-lv-gv-na i-ge-se-s-di na-s-gi-ya a-yo-li tsi-da-da-ni-lv-go-i, v-tla na-hna yi-wv-gv-yv-ha."
        intervals [389]:
            xmin = 616.070
            xmax = 616.070
            text = "021016: Du-ne-sv-no a-le du-si-ta-dv, o-s-dv du-ne-tse-le-i."
        intervals [390]:
            xmin = 616.070
            xmax = 616.070
            text = "021017: U-ni-gi-sv-no ga-nv-nv wu-lu-tsv, gi-lo i-yu-s-di u-di-tlo-e-lv-gi, a-le du-li-ni-qua-nv-ne-lv-gi, u-dv-dv-ne hi-a nu-we-se-le-i, Ho-s-dv Ta-de-yo-hv-s-gi, ga-do da-ga-dv-ne-li u-li-s-qua-di-s-di ni-ge-sv-na gv-ni-dv a-qua-tse-li i-yu-li-s-do-di-yi?"
        intervals [391]:
            xmin = 616.070
            xmax = 616.070
            text = "021018: Tsi-sa-no hi-a nu-we-se-le-i, Ga-do-no ho-s-dv i-s-quo-se-ha a-yv?  V-tla gi-lo o-s-dv yi-gi, sa-quo u-wa-sv-hi-yu, na-s-gi U-ne-la-nv-hi."
        intervals [392]:
            xmin = 616.070
            xmax = 616.070
            text = "021019: De-hi-ga-ta-ha di-ka-hna-wa-dv-s-di, na-s-gi, Tle-s-di tsa-da-yo-ne-lv-gi, Tle-s-di tsa-da-lv-gi, Tle-s-di tsa-no-s-gi-sv-gi, Tle-s-di ga-ye-go-gi tsa-no-he-lv-gi, Tle-s-di tsa-da-lo-nu-he-lv-gi, Tsa-do-da a-le tsa-tsi de-hi-lv-quo-de-s-di."
        intervals [393]:
            xmin = 616.070
            xmax = 616.070
            text = "021020: U-ne-tsv-no hi-a nu-we-se-le-i, Ta-de-yo-hv-s-gi, hi-a na-s-gi ni-ga-dv da-gi-s-qua-ni-go-ta-nv tsi-tsu-tsa ge-sv nv-da-gv-wa-da-le-nv-dv."
        intervals [394]:
            xmin = 616.070
            xmax = 616.070
            text = "021021: Tsi-sa-no du-ka-hna-nv, u-ge-yu-hi-yu nu-li-s-ta-ne-i, a-le hi-a nu-we-se-le-i, Su-da-le-gi tsa-lu-la; he-na wi-na-du-ga ni-ga-v go-hu-s-di tsa-na-v-i, a-le u-yo i-yu-na-dv-hna-de-gi gi-ne-lv-ha, tso-sv-no wi-tsa-he-s-di tsu-gv-wa-lo-di; a-le te-sv-ha, tsu-da-hna-wa-dv hi-yv-hv-ha, a-le s-gi-s-da-wa-de-sv-ha."
        intervals [395]:
            xmin = 616.070
            xmax = 616.070
            text = "021022: U-yo-no u-ye-lv-ne na-s-gi na-tsi-we-se-lv, a-le e-hi-s-di gv-wa-da-nv-ti u-da-nv-se-i; u-tsa-ti-ye-no u-hna-e-i."
        intervals [396]:
            xmin = 616.070
            xmax = 616.070
            text = "021023: Tsi-sa-no u-du-wi-dv du-ka-hna-ni-do-lv, hi-a ni-du-we-se-le gv-wa-s-da-wa-di-do-hi, Na-s-da-ya tsu-gv-wa-lo-di u-ni-hi U-ne-la-hv-hi u-tse-li-go-hi wu-ni-yv-s-di-yi."
        intervals [397]:
            xmin = 616.070
            xmax = 616.070
            text = "021024: Gv-wa-s-da-wa-di-do-hi-no gv-wa-s-qua-ni-go-se-le na-s-gi nu-we-sv-i.  A-se-no Tsi-sa ta-li-ne i-u-ne-tsv, hi-a ni-du-we-se-le-i, Di-tsi-yo-li.  na-s-da-ya na-s-gi ge-nv-i-s-di ge-sv a-na-li-s-ga-s-do-di-s-gi, U-ne-la-nv-hi u-tse-li-go-hi wu-ni-yv-s-di-yi."
        intervals [398]:
            xmin = 616.070
            xmax = 616.070
            text = "021025: U-tli a-hi-di-yu ge-mi-li yv-gi ga-sa-ne-na-dv-di-yi u-ga-dv-le-hi-s-di-yi, a-no u-we-hna-i yv-wi U-ne-la-nv-hi u-tse-li-go-hi wu-yv-s-di-yi."
        intervals [399]:
            xmin = 616.070
            xmax = 616.070
            text = "021026: U-lo-sv-s-ta-nv-hi-no u-ni-s-qua-ni-go-s-ge-i, hi-a ni-da-na-da-we-se-he-i, Ga-go-ge ye-li ga-ye-tsi-s-de-lv-di?"
        intervals [400]:
            xmin = 616.070
            xmax = 616.070
            text = "021027: Tsi-sa-no na-s-gi du-ka-hna-nv, hi-a nu-we-se-i, Yv-wi ge-sv na-s-gi i-gv-dv-ne-di ni-ge-sv-na, U-ne-la-nv-hi-s-gi-ni ge-sv v-tla; U-ne-la-nv-hi-ye-no ge-sv ni-ga-v go-hu-s-di i-gv-dv-ne-di."
        intervals [401]:
            xmin = 616.070
            xmax = 616.070
            text = "021028: Hna-quo-no Qui-da u-le-nv-he hi-a nu-we-se-le-i, Gv-ni-yu-quo a-yv ni-ga-di-yu o-gv-de-tso-nv, a-le ni-hi i-tsv-s-da-wa-de-nv."
        intervals [402]:
            xmin = 616.070
            xmax = 616.070
            text = "021029: Tsi-sa-no u-ne-tsv hi-a nu-we-se-i; U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, v-tla gi-lo ye-ha na-s-gi u-wv-de-tsv-hi i-ge-se-s-di a-da-ne-lv-i, a-le a-na-li-nv-tli, a-le tsu-do, a-le u-do-da, a-le u-tsi, a-le u-da-li-i, a-le tsu-we-tsi, a-le du-lo-ge-sv-i, a-yv ge-sv nv-di-ga-li-s-do-di-s-ge-s-di, a-le o-s-dv ka-no-he-dv nv-di-ga-li-s-do-di-s-ge-s-di,"
        intervals [403]:
            xmin = 616.070
            xmax = 616.070
            text = "021030: Na-s-gi go-hi ge-sv a-tsi-ne-di ni-ge-sv-na ge-sv a-s-go-hi-tsu-qui i-yu-wa-gu-di u-lo-sv-s-di da-da-ne-lv-i, a-le a-na-li-nv-tli, a-le tsu-do, a-le tsu-tsi, a-le tsu-we-tsi, a-le de-ga-lo-ge-sv-i, a-gi-li-yo-i-s-di ge-sv ta-li u-dv-di; so-i-yi-no di-ge-sv u-li-s-qua-di-s-di ni-ge-sv-na gv-ni-dv."
        intervals [404]:
            xmin = 616.070
            xmax = 616.070
            text = "021031: A-se-no u-ni-tsa-ta na-s-gi i-gv-yi tsi-gi, o-ni ge-se-s-di; o-ni-no tsi-gi, i-gv-yi ge-se-s-di."
        intervals [405]:
            xmin = 616.070
            xmax = 616.070
            text = "021032: Ga-nv-nv-no a-na-i-se Tsi-lu-si-li-mi tsa-ni-ga-te-i; tsi-sa-no i-gv-yi du-we-nv-e-le-i; u-ni-s-qua-ni-go-se-no; na-s-gi-no a-na-li-s-da-wa-di-sv a-ni-s-ga-i-he-i.  Ta-li-ne-no du-ya-nv-hv ta-la-du i-ya-ni-dv, u-le-nv-he du-no-ne-le na-s-gi i-yu-li-s-da-ne-li-da-s-di ge-sv-i."
        intervals [406]:
            xmin = 616.070
            xmax = 616.070
            text = "021033: [Hi-a ni-ga-we-s-ge-i;] Gv-ni-yu-quo Tsi-lu-si-li-mi wi-di-ga-ti; a-le yv-wi U-we-tsi do-da-ye-tsi-yo-si nu-ni-gv-wi-yu-sv a-tsi-lv a-ne-lo-hi a-le di-no-we-li-s-gi do-da-ge-tsi-yo-hi-se-li; a-le do-da-gv-wu-go-da-ne-li u-yo-hu-hi-s-di-yi, a-le tsu-na-da-le-nv-dv yv-wi wi-do-dv-ni-yo-hi-se-li;"
        intervals [407]:
            xmin = 616.070
            xmax = 616.070
            text = "021034: A-le da-gv-wa-so-tlv-i-s-ta-ni, a-le da-gv-wa-li-v-ni-li, a-le do-da-gv-wa-li-tsi-s-qui, a-le da-gv-wa-li; tso-i-ne-no i-ga ta-li-ne do-dv-a-le-ni."
        intervals [408]:
            xmin = 616.070
            xmax = 616.070
            text = "021035: Tsi-mi-no a-le Tsa-ni, Tse-qui-di tsu-we-tsi gv-wa-lu-tse-le-i, hi-a nu-ni-we-se-i, Ta-de-yo-hv-s-gi, s-gi-na-du-li-ha i-s-gi-na-dv-ne-di-yi nu-s-dv i-s-dv-ta-yo-se-di ge-sv-i."
        intervals [409]:
            xmin = 616.070
            xmax = 616.070
            text = "021036: Hi-a-no ni-du-we-se-le-i, Ga-do-no i-s-da-du-li i-s-dv-ya-dv-ne-di-yi?"
        intervals [410]:
            xmin = 616.070
            xmax = 616.070
            text = "021037: Hi-a-no ni-gv-wa-we-se-le-i, S-gi-na-li-s-go-lv-da-si, na-s-gi tso-gi-ni-di-yi, a-si-yv-wi hi-ga-ti-si-di-tlv, so-i-no hi-ga-s-ga-ni-di-tlv, tsa-tse-li ga-lv-quo-di-yu ge-sv-i."
        intervals [411]:
            xmin = 616.070
            xmax = 616.070
            text = "021038: A-se-no Tsi-sa hi-a ni-du-we-se-le-i, v-tla yi-s-di-ga-ta-ha nu-s-dv i-s-di-ta-yo-hi-hv-i.  Tsi-sa ye-li-quo ge-s-da-di-ta-s-di u-li-s-qui-di na-s-gi a-qua-di-ta-s-di tsi-gi?  A-le di-ga-ye-s-da-wo-s-di na-s-gi di-da-wo-s-di ge-sv na-s-gi v-qua-wo-s-do-di tsi-gi?"
        intervals [412]:
            xmin = 616.070
            xmax = 616.070
            text = "021039: Hi-a-no ni-gv-wa-we-se-le-i, ye-li-quo.  Tsi-sa-no hi-a ni-du-we-se-le-i, U-do-hi-yu-hi da-s-da-di-ta-hi u-li-s-qui-di na-s-gi a-yv a-qua-di-ta-s-di tsi-gi, a-le di-da-wo-s-di ge-sv a-yv v-qua-wo-s-do-di tsi-gi, na-s-gi do-da-ye-s-da-wo-s-ta-ni;"
        intervals [413]:
            xmin = 616.070
            xmax = 616.070
            text = "021040: U-we-di-yi-s-gi-ni a-quo-lv tsi-ga-ti-si i-di-tlv, a-le tsi-ga-s-ga-ni i-di-tlv, v-tla a-yv a-qua-da-ne-di yi-gi; u-nv-sv-s-gi-ni na-s-gi ge-ga-dv-nv-i-s-da-ne-lv-hi tsi-gi"
        intervals [414]:
            xmin = 616.070
            xmax = 616.070
            text = "021041: A-s-go-hi-no i-ya-ni-dv u-na-dv-ga-nv, u-na-le-nv-he u-tsa-ti e-s-ga du-ni-ye-lv-na-ne-le Tsi-mi a-le Tsa-ni."
        intervals [415]:
            xmin = 616.070
            xmax = 616.070
            text = "021042: A-se-no tsi-sa wi-du-ya-nv-hv hi-a ni-du-we-se-le-i; I-tsi-ga-ta-ha na-s-gi u-ni-gv-wi-yu-hi ge-tsi-ye-lv-i ge-sv tsu-na-da-le-nv-dv yv-wi da-ne-wa-di-sv-i, di-gv-wa-na-ne-lo-do-di-yi na-nv-ne-ho-i; tsu-ni-lv-quo-di-no ge-sv gv-wa-na-da-li-ne-hi-de-ho-i."
        intervals [416]:
            xmin = 616.070
            xmax = 616.070
            text = "021043: Ni-hi-s-gi-ni i-tse-hv v-tle-s-di na-s-gi yi-ni-tsv-ne-s-di; gi-lo-s-gi-ni a-tsi-lv-quo-di i-yu-li-s-do-di-yi u-du-li-s-ge-s-di, na-s-gi e-tsi-nv-si-da-s-di ge-se-s-di."
        intervals [417]:
            xmin = 616.070
            xmax = 616.070
            text = "021044: A-le gi-lo ni-hi ni-tsa-dv-nv nu-gv-wi-yu-sv i-yu-li-s-do-di-yi u-du-li-s-ge-s-di, na-s-gi ni-ga-dv gv-wa-nv-si-do-hi ge-se-s-di."
        intervals [418]:
            xmin = 616.070
            xmax = 616.070
            text = "021045: Na-s-quo-ye-no yv-wi U-we-tsi v-tla yu-lu-tsv go-hu-s-di a-ga-dv-ne-di-yi, go-hu-s-di-s-gi-ni u-da-dv-ne-di-yi, a-le gv-nv tsu-yo-hi-s-di-yi tsu-gu-yv-do-di-yi u-ni-tsa-ti."
        intervals [419]:
            xmin = 616.070
            xmax = 616.070
            text = "021046: Tse-li-go-no u-ni-lu-tse-i, a-le na-s-gi Tse-li-go i-u-nu-go-tsv a-le na-s-gi gv-wa-s-da-wa-di-do-hi, a-le u-ni-tsa-ti yv-wi, di-ge-wi Qua-di-mi-ya, na-s-gi Di-mi-ya u-we-tsi, u-wo-le nv-no-hu-lo-di a-du-la-di-s-ge-i."
        intervals [420]:
            xmin = 616.070
            xmax = 616.070
            text = "021047: U-dv-ga-nv-no na-s-gi Tsi-sa Na-se-li-di e-hi ge-sv-i, u-le-nv-he u-we-lu-ne, hi-a nu-we-se-i, De-wi U-we-tsi, Tsi-sa, s-gi-do-li-gi."
        intervals [421]:
            xmin = 616.070
            xmax = 616.070
            text = "021048: U-ni-tsa-te-no gv-wa-gv-s-go-lv-ne gv-wa-ne-tse-le e-la-we-yi u-wv-di-yi; a-se-no u-tli-quo i-ga-i u-we-lu-ne-i, De-wi U-we-tsi s-gi-do-li-gi, a-di-s-ge-i."
        intervals [422]:
            xmin = 616.070
            xmax = 616.070
            text = "021049: Tsi-sa-no u-le-wi-s-ta-nv u-ne-tse wa-tsi-ya-nv-di-yi.  U-ni-ya-nv-he-no di-ge-wi, hi-a nu-ni-we-se-le-i, U-ga-li-s-di-quo ha-da-nv-da-da; ta-le-hv-ga; di-tsa-ya-ni-ha."
        intervals [423]:
            xmin = 616.070
            xmax = 616.070
            text = "021050: Na-s-gi-no u-da-i-nv u-nu-wo du-le-ne-i, a-le Tsi-sa wu-lu-tse-le-i."
        intervals [424]:
            xmin = 616.070
            xmax = 616.070
            text = "021051: Tsi-sa-no u-ne-tsv hi-a nu-we-se-le-i, Ga-do tsa-du-li gv-ya-dv-ne-di-yi?  Di-ge-wi-no hi-a nu-we-se-le-i, Tsa-gv-wi-yu-hi, v-a-gi-go-wa-dv-di-yi [a-qua-du-li-ha.]"
        intervals [425]:
            xmin = 616.070
            xmax = 616.070
            text = "021052: Tsi-sa-no hi-a nu-we-se-le-i, He-na-quo-no; tso-hi-yu-sv tsa-s-de-lv.  Gi-la-quo-no i-yv-dv gv-wa-go-wa-dv-di nu-li-s-ta-ne-i, a-le u-s-da-wa-dv-se Tsi-sa a-i-sv-i."
        intervals [426]:
            xmin = 616.070
            xmax = 616.070
            text = "021101: Tsi-lu-si-li-mi-no na-v wu-ni-lu-tsv na-s-gi Sv-ga-do-hi a-le Que-di-ni-yi i-yv-dv, O-li-wa-yo-hi u-sa-hi-lv-i, a-ni-ta-li gv-wa-s-da-wa-di-do-hi du-nv-se-i,"
        intervals [427]:
            xmin = 616.070
            xmax = 616.070
            text = "021102: A-le hi-a ni-du-we-se-le-i, I-s-de-na na de-s-di-do-gv tsu-yu-go-di tsv-di-ga-du-ha wi-s-di-tsa-hi; wi-s-di-yv-lv-quo-no na-hna-ni, da-ye-s-di-wa-dv-hi di-ga-li-a-nv-hi-dv a-gi-na ge-li-sa-de-s-di, na-s-gi v-tla gi-lo yv-wi u-gi-lv-ta-nv-hi yi-gi; e-s-de-li-sa-de-sv-ha a-le tse-s-da-ti-ne-sv-ha."
        intervals [428]:
            xmin = 616.070
            xmax = 616.070
            text = "021103: I-yu-no gi-lo Ga-do-no na-s-gi ni-s-da-dv-ne-ha i-s-do-se-lv-ha?  U-gv-wi-yu-hi u-du-li-ha, i-s-da-dv-nv-ha; gi-la-quo-no i-yv-dv do-da-yu-yo-si a-ni e-s-da-ti-no-hi-s-di-yi."
        intervals [429]:
            xmin = 616.070
            xmax = 616.070
            text = "021104: U-ne-nv-se-no, a-le wu-ni-wa-dv-he a-gi-na ge-li-sa-de ga-lo-hi-s-di-yu-lo-di do-yi-di-tlv, na-hna de-ga-nv-nv da-tlo-s-gv-i; u-ne-li-sa-de-se-no."
        intervals [430]:
            xmin = 616.070
            xmax = 616.070
            text = "021105: Gi-lo-no i-yu-na-s-di na-hna di-ni-do-gi hi-a ni-du-ni-we-se-le-i, Ga-do-no i-e-s-de-li-sa-de a-gi-wi?"
        intervals [431]:
            xmin = 616.070
            xmax = 616.070
            text = "021106: A-le na-s-gi-ya-quo Tsi-sa nu-we-sv u-ne-tsv ni-du-ni-we-se-le-i:  du-ni-yo-se-no."
        intervals [432]:
            xmin = 616.070
            xmax = 616.070
            text = "021107: A-gi-na-no Tsi-sa u-na-ti-no-he-le-i, a-le tsu-na-nu-wo du-ni-tlv-ne-le-i; Tsi-sa-no u-gi-lv-ta-ne-i."
        intervals [433]:
            xmin = 616.070
            xmax = 616.070
            text = "021108: U-ni-tsa-te-no tsu-na-nu-wo nv-no-hi du-nu-ye-s-dv-ne-i; i-ga-dv-no de-tlu-gv du-nv-ni-ga-lv-he-i, a-le nv-no-hi du-ni-la-ge-ya-dv-ne-i."
        intervals [434]:
            xmin = 616.070
            xmax = 616.070
            text = "021109: I-gv-yi-i a-ne-gi, a-le o-ni a-ne-gi, u-ne-lu-ge-i, hi-a na-ni-we-s-ge-i, Ho-sa-na, Ga-lv-quo-di-yu ge-se-s-di Yi-ho-wa de-u-do-s-dv tsi-ga-lu-hi-s-di-da."
        intervals [435]:
            xmin = 616.070
            xmax = 616.070
            text = "021110: Ga-lv-quo-di-yu ge-se-s-di De-wi i-gi-do-da u-tse-li u-gv-wi-yu-hi ge-sv-i, na-s-gi Yi-ho-wa du-do-s-dv tsi-ga-lu-hi-s-di-ha; Ho-sa-na wa-s-dv ga-lv-la-di-yu."
        intervals [436]:
            xmin = 616.070
            xmax = 616.070
            text = "021111: Tsi-sa-no Tsi-lu-si-li-mi wu-yv-le-i, a-le u-ta-nv--di-ga-la-wi-i-s-di-yi wu-yv-le-i; hna-quo-no gv-wa-du-wi-dv du-ka-hna-ni-do-lv ni-ga-dv tsu-da-le-nv-dv du-ka-hna-nv, a-le hna-quo u-sv-hi-yv-yi ge-se-i, u-nu-go-tse Que-di-ni-yi wu-lo-se a-ne-he ta-la-du i-ya-ni-dv."
        intervals [437]:
            xmin = 616.070
            xmax = 616.070
            text = "021112: U-gi-tsv-dv-no Que-di-ni-yi tsu-ni-lo-sv a-go-nu u-yo-si-s-ge-i;"
        intervals [438]:
            xmin = 616.070
            xmax = 616.070
            text = "021113: Wu-go-he-no ge i-yv-dv di-tlu-ge sv-ga-la-i-yu-s-di, u-li-s-du-se-i, wu-lu-tse-i, ya-se-ga-gi yi-tsi-wa-dv go-hu-s-di yu-ta u-we-li-se-i; na-hna-no wu-lu-tsv v-tla go-hu-s-di yu-wa-dv-he u-li-s-du-sv-quo u-wa-sv; v-tla-ye-no a-si yu-s-qua-lv-he sv-ga-ta-i-yu-na-s-di u-nv-ni-s-di-yi."
        intervals [439]:
            xmin = 616.070
            xmax = 616.070
            text = "021114: Tsi-sa-no u-ne-tsv hi-a nu-we-se-le-i, Tle-s-di gi-lo i-lv-hi-yu tsi-a-gi ni-hi tsa-da-ta-nv-hi go-hi i-yu-da-le-nv-dv.  Gv-wa-s-da-wa-di-do-hi-no u-na-dv-ga-ne-i."
        intervals [440]:
            xmin = 616.070
            xmax = 616.070
            text = "021115: Tsi-lu-si-li-mi-no u-ni-lu-tse-i; Tsi-sa-no u-ta-nv--di-ga-ta-wi-i-s-di-yi wu-yv-lv, u-le-nv-he du-nu-go-wi-se a-ni-na-de-gi a-le u-ni-wa-e-v-s-gi na-hna u-ta-nv--di-ga-la-wi-i-s-di-yi, a-le du-lu-qua-di-nv-se du-ni-s-gi-lv a-de-lv di-ni-tli-yv-s-gi, a-le u-na-nv-di-yi gu-le--di-ni-s-go-ni-hi di-ni-na-de-gi;"
        intervals [441]:
            xmin = 616.070
            xmax = 616.070
            text = "021116: A-le v-tla u-ne-la-gi yu-we-li-se-le gi-lo go-hu-s-di u-s-di a-te-li-do u-yv-do-di-yi u-dv-nv--di-ga-la-wi-i-s-di-yi."
        intervals [442]:
            xmin = 616.070
            xmax = 616.070
            text = "021117: Du-de-yo-ne-no, hi-a ni-du-we-se-le-i, tla-s-go hi-a yi-ni-gv-nv yi-go-we-la, a-qua-tse-li a-da-ne-lv ni-ga-di-yu tsu-na-da-le-nv-dv yv-wi u-na-da-do-li-s-do-di-yi du-do-e-s-di?  Ni-hi-s-gi-ni a-ni-no-s-gi-s-gi u-ni-yv-s-di-yi u-s-da-ga-lv ni-tsv-ne-lv."
        intervals [443]:
            xmin = 616.070
            xmax = 616.070
            text = "021118: Di-no-we-li-s-gi-no a-le nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi u-na-dv-ga-ne-i, a-le u-ni-yo-le i-yu-nv-ne-di-yi u-ni-hi-s-di-yi; gv-wa-na-ye-s-ge-ye-no, nv-di-ga-li-s-do-di-s-ge ni-ga-dv yv-wi u-ni-s-qua-ni-go-s-gv nu-s-dv da-de-yo-hv-s-gv-i."
        intervals [444]:
            xmin = 616.070
            xmax = 616.070
            text = "021119: U-sv-no nu-li-s-ta-nv u-nu-go-tse ga-du-hv-i."
        intervals [445]:
            xmin = 616.070
            xmax = 616.070
            text = "021120: Su-na-le-no a-na-i-sv-i, u-ni-go-he e-ga-ta-i-yu-s-di tlu-gv u-wa-yv-sv-hi ge-se du-hna-s-de-tlv nv-da-gv-wa-da-le-nv-dv."
        intervals [446]:
            xmin = 616.070
            xmax = 616.070
            text = "021121: Qui-da-no u-nv-da-dv hi-a nu-we-se-le-i, Ta-de-yo-hv-s-gi, gv-ni-yu-quo, e-ga-ta---i-yu-s-di tlu-gv tsi-s-ga-tsv-gi u-wa-yv-so-nv."
        intervals [447]:
            xmin = 616.070
            xmax = 616.070
            text = "021122: Tsi-sa-no u-ne-tsv, hi-a ni-du-we-se-le-i, U-ne-la-nv-hi e-tso-i-yu-se-s-di."
        intervals [448]:
            xmin = 616.070
            xmax = 616.070
            text = "021123: U-do-hi-yu-hi-ya-ye-no hi-a ni-tsv-we-se-ha, Gi-lo hi-a ni-ga-we-se-he-s-di hi-a tso-da-lv, We-tsa-hv-na, a-le a-me-quo-hi we-tsa-du-ga; a-le nu-dla-si-dv-e-hv-na i-ge-se-s-di u-na-wi-yi, go-hi-yu-hv-s-ge-s-di-quo-s-gi-ni na-s-gi ni-ga-we-s-gv a-se i-yu-li-s-do-di ge-sv-i; na-s-gi u-he-s-di ni-ga-v nu-we-sv-i."
        intervals [449]:
            xmin = 616.070
            xmax = 616.070
            text = "021124: na-s-gi i-yu-s-di hi-a ni-tsv-we-se-ha, Ni-ga-v go-hu-s-di i-tsi-ta-yo-ha i-tsa-da-do-li-s-da, i-tso-hi-yu-hv-s-ge-s-di e-tsi-ne-i ge-sv-i, a-le a-se i-tsi-he-s-di."
        intervals [450]:
            xmin = 616.070
            xmax = 616.070
            text = "021125: I-yu-no i-tsa-le-hv-s-ge-s-di i-tsa-da-do-li-s-di-s-ge-s-di, ge-tsa-da-ne-he-s-di e-tsi-s-ga-nv-tse-lv-i, i-yu-no go-hu-s-di e-tse-li-se-he-s-di gi-lo-i; na-s-gi na-s-quo I-tsi-do-da ga-lv-ta-di tse-ha ga-ge-tsi-ne-di-yi hi-a i-tsi-s-ga-nv-tsv-i."
        intervals [451]:
            xmin = 616.070
            xmax = 616.070
            text = "021126: I-yu-s-gi-ni ni-tsa-da-ne-hv-na i-ge-se-s-di e-tsi-s-ga-nv-tse-lv-i, v-tla na-s-quo I-tsi-do-da ga-lv-la-di e-hi yv-ge-tsi-do-li-gi i-tsi-s-ga-nv-tsv-i."
        intervals [452]:
            xmin = 616.070
            xmax = 616.070
            text = "021127: Tsi-lu-si-li-mi-no ta-li-ne u-ni-lu-tse-i; u-dv-nv-no--di-ga-la-wi-i-s-di-yi e-do-he-i, gv-wa-lu-tse-le nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi, a-le di-no-we-li-s-gi, a-le di-ni-la-wi-gi,"
        intervals [453]:
            xmin = 616.070
            xmax = 616.070
            text = "021128: A-le hi-a ni-gv-wa-we-se-le-i, Ga-do tsa-li-s-ga-s-do-di hi-a na-s-gi tsi-hna-dv-ne-ha?  A-le ga-go tsa-ne-le na-s-gi hi-a i-tsa-dv-ne-di-yi?"
        intervals [454]:
            xmin = 616.070
            xmax = 616.070
            text = "021129: Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-le-i, A-yv na-s-gi su-da-le-gi dv-tsv-ya-dv-dv-ni, a-le s-gi-no-hv-si, a-yv-no da-tsv-no-ne-li nu-s-dv a-qua-li-s-ga-s-do-dv hi-a na-s-gi tsi-ni-ga-dv-ne-ha."
        intervals [455]:
            xmin = 616.070
            xmax = 616.070
            text = "021130: Tsa-ni tsi-da-da-wo-s-gv-gi, ga-lv-la-s-go tsu-da-le-ne-i, yv-wi-quo-ge a-ne-hv-i?  S-gi-no-hv-si."
        intervals [456]:
            xmin = 616.070
            xmax = 616.070
            text = "021131: U-nv-sv-no ge-sv u-na-li-no-he-le-i, hi-a nu-ni-we-se-i, I-yu-no ga-lv-la-di nv-da-yu-da-le-nv-hi yi-ga-dv-nv, hi-a yi-ni-ga-wi, Ga-do-no tla yi-e-tso-i-yu-ne-i?"
        intervals [457]:
            xmin = 616.070
            xmax = 616.070
            text = "021132: I-yu-no yv-wi-quo a-ne-hv yi-ga-dv-nv,^na-s-gi da-ni-s-ga-i-he yv-wi; ni-ga-dv-ye-no yv-wi a-do-le-ho-s-gi u-do-hi-yu-hi gv-wa-ye-lv-ha Tsa-ni."
        intervals [458]:
            xmin = 616.070
            xmax = 616.070
            text = "021133: U-ni-ne-tsv-no hi-a nu-ni-we-se-le Tsi-sa, V-tla yo-tsi-ga-ta-ha.  Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-le-i, V-tla na-s-quo a-yv yv-da-tsv-no-ne-li i-yu-s-di a-qua-li-s-ga-s-do-dv hi-a na-s-gi tsi-ni-ga-dv-ne-ha."
        intervals [459]:
            xmin = 616.070
            xmax = 616.070
            text = "021201: U-le-nv-he-no du-wo-ne-ta-ne da-tli-lo-s-di-s-gv-i.  Gi-lo i-yu-s-di te-lv-la-di du-wi-se-i, a-le u-so-yi-le gv-wa-du-wi-dv, a-le u-s-go-se gi-ga-ge--a-di-ta-s-di go-tlv-di-yi, a-le u-ne-s-ge-he i-nv i-ga-ti, a-le du-do-la-s-ta-ne tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi, a-le i-nv wu-lo-se-i."
        intervals [460]:
            xmin = 616.070
            xmax = 616.070
            text = "021202: U-nv-ni-s-di-yi-no ge-sv i-yu-i, u-nv-se u-nv-si-da-s-di tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi di-ne-hv-i, na-s-gi tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi nv-da-gv-wa-ne-di-yi u-ne-quo-tsv-hi te-lv-la-di da-wi-sv-i."
        intervals [461]:
            xmin = 616.070
            xmax = 616.070
            text = "021203: I-gv-wa-ni-yv-he-no, a-le i-gv-wa-li-v-ni-le-i, a-le a-sv-ha i-gv-wa-ni-gi-s-ta-ne-i."
        intervals [462]:
            xmin = 616.070
            xmax = 616.070
            text = "021204: Ta-li-ne-no nv-wa-da-le u-nv-si-da-s-di u-nv-se di-ne-hv-i; na-s-gi-no nv-ya-quo do-gv-wa-ni-s-ta-ne-i, a-le i-gv-wa-so-nv-ne a-s-go-li, a-le i-gv-wa-ni-gi-s-ta-ne u-de-ho-hi-s-di i-gv-wa-ne-lv-hi."
        intervals [463]:
            xmin = 616.070
            xmax = 616.070
            text = "021205: Ta-li-ne-no nv-wa-da-le u-nv-se-i; a-le na-s-gi u-ni-le-i; a-le u-ni-tsa-te nv-wa-na-da-le-i; i-ga-dv da-ni-li-v-ni-he-i, i-ga-dv-no da-ni-hi-he-i."
        intervals [464]:
            xmin = 616.070
            xmax = 616.070
            text = "021206: A-si-no sa-quo u-we-tsi e-he-i, u-ge-yu-hi, na-s-gi na-s-quo u-nv-se o-ni-yi di-ne-hv-i, hi-a nu-we-se-i, A-se dv-ni-lv-quo-ta-ni a-que-tsi."
        intervals [465]:
            xmin = 616.070
            xmax = 616.070
            text = "021207: A-se-no na-s-gi na tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi, hi-a ni-du-na-da-we-se-le-i, Hi-a na-s-gi tsu-gv-wa-lo-di wu-ti-ye-li-hi-s-di ge-sv-i;  ka, e-di-lu-ga, tsu-gv-wa-lo-di-no u-ti-ye-di i-ga-tse-li-ga ge-se-s-di."
        intervals [466]:
            xmin = 616.070
            xmax = 616.070
            text = "021208: Gv-wa-ni-yv-hv-no gv-wa-le-i, a-le te-lv-la-di da-wi-sv do-yi-di-tlv wi-gv-wa-da-i-nv-se-i."
        intervals [467]:
            xmin = 616.070
            xmax = 616.070
            text = "021209: Ga-do-no na-s-gi dv-dv-ne-li te-lv-la-di da-wi-sv u-tse-li-ga?  Da-ga-lu-tsi a-le do-dv-dv-ta-ni na-s-gi tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi, a-le nv-wa-na-da-le do-dv-ne-li te-lv-la-di da-wi-sv-i."
        intervals [468]:
            xmin = 616.070
            xmax = 616.070
            text = "021210: Tla-s-go-no yi-tsi-go-li-ye-o hi-a na-s-gi tsi-ni-gv-nv tsi-go-we-la?  Na-s-gi nv-ya, di-na-ne-s-ge-s-gi u-ni-yo-i-se-lv-hi nu-gv-wi-yu-sv u-nv-si-yv a-di nu-li-s-ta-nv;"
        intervals [469]:
            xmin = 616.070
            xmax = 616.070
            text = "021211: Na-s-gi hi-a Yi-ho-wa nu-dv-ne-lv, a-le u-s-qua-ni-go-di-yu de-da-ka-ni-s-gv-i."
        intervals [470]:
            xmin = 616.070
            xmax = 616.070
            text = "021212: U-na-ne-lo-ta-ne-no gv-wa-ni-yv-di-yi, a-se-no u-ni-tsa-ti yv-wi da-ni-s-ga-i-he-i; a-ni-ga-ta-he-ye-no u-nv-sv ge-tsi-dv-gv na-s-gi du-tli-lo-s-ta-nv-i; i-gv-wa-da-nv-e-le-no a-le du-ne-nv-se-i."
        intervals [471]:
            xmin = 616.070
            xmax = 616.070
            text = "021213: Du-ni-nv-se-no wi-gv-wa-lu-tse-di-yi gi-lo i-yu-na-s-di A-ni-qua-li-si a-le E-lo-dv gv-wa-s-de-li-s-gi, u-ni-sa-dv-di-yi u-na-du-li-s-ge ga-wo-ni-s-gv-i."
        intervals [472]:
            xmin = 616.070
            xmax = 616.070
            text = "021214: U-ni-lu-tsv-no, hi-a ni-gv-wa-we-se-le-i, Ta-de-yo-hv-s-gi, o-tsi-ga-ta-ha du-yu-go-dv hi-wo-ni-s-gv ge-sv-i, a-le gi-lo ni-te-na-ye-s-gv-na ge-sv-i; v-tla-ye-no nu-na-s-dv yv-wi yi-te-lv-quo-do-i, U-ne-la-nv-hi-s-gi-ni u-nv-nv u-do-hi-yu-sv de-ha-de-yo-hv-s-go-i; du-yu-go-di-s-go a-ye-li a-na-gu-yi-s-gv Si-sa a-gu-yv-e-di-yi, tla-ge?"
        intervals [473]:
            xmin = 616.070
            xmax = 616.070
            text = "021215: Da-yo-tsi-ni-tsu, tla-ge yv-da-yo-tsi-ni?  A-se-no a-ga-ta-he u-na-tlo-na-s-dv-i, hi-a ni-du-we-se-le-i, Ga-do-no i-s-gi-go-li-ye-ha?  E-s-gi-v-si a-gi-si tsu-gv-wa-lo-di na-s-gi a-gi-go-wa-dv-di-yi."
        intervals [474]:
            xmin = 616.070
            xmax = 616.070
            text = "021216: U-ni-yo-le-no.  Hi-a-no ni-du-we-se-le-i, Ga-go hi-a da-ga-tli-lo-s-di, a-le ga-go a-tsi-no-he-ha hi-a tsi-ga-we-la?  Si-sa, i-gv-wo-se-le-i."
        intervals [475]:
            xmin = 616.070
            xmax = 616.070
            text = "021217: Tsi-sa-no u-ne-tli hi-a ni-su-we-se-le-i, Si-sa e-tsa-gu-yv-si Si-sa u-tse-li-ga, U-ne-la-nv-hi-no U-ne-la-nv-hi u-tse-li-ga.  I-gv-wa-s-qua-ni-go-se-le-no."
        intervals [476]:
            xmin = 616.070
            xmax = 616.070
            text = "021218: No-qua-le A-ni-sa-du-si i-gv-wa-lu-tse-le-i, na-s-gi a-yo-hu-sv v-tla di-le-hi-so-di yi-gi a-na-di-s-gi; a-le i-gv-wa-dv-dv-ne-i, hi-a nu-ni-we-se-i."
        intervals [477]:
            xmin = 616.070
            xmax = 616.070
            text = "021219: Ta-de-yo-hv-s-gi, Mo-si o-go-we-la-ne-lv-gi hi-a no-gi-we-se-lv-gi, A-na-li-nv-tli gi-lo a-yo-hu-s-ge-s-di, a-le u-da-li-i i-ga-ka-hi-ya-s-ge-s-di, tsu-we-tsi-no ni-di-ga-ka-hi-ya-s-gv-na i-ge-se-s-di, a-na-li-nv-tli a-ya-ni-s-ge-s-di u-da-li-i, a-le na-s-gi a-na-li-nv-tli tsu-we-tsi da-dv-hi-s-da-ne-he-s-di."
        intervals [478]:
            xmin = 616.070
            xmax = 616.070
            text = "021220: Na-s-gi-no ga-li-quo-gi a-na-li-nv-tli a-ne-hv-gi;  i-gv-yi-no e-hi u-de-sv-nv-gi, a-le u-yo-hu-sv-gi tsu-we-tsi na-ne-hv-na."
        intervals [479]:
            xmin = 616.070
            xmax = 616.070
            text = "021221: Ta-li-ne-no we-hi na-s-gi u-da-yv-sv-gi, a-le u-yo-hu-sv-gi; na-s-quo-no na-s-gi v-tla tsu-we-tsi yi-du-we-ka-hi-ye-i; a-le na-s-gi-ya na-s-quo tso-i-ne we-hi."
        intervals [480]:
            xmin = 616.070
            xmax = 616.070
            text = "021222: A-le na-s-gi ga-li-quo-gi i-ya-ni-dv u-na-da-yv-sv-gi, a-le v-tla yi-du-ni-hi-ka-hi-ye tsu-ne-tsi; o-ni-yi-no a-ge-yv na-s-quo u-yo-hu-se-i."
        intervals [481]:
            xmin = 616.070
            xmax = 616.070
            text = "021223: Tsu-ni-yo-hu-sv-hi-no tsu-na-le-hi-so-di ge-sv-i, na-hi-yu na-s-gi hi-a da-na-le-hi-sa-nv-ha, ga-go u-da-li-i ge-se-s-di na-s-gi hi-a?  Ga-li-quo-gi-ye-no i-ya-ni-dv a-na-da-ye-hv-gi."
        intervals [482]:
            xmin = 616.070
            xmax = 616.070
            text = "021224: Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-lv-gi, Tla-s-go yi-tsi-li-da-s-di-ha, yi-nv-di-ga-li-s-do-di-ha ni-tso-li-gv-na ge-sv Go-we-li, a-le U-ne-la-nv-hi u-li-ni-gi-di-yu ge-sv-i?"
        intervals [483]:
            xmin = 616.070
            xmax = 616.070
            text = "021225: Na-hi-yu-ye-no tsu-na-le-hi-so-di ge-sv tsu-ni-yo-hu-sv-hi, v-tla yi-da-na-de-sv-hv-s-go-i, v-tla a-le yi-di-ge-tsi-ye-go-i;  ga-lv-la-di-s-gi-ni a-ne-hi ge-tsi-nv-si-da-s-di nu-na-s-dv na-s-gi-ya nu-na-s-di."
        intervals [484]:
            xmin = 616.070
            xmax = 616.070
            text = "021226: Tsu-ni-yo-hu-sv-hi-no na-s-gi tsu-na-le-hi-so-di ge-sv-i; tla-s-go yi-tsi-go-li-ye-o Mo-si u-tse-li go-we-li-hi, na-s-gi u-we-yo-da-dv U-ne-la-nv-hi u-li-no-he-ta-nv-i, hi-a nu-we-se-lv-i, A-yv A-qua-ne-la-nv-hi E-qua-ha-mi u-tse-li-ga, a-le A-qua-ne-la-nv-hi E-si-gi u-tse-li-ga, a-le A-qua-ne-la-nv-hi Tse-ga-qui u-tse-li-ga."
        intervals [485]:
            xmin = 616.070
            xmax = 616.070
            text = "021227: V-tla tsu-ni-yo-hu-sv-hi u-na-tse-li U-ne-la-nv-hi yi-gi, di-nv-no-dv-s-gi-ni u-na-tse-li U-ne-la-nv-hi; na-s-gi i-yu-s-di u-tsa-ti i-tsi-li-da-s-di-ha."
        intervals [486]:
            xmin = 616.070
            xmax = 616.070
            text = "021228: Di-no-we-li-s-gi-no ge-sv a-si-yv-wi u-lu-tse-lv, u-dv-ga-nv a-na-li-no-he-s-gv-i, a-le u-do-le-ho-sv o-si-yu nu-we-sv du-ne-tse-lv-i, u-dv-dv-ne-i, Ga-do u-s-di u-tli ga-lv-quo-di-yu ni-ga-dv di-ka-hna-wa-dv-s-di ge-sv-i?  U-dv-ne-i."
        intervals [487]:
            xmin = 616.070
            xmax = 616.070
            text = "021229: Tsi-sa u-ne-tse-le hi-a nu-we-se-le-i, U-tli ga-lv-quo-di ni-ga-dv di-ka-hna-wa-dv-s-di ge-sv hi-a na-s-gi; Ha-dv-gv-ga I-si-li; Yi-ho-wa I-ga-ne-la-nv-hi sa-quo-hi-yu Yi-ho-wa;"
        intervals [488]:
            xmin = 616.070
            xmax = 616.070
            text = "021230: A-le hi-ge-yu-se-s-di Yi-ho-wa Tsa-ne-la-nv-hi hv-di-s-ge-s-di ni-gv tsa-na-wi, a-le ni-gv-tsa-da-nv-do, a-le ni-gv tsa-da-nv-te-di-yi, a-le ni-ga-v tsa-li-ni-gv-gv-i.  Hi-a na-s-gi wu-da-go-na-dv-dv ga-lv-quo-di di-ka-hna-wa-dv-s-di."
        intervals [489]:
            xmin = 616.070
            xmax = 616.070
            text = "021231: Ta-li-ne-no ge-sv-i, na-s-gi-ya-quo, hi-a na-s-gi nu-s-di, tsv-sv ni-tsa-da-ge-yu-sv na-s-gi-ya ni-ge-yu-se-s-di na-v i-di-s-da-da-la.  V-tla nv-wa-da-le di-ka-hna-wa-dv-s-di ya-ha u-tli i-ga-lv-quo-di e-s-ga-quo na-s-gi."
        intervals [490]:
            xmin = 616.070
            xmax = 616.070
            text = "021232: Di-go-we-li-s-gi-no hi-a nu-we-se-le-i; Ka, Ta-de-yo-hv-s-gi, du-yu-go-dv ni-wi; sa-quo-quo-ye-no e-ha U-ne-la-nv-hi; v-tla a-le nv-wa-da-le ye-ha na-s-gi u-wa-sv-hi-yu;"
        intervals [491]:
            xmin = 616.070
            xmax = 616.070
            text = "021233: Na-s-gi-no a-ge-yu-di-yi gv-do-di-yi ni-gv o-na-wi-yi, a-le ni-gv a-da-nv-te-di-yi, a-le ni-gv a-da-nv-do, a-le ni-ga-v no-li-ni-gv-gv-i, a-le na-v i-yu-na-da-la u-wa-sv u-da-ge-yu-sv na-s-gi-ya u-ge-yu-di-yi, u-tli ga-lv-quo-di-yu e-s-ga-quo ni-ga-dv di-gv-wa-no-s-dv a-tsi-lv di-ge-la-s-do-di, a-le a-li-s-go-lv-do-di."
        intervals [492]:
            xmin = 616.070
            xmax = 616.070
            text = "021234: Tsi-sa-no u-go-hv a-ga-ta-hna-i i-yu-we-s-di nu-we-sv u-ne-tsv-i, hi-a nu-we-se-le-i, V-tla i-nv-hi-yu yi-ni-tsa-dv-hna-de-ga U-ne-la-nv-hi u-tse-li-go-hi ge-sv-i.  Na-hi-yu-no i-yu-da-le-nv-dv v-tla gi-lo go-hu-s-di gv-wa-dv-dv-di yi-ge-se-i."
        intervals [493]:
            xmin = 616.070
            xmax = 616.070
            text = "021235: Tsi-sa-no u-ne-tsv da-de-yo-hv-s-gv u-dv-nv-di-ga-la-wi-i-s-di-yi, hi-a nu-we-se-i; Ga-do-no di-no-we-li-s-gi Ga-lo-ne-dv De-wi u-we-tsi, tsa-na-di-s-go-i?"
        intervals [494]:
            xmin = 616.070
            xmax = 616.070
            text = "021236: De-wi-ye-no u-wa-sv Ga-lv-quo-di-yu A-da-nv-do u-we-yo-hv-s-gv hi-a nu-we-se-i, Yi-ho-wa hi-a nu-we-se-le a-qua-tse-li U-gv-wi-yu-hi, Tsi-ga-ti-si i-di-tlv tso-le-s-di gv-ni ge-tsa-s-ga-gi di-tsa-la-si-di-yi ga-s-gi-lo ni-ga-tsi-yv-ne-lv-ha."
        intervals [495]:
            xmin = 616.070
            xmax = 616.070
            text = "021237: De-wi-ye-no u-wa-sv U-gv-wi-yu-hi i-go-se-ha; ga-do-no di-ga-le-s-do-di-ha u-we-tsi i-gi?  U-ni-tsa-ti-no yv-wi u-na-li-he-li-tsv-hi gv-wa-dv-da-ne-le-i."
        intervals [496]:
            xmin = 616.070
            xmax = 616.070
            text = "021238: Hi-a-no ni-du-we-se-le da-de-yo-hv-s-gv-i, De-tse-ya-do-tse-he-s-di di-no-we-li-s-gi o-si-yu tsu-ni-ye-lv di-ga-nv-hi-dv tsu-na-nu-wa-i u-ne-da-s-di-yi, a-le ge-tsi-yo-li-s-di-yi di-ga-no-do-di-yi,"
        intervals [497]:
            xmin = 616.070
            xmax = 616.070
            text = "021239: A-le nu-gv-wi-yu-sv de-ga-s-gi-lv di-ga-la-wi-i-s-di-yi, a-le nu-gv-wi-yu-sv tsu-na-ni-tlv-di-yi da-na-li-s-da-yv-hv-gv-i;"
        intervals [498]:
            xmin = 616.070
            xmax = 616.070
            text = "021240: Na-s-gi tsi-da-ni-sv-ne-ho tsu-no-su-lo-tsv-hi da-ni-ne-lv-i, a-le u-na-tlo-na-s-dv go-hi-di-yu tsa-na-da-do-li-s-di-s-go-i; hi-a na-s-gi u-tli i-ga-i u-ni-gi-li-yo-i-s-di di-ge-gu-go-da-ne-di ge-se-s-di."
        intervals [499]:
            xmin = 616.070
            xmax = 616.070
            text = "021241: Tsi-sa-no u-wo-le a-de-lv--di-di-yi tsu-yu-go-di, a-le u-go-he na-na-dv-ne-hv yv-wi a-de-lv da-ni-hv-s-gv a-de-lv--di-di-yi; u-ni-tsa-ti-no tsu-ne-hna-i u-tsa-ti da-ni-hv-s-ge-i."
        intervals [500]:
            xmin = 616.070
            xmax = 616.070
            text = "021242: Gi-lo-no i-yu-s-di u-yo i-yu-dv-hna-de-gi u-wo-su-lo-tsv-hi u-lu-tsv, ta-li a-gi-nu-dv-di i-ya-da-nv-te-di u-ne-i, na-s-gi a-ye-li i-ya-da-nv-te-di i-ga-i tsi-gi."
        intervals [501]:
            xmin = 616.070
            xmax = 616.070
            text = "021243: Wi-du-ya-nv-hv-no gv-wa-s-da-wa-di-do-hi, hi-a ni-du-we-se-le-i, U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, Hi-a na-s-gi u-yo i-yu-dv-hna-de-gi u-wo-su-lo-tsv-hi u-tli i-ga-i a-hv-ga e-s-ga-quo ni-ga-dv na-s-gi a-de-lv--di-di-yi tsa-ni-hv-ga."
        intervals [502]:
            xmin = 616.070
            xmax = 616.070
            text = "021244: Ni-ga-dv-ye-no u-tsa-ti u-ni-hv u-no-tsa-le-dv a-ni-hv-ga; na-s-gi-s-gi-ni--u-ni-gi-dv ge-sv a-hv-ga ni-ga-dv u-hv-i, ni-ga-dv u-li-s-de-lv-do-di u-hv-i."
        intervals [503]:
            xmin = 616.070
            xmax = 616.070
            text = "021301: Ga-nu-go-he-no u-dv-nv--di-ga-la-wi-i-s-di-yi, a-si-yv-wi na-s-gi gv-wa-s-da-wa-di-do-hi hi-a nu-we-se-le-i, Ta-de-yo-hv-s-gi, gv-ni-yu-quo na ni-de-u-s-di nv-ya a-le ni-de-u-s-di da-da-ne--lv-i?"
        intervals [504]:
            xmin = 616.070
            xmax = 616.070
            text = "021302: Tsi-sa-no u-ne-tsv hi-a nu-we-se-le-i, De-hi-go-wa-di-s-go hi-a na-s-gi tse-qua da-da-ne-lv-i?  V-tla sa-quo nv-ya ka-no-hi-yv-hi yi-ge-se-s-di yi-du-da-sa-tla-he-s-di, na-s-gi ni-go-hv-ta-nv-na yi-ge-se-s-di."
        intervals [505]:
            xmin = 616.070
            xmax = 616.070
            text = "021303: O-li-wa-yo-no u-sa-hi-lv u-wo-lv-i, u-dv-nv-di-ga-la-wi-i-s-di-yi a-da-ne-lv tsu-yu-go-di, Qui-da, a-le Tsi-mi, a-le Tsa-ni, a-le E-ni-di, u-nv-sv ge-sv gv-wa-dv-dv-ne-i, hi-a nu-ni-we-se-i,"
        intervals [506]:
            xmin = 616.070
            xmax = 616.070
            text = "021304: S-gi-no-hv-si, i-la-gi-yu na-s-gi hi-a nv-da-ga-li-s-ta-ni?  A-le ga-do u-ye-lv-dv ge-se-s-di na-hi-yu hi-a na-s-gi ni-ga-dv u-li-ye-i-lo-hi-s-di ge-sv-i?"
        intervals [507]:
            xmin = 616.070
            xmax = 616.070
            text = "021305: Tsi-sa-no du-ne-tse-lv, u-le-nv-he hi-a nu-we-se-i, I-tse-ya-ta-he-s-di, tle-s-di gi-lo tsi-tsi-lo-nu-he-li."
        intervals [508]:
            xmin = 616.070
            xmax = 616.070
            text = "021306: U-ni-tsa-te-s-di-ye-no a-yv da-qua-do-s-dv a-ni-lu-hi-s-di-s-ge-s-di, hi-a na-ni-we-s-ge-s-di, a-yv na-s-gi; a-le u-ni-tsa-te-s-di da-ni-lo-nu-he-s-ge-s-di."
        intervals [509]:
            xmin = 616.070
            xmax = 616.070
            text = "021307: I-tsa-dv-gi-s-ge-s-di-no da-nv-wa, a-le a-ni-no-he-li-do-hv da-nv-wa, tle-s-di yi-tsa-de-ya-ta-ne-he-s-di; na-s-gi-ye-no a-se i-yu-li-s-do-di; u-li-s-qua-di-s-di-yi-s-gi-ni ge-sv a-si ge-se-s-di."
        intervals [510]:
            xmin = 616.070
            xmax = 616.070
            text = "021308: Tsu-na-da-le-dv-ye-no yv-wi do-dv-na-le-ni do-dv-na-da-tlu-ta-ni, a-le a-ye-li de-go-tlv-wa-di-sv do-dv-na-da-tlu-ta-ni; a-le ga-do-hi da-li-te-lv-ni-do-he-s-di, a-le da-go-nu-lo-si-do-he-s-di a-le u-de-ya-do-di ni-ga-li-s-ta-ni-do-he-s-di; hi-a na-s-gi a-da-le-ni-s-gv a-gi-li-ya."
        intervals [511]:
            xmin = 616.070
            xmax = 616.070
            text = "021309: A-di-na i-tse-ya-ta-he-s-di; da-ni-la-wi-v-ye-no de-ge-tsi-yo-s-ge-s-di; tsu-ni-ta-wi-i-s-di-yi-no de-tsi-li-v-ni-he-s-di; a-le nu-ni-gv-wi-yu-sa-de-gi a-le u-ni-gv-wi-yu-hi a-ni-nv tse-tsa-te-no-hi-s-di ge-se-s-di a-yv ge-sv nv-di-ga-li-s-do-di-s-ge-s-di, na-s-gi go-hi-yu-di-s-gi tsu-ni-ga-ti-le-gi."
        intervals [512]:
            xmin = 616.070
            xmax = 616.070
            text = "021310: O-s-dv-no ka-no-he-dv i-gv-yi ni-gv-na-dv tsu-ne-wa-di-sv yv-wi a-li-tsi-do-di ge-se-s-di."
        intervals [513]:
            xmin = 616.070
            xmax = 616.070
            text = "021311: A-le hna-quo de-tsa-ti-ne-ge-s-di, a-le de-tsi-yo-s-ge-s-di, tle-s-di i-gv-yi ga-ye-hi yi-tse-li-hi-s-ge-s-di i-tsi-we-s-di-yi i-tsi-ne-i-s-di-yi, a-le tle-s-di i-gv-yi ga-ye-hi yi-tsa-da-nv-te-s-ge-s-di; nu-s-dv-s-gi-ni wi-hi-yu ge-sv e-tsi-ne-lv na-s-gi i-tsi-ne-ge-s-di; v-tla-ye-no ni-hi yi-tsa-ne-go-i, Ga-lv-quo-di-yu-s-gi-ni A-da-nv-do."
        intervals [514]:
            xmin = 616.070
            xmax = 616.070
            text = "021312: A-na-li-nv-tli-no du-yo-s-ge-s-di a-na-li-nv-tli u-yo-hu-hi-hi-s-di-yi; a-s-ga-ya-no u-we-tsi du-yo-s-ge-s-di; a-le di-ge-ga-nv-gi da-na-le-hv-s-ge-s-di tsu-ni-ga-yv-li-ge da-na-tlu-di-s-ge-s-di, a-le na-s-gi na-nv-ni-si-s-ge-s-di de-ge-tsi-i-he-s-di."
        intervals [515]:
            xmin = 616.070
            xmax = 616.070
            text = "021313: A-le ni-ga-di-yu yv-wi ge-tsi-s-ga-gi ge-se-s-di a-yv tsu-qua-do-v nv-di-ga-li-s-do-di-s-ge-s-di; gi-lo-s-gi-ni gv-li-s-qua-di-s-gi di-ka-hna-wa-de-gi, na-s-gi a-tsi-s-de-lv-di ge-se-s-di."
        intervals [516]:
            xmin = 616.070
            xmax = 616.070
            text = "021314: I-tsi-go-wa-ti-s-ge-s-di-s-gi-ni u-s-ga-i-s-di a-dv-di-s-gi De-ni-li a-do-le-ho-s-gi u-ne-i-s-ta-nv-hi, ga-do-ge-s-di na-hna gv-wa-le-di ni-ge-sv-na, (gi-lo a-go-li-ye-s-ge-s-di go-li-ge-s-di,) hna-quo Tsu-di-yi a-ni-ni a-na-li-sv-ha do-tso-da-lv wa-ni-lo-sv-ha."
        intervals [517]:
            xmin = 616.070
            xmax = 616.070
            text = "021315: A-le gi-lo ga-sa-na-li u-gi-le-s-di, tle-s-di yv-di-tlo-a-s-ge-s-di a-da-ne-lv wi-ya-yv-hi-he-s-di, a-le tle-s-di na-hna wi-ya-yv-hi-he-s-di wu-gi-s-di-yi go-hu-s-di u-hna-v ga-ne-lv-i."
        intervals [518]:
            xmin = 616.070
            xmax = 616.070
            text = "021316: A-le gi-lo tlo-ge-si e-do-hi tle-s-di yv-di-u-tsv-se-s-di u-nu-wo yu-ne-so-le-s-di."
        intervals [519]:
            xmin = 616.070
            xmax = 616.070
            text = "021317: A-le u-yo-i-yu i-yu-na-li-s-da-ne-di di-ni-ne-li-dv, a-le tsu-ni-s-da-i na-hi-yu ge-se-s-di."
        intervals [520]:
            xmin = 616.070
            xmax = 616.070
            text = "021318: A-le i-tsa-da-do-li-s-di-s-ge-s-di i-tsi-ta-yo-hi-he-s-di go-la i-tsa-li-s-di-yi ni-ge-sv-na i-yu-li-s-do-di-yi."
        intervals [521]:
            xmin = 616.070
            xmax = 616.070
            text = "021319: Na-hi-yu-ye-no ge-se-s-di a-gi-li-ya e-he-s-di, na-s-gi go-tlv-nv-i na-s-gi U-ne-la-nv-hi tsu-wo-tlv-ne nv-da-gv-wa-da-le-nv-dv go-hi i-ya-s-di v-tla na-s-gi i-yu-s-di yu-de-no-i, v-tla a-le u-de-di yi-ge-se-s-di."
        intervals [522]:
            xmin = 616.070
            xmax = 616.070
            text = "021320: A-le U-gv-wi-yu-hi ni-du-go-la-dv-na yi-ge-se na-hi-yu i-ga, v-tla u-que-da-li yi-ga-ye-tsi-s-de-lv-he-i; ge-ga-su-ye-dv-s-gi-ni nv-di-ga-li-s-do-di-ha, na-s-gi tsu-su-ye-dv ge-sv-i, na-s-gi du-go-la-dv na-hi-yu i-ga."
        intervals [523]:
            xmin = 616.070
            xmax = 616.070
            text = "021321: Hna-quo-no i-yu gi-lo hi-a ni-tsi-we-se-lv-ha, Gv-ni-yu-quo a-ni Ga-lo-ne-dv; a-le gv-ni-yu-quo na-hna-ni; tle-s-di i-tso-i-yu-nv-gi;"
        intervals [524]:
            xmin = 616.070
            xmax = 616.070
            text = "021322: Ga-lo-ne-dv-ye-no u-na-tse-lv-hi a-le a-na-do-le-ho-s-gi u-na-tse-lv-hi dv-ni-na-nu-go-tsi, a-le a-ni-na-nu-go-wi-s-ge-s-di u-ye-lv-dv a-le u-s-qua-ni-go-di, na-s-gi tsu-ni-lo-nu-he-di-yi, i-yu-no ye-li yi-gi, na-s-quo ge-ga-su-ye-dv."
        intervals [525]:
            xmin = 616.070
            xmax = 616.070
            text = "021323: Ni-hi-s-gi-ni i-tse-ya-ta-he-s-di; gv-ni-yu-quo ni-ga-dv ni-tsv-no-ne-lv."
        intervals [526]:
            xmin = 616.070
            xmax = 616.070
            text = "021324: Na-hi-yu-s-gi-ni ge-se-s-di, u-lo-so-ne-s-di na-s-gi a-gi-li-ya, nv-do i-ga e-hi dv-li-si-hv-si, a-le nv-do sv-no-yi e-hi v-tla i-ga yu-te-s-de-di;"
        intervals [527]:
            xmin = 616.070
            xmax = 616.070
            text = "021325: A-le no-qui-si a-ni-ka-lv ga-lv-lo-i a-ni-nv-go-a-s-ge-s-di, a-le u-ni-tsa-te ga-lv-lo tsa-ni-ka-la dv-na-li-te-lv-ni."
        intervals [528]:
            xmin = 616.070
            xmax = 616.070
            text = "021326: Hna-quo-no dv-ni-go-hi yv-wi U-we-tsi tsa-i-se-s-di u-lo-gi-lv-i, u-nu-wo-s-de-s-di u-tsa-ti u-li-ni-gi-di-yu ge-sv a-le ga-lv-quo-di-yu ge-sv-i."
        intervals [529]:
            xmin = 616.070
            xmax = 616.070
            text = "021327: Hna-quo-no do-da-ga-nv-si tsu-tse-li di-ni-ka-hna-wa-di-do-hi, a-le do-da-ga-tli-sa-ni ge-ga-su-ye-dv tsu-tse-li-ga wi-do-dv-ya-nv-hi nv-gi ni-do-di-ga-lo-s-gv u-no-le, e-lo-hi wu-li-s-ti-ni-lv nv-da-yu-da-le-nv-dv ga-lv-lo-no wu-li-s-ti-ni-lv wi-ga-lu-gi."
        intervals [530]:
            xmin = 616.070
            xmax = 616.070
            text = "021328: I-tsa-de-lo-qua-no sv-ga-ta--i-yu-s-di tlu-gv da-tli-lo-s-dv-i;  U-wa-ni-ga-lv hna-quo u-da-ge ni-ga-li-s-da, a-le tsi-ga-li-s-du-hv-s-go-i, i-tsi-ga-ta-ho go-gi na-v-ni-yu ge-sv-i;"
        intervals [531]:
            xmin = 616.070
            xmax = 616.070
            text = "021329: Na-s-gi-ya na-s-quo ni-hi, hna-quo i-tsi-go-wa-ti-s-ge-s-di hi-a na-s-gi ni-ga-li-s-ta-ni-do-hv-i, i-tsi-ga-ta-he-s-di na-v-ni-yu ge-sv-i, ga-lo-hi-s-di-yi-quo ge-sv-i."
        intervals [532]:
            xmin = 616.070
            xmax = 616.070
            text = "021330: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-he, hi-a na-s-gi go-hi tsa-ne-ha v-tla yv-dv-ni-lo-so-ni gv-ni hi-a na-s-gi ni-ga-di-yu ni-ga-li-s-ta-nv-ha."
        intervals [533]:
            xmin = 616.070
            xmax = 616.070
            text = "021331: Ga-lv-lo a-le e-lo-hi dv-ni-lo-so-ni; a-yv-s-gi-ni a-gi-ne-tsv v-tla yv-da-ga-lo-so-ni."
        intervals [534]:
            xmin = 616.070
            xmax = 616.070
            text = "021332: Na-hi-yu-s-gi-ni i-ga ge-sv a-le i-yu ka-la-wa-di-sv v-tla gi-lo ya-ga-ta-ha, v-tla na-s-quo di-ni-ka-hna-wa-di-do-hi ga-lv-la-di a-ne-hi, tla na-quo-no U-we-tsi, a-ga-yv-li-ge-s-gi-ni u-wa-sv."
        intervals [535]:
            xmin = 616.070
            xmax = 616.070
            text = "021333: I-tse-ya-ta-he-s-di, i-tsi-ya-wi-s-ge-s-di a-le i-tsa-da-do-li-s-di-s-ge-s-di; v-tla-ye-no yi-tsi-ga-ta-ha i-yu ge-sv-i."
        intervals [536]:
            xmin = 616.070
            xmax = 616.070
            text = "021334: [Yv-wi-ye-no U-we-tsi] na-s-gi-ya-quo a-s-ga-ya tsa-ni-gi-s-go i-lv-hi-tlv tse-go-i, na-s-gi tsi-gv-de-go ga-ne-lv-i, a-le a-ni-ga-ti-ya tsi-ni-de-gv-ne-ho tsu-nv-si-da-s-di, a-le a-ni-si-yv-wi-ha tsu-ni lv-wi-s-da-ne-di tsi-da-ne-ho-i, a-le ga-lo-hi-s-di-yi a-ga-ti-ya tsi-ka-ne-tse-ho u-ya-wi-di-yi."
        intervals [537]:
            xmin = 616.070
            xmax = 616.070
            text = "021335: Na-s-gi i-yu-s-di i-tsi-ya-wi-s-ge-s-di; v-tla-ye-no yi-tsi-ga-ta-ha i-yu-quo u-lu-hi-s-di-yi ga-ne-la, u-sv-i, a-le sv-no-yi a-ye-li, a-le tsa-ta-ga a-ni-yv-gv-i, a-le su-na-le-i;"
        intervals [538]:
            xmin = 616.070
            xmax = 616.070
            text = "021336: Yi-ga-lu-gi-ye-no ya-ye-lo-i-s-da, yv-tsi-wa-dv-da i-tsi-li-na-v-i."
        intervals [539]:
            xmin = 616.070
            xmax = 616.070
            text = "021337: Na-s-gi-no hi-a ni-hi tsi-ni-tsv-we-se-ha, na-s-gi ni-ga-dv-quo ni-ga-tsi-we-se-ha--I-tsi-ya-wi-s-ge-s-di."
        intervals [540]:
            xmin = 616.070
            xmax = 616.070
            text = "021401: Ta-li-no wi-nu-sv-lv ka-no-hi-yv-gi di-li-s-da-yv-di-yi a-le na-go-ta-nv-na ga-du a-gi-s-di-yi u-s-qua-lv-di ge-se-i, nu-ni-gv-wi-sv-no a-tsi-lv-a-ne-lo-hi a-le di-no-we-li-s-gi u-ni-yo-le i-yu-na-dv-ne-di-yi ga-lo-nu-he-dv u-nv-do-di-yi u-ni-ni-yv-di-yi, a-le u-ni-hi-s-di-yi."
        intervals [541]:
            xmin = 616.070
            xmax = 616.070
            text = "021402: A-se-no v-tle-s-di di-li-s-da-yv-di-yi i-yu i-ga ge-sv-i, ya-na-li-de-lv-hv-ga-ye-no yv-wi, u-na-dv-ne-i."
        intervals [542]:
            xmin = 616.070
            xmax = 616.070
            text = "021403: Que-di-ni-yi-no e-do-he-i, Aa-wa-ni a-da-ye-s-gi u-tlv-tsv-hi ga-ne-lv-i, ga-nv-ge-no a-li-s-da-yv-hv-s-ge-i, a-ge-yv u-lu-tse a-ye-he gu-gu nv-ya u-ne-gv go-tlv-ta-nv-hi a-tli-s-de a-tlo-ne-di na-da tsu-do-i-dv, u-tsa-ti tsu-gv-wa-lo-di; a-le u-lo-sv gu-gu, a-le u-lo-ne-ta-ne a-s-go-li."
        intervals [543]:
            xmin = 616.070
            xmax = 616.070
            text = "021404: Gi-lo-no u-na-da-su-ye u-nv-yu-tse do-tsu-na-da-nv-dv-i, a-le hi-a nu-ni-we-se-i, Ga-do-no hi-a a-tse-wo-gi a-tlo-ne-di?"
        intervals [544]:
            xmin = 616.070
            xmax = 616.070
            text = "021405: Yu-ni-na-di-nv-se-ye-no na-s-gi hi-a a-tlo-ne-di tso-i-tsu-qui a-ni-gi-si tsu-na-gv-wa-lo-di u-lo-sv-s-di yi-du-li-gv-wa-la-ne-i, a-le u-yo i-yu-na-dv-hna-de-gi di-gv-ne-di yi-ge-se-i.  A-le gv-wa-go-ne-lo-hi-se-le-i."
        intervals [545]:
            xmin = 616.070
            xmax = 616.070
            text = "021406: Tsi-sa-no hi-a nu-we-se-i, U-ne-la-gi; ga-do-no i-e-tsa-de-ya-do-di-ha?  O-si-yu de-u-lv-wi-s-da-si tsi-na-quv-ga."
        intervals [546]:
            xmin = 616.070
            xmax = 616.070
            text = "021407: U-yo-ye-no i-yu-na-dv-hna-de-gi ni-go-hi-lv ge-tse-la-di-do-ha, a-le i-yu-quo i-tse-li-s-gv-i o-s-dv yi-ni-de-tsa-dv-ni-si; a-yv-s-gi-ni v-tla ni-go-hi-lv yi-tsv-ye-la-di-do-ha."
        intervals [547]:
            xmin = 616.070
            xmax = 616.070
            text = "021408: Ni-ga-v i-gv-wa-dv-ne-di ge-sv na-dv-ga; i-gv-yi ga-ye-hi ga-lu-gi u-lo-ne-di-yi tsi-ye-le v-gi-ni-so-di-yi u-gv-wa-li."
        intervals [548]:
            xmin = 616.070
            xmax = 616.070
            text = "021409: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, I-lv-hi-tlv hi-a na-s-gi o-s-dv ka-no-he-dv a-li-tsi-do-di ni-ga-li-s-di-s-ge-s-di e-lo-hi ni-gv-na-dv-i, hi-a na-s-gi tsi-na-dv-ga na-s-quo u-ni-no-he-di ge-se-s-di na-s-gi a-ga-nv-da-di-s-do-di."
        intervals [549]:
            xmin = 616.070
            xmax = 616.070
            text = "021410: Tsu-da-si-no I-ya-ga-la-di, a-si-yv-wi na-s-gi ta-la-du i-ya-ni-dv ge-sv-i, u-we-nv-se nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi di-ni-nv-i, na-s-gi tsu-yo-hi-se-di-yi."
        intervals [550]:
            xmin = 616.070
            xmax = 616.070
            text = "021411: U-na-dv-ga-nv-no o-si-yu u-ni-ye-lv-ne-i, a-le u-ni-du-i-s-da-ne-le a-de-lv tsu-ni-ne-di-yi.  U-yo-le-no o-s-dv u-dla-nv-da-de-di-yi tsu-yo-hi-se-di-yi."
        intervals [551]:
            xmin = 616.070
            xmax = 616.070
            text = "021412: I-gv-yi-yi-no i-ga na-go-ta-nv-na ga-du a-gi-s-di-yi, na-hi-yu u-ni-lv ka-no-hi-ye-gi di-li-s-da-yv-di-yi, gv-wa-s-da-wa-di-do-hi hi-a ni-gv-wa-we-se-le-i, Ha-tlv tsa-du-li wo-ga-dv-nv-i-s-do-di-yi, ka-no-hi-ye-gi tsa-li-s-da-yv-di-yi?"
        intervals [552]:
            xmin = 616.070
            xmax = 616.070
            text = "021413: Du-nv-se-no a-ni-ta-li gv-wa-s-da-wa-di-do-hi, a-le hi-a ni-du-we-se-le-i, Di-ga-du-hv i-s-de-na, do-da-tsa-tlo-si-no a-s-ga-ya a-ye-he-s-di a-te-li-do a-ma a-tli-s-de-s-di; e-s-di-s-da-wa-de-sv-ha."
        intervals [553]:
            xmin = 616.070
            xmax = 616.070
            text = "021414: I-lv-hi-tlv-no wa-yv-lv-ha, hi-a ne-s-di-we-se-lv-ha a-s-ga-ya ga-ne-la, Di-de-yo-hv-s-gi hi-a ni-ga-we-ha, Ha-tlv a-ne-do-hi u-ni-yv-s-di-yi, na-hna ka-no-hi-ye-gi i-tsu-la-ha o-ga-li-s-da-yv-di-yi gv-gi-s-da-wa-di-do-hi."
        intervals [554]:
            xmin = 616.070
            xmax = 616.070
            text = "021415: Da-s-da-se-he-li-no u-dv-nv ga-lv-la-di ka-nv-su-lv-i, ga-yu-la gv-hna-i, a-le a-dv-nv-i-s-ta-nv-hi; na-hna s-gi-ya-dv-nv-i-s-da-ne-lv-ha."
        intervals [555]:
            xmin = 616.070
            xmax = 616.070
            text = "021416: Gv-wa-s-da-wa-di-do-hi-no u-ne-nv-se a-le di-ga-du-hv wu-ni-lu-tse-i, a-le wu-ni-wa-dv-he na-s-gi-ya ni-du-we-se-lv-i; u-na-dv-nv-i-s-ta-ne-no ka-no-hi-ye-gi di-li-s-da-yv-di-yi."
        intervals [556]:
            xmin = 616.070
            xmax = 616.070
            text = "021417: U-sv-no nu-li-s-ta-nv u-lu-tse da-te-ne-he ta-la-du i-ya-ni-dv."
        intervals [557]:
            xmin = 616.070
            xmax = 616.070
            text = "021418: Na-s-gi-no a-ni-nv-dla-e-i a-le a-na-li-s-da-yv-hv-s-ge-i, tsi-sa hi-a nu-we-se-i, U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, a-si-yv-wi hi-a tsi-ni-tsa-dv-nv i-tsu-la-ha tso-s-da-li-s-da-yv-hv-s-ga, dv-qua-tlu-ta-ni."
        intervals [558]:
            xmin = 616.070
            xmax = 616.070
            text = "021419: U-na-le-nv-he-no u-yo u-ni-ye-lv-ne-i, a-le hi-a ni-gv-wa-we-se-le-i, sa-quo gv-we-sv-dv, Tsi-go a-yv?  Nv-wa-da-le-no, Tsi-go a-yv?  A-di-s-ge-i."
        intervals [559]:
            xmin = 616.070
            xmax = 616.070
            text = "021420: U-ne-tsv-no hi-a ni-du-we-se-le-i, A-si-yv-wi ta-la-du i-tsi-dv ge-sv na-s-gi i-tsu-la-ha a-te-li-do-gi-hi tso-s-da-su-wa-s-ga."
        intervals [560]:
            xmin = 616.070
            xmax = 616.070
            text = "021421: Yv-wi U-we-tsi u-do-hi-yu-hi u-we-nv-s-di na-s-gi-ya ni-gv-nv go-we-lv a-tsi-no-he-s-gv-i; a-se-no u-yo-i-yu i-yu-li-s-da-ne-di na-s-gi a-s-ga-ya yv-wi U-we-tsi a-tlu-di-s-gi!  o-si-yu yi-ge-se i-yu-no na-s-gi a-s-ga-ya nu-de-nv-na-quo yi-ge-se-i."
        intervals [561]:
            xmin = 616.070
            xmax = 616.070
            text = "021422: A-na-li-s-da-yv-hv-s-gv-no Tsi-sa ga-du u-gi-sv, a-le u-li-he-li-tsv, u-gv-ha-lu-ye-i, a-le du-ne-le-i, a-le hi-a nu-we-se-i, I-tsi-gi, i-tsi-ga; hi-a na-s-gi a-yv tsi-ye-lv-i."
        intervals [562]:
            xmin = 616.070
            xmax = 616.070
            text = "021423: A-le u-li-s-qui-di u-gi-sv, a-le u-li-he-li-tsv, na-s-gi du-ne-le-i; ni-ga-dv-no na-s-gi u-na-di-ta-he-i."
        intervals [563]:
            xmin = 616.070
            xmax = 616.070
            text = "021424: Hi-a-no ni-du-we-se-le-i, hi-a na-s-gi a-yv a-gi-gi-gv i-tsv ka-no-he-dv da-tlo-hi-s-dv-i, na-s-gi u-ni-tsa-ti tsi-ge-ga-tse-we-lv."
        intervals [564]:
            xmin = 616.070
            xmax = 616.070
            text = "021425: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, v-tla hna-quo i-lv-hi-yu yv-ga-ga-di-ta te-lv-la-di u-na-nu-go-wi-sv-hi, gv-ni na-hi-yu i-ga i-tse ga-di-ta-hv-ha U-ne-la-nv-hi u-tse-li-go-hi."
        intervals [565]:
            xmin = 616.070
            xmax = 616.070
            text = "021426: Du-ni-no-gi-sv-no, u-ni-nu-go-tse O-li-wa-yo o-da-lv wu-ni-lo-se-i."
        intervals [566]:
            xmin = 616.070
            xmax = 616.070
            text = "021427: Tsi-sa-no hi-a ni-du-we-se-le-i, ni-tsi-v ni-hi do-da-tso-de-li go-hi sv-no-yi tsi-gi, a-yv ge-sv nv-di-ga-li-s-do-di-s-ge-s-di; hi-a-ye-no ni-gv-nv-i-go-we-la, A-wi di-ga-ti-ya da-tsi-yv-ni-li, u-ni-no-de-na-no dv-na-di-ga-le-yo-tsi."
        intervals [567]:
            xmin = 616.070
            xmax = 616.070
            text = "021428: A-se-no hna-quo di-qua-le-nv-hi ge-se-s-di, i-gv-yi da-tsv-ye-nv-e-li Ge-li-li i-yv-dv."
        intervals [568]:
            xmin = 616.070
            xmax = 616.070
            text = "021429: A-se-no Qui-da hi-a nu-we-se-le-i, Na-s-quo ni-ga-dv yi-du-no-de-s-ta-nv, a-yv a-se v-tla."
        intervals [569]:
            xmin = 616.070
            xmax = 616.070
            text = "021430: Tsi-sa-no hi-a nu-we-se-le-i, U-do-hi-yu-hi-ya hi-a ni-gv-we-se-ha, Na-s-gi go-hi i-ga, a-le go-hi-quo sv-no-yi, a-si ta-li-ne na-ni-yv-gv-na tsa-ta-ga, tso-i nv-da-s-qua-da-yi-li."
        intervals [570]:
            xmin = 616.070
            xmax = 616.070
            text = "021431: A-se-no u-tli u-li-ni-gi-dv u-ne-tse hi-a nu-we-se-i, I-yu-no na-s-quo i-tsu-la-ha di-gi-ni-yo-hu-hi-s-di yi-gi, a-se v-tla yv-ga-gv-ya-da-yi-ga.  Na-s-gi-ya na-s-quo nu-ni-we-se ni-ga-dv."
        intervals [571]:
            xmin = 616.070
            xmax = 616.070
            text = "021432: Ge-se-mi-ni-no du-do-v u-ni-lu-tse-i; hi-a-no ni-du-we-se-le gv-wa-s-da-wa-di-do-hi, A-ni i-tsi-ne-s-di, wi-ga-da-do-li-s-di-s-gv i-go-hi-dv."
        intervals [572]:
            xmin = 616.070
            xmax = 616.070
            text = "021433: Du-te-nv-se-no Qui-da a-le Tsi-mi a-le Tsa-ni, a-le u-le-nv-he u-tsa-ti u-de-ya-ta-ne-le-i, a-le u-tsa-ti e-hi-s-di u-da-nv-da-de-i;"
        intervals [573]:
            xmin = 616.070
            xmax = 616.070
            text = "021434: A-le hi-a ni-du-we-se-le-i, A-qua-da-nv-do u-tsa-ti u-de-ya-ta-ne-ha a-yo-hu-hi-s-di na-s-gi-ya-i; a-ni i-tsi-ne-s-di, a-le i-tsi-ya-wi-s-ge-s-di."
        intervals [574]:
            xmin = 616.070
            xmax = 616.070
            text = "021435: U-s-di-gi-dv-no i-yv-dv i-u-we-nv, e-la-di u-da-nv-ne-i, a-le u-da-do-li-s-ta-ne, u-ta-yo-le-i, na-s-gi ye-li i-gv-wa-li-s-do-di yi-gi, na-hi-yu ge-sv u-lo-hi-se-di-yi-quo."
        intervals [575]:
            xmin = 616.070
            xmax = 616.070
            text = "021436: A-le hi-a nu-we-se-i, A-qua, E-do-da, ni-hi, ge-sv ye-li-ga-ya-quo i-ge-tsa-dv-ne-di ni-ga-v-i; s-gi-hv-si-quo hi-a na-s-gi u-li-s-qui-di; v-tla-s-gi-ni-no-nv a-yv a-qua-du-li-s-gv-i, ni-hi-s-gi-ni tsa-du-li-s-gv-i."
        intervals [576]:
            xmin = 616.070
            xmax = 616.070
            text = "021437: I-u-lu-tse-no a-le du-wa-dv-he a-ni-li-na-e-i, a-le hi-a nu-we-se-le Qui-da, Sa-wa-ni, hi-li-ha-quo-tsu?  Tla-s-go su-tli-lo-dv-quo i-go-hi-dv na-s-quo ge-tsa-ya-wi-s-di yi-ge-se-i?"
        intervals [577]:
            xmin = 616.070
            xmax = 616.070
            text = "021438: I-tsi-ya-wi-s-ge-s-di a-le i-tsa-da-do-li-s-di-s-ge-s-di na-s-gi tle-s-di u-da-le-na-s-di-yi wi-tsi-na-nu-go-tsv-gi; A-da-nv-do u-do-hi-yu-hi u-dv-nv-i-s-di, u-que-da-lv-s-gi-ni a-wa-na-ga-la-hi-yu."
        intervals [578]:
            xmin = 616.070
            xmax = 616.070
            text = "021439: Ta-li-ne-no i-yv-dv wu-lo-sv, u-da-do-li-s-ta-ne-i, nu-we-sv na-s-gi-ya wi-nu-we-se-i."
        intervals [579]:
            xmin = 616.070
            xmax = 616.070
            text = "021440: Di-u-lu-tsv-no du-wa-dv-he ta-li-ne a-ni-li-na-e-i, di-ni-ga-do-li-ye-no di-ga-ge-di-yu ge-se-i, v-tla a-le yi-ni-ga-ta-he i-yu-ni-we-s-di-yi u-ni-ne-tse-di-yi."
        intervals [580]:
            xmin = 616.070
            xmax = 616.070
            text = "021441: Tso-i-ne-no wi-du-lu-tse-le-i, a-le hi-a ni-du-we-se-le-i, ge-tsi-li-ne-s-di-quo hna-quo, a-le i-tsa-tsa-we-so-lv-s-da; Hna-quo ga-lo-so-na---hna-quo a-s-qua-lv na-hi-yu ge-sv-i; gv-ni-yu-quo yv-wi U-we-tsi a-ni-s-ga-na de-ge-tsi-yo-hi-si."
        intervals [581]:
            xmin = 616.070
            xmax = 616.070
            text = "021442: Di-tsa-le-hv-ga, i-de-na; gv-ni-yu-quo a-qua-tlu-di-s-gi e-s-ga-ni-yu da-ya-i."
        intervals [582]:
            xmin = 616.070
            xmax = 616.070
            text = "021443: Gi-la-quo-no i-yv-dv a-si-quo ga-we-ni-s-ge-i, tsu-na-lv-go-tse, Tsu-da-si, a-si-yv-wi ta-la-du i-ya-ni-dv ge-sv, da-ti-ne-he u-ni-tsa-ti, a-ye-la-s-di--di-ga-nv-hi-dv a-le a-da di-ni-ne-hi, nv-da-gv-wa-ni-nv-si-dv nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi, a-le di-no-we-li-s-gi, a-le di-ni-la-wi-gi."
        intervals [583]:
            xmin = 616.070
            xmax = 616.070
            text = "021444: U-tlu-di-s-gi-no gv-ni-ge-sv i-tsu-wa-ne-lv-hi ge-se u-na-do-le-ho-hi-s-do-di, hi-a i-yu-we-sv-hi ge-se-i, Gi-lo tsi-ya-du-tsa-la-nv-ha, na-s-gi ge-se-s-di, sv-tsi-ni-yv-hv-ha, e-tsa-ti-na-wi-dv-hv-ha gv-wa-du-da-le-s-di ni-ge-sv-na ne-tsv-ne-s-di."
        intervals [584]:
            xmin = 616.070
            xmax = 616.070
            text = "021445: U-lu-tsv-quo-no gi-la-quo i-yv-dv wu-lu-tse-le-i, a-le hi-a nu-we-se-i, Di-s-que-yo-hv-s-gi, Di-s-que-yo-hv-s-gi; a-le u-du-tsa-la-ne-i."
        intervals [585]:
            xmin = 616.070
            xmax = 616.070
            text = "021446: De-gv-wa-si-ta-de-no, a-le gv-wa-ni-yv-he-i."
        intervals [586]:
            xmin = 616.070
            xmax = 616.070
            text = "021447: A-si-yv-wi-no na-v a-ni-do-hna-i, a-ye-la-s-di--ga-nv-hi-dv u-lv-he-i, a-le nu-gv-wi-yu-sv a-tsi-lv--ge-lo-hi u-nv-si-da-s-di u-lu-ye a-le u-li-s-de-s-ta-ne-i."
        intervals [587]:
            xmin = 616.070
            xmax = 616.070
            text = "021448: Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-le-i, Tsi-go ga-no-s-gi-s-gi tsv-tse-tsi-ni-yv-hi-so na-s-gi-ya i-tsi-lu-gi, di-tsi-ne-hi a-ye-la-s-di--di-ga-nv-hi-dv a-le a-da a-yv s-gi-ni-yv-ho-ga?"
        intervals [588]:
            xmin = 616.070
            xmax = 616.070
            text = "021449: Ni-du-gi-tsv-ni-sv i-tsv-ye-la-di-do-hv-gi u-dv-nv--di-ga-la-wi-i-s-di-yi, de-ga-de-yo-hv-s-gv-gi, a-le v-tla yi-s-gi-ni-yv-he-i; u-do-hi-yu-di-s-gi-ni-no-nv ni-gv-nv Go-we-lv-i."
        intervals [589]:
            xmin = 616.070
            xmax = 616.070
            text = "021450: Ni-ga-di-yu-no gv-wa-de-tso-ne-i, a-le u-na-li-se-i."
        intervals [590]:
            xmin = 616.070
            xmax = 616.070
            text = "021451: Gi-lo-no i-yu-s-di a-wi-nv u-s-da-wa-dv-se-i, do-le-dv a-nu-wo u-da-que-nv-de u-ye-lv-ha ge-sv-i; a-ni-wi-nv-no gv-wa-ni-yv-he-i."
        intervals [591]:
            xmin = 616.070
            xmax = 616.070
            text = "021452: Do-le-dv-no a-nu-wo u-ni-ye-i, a-le u-ye-lv-ha du-li-ti-e-le-i."
        intervals [592]:
            xmin = 616.070
            xmax = 616.070
            text = "021453: Tsi-sa-no nu-gv-wi-yu-sv a-tsi-lv--ge-lo-hi tsu-wo-lv wu-na-ti-nv-s-ta-ne-i; na-s-gi-no de-gv-wa-la-wi-e ni-ga-dv nu-ni-gv-wi-yu-sv a-tsi-lv-a-ne-lo-hi, a-le di-ni-la-wi-gi, a-le di-no-we-li-s-gi."
        intervals [593]:
            xmin = 616.070
            xmax = 616.070
            text = "021454: Qui-da-no ge i-yv-dv u-s-da-wa-di-se-i, na-s-gi nu-gv-wi-yu-sv a-tsi-lv--ge-lo-hi di-ga-ne-lv wu-yv-le-i, u-wo-le-no ge-tsi-nv-si-da-s-di a-ni-nv-i, a-le go-dv u-ga-na-wo-s-ge-i."
        intervals [594]:
            xmin = 616.070
            xmax = 616.070
            text = "021455: Nu-ni-gv-wi-yu-sv-no a-tsi-lv--a-ne-lo-hi a-le ni-ga-dv da-ni-la-wi-v u-ni-yo-he u-ni-no-he-lv-hi Tsi-sa u-tlu-di-s-gi, na-s-gi u-ni-hi-s-di-yi, u-na-tlo-tse-no."
        intervals [595]:
            xmin = 616.070
            xmax = 616.070
            text = "021456: U-ni-tsa-te-ye-no ga-ye-go-gi a-ni-no-he-s-gi gv-wa-tlu-di-s-ge-i, a-se-no a-ni-no-he-s-gv v-tla u-tlo-yi yi-ge-se-i."
        intervals [596]:
            xmin = 616.070
            xmax = 616.070
            text = "021457: Du-na-le-ne-no gi-lo i-yu-na-s-di a-le ga-ye-go-gi u-ni-no-he-le gv-wa-tlu-di-s-gv-i, hi-a na-ni-we-s-ge-i;"
        intervals [597]:
            xmin = 616.070
            xmax = 616.070
            text = "021458: O-ga-dv-ga-nv-gi hi-a ni-ka-we-s-gv-gi, Da-tsi-yo-s-ta-ni hi-a u-dv-nv--di-ga-la-wi-i-s-di-yi, na-s-gi di-go-yi di-gv-ta-nv-hi go-tlv-nv-hi, tso-i-quo-no tsu-sv-hi-dv dv-tsi-yi-li-do-li dv-ga-ne-s-ge-hi nv-wa-da-le di-go-yi di-gv-ta-nv-hi ni-ge-sv-na."
        intervals [598]:
            xmin = 616.070
            xmax = 616.070
            text = "021459: A-se-no na-s-quo na-s-gi u-ni-no-he-lv-hi v-tla u-tlo-yi yi-ge-se-i."
        intervals [599]:
            xmin = 616.070
            xmax = 616.070
            text = "021460: Nu-gv-wi-yu-sv-no a-tsi-lv--ge-lo-hi a-ye-li u-le-nv, u-dv-dv-ne Tsi-sa, hi-a ne-we-se-i, Tla-s-go go-hu-s-di ya-di-ha?  Ga-do na-s-gi hi-a tsa-ni-no-he-ha ge-tsa-tlu-di-s-gv-i?"
        intervals [600]:
            xmin = 616.070
            xmax = 616.070
            text = "021461: A-se-no e-la-we-quo u-wa-se-i, a-le v-tla go-hu-s-di yu-dv-ne tsv-ne-tse-i.  Nu-gv-wi-yu-sv-no a-tsi-lv--ge-lo-hi ta-li-ne u-dv-dv-ne, a-le hi-a nu-we-se-le-i, Ni-hi-s-go Ga-lo-ne-dv, A-tsi-lv-quo-di U-we-tsi?"
        intervals [601]:
            xmin = 616.070
            xmax = 616.070
            text = "021462: Tsi-sa-no hi-a nu-we-se-i, A-yv na-s-gi; a-le da-ye-tsi-go-i yv-wi U-we-tsi u-wo-le-s-di a-ga-ti-si i-di-tlv u-li-ni-gi-dv ge-sv-i, a-le tsa-i-se-s-di u-lo-gi-lv ga-lv-lo-i."
        intervals [602]:
            xmin = 616.070
            xmax = 616.070
            text = "021463: Nu-gv-wi-yu-sv-no a-tsi-lv--ge-lo-hi du-nu-wa-v du-we-tsa-ga-lv-he-i, hi-a nu-we-se-i, Ga-do-no a-si yi-di-ga-du-li a-ni-no-he-s-gi?"
        intervals [603]:
            xmin = 616.070
            xmax = 616.070
            text = "021464: I-tsa-dv-gv-ga a-so-tlv-i-s-di-s-gv-i; ga-do i-tse-li-ha?  ni-ga-dv-no de-gv-wu-go-da-ne-le ye-li-quo gv-wa-yo-hu-hi-s-di ge-sv-i."
        intervals [604]:
            xmin = 616.070
            xmax = 616.070
            text = "021465: I-ga-dv-no u-na-le-nv-he de-gv-wa-li-tsi-s-qua-s-ge-i, a-le u-ka-dv gv-wu-tlv-ne-he-i, a-le a-s-qui-nv de-gv-wa-ni-di-s-ge-i, a-le hi-a ni-gv-wa-we-se-he-i, Ha-do-le-ho-hi; a-le ge-tsi-nv-si-da-s-di de-gv-wa-ni-he-i."
        intervals [605]:
            xmin = 616.070
            xmax = 616.070
            text = "021466: Qui-da-no e-la-di-tlv na-hna a-da-ne-lv e-do-he-i, u-lu-tse a-si-yv-wi a-ge-yv nu-gv-wi-yu-sv a-tsi-lv--ge-lo-hi u-nv-si-da-s-di."
        intervals [606]:
            xmin = 616.070
            xmax = 616.070
            text = "021467: Na-s-gi-no u-go-hv Qui-da u-ga-na-wo-s-gv-i, du-ka-hna-ne-i, a-le hi-a nu-we-se-i, Ni-hi na-s-quo tsi-s-de-do-hv-gi Tsi-sa Na-se-li-di e-hi."
        intervals [607]:
            xmin = 616.070
            xmax = 616.070
            text = "021468: A-se-no u-da-yi-le-i, hi-a nu-we-se-i, V-tla yi-tsi-ga-ta-ha, v-tla a-le yi-go-li-ga ni-we-s-gv-i.  U-nu-go-tse-no do-yi-di-tlv wa-yo-da-tla-hv wu-lo-se-i; tsa-ta-ga-no u-yv-li-se-i."
        intervals [608]:
            xmin = 616.070
            xmax = 616.070
            text = "021469: A-dv-no ta-li-ne u-go-he-i, a-le u-le-nv-he hi-a ni-du-we-se-le na-v a-ni-do-na-i, hi-a na-s-gi na-hna ge-la."
        intervals [609]:
            xmin = 616.070
            xmax = 616.070
            text = "021470: Ta-li-ne-no u-da-yi-le-i.  Ni-go-hi-lv-na-no o-ni na-s-gi na-v a-ni-do-na-i ta-li-ne hi-a nu-ni-we-se-le Qui-da, U-do-hi-yu-hi ni-hi na-hna he-la; Ge-li-li-ye-no he-hi, a-le go-wo-ni-s-gv u-tlo-yi i-gi."
        intervals [610]:
            xmin = 616.070
            xmax = 616.070
            text = "021471: A-se-no u-le-nv-he u-s-gi-nv-de a-le u-se-li-ta-ne hi-a ne-we-se-i, V-tla yi-tsi-ga-ta-ha na a-s-ga-ya na-s-gi tse-tsi-no-he-ha."
        intervals [611]:
            xmin = 616.070
            xmax = 616.070
            text = "021472: Ta-li-ne-no u-yv-li-se tsa-ta-ga.  Qui-da-no u-nv-da-de Tsi-sa nu-we-sv-i, hi-a tsi-nu-we-se-le-i, A-si tsa-ta-ga ta-li nu-yv-la-sv-na ge-se-s-di, tso-i nv-da-s-qua-da-yi-li.  Na-s-gi-no u-da-nv-te-lv du-tlo-yi-le-i."
        intervals [612]:
            xmin = 616.070
            xmax = 616.070
            text = "021501: Gi-la-quo-no i-yv-dv wu-gi-tsv-nv nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi, a-le tsu-na-dv-so-nv-hi, a-le di-no-we-li-s-gi, a-le ni-ga-dv di-ni-la-wi-gi u-na-li-no-he-lv u-na-lv-le Tsi-sa, a-le  u-na-ti-na-wi-dv-he-i, a-le Qua-le-di wi-du-ni-yo-hi-se-le-i."
        intervals [613]:
            xmin = 616.070
            xmax = 616.070
            text = "021502: Qua-le-di-no u-dv-dv-ne hi-a nu-we-se-le-i, Ni-hi-s-go Tsa-gv-wi-yu-hi A-ni-tsu-si u-na-tse-li-ga?  U-ne-tsv-no hi-a nu-we-se-le-i, Ye-li-quo ni-wi."
        intervals [614]:
            xmin = 616.070
            xmax = 616.070
            text = "021503: Nu-ni-gv-wi-yu-sv-no a-tsi-lv--a-ne-lo-hi u-tsa-te tsu-da-le-nv-dv gv-wu-hi-s-di-s-ge-i."
        intervals [615]:
            xmin = 616.070
            xmax = 616.070
            text = "021504: Qua-le-di-no ta-li-ne u-dv-dv-ne hi-a nu-we-se-i; Tla-s-go go-hu-s-di ya-di-ha?  Gv-ni-yu-quo u-tsa-ti tsu-da-le-nv-dv a-ni-no-he-ha ge-tsa-tlu-di-ha."
        intervals [616]:
            xmin = 616.070
            xmax = 616.070
            text = "021505: A-se-no Tsi-sa a-si v-tla go-hu-s-di ya-di-s-ge-i; na-s-gi i-yu-s-di Qua-le-di u-s-qua-ni-go-se-i."
        intervals [617]:
            xmin = 616.070
            xmax = 616.070
            text = "021506: Da-na-li-s-da-yv-hv-s-gv-no i-yu-i da-yo-hi-se-he a-si-yv-wi a-yv-gi, na-s-gi-quo a-ni-ta-yo-ha."
        intervals [618]:
            xmin = 616.070
            xmax = 616.070
            text = "021507: A-si-yv-wi-no e-he Qua-la-qua tsu-do-i-dv na-s-gi i-tsu-la-ha de-ge-ga-lv-e gv-wa-li-go-ne-lv-hi u-na-da-su-ye-dv u-na-li-te-lv-nv-hi, na-s-gi u-na-da-lv-hi ge-se na-hi-yu u-na-da-su-ye-dv u-na-li-te-lv-nv-i."
        intervals [619]:
            xmin = 616.070
            xmax = 616.070
            text = "021508: U-ni-tsa-ti-no a-s-da-ya u-na-li-s-de-i, u-na-le-nv-he u-ni-ta-yo-le na-s-gi-ya ni-du-dv-ne-lv tsu-wa-gu-ta-nv-sv i-tsu-dv-ne-di-yi."
        intervals [620]:
            xmin = 616.070
            xmax = 616.070
            text = "021509: Qua-le-di-no du-ne-tse-le hi-a nu-we-se-i, I-tsa-du-li-s-go U-gv-wi-yu-hi A-ni-tsu-si u-na-tse-li-ga di-yu-yo-hi-se-di-yi."
        intervals [621]:
            xmin = 616.070
            xmax = 616.070
            text = "021510: A-ga-ta-he-ye-no na-s-gi nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-nv-yu-tse-hv-quo nv-di-ga-li-s-do-di-s-gv de-gv-wa-yo-sv-i."
        intervals [622]:
            xmin = 616.070
            xmax = 616.070
            text = "021511: A-se-no nu-ni-gv-yu-sv a-tsi-lv--a-ne-lo-hi nu-nv-ni-sa-ne u-ni-tsa-ti yv-wi, na-s-gi Qua-la-qua u-ni-ta-yo-s-di-yi tsu-yo-hi-se-di-yi."
        intervals [623]:
            xmin = 616.070
            xmax = 616.070
            text = "021512: Qua-le-di-no ta-li-ne u-ne-tsv, hi-a ni-du-we-se-le-i, Ga-do-no i-tsa-du-li tsi-yv-ne-di-yi na-s-gi na U-gv-wi-yu-hi A-ni-tsu-si u-na-tse-li-ga tse-tso-se-ha?"
        intervals [624]:
            xmin = 616.070
            xmax = 616.070
            text = "021513: Ta-li-ne-no u-ne-lu-ne-i hi-ya-dv-v-ga u-na-dv-ne-i."
        intervals [625]:
            xmin = 616.070
            xmax = 616.070
            text = "021514: Qua-le-di-no hi-a ni-du-we-se-le-i, Ga-do-no, ga-do u-s-di u-yo du-lv-wi-s-da-ne-lv?  A-se-no u-tli-quo i-ya-s-da-ya u-ne-lu-ne-i, hi-ya-dv-v-ga, u-na-dv-ne-i."
        intervals [626]:
            xmin = 616.070
            xmax = 616.070
            text = "021515: Qua-le-di-no o-si-yu u-ye-lv-se o-s-dv tsu-da-nv-da-di-s-do-di-yi u-ni-tsa-ti, du-yo-hi-se-le Qua-la-qua, Tsi-sa-no u-li-v-ni-lv du-yo-se a-ga-dv-di-yi."
        intervals [627]:
            xmin = 616.070
            xmax = 616.070
            text = "021516: A-ni-ya-wi-s-gi-no gv-wa-ti-na-wi-dv-he wi-gv-wa-yv-ta-ne u-gv-wi-yu-hi-yi a-da-ne-lv-i na-s-gi u-gv-wi-yu-hi tsa-tsi-la-wi-tse-di-yi, ni-ga-dv-no su-na-da-tlu-gi wi-du-ni-ya-nv-he-i."
        intervals [628]:
            xmin = 616.070
            xmax = 616.070
            text = "021517: Gi-ga-ge-no gv-wa-nu-we-e-i, a-le a-li-s-du-lo tsu-tsa-yo-s-di go-tlv-ta-nv-hi u-ni-s-de-yo-nv, na-s-gi u-ni-s-du-lo-ta-ne-i."
        intervals [629]:
            xmin = 616.070
            xmax = 616.070
            text = "021518: A-le u-na-le-nv-he a-ni-yo-li-he-i, i-tsv-yo-li-ga, Tsa-gv-wi-yu-hi A-ni-tsu-si u-na-tse-li-ga, a-na-di-s-ge-i."
        intervals [630]:
            xmin = 616.070
            xmax = 616.070
            text = "021519: A-s-go-li-no de-gv-wa-ni-he ga-na-s-da gv-di, a-le de-gv-wa-li-tsi-s-qua-s-ge-i, a-le da-na-li-ni-qua-nv-v-s-ge gv-wa-da-do-li-s-da-ne-he-i."
        intervals [631]:
            xmin = 616.070
            xmax = 616.070
            text = "021520: U-na-de-ho-ta-no-nv-no, gv-wa-nu-we-se gi-ga-ge-i, a-le u-wa-sv tsu-nu-wo de-gv-wa-nu-wo-e-i, a-le wi-gv-wa-ti-nv-s-ta-ne gv-wa-dv-di-yi."
        intervals [632]:
            xmin = 616.070
            xmax = 616.070
            text = "021521: Gi-lo-no i-yu-s-di Sa-wa-ni tsu-do-i-dv Sa-li-ni e-hi a-i-se-i, do-di-ga-lo-ge-sv nv-da-yu-lo-sv-hi, na-s-gi E-li-gi a-le Lu-qua-si u-ni-do-da, na-s-gi u-tse-li tsu-da-hna-wa-dv u-we-nv-s-di-yi nu-nv-ne-le-i."
        intervals [633]:
            xmin = 616.070
            xmax = 616.070
            text = "021522: Go-li-ga-da-no du-do-v wi-gv-wa-ti-nv-ta-ne-i, na-s-gi a-ne-tlv-ta-nv-hi ge-sv u-s-qua-lu-go ga-dv-ga."
        intervals [634]:
            xmin = 616.070
            xmax = 616.070
            text = "021523: Gv-wa-ne-ne-le-no u-di-ta-s-di gi-ga-ge-a-di-ta-s-di mi-la a-su-li; a-se-no v-tla yu-ne-gi-se-i."
        intervals [635]:
            xmin = 616.070
            xmax = 616.070
            text = "021524: Hna-quo-no da-da-hna-wa-s-dv gv-wa-dv-nv u-ni-ya-do-le tsu-nu-wo-i, u-na-se-sv-he u-na-do-le-ho-hi-s-di-yi na-s-gi a-ni-si-yv-wi-ha tsu-ni-ne-sv-s-di ge-sv-i."
        intervals [636]:
            xmin = 616.070
            xmax = 616.070
            text = "021525: So-o-ne-la-no i-yu-tli-lo-dv ka-la-wa-di-sv ge-se-i, a-le gv-wa-dv-ne-i."
        intervals [637]:
            xmin = 616.070
            xmax = 616.070
            text = "021526: Ga-lv-la-di-tlv-no go-we-le nu-s-dv a-gu-i-s-dv-i, hi-a ni-gv-ne-i, U-Gv-Wi-Yu-Hi A-Ni-Tsu-Si U-Na-Tse-Li-Ga."
        intervals [638]:
            xmin = 616.070
            xmax = 616.070
            text = "021527: I-tsu-la-ha-no de-ge-ga-dv-ne a-ni-ta-li di-na-da-na-sa-hv-s-gi; a-si-yv-wi a-ga-ti-si-di-tlv, so-i-no a-ga-s-ga-ni i-di-tlv."
        intervals [639]:
            xmin = 616.070
            xmax = 616.070
            text = "021528: Go-we-lv-no u-do-hi-yu-ne-i, hi-a tsi-ni-ga-we-ha, u-ni-s-ga-nv-tsv-hi ge-ga-se-lv a-ga-tlo-ya-s-ta-nv-gi."
        intervals [640]:
            xmin = 616.070
            xmax = 616.070
            text = "021529: A-ni-lo-s-gi-no ga-gv-wa-so-tlv-di-s-ge-i, a-le da-na-li-s-dv-ni-he hi-a na-ni-we-s-ge-i, Yo, u-dv-nv--di-ga-la-wi-i-s-di-yi hi-yo-s-di-s-gi, a-le tso-i-quo-quo i-ga hi-yi-li-do-hi ha-ne-s-ge-s-gi,"
        intervals [641]:
            xmin = 616.070
            xmax = 616.070
            text = "021530: Tsv-sv ha-li-s-de-lv, a-le e-ha-tlo-a-hi da-da-hna-wa-s-dv-i."
        intervals [642]:
            xmin = 616.070
            xmax = 616.070
            text = "021531: Na-s-gi-ya na-s-quo nu-ni-gv-wi-yu-sv a-tsi-lv a-ne-lo-hi a-le di-no-we-li-s-gi gv-wa-de-ho-di-s-gv, hi-a ni-da-na-da-we-se-he-i, Nv-wa-na-da-le da-s-de-li-s-gv-gi; u-wa-sv v-tla yv-gv-li-s-de-lv."
        intervals [643]:
            xmin = 616.070
            xmax = 616.070
            text = "021532: Ga-lo-ne-dv U-gv-wi-yu-hi I-si-li u-na-tse-li-ga hna-quo wa-tlo-a-hi da-da-hna-wa-s-dv-i, na-s-gi o-gi-go-wa-dv-di-yi a-le o-go-hi-yu-di-yi.  A-le na-s-gi i-tsu-la-ha di-ge-ga-dv-nv-hi ga-gv-wa-so-tlv-de-i."
        intervals [644]:
            xmin = 616.070
            xmax = 616.070
            text = "021533: Ta-la-du-no i-yu-tli-lo-dv u-li-ye-i-lo-lv u-li-si-hv-se ni-gv-na-dv na-hna ga-do-hi, tso-i i-yu-tli-lo-dv i-ya-s-ti."
        intervals [645]:
            xmin = 616.070
            xmax = 616.070
            text = "021534: Tso-i-ne i-yu-tli-lo-dv u-li-ye-i-lo-lv Tsi-sa a-s-da-ya u-we-lu-ne-i, hi-a nu-we-se-i, I-lo-i, I-lo-i, la-ma sa-qua-da-ni?  Na-s-gi a-ne-tlv-ta-nv-hi hi-a nu-s-di ga-dv-ga, A-qua-ne-la-nv-hi, A-qua-ne-la-nv-hi, ga-do-no v-s-quv-de-gi?"
        intervals [646]:
            xmin = 616.070
            xmax = 616.070
            text = "021535: I-ga-dv-no na-v a-ni-do-na-i u-na-dv-ga-nv, hi-a nu-ni-we-se-i, Gv-ni-yu-quo, I-la-ya a-ya-ni-ha."
        intervals [647]:
            xmin = 616.070
            xmax = 616.070
            text = "021536: A-se-yv-wi-no du-s-qua-lv-ta-nv, a-le du-wo-li tsu-ni-tso-ya-s-di wu-ka-li-i-s-ta-nv, a-le ga-na-s-do-hi u-we-qua-ta-nv, u-ne-ne-lv u-di-ta-s-di; hi-a nu-we-se-i, U-ne-la-gi, i-da-do-le-ho-hi, tsi-go-no I-la-ya da-ga-lu-tsi da-yu-tlo-v-ta-ni-li."
        intervals [648]:
            xmin = 616.070
            xmax = 616.070
            text = "021537: Tsi-sa-no a-s-da-ya u-we-lu-nv, u-li-s-qua-de-le-i."
        intervals [649]:
            xmin = 616.070
            xmax = 616.070
            text = "021538: A-ye-do-la-dv-di-no u-dv-nv--di-ga-la-wi-i-s-di-yi ga-dv u-da-tsa-ga-lv-he ta-li nu-da-de-i, ga-lv-la-di nv-da-yu-da-le-nv-dv e-la-di wa-s-di."
        intervals [650]:
            xmin = 616.070
            xmax = 616.070
            text = "021539: A-s-go-hi-tsu-qui-no di-ti-ni-do-hi a-i-di-tlv tsu-yu-go-di ga-do-gi, u-do-le-ho-sv na-s-gi u-we-lu-nv-i, a-le u-li-s-qua-de-lv-i, hi-a nu-we-se-i, U-do-hi-yu-hi hi-a a-s-ga-ya U-ne-la-nv-hi U-we-tsi ge-se-i."
        intervals [651]:
            xmin = 616.070
            xmax = 616.070
            text = "021540: A-ni-ge-yv-no na-s-quo ge i-yv-dv do-di-ni-ka-ne-i; na-hna-no a-ne-le Me-li Su-gi-de-li e-hi, a-le Me-li Tsi-mi u-s-di a-le Tso-si u-ni-tsi-i, a-le Sa-lo-mi."
        intervals [652]:
            xmin = 616.070
            xmax = 616.070
            text = "021541: Na-s-gi na-s-quo Ge-li-li tse-do-he gv-wa-s-da-wa-di-do-he a-le gv-wa-s-de-lv-hi-do-he-i; a-le u-ni-tsa-te nv-wa-na-da-le a-ni-ge-yv Tsi-lu-si-li-mi nv-da-gv-wa-s-da-wa-do-lv-hi."
        intervals [653]:
            xmin = 616.070
            xmax = 616.070
            text = "021542: Hna-quo-no u-sv nu-li-s-ta-nv, na-s-gi a-dv-nv-i-s-do-di-yi ge-sv i-yu-s-di, na-s-gi u-na-do-da-qui-de-na i-ga ge-sv-i."
        intervals [654]:
            xmin = 616.070
            xmax = 616.070
            text = "021543: Tso-wa A-li-ma-di-yi e-hi a-tsi-lv-quo-di di-ga-la-wi-gi, na-s-gi na-s-quo a-ga-ti-ye U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv u-lu-hi-s-di-yi, na-s-gi u-lu-tse-i, a-le na-s-ga-i-hv-na wu-yv-le Qua-le-di-yi, a-le u-ta-yo-le Tsi-sa a-ye-lv-i."
        intervals [655]:
            xmin = 616.070
            xmax = 616.070
            text = "021544: Qua-le-di-no u-s-qua-si-go-se u-dla-si-dv-e-he na-tle-gv u-yo-hu-sv-i; wu-ya-nv-hv-no a-s-go-hi-tsu-qui di-ti-ni-do-hi, u-dv-dv-ne, ye-li-s-go go-hi-gi gv-wa-yo-hu-sv-hi, u-dv-ne-i."
        intervals [656]:
            xmin = 616.070
            xmax = 616.070
            text = "021545: Gv-ni-ge-sv-no nu-wa-ne-lv a-s-go-hi-tsu-qui di-ti-ni-do-hi, Tso-wa du-yo-hi-se-le a-ye-lv-i."
        intervals [657]:
            xmin = 616.070
            xmax = 616.070
            text = "021546: U-wa-sv-no u-si-do-li do-le-dv a-nu-wo, a-le u-de-sv a-ye-lv-i, a-le a-nu-wo-gi-hi do-le-dv u-we-tsa-nu-la-nv, a-tse-li-s-dv u-nv-ne na-s-gi nv-yo-hi a-s-go-sv-i, a-le nv-ya u-we-sa-qua-le-le-i a-tse-li-s-dv ga-lo-hi-s-di-yi u-ne-i."
        intervals [658]:
            xmin = 616.070
            xmax = 616.070
            text = "021547: Me-li-no Ma-gi-de-li e-hi, a-le Me-li Tso-si u-tsi u-ni-go-he na-hna u-ni-nv-nv-i."
        intervals [659]:
            xmin = 616.070
            xmax = 616.070
            text = "021601: U-na-do-da-qua-s-gv-no u-lo-so-nv, Me-li Ma-gi-de-li e-hi, a-le Me-li Tsi-mi u-tsi a-le Sa-lo-mi u-ni-wa-sv-hi ge-se u-ga-na-s-dv ga-wa-sv-gi, u-ni-lu-hi-s-di-yi u-ni-ye-lv-se a-le gv-wa-lo-ne-di-yi."
        intervals [660]:
            xmin = 616.070
            xmax = 616.070
            text = "021602: Su-na-le-i-yu-no i-gv-yi-yi i-ga su-na-do-da-qua-s-di ge-sv-i, u-ni-lu-tse a-tse-li-s-dv tsv-di-ka-lv-go-quo."
        intervals [661]:
            xmin = 616.070
            xmax = 616.070
            text = "021603: Hi-a-no ni-du-na-da-we-se-le-i, Ga-go da-gi-hv-e-li nv-ya a-tse-li-s-dv ga-lo-hi-s-di-yi a-hv-i?"
        intervals [662]:
            xmin = 616.070
            xmax = 616.070
            text = "021604: Wi-du-na-ka-hna-nv-no u-ni-go-he nv-ya a-hv-dv ge-sv-i, u-tsa-ti-ye-no e-quo-hi-yu ge-se-i."
        intervals [663]:
            xmin = 616.070
            xmax = 616.070
            text = "021605: Wu-ni-yv-lv-no a-tse-li-s-dv-i, u-ni-go-he a-wi-yv a-ga-ti-si-di-tlv u-wo-le-i, u-nu-we ga-nv-hi-dv u-ne-gv a-nu-wo; a-ni-s-ga-i-he-no."
        intervals [664]:
            xmin = 616.070
            xmax = 616.070
            text = "021606: Hi-a-no ni-du-we-se-le-i, Tle-s-di yi-tsi-s-ga-i-he-s-di; Tsi-sa Na-se-li-di e-hi e-tsi-yo-ha, na-s-gi tsa-ga-dv-v-s-gv-gi; du-le-hi-sa-nv; v-tla a-ni yi-ga-nv; di-tsa-ka-nv-ga a  u-ni-nv-nv-i."
        intervals [665]:
            xmin = 616.070
            xmax = 616.070
            text = "021607: A-se-no tsi-tse-na, a-le wi-di-tsi-no-hv-si gv-wa-s-da-wa-di-do-hi a-le Qui-da na-s-gi i-gv-yi wi-du-lo-hi-se-di-yi Ge-li-li; na-hna da-ye-tsi-go-i, na-s-gi-ya ni-tsi-we-se-lv-i."
        intervals [666]:
            xmin = 616.070
            xmax = 616.070
            text = "021608: U-li-s-di-no u-ni-nu-go-tsv du-na-li-te-se a-tse-li-s-dv-i; du-ni-na-wi-s-ge-ye-no a-le u-ni-s-qua-ni-go-s-ge-i; v-tla a-le gi-lo go-hu-s-di yu-no-se-le-i; a-ni-s-ga-i-he-ye-no."
        intervals [667]:
            xmin = 616.070
            xmax = 616.070
            text = "021609: Tsi-sa-no du-le-hi-sa-nv su-na-le-i-yu i-gv-yi-yi i-ga su-na-do-da-qua-s-di ge-sv-i, i-gv-yi gv-ni-ge-sv nu-dv-ne-le Me-li Ma-gi-de-li e-hi, na-s-gi ga-li-quo-gi a-ni-s-gi-na tsi-du-nu-go-wi-se-le-i."
        intervals [668]:
            xmin = 616.070
            xmax = 616.070
            text = "021610: Na-s-gi-no u-we-nv u-ne-do-lv-hi wi-du-no-ne-le u-yo du-na-da-nv-dv-i a-le da-na-tlo-yi-hv-i."
        intervals [669]:
            xmin = 616.070
            xmax = 616.070
            text = "021611: Na-s-gi-no u-na-dv-ga-nv gv-nv-i, a-le na-s-gi u-go-hv-i, v-tla yu-no-hi-yu-ne-i."
        intervals [670]:
            xmin = 616.070
            xmax = 616.070
            text = "021612: O-ni-no nv-wa-da-le nu-s-de gv-ni-ge-sv ni-du-dv-ne-le a-ni-ta-li na-hna a-ne-la a-na-i-se-i, do-di-ga-lo-ge-sv wa-ni-ga-te-i."
        intervals [671]:
            xmin = 616.070
            xmax = 616.070
            text = "021613: Na-s-gi-no u-ne-nv wi-du-ni-no-ne-le a-ni-so-i; na-s-quo v-tla yi-du-no-hi-yu-ne na-s-gi."
        intervals [672]:
            xmin = 616.070
            xmax = 616.070
            text = "021614: O-ni-no gv-ni-ge-sv ni-du-dv-ne-le sa-du i-ya-ni-dv a-na-li-s-da-yv-hv-s-gv-i, a-le du-gv-s-go-lv-ne ni-ga-li-s-do-di-s-ge nu-no-hi-yu-sv-na ge-sv a-le di-s-da-yi-yu ge-sv tsu-ni-na-wi, ni-du-no-hi-yu-nv-na ge-sv i-yu-s-di na-s-gi gv-wa-go-hv-hi tsu-le-hi-sa-nv-hi ni-ge-se-i."
        intervals [673]:
            xmin = 616.070
            xmax = 616.070
            text = "021615: Hi-a-no ni-du-we-se-le-i, I-tse-do-na e-lo-hi ni-gv-na-dv-i, a-le wi-di-tsa-li-tsi-do-hv-si o-s-dv ka-no-he-dv na-ni-v ge-go-tlv-nv-hi."
        intervals [674]:
            xmin = 616.070
            xmax = 616.070
            text = "021616: Gi-lo go-hi-yu-hv-s-ge-s-di a-le a-ga-wo-s-ge-s-di a-tsi-s-de-lv-di ge-se-s-di; ni-go-hi-yu-hv-s-gv-na-s-gi-ni tsa-gu-go-da-ne-di ge-se-s-di."
        intervals [675]:
            xmin = 616.070
            xmax = 616.070
            text = "021617: Hi-a-no na-s-gi u-ye-lv-dv di-go-li-s-do-di ta-li du-dv-di-de-ge-s-di a-no-hi-yu-hv-s-gi; a-yv da-qua-do-v a-nv-di-s-ge-s-di a-ni-s-gi-na da-ni-nu-go-wi-s-ge-s-di; nv-wa-na-da-le tsu-ni-wo-ni-hi-s-di da-ni-wo-ni-s-ge-s-di;"
        intervals [676]:
            xmin = 616.070
            xmax = 616.070
            text = "021618: I-na-dv da-ni-ne-s-ge-s-di; i-yu a-le go-hu-s-di a-da-hi-hi yu-na-di-ta-hv, v-tla go-hu-s-di yu-nv-ne-he-s-di; tsu-ni-tlv-gi da-na-si-ta-di-s-ge-s-di, a-le du-na-di-wa-s-ge-s-di."
        intervals [677]:
            xmin = 616.070
            xmax = 616.070
            text = "021619: Na-s-gi-no U-gv-wi-yu-hi du-wo-ne-ta-nv, ga-lv-la-di do-tsa-de-da-ni-lv-tse-i, a-le a-ga-ti-si i-di-tlv U-ne-la-nv-hi u-wo-lv u-we-ne-i."
        intervals [678]:
            xmin = 616.070
            xmax = 616.070
            text = "021620: U-ne-nv-se-no a-le ni-gv-na-dv u-na-li-tsi-do-ni-do-le-i, U-gv-wi-yu-hi ta-li u-dv-di-de-ge du-ni-lv-wi-s-da-ne-hv-i, a-le a-ni-ne-gv a-s-da-yi-di-s-di-s-ge u-ye-lv-dv u-li-tlo-ya-s-di-de-gv-i.  E-me-nv."
