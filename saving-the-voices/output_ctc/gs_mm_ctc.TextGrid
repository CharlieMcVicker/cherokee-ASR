        intervals [60]:
            xmin = 339.000
            xmax = 344.060
            text = "chunk_059: ᏗᏣᎸᏫᏍᏓᏁᎵᏙᎸ ᎭᏢ ᏕᏣᎸᏫᏍᏓᏁᎴ?"
        intervals [61]:
            xmin = 344.060
            xmax = 436.620
            text = "chunk_060: ᎯᎸᏍᎩ Ꮫ ᏄᏓᎴᏒ ᏓᎩᎸᏫᏍᏓᏁᎸ ᏥᏫᏄᏥ ᎮᏂ ᏥᎨᎲ ᎠᏩᎴᏅᎲ CooksonᎢ ᏗᏓᎾᏅ ᏓᎩᎸᏫᏍᏓᏁᎸ ᏞᎦ George Stratton ᏚᏙᎥ ᎤᏓᎾᏅ ᎤᎾ ᎤᏍᏓᏴᎲᏍᎩᏂ Helen ᏚᏙᎥ ᎠᏃᏍᏗ ᎠᏂᏴᏫ ᎤᎾᏓᏅᏔ ᏝᎦ ᏓᎩᎸᏫᏍᏓᏁᎸ ᎤᎾ ᏃᏭᎾ ᏧᎷᏨ Ꮎ ᎠᎹ ᎤᏔᏂ ᏧᏂᏍᏚᏅ ᏓᎾᏁᏍᎨᏍᎬ ᏧᎾᎴᏅᎲ ᎠᎹ boat dock ᏓᏃᏎᎲ ᏥᏳ ᏧᏂᏴᏍᏗ ᏃᎴ Ft. Smith ᏛᏳᏂᎩᏓ ᏧᎴᏅ ᏓᏁᏍᎨᏍᎬ ᏍᎩ ᏳᏍᏗ ᎤᎾ Cookson Bend ᏚᏙᎥ ᎤᎾ ᏍᎩ ᏃᎴ ᎤᏕᎶᎰᏌ ᏓᎩᎸᏫᏍᏓᏁᎲ CooksonᎢ ᎤᎷᏨ ᏳᎪᏗ ᏱᎬᏈᏴᏏ ᎠᏯ ᏱᎬᏍᏕᎸ ᎠᏬᏎᎸ ᏗᏁᏍᎨᎲ Ꮎ Boat Dock ᎬᏂᏛ ᏱᏂᎦᎵᏍᏗ ᎯᎾ ᎣᎩᎾᎵ ᏥᏍᏕᎸᎯᏙᎰ ᎠᎭᏂ ᏥᏲᎮᎲ ᏲᎩᏂᏃᎮᏟ Ꮭ ᎩᎳᏫᏴ ᏱᎦᎬᏍᏓᏩᏚᎩ about week two weeks ᎴᏱᎦ notice ᏱᏥᏁᎵ ᏓᏥᏑᎵᎪᏥᏒ ᎩᎳ ᏱᎨᎾ ᏥᏥᏲᏎᎸ ᎣᏏᏅ ᏄᏰᎸᏅ Ꮩ ᏍᎩᎾ ᎾᏩᏛᏁᎸ ᏃᏭᏅ ᎠᏪᏅᏒ ᏙᎦᏁᏍᎨᎮᏂ Ꮎ ᏥᏳ ᏧᏂᏗᏍᏗ boat docks."
        intervals [62]:
            xmin = 436.620
            xmax = 517.070
            text = "chunk_061: ᎤᏓᎾᏅᏅᏂ ᎤᏍᏗ ᎤᎾ ᏓᎩᎸᏫᏍᏓᏁᎸ ᏃᎴ ᎡᎵᎠᎮ ᏔᎵ ᏧᏕᏘᏴᏗ ᏓᎩᎸᏫᏍᏓᏁᎸ ᎤᎾ Ꮕ ᎤᏓᎾᏂ CooksonᎢ ᎤᏪᏥ ᎠᏫᏄᏥ ᏓᏁᏍᎨᎯᏙᎲ ᎬᏩᏕᏱᏓ ᎤᎾ Ꮎ ᎥᏓᎵ ᎠᎮ ᏴᎪᏍ lake ᏍᎩᎾᎾ ᏂᎯᏍ ᏗᏣᏁᏍᎨᏗ Ꮎ Cookson Bend ᏥᏓᏓᏁᎳ ᎠᎹᏯ ᏣᏬᎮᎸ ᎠᏩᏍᏕᎸᏗᏛ ᏥᏥᏲᎮᎸ Ꮭ ᎠᎹᏯ ᏱᏗᎦᏁᏍᎨ ᎠᏯ Ꮎ ᏙᏛᎸ ᏕᎦᏁᏍᎨ ᏣᏬᎮᎸ ᏯᏩᏚᎳ ᏍᏕᏟᏗ Ꭲ ᏙᏳᏃ ᏗᏪᏅᏒ ᎠᎭᏂ ᎠᏩᏨᏏᏰᏗ ᏗᎩᎸᏫᏍᏓᏗ Ꭲ ᏥᏲᏎᎸ ᎭᏛ ᎪᎱᏍᏗ ᏯᏓᏖ ᏱᎬᏍᎬᎾ ᏱᏗᏓᏠᏍᎩ ᏗᏓᎾᏅ ᎤᎾᏂ ᏱᏓᏂᎩ ᏌᎾᎴ Ꮓ ᏱᏕᏓᏁᏍᎨᎯᏓ ᎤᏛᎾ meeting place ᏱᎩ CooksonᎢ ᎤᏛᎾ Ꭲ I will give that guy a notice ᏒᏅᏙᏓᏩᏍᎩ ᏱᎪᎯᏓ ᏄᏓᎴ ᎩᎶ ᎤᏩᏛᏗ ᎤᏍᏕᎵᏍᎦ ᏥᏲᎮᎲ I can't just quit ᏥᏲᎮᎲ and ᏙᏅ ᏍᎩᎾ ᏩᏥᏍᏕᎸᎲ ᏒᏂᏙᏓᏩᏍᏗ ᎤᎶᏒᏍᏗ ᏄᎵᏍᏛᏅ."
        intervals [63]:
            xmin = 517.070
            xmax = 646.310
            text = "chunk_062: ᎪᎯᏗᏛᏃ ᏕᎦᏁᏍᎨᎯᏙᎲ ᎠᎹᏯᏳᏟᏗ ᎠᎮᏃ ᏃᎴ ᎣᎩᏍᏆᏗ ᏂᎦᏓ ᎮᏂ ᏥᏓᏓᏁᎵ ᎠᎹᏯᏳᏟᏗ ᎦᏲᏟ ᏱᏓᏓᏁᎳ ᎠᏯ ᏥᎦᏁᏍᎨᏗ ᏂᎨᎲᏂ ᎤᎾ ᏬᎩᏍᏆᏗ ᏃᎴ St Claire Lime Company Ꮎ Sallisaw ᏌᎷᏂᎨᏴ ᏃᎴ ᏍᎩᎾ ᎠᎬᎩᏴᏅᎲ ᎠᎭᏂ ᏕᎮᎾ ᎠᏯ ᎢᏍᎩᏍᏕᎳ ᎭᏗ ᎢᎸᎯᏳ ᎪᏍᏓ ᎤᏁᎦ ᎠᏬᏢᏅ ᏱᎩ ᎭᏗ ᏱᎦᎰᏢᏍᎦ ᏂᎯ ᏔᎦᏎᏗ ᏱᎦ ᏧᏂᎸᏫᏍᏓᏁ ᎣᏍᏓ ᏱᎾᏅᏛᏁ ᏝᎴᏱᎦ ᎤᎾ ᎦᎸᎳᏗ ᏱᏦᏝ stairs ᎮᏂ ᏂᏕᎬᏂ ᎤᎾ ᎦᎸᎳᏗ ᏔᎵᏁ ᎠᏲᏓᏝᎲ ᎤᎾ ᏱᏦᏝ ᏱᎦᎯᏯᏎᎮ ᏳᎾᏛᏁᏗᎢ ᎠᏬᏎᎸ. ᎲᏛ ᏯᏩᏅᏔ ᎦᎦᏥᏯᏎᎮᏗ ᏱᎩ Ꮭ ᎢᎸᎯᏳ ᏍᎩ ᏯᏩᏛᏁᎸ ᏱᎩ Ꮭ ᎢᎸᎯᏳ lime ᎠᏬᏢᏅ ᏱᎩ ᏓᏨᏃᏎᎵᎢᏛ ᏱᎬᏗ meters ᎤᎮᏂ ᏗᎬᏎᏙᏗ ᏍᎩᎾᎾ meters ᏕᏣᎦᏎᏍᏛ ᎡᎵᎡᏍ ᏂᏕᎬᏅ ᏍᎩᎾᎾ Ꮎ meters ᏕᏣᎬᏎᏍᏛ they got to hold certain degrees all twenty-four hours. They can't go up they can't go down they got to stay right there. Well, I can do that ᏥᏲᎮᎸ yeah, I know you can do it ᎠᏬᏎᎸ Ꮎ ᏧᎧᏍᏟ ᎤᎾ ᏃᎴ ᏩᏩᎴᏅᎲ ᎪᎯᏗ Ꮓ ᎤᎾ ᏓᎩᎸᏫᏍᏓᏁᎲ Ꮓ ᎠᏂᏲᏍᎩ ᏣᎩᏴᏢ ᏣᎩᏅᎪᏣ ᏣᎦᏍᏆᏛ ᏃᎴ ᎠᏂᏲᏍᎩ ᎭᏝ Ꮓ ᏧᏩᏩᎴᏅᎲ?"
