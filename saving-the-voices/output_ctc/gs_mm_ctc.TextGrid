            text = "chunk_081: City Hospital Ꮫ ᏗᎩᎸᏫᏍᏓᏁᎸ ᏐᏁᎳᏚ ᏧᏕᏘᏴᏗ ᏗᎩᎸᏫᏍᏓᏁᎸ ᎤᎾ ᏙᏳ ᎪᎯᏗ ᏃᎴ ᎤᎾ ᎠᎩᏑᎵᎪᏨ ᏃᎴ HastingsᎢ ᏣᏪᏅᏒ ᏃᎴ ᏁᎳᏚ ᏧᏕᏘᏴᏓ ᏛᎩᎸᏫᏍᏓᏁᎳ ᎤᎾᏂ retire ᎾᏩᏛᏁᎸ ᏓᎩᎸᏫᏍᏓᏁᎲ Ꮎ Ꭱ ICUᎢ ᏗᎩᎸᏫᏍᏓᏁᎸ HastingᎢ heart monitor ᏗᏬᎦᏎᏍᏗ ᎨᎲ ᎤᎾ Ꮓ ᎬᎩᎧᎲᏍ ᏃᎴ Ꮎ ᏧᎾᏍᏗ ᏗᏂᏯ ᏃᎴ ᎤᎾ ᏩᎩᏴᏢ City HospitalᎢ ᏍᏊ ᎤᏠᏱ ᏯᏩᏛᏁᎸ ᎤᎾ ICU ᏗᎩᎸᏫᏍᏓᏁᎸ ᏃᎴ Ꮎ ᏧᎾᏍᏗ ᎤᏂᏴᏍᏗ ᏗᎩᎸᏫᏍᏓᏁᎸ"
