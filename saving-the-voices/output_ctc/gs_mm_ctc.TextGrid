            xmin = 3109.160
            xmax = 3123.610
            text = "chunk_275: ᎾᏛᎾ fry bread ᏱᎪᏢᎾ gravy ᎢᎾ ᏱᎪᏢᎾ ᎤᎾ Ꮫ ᏴᎵᏍᏓᏴᎲᎦ ᏪᏌ Ꭴ ᎡᎵᏍᏗ"
        intervals [277]:
            xmin = 3123.610
            xmax = 3155.260
            text = "chunk_276: ᎾᏅ ᎠᎩᏲᏏᎲ ᎠᎴᏂ, ᎯᎾᎭ Ꮓ ᎣᏂ ᏗᏝ Ꭰ ᏴᏛᎾ ᎩᎳ ᏗᎾᏛᏍᎦ ᏣᎳᎩ ᏣᏂᏬᏂ ᏄᏓᎴᏍ ᏳᏍᏗ ᎤᏃᏴᎪ ᏎᎾ ᏕᎦᏛᏏᏗᏒ ᎠᏣᎳᎩ ᏥᏗᏬᏂᎰ?"
        intervals [278]:
            xmin = 3155.260
            xmax = 3155.740
            text = "chunk_277: ᎥᎥ"
        intervals [279]:
            xmin = 3155.740
            xmax = 3156.230
            text = "chunk_278: ᎥᎥ"
        intervals [280]:
            xmin = 3156.230
            xmax = 3160.960
            text = "chunk_279: ᏄᏓᎴᏍ ᏳᏍᏗ ᎤᏃᏴᎪ? Ꮓ ᏣᏂᏬᏂ?"
        intervals [281]:
            xmin = 3160.960
            xmax = 3178.270
            text = "chunk_280: ᏄᏓᎴ ᎾᏩᎵᏍᏓᏁᎰ Ꭵ ᎪᎱᏍᏗ Ꭲ ᏳᏍᏗ ᎠᏝᎭ ᎾᏩᎵᏍᏓᏁᎰ ᎣᏂ ᏌᎶᎵ ᏣᎾᏗᎰ ᏌᎶᎵ ᎦᏗᎰ ᎠᏯ ᏱᎦ ᏌᎶᎵ ᏌᎶᎵ ᏯᏅᏓ ᏥᏍ"
        intervals [282]:
            xmin = 3178.270
            xmax = 3180.060
            text = "chunk_281: ᎢᎦᏗᏅ ᏌᎶᎵ ᏯᏅᏚᏭ"
        intervals [283]:
            xmin = 3180.060
            xmax = 3192.680
            text = "chunk_282: Ꭵ ᏍᎩᏛ ᏄᏍᏓ ᏳᏂᏪᏍᏗ ᎠᏂ ᏣᎳᎩ ᏌᎶᎵ it’s a squirrel ᏌᎶᎵ ᏥᏍᏚ Ꮕ ᏳᏂᎪ Ꮭ rabbit ᏱᎬᎾᏓ ᎨᎲ ᏥᏍᏚ ᏯᏅᏗ ᎮᏂ"
        intervals [284]:
            xmin = 3192.680
            xmax = 3196.360
            text = "chunk_283: ᏙᏛ ᏚᏓᎴᎾ ᏙᎭ ᎯᎾᎭ ᏴᏛᎾ ᏔᎵᏍᎪ ᏧᏕᏘᏴᏓ ᏩᏟᎶᏢ ᎠᏱᏎᏍᏚᏭᏍ ᏣᎳᎩ ᎦᏬᏂᎯᏍᏗ ᎨᏒ ᏍᏕᎵᏍᎪ? ᏙᎨ Ꮲ Ꭸ ᏫᏛᎵᏒᏂ ᏍᏕᎵᏍᎪ?"
        intervals [285]:
            xmin = 3196.360
            xmax = 3220.480
            text = "chunk_284: ᎢᎠᎢᏎᏍᏚᏛ Ꮟ ᎾᎯᏳ ᏔᎵᏍᎪ ᏧᏕᏘᏴᏓ ᎩᎶ ᏥᎩ ᎠᏟᎶᏢ ᏔᎵᏍᎪ ᏧᏕᏘᏴᏗ ᎾᎾᏕᎳᏆᏍᎬᏂ ᎨᎮᏍᏗ ᏅᎾᏁᏟᏗᏍᎬᏂ ᎨᎮᏍᏗ ᎤᏂᏬᏂᎯᏍᏗ ᎠᏂᏐ ᎲᏗ ᏱᎦᏰᎮᏍᏗ ᏣᎳᎩ ᎦᏬᏂᏓ ᏲᏁᎩ Ꮫ ᏂᏓᎦᎵᏍᏛᏂ"
        intervals [286]:
            xmin = 3220.480
            xmax = 3230.840
            text = "chunk_285: ᎯᎾᎭ ᏥᏓᏅᏕᎳᏆ ᎡᏙᎮᏍᏗ Ꭸ ᎫᏩᏍᏗ ᏓᎾᏕᎳᏆᏍᎨᏍᏗ ᎠᏣᎳᎩ ᎯᎾ ᏗᏂᏲᏟ ᏥᏓᎾᏕᎳᏆ ᎠᎢᏎᏗᏚᏭᏍ Ꮟ ᏍᏕᎵ ᎾᎯᏳ?"
        intervals [287]:
            xmin = 3230.840
            xmax = 3257.290
            text = "chunk_286: ᏯᏛᏂᏍ Ꮎ Sequoyah ᏥᎩ ᏥᏓᎾᏕᎳᏆ ᎠᏂᏣᎳᎩ? ᎤᎾ Ꮲ ᏳᎵᏑ ᎡᎵᏍᏓ ᎩᎶ ᏍᏊ maybe an hour or two ᏱᎢᏗᎦᏬᏂᏗ ᎠᏣᎳᎩ ᎬᏗ ᎡᎵᏍᏓ ᎤᏅᎨᏫᏍᏗ ᏂᎨᏒᏂ ᏙᏳ ᎮᏂ ᏫᏛᎵᏍᏆᏗᏟ ᎮᏂ ᏣᎳᎩ ᎢᎩᏬᏂᎯᏍᏗ ᎠᏯ ᎮᏂ ᏌᏬ ᎣᎩᏂᎧ ᎠᏫᏄᏥ Tulsa Ꮲ Ꮺ ᏗᎧᏃᎩᏍᏗᏍᎦ ᎢᎦᏭᏅ ᎨᎲ ᏥᎦ ᎠᏁᏟᏗᏍᎪ ᏣᎳᎩ ᎤᏬᏂᎯᏍᏗ Ꭷ"
        intervals [288]:
            xmin = 3257.290
            xmax = 3257.400
            text = "chunk_287: ᎥᎥ"
        intervals [289]:
            xmin = 3257.400
            xmax = 3294.580
            text = "chunk_288: ᎠᎯᎵ ᎠᏕᎳᏆ Ꮎ ᏍᏊ ᏳᏪᏙᎳ ᏦᎩᏁᏅᏒ ᎦᏙ ᎠᏗ Ꭿ ᏱᎦᏪᏍᏗ ᎣᏍᏗᏃᏎ ᎰᏅ ᏍᎫᏭᏂ ᎬᏩᏘ ᎨᎰ ᏳᏪᏙᎳ ᏍᎩ ᎮᏂ ᏱᎾᏅᏛᎩ ᏯᎾᏁᏟᏗ Ꮎ ᏧᎾᏛᎾ Ꭵ ᏯᎾᏁᏟᏗ ᏧᏁᏲᏗ ᎾᏅ ᏥᏈᏍᏓ ᎠᎩᏛᎦᏅ ᏚᎾᏓᏟᏌᎲ ᏴᏫ ᎠᏂᏣᎳᎩ ᎠᏂᏲᏁᎩ ᎢᎾ ᎤᎾᎵᏑᏯᏩᏕᎬ ᏝᏅ ᏱᏙᎬᏁᏲᎲᎦ Ꮎ ᎠᏣᎳᎩ ᏳᏬᏝ ᎾᎾ ᎠᏲᏟ ᏳᎷᏥ ᎠᏫᏴ ᏝᏅ ᎯᏛ ᏁᏣᏪᏎᎠ ᏱᎬᏃᏏ. ᏲᏁᎦᎭ ᏱᎪᎵᎦ ᎠᏯ ᎨᎲ ᎠᏬᏟᏍᏗ ᎨᎲ ᏲᏁᎦᎠᎭ ᏱᎪᎵᎦ ᎠᏴᏫᏯ ᎠᏣᎳᎩ ᎢᎾ ᏱᏈ Ꮭ ᎮᏂ ᎪᎱᏍᏗ ᏳᏅᏔ. ᏙᏳ Ꮭ ᎪᎱᏍᏗ ᏳᏅᏔ ᏱᎨᎷᏭᏂ"
        intervals [290]:
            xmin = 3294.580
            xmax = 3295.250
            text = "chunk_289: Well ᎬᎵᎡᎵᎦ"
        intervals [291]:
