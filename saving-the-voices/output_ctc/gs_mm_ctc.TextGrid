            text = "chunk_051: ᎦᏙ ᎡᎩᎩᎡᎳ man. ᏗᎨᎬ ᏍᏊ ᏍᎩ ᏥᏄᏅᎵᏍᏓᏁᎸ ᏗᎨᎬ ᏗᏝ ᎨᏥᎩᎡᎳ ᎦᏙ yeah ᏃᎮᏂ ᏥᏈᏍᏓ ᏱᎩᎮ ᎦᏙ ᏙᎲ ᏍᎩ ᏁᎬᏁᎸᎾ ᏱᎨᎮ"
