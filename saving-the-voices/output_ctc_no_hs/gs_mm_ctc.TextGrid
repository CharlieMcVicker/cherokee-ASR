            xmax = 1107.330
            text = "chunk_071: Ꮭ job ᏯᎩᎮ ᏦᎩᏁᏅᏒ ᎾᎠ ᏥᏥᎶᎨᏗᏙᎲ call ᏄᏩᏁᎸ ᏃᎴ Ross “When you going to come to work?” ᎠᏬᎮᎸ “what are you talking about?” ᏥᏲᎮᎸ “Well we got a job for you.” “Well, I didn’t know that!” ᏥᏲᎮᎸ “My crystal ain’t working just right. I didn’t know anything about having a job.” “Well we have a job for you we want you to come to work.” “Where at?” “Northeastern College, Tahlequah.” “I ain’t got no degree in teaching” ᏥᏲᎮᎸ “Ok come over there we need help over there.” “Alright” ᎠᏩᎴᏅᎲ ᏃᎴ ᎤᎾ ᎪᎯᏗ ᏛᏃ ᏓᎩᎸᏫᏍᏓᏁᎸ Ꮓ ᎤᎾ ᎭᎸ ᏛᏍᏊ ᏓᎩᎸᏫᏍᏓᏁᎮ Cherokee Nation ᎮᏂ ᏓᎩᎸᏫᏍᏓᏁᎲ retire ᎾᏩᏛᏁᎸ"
