            xmax = 210.290
            text = "chunk_042: ᎾᎡ Caney Creek ᎾᎥ ᎨᎲ ᏍᎩᎾ Ꮲ ᏅᎩ ᏧᏕᏘᏴᏗ ᎢᎪᎯᏓ ᎣᎦᏕᏅ ᎤᎾ ᏃᏭᏅ ᎦᏙ ᏣᏥᎩᎡᎳ ᎡᎵᏏ ᏥᎨᎲ Ꮎ lake ᏧᎩᎡᎸ ᎣᎩᎾᎷᏒ Babo (Barber) Ꮓ ᏩᏩᏛᏒ ᎤᎾ ᎦᏚᏏ ᏗᏝ Babo ᎠᏃᏎᎰ ᎤᎾ ᏩᏩᏛᏒ Ꮓ"
