        intervals [572]:
            xmin = 3272.050
            xmax = 3303.565
            text = "chunk_286: ᏣᎵ: ᏯᏛᏂᏍ Ꮎ Sequoyah ᏥᎩ ᏥᏓᎾᏕᎳᏆ ᎠᏂᏣᎳᎩ? ᎤᎾ Ꮲ ᏳᎵᏑ ᎡᎵᏍᏓ ᎩᎶ ᏍᏊ maybe an hour or two ᏱᎢᏗᎦᏬᏂᏗ ᎠᏣᎳᎩ ᎬᏗ ᎡᎵᏍᏓ ᎤᏅᎨᏫᏍᏗ ᏂᎨᏒᏂ ᏙᏳ ᎮᏂ ᏫᏛᎵᏍᏆᏗᏟ ᎮᏂ ᏣᎳᎩ ᎢᎩᏬᏂᎯᏍᏗ ᎠᏯ ᎮᏂ ᏌᏬ ᎣᎩᏂᎧ ᎠᏫᏄᏥ Tulsa Ꮲ Ꮺ ᏗᎧᏃᎩᏍᏗᏍᎦ ᎢᎦᏭᏅ ᎨᎲ ᏥᎦ ᎠᏁᏟᏗᏍᎪ ᏣᎳᎩ ᎤᏬᏂᎯᏍᏗ Ꭷ"
