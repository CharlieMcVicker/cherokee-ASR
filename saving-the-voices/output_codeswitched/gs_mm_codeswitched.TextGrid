            text = "chunk_114: Mary: Pete Foster ᏚᏙᎥ ᎡᏙᏓ ᎤᏁᎩ Ꮫ ᏚᏙᎥ ᏣᎳᎩ ᎬᏛᏅ ᎡᏥ Ꮎ ᎨᎲ Ᏺ Sally Hooper ᏌᎵ ᏚᏙᎥ ᎡᏙᏓ Ꮕ Vian ᏂᏛᏳᏂᎩᏓ ᎡᏥ Ꮓ Ꮎ Babo (Barber) ᎤᏛᏏᏙᎸ ᎠᏎᎾ ᏁᎳᏛ ᏱᏅᏓ ᎬᎨ ᎨᎲ ᏚᎾᎬᎴᏅᎲ ᏍᎩᏃ ᎡᎵᏏ ᏥᎨᎲ Ꮓ ᎣᏍᏓᏝᏩᏍᏛᏂᏢ ᎠᏯ"
