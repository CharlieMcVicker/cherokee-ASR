            text = "chunk_288: ᏣᎵ: ᎠᎯᎵ ᎠᏕᎳᏆ Ꮎ ᏍᏊ ᏳᏪᏙᎳ ᏦᎩᏁᏅᏒ  ᎦᏙ ᎠᏗ Ꭿ ᏱᎦᏪᏍᏗ ᎣᏍᏗᏃᏎ ᎰᏅ ᏍᎫᏭᏂ ᎬᏩᏘ ᎨᎰ ᏳᏪᏙᎳ ᏍᎩ ᎮᏂ ᏱᎾᏅᏛᎩ ᏯᎾᏁᏟᏗ Ꮎ ᏧᎾᏛᎾ Ꭵ ᏯᎾᏁᏟᏗ ᏧᏁᏲᏗ ᎾᏅ ᏥᏈᏍᏓ ᎠᎩᏛᎦᏅ ᏚᎾᏓᏟᏌᎲ ᏴᏫ ᎠᏂᏣᎳᎩ ᎠᏂᏲᏁᎩ ᎢᎾ ᎤᎾᎵᏑᏯᏩᏕᎬ ᏝᏅ ᏱᏙᎬᏁᏲᎲᎦ Ꮎ ᎠᏣᎳᎩ ᏳᏬᏝ ᎾᎾ ᎠᏲᏟ ᏳᎷᏥ ᎠᏫᏴ ᏝᏅ ᎯᏛ ᏁᏣᏪᏎᎠ ᏱᎬᏃᏏ. ᏲᏁᎦᎭ ᏱᎪᎵᎦ ᎠᏯ ᎨᎲ ᎠᏬᏟᏍᏗ ᎨᎲ ᏲᏁᎦᎠᎭ ᏱᎪᎵᎦ ᎠᏴᏫᏯ ᎠᏣᎳᎩ ᎢᎾ ᏱᏈ Ꮭ ᎮᏂ ᎪᎱᏍᏗ ᏳᏅᏔ. ᏙᏳ Ꮭ ᎪᎱᏍᏗ ᏳᏅᏔ ᏱᎨᎷᏭᏂ"
