item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 486.745
        intervals: size = 72
        intervals [1]:
            xmin = 0.000
            xmax = 3.205
            text = ""
        intervals [2]:
            xmin = 3.205
            xmax = 12.135
            text = "011401: Na-ne-yu E-lo-dv nv-gi i-ga-du-gi ge-sv s-da-du-gi a-tsi-ga-ti-di-s-di u-dv-ga-ne de-ga-no-tsa-lv Tsi-sa."
        intervals [3]:
            xmin = 12.135
            xmax = 12.970
            text = ""
        intervals [4]:
            xmin = 12.970
            xmax = 26.710
            text = "011402: Hi-a-no ni-du-we-se-le tsu-nv-si-da-s-di; Hi-a na-s-gi Tsa-ni Di-da-we-s-gi; do-u-le-nv tsu-yo-hu-sv-gi, a-le na-s-gi i-yu-s-di u-s-qua-ni-go-di-yu tsi-du-lv-wi-s-da-ne-ha."
        intervals [5]:
            xmin = 26.710
            xmax = 27.570
            text = ""
        intervals [6]:
            xmin = 27.570
            xmax = 44.750
            text = "011403: E-lo-dv-ye-no u-ni-yv-he Tsa-ni a-le u-lv-le-i a-le u-s-du-ne di-da-s-du-di-yi,  Qui-li-gi E-lo-dv di-na-da-nv-tli u-da-li-i E-lo-di-si tsu-do-i-dv u-s-dv-di-s-ge-i."
        intervals [7]:
            xmin = 44.750
            xmax = 46.200
            text = ""
        intervals [8]:
            xmin = 46.200
            xmax = 54.080
            text = "011404: Tsa-ni-ye-no hi-a nu-we-se-le E-lo-dv; v-tla du-yu-go-dv yi-gi na-s-gi tsa-da-ye-ha."
        intervals [9]:
            xmin = 54.080
            xmax = 55.400
            text = ""
        intervals [10]:
            xmin = 55.400
            xmax = 65.080
            text = "011405: A-le u-du-li-s-ge u-hi-s-di-yi, a-se-no da-s-ga-i-he yv-wi, a-do-le-ho-s-gi-ye-no u-ni-ye-lv-se Tsa-ni."
        intervals [11]:
            xmin = 65.080
            xmax = 66.185
            text = ""
        intervals [12]:
            xmin = 66.185
            xmax = 79.455
            text = "011406: A-se-no hna-quo E-lo-dv u-de-nv i-yu i-ga du-ni-la-wi-tsv, E-lo-di-si u-we-tsi a-dv u-na-li-s-gi-e-le-i, a-le o-se u-ye-lv-ne E-lo-dv."
        intervals [13]:
            xmin = 79.455
            xmax = 80.955
            text = ""
        intervals [14]:
            xmin = 80.955
            xmax = 89.905
            text = "011407: Na-s-gi i-yu-s-di u-se-li-ta-ne u-du-i-s-da-ne-le u-ne-di-yi nu-s-dv-quo u-ta-yo-lv-i."
        intervals [15]:
            xmin = 89.905
            xmax = 91.810
            text = ""
        intervals [16]:
            xmin = 91.810
            xmax = 104.000
            text = "011408: Hna-quo-no u-tsi u-we-yo-nv-hi ni-ge-se-i hi-a nu-we-se-i; A-ni s-gi-yo-he-lv-ha Tsa-ni Di-da-wo-s-gi u-s-go a-te-li-do ga-lo-de-s-di."
        intervals [17]:
            xmin = 104.000
            xmax = 104.940
            text = ""
        intervals [18]:
            xmin = 104.940
            xmax = 120.215
            text = "011409: U-gv-wi-yu-hi-no u-yo-i-yu u-ye-lv-ne-i, a-se-no u-se-li-ta-nv-i, a-le na-s-quo na-s-gi a-na-li-s-da-yv-hv-s-gi nv-tsu-li-s-do-ta-ne-i, u-ne-tse a-tsi-ne-di-yi."
        intervals [19]:
            xmin = 120.215
            xmax = 121.160
            text = ""
        intervals [20]:
            xmin = 121.160
            xmax = 128.255
            text = "011410: U-da-nv-se-no wu-ni-s-gu-de-se Tsa-ni di-da-s-du-di-yi."
        intervals [21]:
            xmin = 128.255
            xmax = 129.035
            text = ""
        intervals [22]:
            xmin = 129.035
            xmax = 137.675
            text = "011411: U-s-go-no u-ni-yo-le a-te-li-do-gi-hi, a-le u-ni-ne-le a-dv, na-s-gi-no u-tsi wu-ne-le-i."
        intervals [23]:
            xmin = 137.675
            xmax = 139.220
            text = ""
        intervals [24]:
            xmin = 139.220
            xmax = 150.760
            text = "011412: Gv-wa-s-da-wa-di-do-hi-no u-ni-lu-tse a-le u-ni-ne-se a-ye-lv-i, a-le u-ni-ni-sa-ne-i, a-le u-ne-nv-se wu-ni-no-ne-le Tsi-sa."
        intervals [25]:
            xmin = 150.760
            xmax = 152.340
            text = ""
        intervals [26]:
            xmin = 152.340
            xmax = 173.895
            text = "011413: Tsi-sa-no u-dv-ga-nv, tsi-yu u-tso-ta-nv-gi na-hna u-ni-gi-sv-gi u-da-ye-li-lv i-na-ge wu-lo-sv-gi.  Hna-quo-no yv-wi u-na-dv-ga-nv, e-la-di gv-wa-s-da-wa-dv-e-gi de-ga-du-hv do-da-yu-ne-nv-sv-gi."
        intervals [27]:
            xmin = 173.895
            xmax = 174.590
            text = ""
        intervals [28]:
            xmin = 174.590
            xmax = 184.850
            text = "011414: Tsi-sa-no u-tsa-i-sv du-go-hv-gi u-ni-tsa-ti yv-wi, a-le du-we-do-li-tsv-gi, a-le du-nv-wa-nv-tsu-ni-tlv-gi."
        intervals [29]:
            xmin = 184.850
            xmax = 186.150
            text = ""
        intervals [30]:
            xmin = 186.150
            xmax = 212.975
            text = "011415: U-sv-no nu-li-s-ta-nv gv-wa-s-da-wa-do-hi gv-wa-lu-tse-lv-gi hi-a nu-ni-we-sv-gi; A-ni i-na-ge-quo, a-le i-ga u-lo-so-ni-di, tsi-tse-na-quo-no gi-yo-si hi-a u-ni-tsa-ti yv-wi, a-le do-di-ga-du-hv wi-a-ni-lo-hi, na-hna u-nv-sv u-na-li-s-da-yv-di u-ni-wa-sv-ha."
        intervals [31]:
            xmin = 212.975
            xmax = 213.820
            text = ""
        intervals [32]:
            xmin = 213.820
            xmax = 222.985
            text = "011416: A-se-no Tsi-sa hi-a ni-du-we-se-lv-gi; V-tla a-se v-u-ne-nv-s-di yi-gi, ni-hi-quo di-tse-la-s-da."
        intervals [33]:
            xmin = 222.985
            xmax = 224.170
            text = ""
        intervals [34]:
            xmin = 224.170
            xmax = 232.410
            text = "011417: Hi-a-no nv-gv-wa-we-se-lv-gi; A-ni hi-s-gi-quo ga-du do-gi-ha, ta-li-quo-no a-tsa-di."
        intervals [35]:
            xmin = 232.410
            xmax = 233.370
            text = ""
        intervals [36]:
            xmin = 233.370
            xmax = 237.085
            text = "011418: Hi-a-no nu-we-sv-gi; A-ni di-s-gi-yo-hi-si."
        intervals [37]:
            xmin = 237.085
            xmax = 238.300
            text = ""
        intervals [38]:
            xmin = 238.300
            xmax = 266.870
            text = "011419: Du-ne-tse-lv-no u-ni-tsa-ti ka-ne-s-go-hi ge-sv u-na-nv-di-yi, du-gi-sv-no hi-s-gi ga-du a-le ta-li a-tsa-di du-ne-sv, ga-lv-la-di-no wi-du-ka-na-nv u-li-he-li-tsv-gi, a-le du-gv-ha-lu-yv du-ne-lv-gi ga-du gv-wa-s-da-wa-di-do-hi, na-s-gi-no gv-wa-s-da-wa-di-do-hi u-ni-tsa-ti wi-du-ni-ne-lv-gi."
        intervals [39]:
            xmin = 266.870
            xmax = 268.135
            text = ""
        intervals [40]:
            xmin = 268.135
            xmax = 280.270
            text = "011420: Ni-ga-dv-no u-na-li-s-da-yv-nv-gi a-le du-no-lv-sv-gi, a-le u-nu-ti-sv-gi u-li-gv-ha-lu-yv-hi u-ti-yv-hi ta-la-du i-ya-ka-li-i ta-lu-tsa."
        intervals [41]:
            xmin = 280.270
            xmax = 281.345
            text = ""
        intervals [42]:
            xmin = 281.345
            xmax = 292.245
            text = "011421: U-na-li-s-da-yv-nv-hi-no hi-s-gi-ha i-ya-ga-yv-li a-ni-s-ga-ya na-ni-v-gi, ni-da-ne-tlv-dv-na a-ni-ge-yv a-le di-ni-yo-li."
        intervals [43]:
            xmin = 292.245
            xmax = 293.340
            text = ""
        intervals [44]:
            xmin = 293.340
            xmax = 307.535
            text = "011422: Gi-la-quo-no i-yv-dv Tsi-sa du-nv-wi-s-ta-nv-gi gv-wa-s-da-wa-di-do-hi tsi-yu-hi u-na-tso-di-yi, a-le i-gv-yi ni-du-ni-so-hi-s-di-yi a-si da-ye-li-hi-s-di-s-gv u-ni-tsa-ti."
        intervals [45]:
            xmin = 307.535
            xmax = 308.770
            text = ""
        intervals [46]:
            xmin = 308.770
            xmax = 323.930
            text = "011423: Hna-quo-no du-ye-li-hi-s-ta-nv u-ni-tsa-ti o-da-lv u-hna-lu-sv-gi u-wa-sv ge-sv-i, u-da-do-li-s-ta-nv-sv-gi.  U-sv-no nu-li-s-ta-nv na-hna u-wa-sv-quo ge-sv-gi."
        intervals [47]:
            xmin = 323.930
            xmax = 325.370
            text = ""
        intervals [48]:
            xmin = 325.370
            xmax = 338.680
            text = "011424: Tsi-yu-no hna-quo a-ye-li v-da-li wa-ni-ni-sv-gi u-tla-di-s-ta-ni-do-hv a-ma da-li-s-di-la-ne-gv-i, u-no-le-ye-no i-gv-yi-tlv da-yu-ga-dv-gi."
        intervals [49]:
            xmin = 338.680
            xmax = 339.465
            text = ""
        intervals [50]:
            xmin = 339.465
            xmax = 352.145
            text = "011425: Hna-quo-no nv-gi-ne i-yu-na-da-ne-tli-yv-dv ge-sv a-ni-ya-wi-s-gi sv-no-yi Tsi-sa wi-du-lu-tse-lv-gi v-da-li ga-du-i a-i-sv-gi."
        intervals [51]:
            xmin = 352.145
            xmax = 352.760
            text = ""
        intervals [52]:
            xmin = 352.760
            xmax = 368.200
            text = "011426: Gv-wa-s-da-wa-di-do-hi-no gv-wa-go-hv v-da-li ga-du-gi; a-i-sv-i u-na-da-nv-te-ta-nv-gi, hi-a nu-ni-we-sv-gi; Na-ye-hi hi-a.  A-ni-s-ga-i-hv-no i-yu-s-di u-na-li-s-ta-nv-gi."
        intervals [53]:
            xmin = 368.200
            xmax = 369.300
            text = ""
        intervals [54]:
            xmin = 369.300
            xmax = 383.085
            text = "011427: A-se-no gi-la-quo i-yv-dv Tsi-sa du-ne-tse-lv-gi, hi-a ni-du-we-se-lv-gi; U-ga-li-s-di-quo i-tsa-da-nv-da-da, a-yv-quo-ye-no, tle-s-di yi-tsi-s-ga-i-he-s-di."
        intervals [55]:
            xmin = 383.085
            xmax = 384.210
            text = ""
        intervals [56]:
            xmin = 384.210
            xmax = 394.855
            text = "011428: Qui-da-no u-ne-tsv hi-a nu-we-se-lv-gi; Tsa-gv-wi-yu-hi, i-yu-no ni-hi ge-se-s-di, s-gi-ne-tsi wi-gv-lu-tse-di-yi a-ma-yi ga-du-i."
        intervals [57]:
            xmin = 394.855
            xmax = 396.705
            text = ""
        intervals [58]:
            xmin = 396.705
            xmax = 407.695
            text = "011429: E-he-na, u-dv-nv-gi.  Hna-quo-no Qui-da tsi-yu-hi u-tsa-i-sv a-ma-yi ga-du-i a-i-sv-gi Tsi-sa tse-do-hv wa-ga-dv-gi."
        intervals [59]:
            xmin = 407.695
            xmax = 408.395
            text = ""
        intervals [60]:
            xmin = 408.395
            xmax = 423.020
            text = "011430: A-se-no nv-do-le-ho-sv a-s-da-yi-yu ga-no-lv-v-s-gv u-s-ga-lv-gi, a-le u-le-nv-hv ga-no-yv-gv u-we-lu-nv-gi, Tsa-gv-wi-yu-hi s-gi-s-de-lv, u-dv-nv-gi."
        intervals [61]:
            xmin = 423.020
            xmax = 424.620
            text = ""
        intervals [62]:
            xmin = 424.620
            xmax = 436.395
            text = "011431: Gi-la-quo-no i-yv-dv Tsi-sa wu-do-ya-nv-hi-dv wu-ni-yv-hv-gi, hi-a nu-we-se-lv-gi; u-s-di tso-hi-yu-hi, ga-do-hi v-tsa-dla-si-dv-si?"
        intervals [63]:
            xmin = 436.395
            xmax = 437.630
            text = ""
        intervals [64]:
            xmin = 437.630
            xmax = 442.550
            text = "011432: Tsi-yu-hi-no i-u-na-tsa-nv ga-no-lv-v-s-gv u-su-li-go-tsv-gi."
        intervals [65]:
            xmin = 442.550
            xmax = 444.010
            text = ""
        intervals [66]:
            xmin = 444.010
            xmax = 456.320
            text = "011433: Hna-quo-no tsi-yu-hi u-na-tsa-i u-ni-lu-tsv gv-wa-da-do-li-s-da-ne-lv-gi, hi-a nu-ni-we-sv-gi; U-do-hi-yu-hi-ya ni-hi U-ne-la-nv-hi U-we-tsi."
        intervals [67]:
            xmin = 456.320
            xmax = 457.265
            text = ""
        intervals [68]:
            xmin = 457.265
            xmax = 462.300
            text = "011434: Hna-quo-no du-ni-so-tsv Ge-ni-si-la-di u-ni-lu-tsv-gi."
        intervals [69]:
            xmin = 462.300
            xmax = 463.140
            text = ""
        intervals [70]:
            xmin = 463.140
            xmax = 474.135
            text = "011435: Na-hna-no a-ne-hi a-ni-s-ga-ya gv-wo-li-tsv, gv-wa-du-wi-dv du-na-da-nv-si-do-lv-gi, de-gv-wa-ti-no-he-lv-gi ni-ga-dv tsu-ni-tlv-gi."
        intervals [71]:
            xmin = 474.135
            xmax = 474.845
            text = ""
        intervals [72]:
            xmin = 474.845
            xmax = 486.745
            text = "011436: Gv-wa-ta-yo-se-lv-gi-no ga-da-lu-ya-dv-quo na-s-quo u-nu-wa-v u-na-sv-ne-di-yi, ni-ga-dv-no u-na-sv-ni-lv-hi du-na-di-wa-sv-gi."
