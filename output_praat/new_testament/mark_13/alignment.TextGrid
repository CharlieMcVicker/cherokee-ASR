            xmax = 22.780
            text = ""
        intervals [30]:
            xmin = 22.780
            xmax = 23.620
            text = "hi-a nu-we-se-le-i,"
        intervals [31]:
            xmin = 23.620
            xmax = 24.420
            text = ""
        intervals [32]:
            xmin = 24.420
            xmax = 25.500
            text = "De-hi-go-wa-di-s-go"
