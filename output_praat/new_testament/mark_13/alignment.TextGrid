        intervals [24]:
            xmin = 19.445
            xmax = 20.445
            text = "da-da-ne--lv-i?"
        intervals [25]:
            xmin = 20.445
            xmax = 21.440
            text = ""
        intervals [26]:
            xmin = 21.440
            xmax = 21.880
            text = "Tsi-sa-no"
        intervals [27]:
            xmin = 21.880
            xmax = 21.960
            text = ""
        intervals [28]:
            xmin = 21.960
            xmax = 22.700
            text = "u-ne-tsv"
        intervals [29]:
