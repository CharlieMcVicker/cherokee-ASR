File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 720.085
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 720.085
        intervals: size = 85
        intervals [1]:
            xmin = 0.000
            xmax = 3.340
            text = ""
        intervals [2]:
            xmin = 3.340
            xmax = 18.360
            text = "011001: Wi-du-ya-nv-hv-no ta-la-du i-ya-ni-dv gv-wa-s-da-wa-di-do-hi, du-ne-lv a-ni-s-gi-na tsu-ni-nu-go-wi-s-di-yi, a-le tsu-na-da-nv-wo-di-yi ni-ga-v du-ni-tlv-gv, a-le ni-ga-v v-yu-gi."
        intervals [3]:
            xmin = 18.360
            xmax = 19.250
            text = ""
        intervals [4]:
            xmin = 19.250
            xmax = 38.565
            text = "011002: Hi-a-no na-s-gi nu-s-di du-na-do-v ta-la-du i-ya-ni-dv ge-tsi-nv-si-dv.  I-gv-yi-yi Sa-wa-ni Qui-da tsa-no-se-ho-i, E-ni-di-no na-s-gi-quo u-nv-tli, Tsi-mi-no Tse-qui-di u-we-tsi, Tsa-ni-no na-s-gi-quo u-nv-tli."
        intervals [5]:
            xmin = 38.565
            xmax = 39.495
            text = ""
        intervals [6]:
            xmin = 39.495
            xmax = 56.530
            text = "011003: Qui-li-gi-no, Wa-da-la-mi-no, Da-mi-no, Ma-du-no a-de-lv a-gi-si-do-hi, Tsi-mi-no E-li-qui u-we-tsi, Le-qui-ya-no Da-di-ya tsa-no-se-ho-i,"
        intervals [7]:
            xmin = 56.530
            xmax = 57.640
            text = ""
        intervals [8]:
            xmin = 57.640
            xmax = 66.510
            text = "011004: Sa-wa-ni-no A-ge-na-ni-di, Tsu-da-si-no I-s-ga-la-di na-s-gi Tsi-sa tsu-lo-nu-he-lv-gi."
        intervals [9]:
            xmin = 66.510
            xmax = 67.515
            text = ""
        intervals [10]:
            xmin = 67.515
            xmax = 89.110
            text = "011005: Na-s-gi hi-a ta-la-du i-ya-ni-dv Tsi-sa du-nv-sv-gi du-ne-tse-lv-no hi-a ni-du-we-se-lv-gi; Tsu-na-da-le-nv-dv yv-wi di-ne-hv i-di-tlv tle-s-di wi-tsi-lo-sv-gi, a-le Sa-me-li a-ne-hi du-ni-du-hv tle-s-di i-tsi-yv-lv-gi"
        intervals [11]:
            xmin = 89.110
            xmax = 90.190
            text = ""
        intervals [12]:
            xmin = 90.190
            xmax = 96.900
            text = "011006: A-wi-s-gi-ni u-na-le-na-hi-dv I-si-li si-da-ne-lv ge-sv di-tsi-wa-dv-hu-ga."
        intervals [13]:
            xmin = 96.900
            xmax = 98.105
            text = ""
        intervals [14]:
            xmin = 98.105
            xmax = 108.500
            text = "011007: I-tsa-i-sv-no i-tsa-li-tsi-do-hv-s-ge-s-di, hi-a ni-tsi-we-s-ge-s-di; Ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv e-s-ga-ni-yu da-ya-i."
        intervals [15]:
            xmin = 108.500
            xmax = 109.440
            text = ""
        intervals [16]:
            xmin = 109.440
            xmax = 129.470
            text = "011008: Tsu-ni-tlv-gi de-tsi-nv-wi-s-ge-s-di, a-da-ye-s-gi tsu-ni-tlv-gi de-tsi-nv-ga-li-s-ge-s-di, tsu-ni-yo-hu-sv-hi de-tsa-le-di-s-ge-s-di, a-ni-s-gi-na de-tsi-nu-go-wi-s-ge-s-di.  A-se-quo e-tsi-ne-lv-hi, a-se-quo i-tsa-da-ne-he-s-di."
        intervals [17]:
            xmin = 129.470
            xmax = 130.290
            text = ""
        intervals [18]:
            xmin = 130.290
            xmax = 140.770
            text = "011009: Tle-s-di de-tsa-da-tlo-hv yi-tsa-da-ne-le-s-di da-lo-ni-ge a-de-lv a-le u-ne-gv a-de-lv a-le v-tsa-yi,"
        intervals [19]:
            xmin = 140.770
            xmax = 141.905
            text = ""
        intervals [20]:
            xmin = 141.905
            xmax = 157.670
            text = "011010: A-le de-ga-lo-di, a-le ta-li di-tsa-nu-wo, a-le di-la-su-lo, a-le di-do-la-nv-s-di; tsu-lv-wi-s-da-ne-hi-ye-no u-wa-dv-di ge-so u-li-s-da-yv-di."
        intervals [21]:
            xmin = 157.670
            xmax = 158.865
            text = ""
        intervals [22]:
            xmin = 158.865
            xmax = 175.400
            text = "011011: I-lv-hi-tlv-no u-dv-na ga-du-hv a-le u-s-di ga-du-hv i-tsi-lu-ge-s-di, i-tsa-da-dv-dv-hv-s-ge-s-di gi-lo e-hv u-da-nv-ti, na-hna-no i-tsi-ne-s-di gv-ni v-tsa-ni-gi."
        intervals [23]:
            xmin = 175.400
            xmax = 176.510
            text = ""
        intervals [24]:
            xmin = 176.510
            xmax = 180.090
            text = "011012: A-da-ne-lv-no i-tsi-yv-ha i-tsi-yo-li-he-s-di."
        intervals [25]:
            xmin = 180.090
            xmax = 180.985
            text = ""
        intervals [26]:
            xmin = 180.985
            xmax = 206.090
            text = "011013: I-yu-no na-hna a-ni-ne-la u-wa-do-hi-ya-dv di-gv-wa-na-da-ni-lv-i-s-di i-ge-se-s-di, na-s-gi u-wa-do-hi-ya-dv i-tsa-tse-li u-ni-lu-tse-di ge-se-s-di; i-yu-no di-gv-wa-na-da-ni-lv-i-s-di ni-ge-sv-na i-ge-se-s-di, na-s-gi nv-wa-do-hi-ya-dv i-tsv-sv-quo i-tsi-lu-tse-di i-ge-se-s-di."
        intervals [27]:
            xmin = 206.090
            xmax = 206.730
            text = ""
        intervals [28]:
            xmin = 206.730
            xmax = 226.910
            text = "011014: I-yu-no gi-lo ni-di-tsa-da-ni-lv-gv-na i-ge-se-s-di, a-le i-tsi-ne-gv na-dv-gi-s-gv-na i-ge-se-s-di, na-hna ga-li-tso-de a-le ga-du-hv i-tsi-nu-go-gi, de-tsi-nv-go-v-di-s-ge-s-di ga-da di-tsa-la-si-de-ni."
        intervals [29]:
            xmin = 226.910
            xmax = 227.230
            text = ""
        intervals [30]:
            xmin = 227.230
            xmax = 243.180
            text = "011015: U-do-hi-yu-hi-ya hi-a ni-tsv-yu-we-se-ha, e-s-ga-quo i-ga-i u-ni-gi-li-yo-i-s-di ge-se-s-di So-da-mi a-le Go-ma-li, di-gu-go-do-di-yi i-ga ge-se-s-di, u-tli-hi-yu na-s-gi na ga-du-hv-i."
        intervals [31]:
            xmin = 243.180
            xmax = 243.840
            text = ""
        intervals [32]:
            xmin = 243.840
            xmax = 262.325
            text = "011016: Gv-ni-yu-quo i-tsv-nv-li a-wi u-ni-no-de-na tsa-ne-la-di-do-ho wa-yo-hi na-s-gi-ya-i; na-s-gi i-yu-s-di i-na-dv i-ge-tsi-si-na-sa-ni ge-sa-s-di, a-le gu-le--di-ni-s-go-ni-hi i-ge-tsa-da-nv-ti ge-se-s-di."
        intervals [33]:
            xmin = 262.325
            xmax = 263.080
            text = ""
        intervals [34]:
            xmin = 263.080
            xmax = 274.565
            text = "011017: De-tse-ya-do-tse-he-s-di a-di-na yv-wi, de-ga-la-wi-v-ye-no do-da-ge-tsa-ti-no-li, tsu-ni-la-wi-i-s-di-yi-no do-da-ge-tsi-li-v-ni-li."
        intervals [35]:
            xmin = 274.565
            xmax = 275.200
            text = ""
        intervals [36]:
            xmin = 275.200
            xmax = 291.950
            text = "011018: A-le a-yv ge-sv nv-di-ga-li-s-do-di-s-ge-s-di nu-ni-gv-wi-yu-sa-de-gi a-le u-ni-gv-wi-yu-hi du-no-lv i-gv-yi-di-tlv de-tsa-ti-no-hi-he-s-di, na-s-gi u-nv-sv a-le Tsu-na-da-le-nv-dv yv-wi u-na-do-le-ho-hi-s-do-di."
        intervals [37]:
            xmin = 291.950
            xmax = 292.960
            text = ""
        intervals [38]:
            xmin = 292.960
            xmax = 309.835
            text = "011019: A-se-no hna-quo de-ge-tsa-ti-no-hi-he-s-di tle-s-di yi-tse-li-hi-s-ge-s-di i-yu-s-di i-tsi-ne-i-s-di-yi a-le i-tsi-we-s-di-yi; na-hi-yu-quo-ye-no e-tsi-ne-di ge-se-s-di i-tsi-we-s-di-yi."
        intervals [39]:
            xmin = 309.835
            xmax = 310.710
            text = ""
        intervals [40]:
            xmin = 310.710
            xmax = 319.560
            text = "011020: V-tla-ye-no ni-hi yi-tsi-ne-go-i, I-tsi-do-da-s-gi-ni U-da-nv-do ka-ne-go-i ni-hi i-tsv-di-s-go-i."
        intervals [41]:
            xmin = 319.560
            xmax = 320.640
            text = ""
        intervals [42]:
            xmin = 320.640
            xmax = 344.165
            text = "011021: A-s-ga-ya-no do-da-yu-yo-si u-yo-hu-hi-s-di-yi di-na-da-nv-tli, a-ga-yv-li-ge-no u-we-tsi do-da-yu-yo-si, a-le o-ni tsu-na-dv-sv-hi do-dv-na-tlu-ta-ni tsu-ni-ga-yv-li-ge-i, a-le na-s-gi nv-dv-nv-ni-sa-ni di-ge-tsi-i-s-di ge-se-s-di."
        intervals [43]:
            xmin = 344.165
            xmax = 344.985
            text = ""
        intervals [44]:
            xmin = 344.985
            xmax = 358.920
            text = "011022: A-le na-ni-v-quo yv-wi ge-tsi-s-ga-gi ge-se-s-di a-yv da-qua-do-v nv-di-ga-li-s-do-di-s-ge-s-di; a-se-no na-s-gi gv-li-s-qua-di-s-gi a-tli-ni-gv-ne-hi a-tsi-s-de-lv-di ge-se-s-di."
        intervals [45]:
            xmin = 358.920
            xmax = 359.530
            text = ""
        intervals [46]:
            xmin = 359.530
            xmax = 382.235
            text = "011023: A-le hna-quo u-yo ni-ge-tsv-hna-de-ge-s-di i-lv-hi-tlv ga-du-hv-i, i-lo-li-s-ge-s-di nv-wa-li-le di-ga-du-hv wi-tsi-lo-s-ge-s-di.  U-do-hi-yu-hi-ya-ye-no hi-a ni-tsv-we-se-ha, V-tla I-si-li-yi de-ga-du-hv-i yi-ge-tse-do-ne-s-di hna-quo yv-wi U-we-tsi da-ga-lu-tsi."
        intervals [47]:
            xmin = 382.235
            xmax = 383.200
            text = ""
        intervals [48]:
            xmin = 383.200
            xmax = 397.120
            text = "011024: Di-de-lo-qua-s-gi v-tla u-tli yi-na-tsi-lv-quo-do-i e-s-ga-quo tsu-we-yo-hv-s-gi, a-le a-tsi-nv-si-da-s-di v-tla u-tli yi-na-tsi-lv-quo-do-i sv-s-ga-quo u-nv-si-do-hi."
        intervals [49]:
            xmin = 397.120
            xmax = 398.100
            text = ""
        intervals [50]:
            xmin = 398.100
            xmax = 421.735
            text = "011025: Ye-li-quo-ye-no di-de-lo-qua-s-gi tsu-we-yo-hv-s-gi i-tsu-la-ha-quo yi-gi, a-le a-tsi-nv-si-da-s-di u-nv-si-do-hi i-tsu-la-ha-quo yi-gi.  I-yu-ye-no tsu-da-ti-hna-i a-da-ne-lv Que-li-tsi-qua yu-no-se-lv, u-tli a-hi-di-yu na-s-gi i-tsu-ni-we-se-di-yi du-da-ti-hna-v-i."
        intervals [51]:
            xmin = 421.735
            xmax = 422.475
            text = ""
        intervals [52]:
            xmin = 422.475
            xmax = 441.605
            text = "011026: Na-s-gi i-yu-s-di tle-s-di yi-di-tsi-s-ga-i-he-s-di.  V-tla-ye-no go-hu-s-di yi-gv-s-ga-la na-s-gi gv-ni-ge-sv i-yu-li-s-do-di ni-ge-sv-na ge-sv-i, v-tla a-le go-hu-s-di u-de-li-dv yi-gi na-s-gi a-do-le-ho-hi-s-di ni-ge-sv-na ge-sv-i."
        intervals [53]:
            xmin = 441.605
            xmax = 442.370
            text = ""
        intervals [54]:
            xmin = 442.370
            xmax = 455.495
            text = "011027: U-li-si-gv i-tsv-ne-tse-lv-i i-ga-ga-dv i-tsi ne-ge-s-di; e-tsa-do-nv-e-lv-no ge-sv ga-sa-na-li i-tsa-li-tsi-do-hv-s-ge-s-di."
        intervals [55]:
            xmin = 455.495
            xmax = 456.590
            text = ""
        intervals [56]:
            xmin = 456.590
            xmax = 478.000
            text = "011028: A-le tle-s-di yi-di-tsi-s-ga-i-he-s-di a-ye-lv-i a-ni-hi-hi, a-se-no a-da-nv-do gv-wa-ni-hi-s-di ni-ge-sv-na tsi-gi.  U-gv-wi-yu-se-s-di-s-gi-ni e-tsi-s-ga-i-he-s-di na-s-gi di-gv-wa-hi-s-di tsi-gi a-ye-lv-i a-le a-da-nv-do i-tsu-la tsv-s-gi-no-i."
        intervals [57]:
            xmin = 478.000
            xmax = 479.065
            text = ""
        intervals [58]:
            xmin = 479.065
            xmax = 494.840
            text = "011029: Tla-s-go a-ni-ta-li tsi-s-qua-ya sa-quo i-ya-da-nv-te-di tsu-na-gv-wa-lo-di yi-gi, a-se-no v-tla sa-quo e-la-di u-nv-i-s-di yi-gi I-tsi-do-da u-da-nv-te-lv-hi ni-ge-sv-na."
        intervals [59]:
            xmin = 494.840
            xmax = 495.590
            text = ""
        intervals [60]:
            xmin = 495.590
            xmax = 500.895
            text = "011030: Na-s-quo-s-gi-ni i-tsi-s-ti-ye-gv i-tsi-s-go-li ni-ga-di-yu di-se-lv-hi."
        intervals [61]:
            xmin = 500.895
            xmax = 507.280
            text = ""
        intervals [62]:
            xmin = 507.280
            xmax = 522.360
            text = "011031: Na-s-gi i-yu-s-di tle-s-di yi-tsi-s-ga-i-he-s-di; u-tli-ye-no ni-ga-v di-tsa-gv-wa-lo-di ni-hi e-s-ga-quo u-ni-tsa-ti tsi-s-qua-ya."
        intervals [63]:
            xmin = 522.360
            xmax = 523.280
            text = ""
        intervals [64]:
            xmin = 523.280
            xmax = 536.740
            text = "011032: Gi-lo-ye-no gv-ni-ge-sv na-quv-ne-he-s-di yv-wi a-ni-ga-ta-hv-i, na-s-quo a-yv na-s-gi gv-ni-ge-sv u-da-tsi-yv-ne-li E-do-da ga-lv-la-di e-hi a-ga-ta-hv-i."
        intervals [65]:
            xmin = 536.740
            xmax = 537.700
            text = ""
        intervals [66]:
            xmin = 537.700
            xmax = 548.045
            text = "011033: Gi-lo-s-gi-ni i-a-qua-da-yi-he-s-di yv-wi a-ni-ga-ta-hv-i, na-s-quo a-yv na-s-gi da-tsi-ya-da-yi-li E-do-da ga-lv-la-di e-hi a-ga-ta-hv-i."
        intervals [67]:
            xmin = 548.045
            xmax = 548.825
            text = ""
        intervals [68]:
            xmin = 548.825
            xmax = 562.770
            text = "011034: Tle-s-di do-hi-yi u-na-nu-go-wi-si-lv e-lo-hi, yi-s-gi-ye-li-se-he-s-di; v-tla-s-gi-ni do-hi-yi ya-gi-na-nu-go-wi-si-lv, a-ye-la-s-di-s-gi-ni ga-nv-hi-dv."
        intervals [69]:
            xmin = 562.770
            xmax = 563.700
            text = ""
        intervals [70]:
            xmin = 563.700
            xmax = 580.210
            text = "011035: A-yv-ye-no a-gi-lu-tsi-lv, di-na-da-s-ga-gi i-yu-li-s-do-di-yi a-s-ga-ya u-do-da-no, a-le a-ga-nv-gi a-ge-yv u-tsi-no, a-le u-da-tso-hi-ya u-tso-hi-no;"
        intervals [71]:
            xmin = 580.210
            xmax = 581.110
            text = ""
        intervals [72]:
            xmin = 581.110
            xmax = 587.090
            text = "011036: Gi-lo-no u-wa-sv-quo du-da-ti-hna-v gv-wa-s-ga-gi ge-se-s-di."
        intervals [73]:
            xmin = 587.090
            xmax = 588.465
            text = ""
        intervals [74]:
            xmin = 588.465
            xmax = 618.665
            text = "011037: Gi-lo-no u-tli nu-ge-yu-se-s-di u-do-da a-le u-tsi e-s-ga-quo a-yv na-gi-ge-yu-se-s-di, v-tla ye-li na-s-gi a-yv a-qua-tse-li i-gv-wa-li-s-do-di yi-ge-se-s-di.  Gi-lo-no u-tli nu-ge-yu-se-s-di u-we-tsi a-s-ga-ya a-le u-we-tsi a-ge-yv e-s-ga-quo a-yv na-gi-ge-yu-se-s-di, v-tla ye-li na-s-gi a-yv a-qua-tse-li i-gv-wa-li-s-do-di yi-ge-se-s-di."
        intervals [75]:
            xmin = 618.665
            xmax = 619.710
            text = ""
        intervals [76]:
            xmin = 619.710
            xmax = 633.030
            text = "011038: Gi-lo na-yi-s-gv-na i-ge-se-s-di u-tse-li tsu-da-hna-wa-dv a-le na-gi-s-da-wa-de-gv-na i-ge-se-s-di, v-tla ye-li a-yv a-qua-tse-li i-gv-wa-li-s-do-di yi-ge-se-s-di."
        intervals [77]:
            xmin = 633.030
            xmax = 634.135
            text = ""
        intervals [78]:
            xmin = 634.135
            xmax = 649.485
            text = "011039: Gi-lo-no gv-nv i-a-wa-ti-s-ge-s-di, na-s-gi u-yo-hu-se-di ge-se-s-di; gi-lo-no i-u-yo-hu-se-he-s-di gv-nv a-yv nv-di-ga-li-s-do-di-s-ge-s-di, na-s-gi u-wa-dv-di ge-se-s-di."
        intervals [79]:
            xmin = 649.485
            xmax = 650.760
            text = ""
        intervals [80]:
            xmin = 650.760
            xmax = 663.545
            text = "011040: Gi-lo-no de-tsa-da-ni-lv-ge-s-di, na-s-gi a-yv da-qua-da-ni-lv-ge-s-di; gi-lo-no a-yv da-qua-da-ni-lv-ge-s-di, na-s-gi da-da-ni-lv-ge-s-di nv-dv-gi-nv-sv-hi"
        intervals [81]:
            xmin = 663.545
            xmax = 664.035
            text = ""
        intervals [82]:
            xmin = 664.035
            xmax = 693.745
            text = "011041: Gi-lo-no da-da-ni-lv-ge-s-di a-do-le-ho-s-gi a-do-le-ho-s-gi ge-sv u-di-ga-li-s-do-di-ge-s-di, a-do-le-ho-s-gi a-ga-gu-yv-da-ne-di ge-sv na-s-gi a-ga-gu-yv-da-ne-he-s-di; gi-lo-no da-da-ni-lv-ge-s-di u-da-nv-ti a-s-ga-ya u-da-nv-ti ge-sv u-di-ga-li-s-do di-s-ge-s-di, u-da-nv-ti a-s-ga-ya a-ga-gu-yv-da-ne-di ge-sv na-s-gi a-ga-gu-yv-da-ne-he-s-di."
        intervals [83]:
            xmin = 693.745
            xmax = 694.775
            text = ""
        intervals [84]:
            xmin = 694.775
            xmax = 719.540
            text = "011042: Gi-lo-no sa-quo hi-a tsu-na-s-di ge-sv-i u-li-s-qui-di-quo a-ka-li-i u-yv-dla a-ma a-hu-v-s-ge-s-di a-gi-s-da-wa-di-do-hi ge-sv nv-di-ga-li-s-do-di-s-ge-s-di, u-do-hi-yu-hi-ya ni-tsv-we-se-ha, v-tla na-s-gi u-yo-hu-se-di yi-ge-se-s-di a-ga-gu-yv-e-di ge-sv-i."
        intervals [85]:
            xmin = 719.540
            xmax = 720.085
            text = ""
    item [2]:
        class = "IntervalTier"
        name = "Words"
        xmin = 0
        xmax = 720.085
        intervals: size = 1089
        intervals [1]:
            xmin = 0.000
            xmax = 3.340
            text = ""
        intervals [2]:
            xmin = 3.340
            xmax = 4.340
            text = "Wi-du-ya-nv-hv-no"
        intervals [3]:
            xmin = 4.340
            xmax = 4.580
            text = ""
        intervals [4]:
            xmin = 4.580
            xmax = 4.980
            text = "ta-la-du"
        intervals [5]:
