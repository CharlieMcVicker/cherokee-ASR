item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 529.430
        intervals: size = 60
        intervals [1]:
            xmin = 0.000
            xmax = 4.255
            text = ""
        intervals [2]:
            xmin = 4.255
            xmax = 20.380
            text = "011101: Hi-a-no nu-li-s-ta-nv-gi; Tsi-sa u-s-qua-dv de-ka-ne-tse-hv ta-la-du i-ya-ni-dv gv-wa-s-da-wa-di-do-hi, u-ni-gi-sv-gi na-hna-ni, du-de-yo-u-sv-gi a-le u-li-tsi-do-nv-sv-gi du-ni-du-hna-v-i."
        intervals [3]:
            xmin = 20.380
            xmax = 21.185
            text = ""
        intervals [4]:
            xmin = 21.185
            xmax = 32.650
            text = "011102: Hna-quo-no Tsa-ni tsa-tsi-s-du-hv tsu-dv-ga-nv nu-s-dv du-lv-wi-s-da-ne-hv Ga-lo-ne-dv, do-tsu-nv-se a-ni-ta-li gv-wa-s-da-wa-di-do-hi,"
        intervals [5]:
            xmin = 32.650
            xmax = 33.680
            text = ""
        intervals [6]:
            xmin = 33.680
            xmax = 45.860
            text = "011103: Hi-a nv-da-yu-we-se-lv-gi; Ni-hi-s-go na u-lu-hi-s-di tsi-gi, tsi-go-ge nv-wa-da-le o-tsi-ga-te-no-he-s-di?"
        intervals [7]:
            xmin = 45.860
            xmax = 46.930
            text = ""
        intervals [8]:
            xmin = 46.930
            xmax = 60.770
            text = "011104: Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-lv-gi; tsi-s-de-na Tsa-ni wi-e-s-di-no-hv-si ni-ga-v i-s-da-dv-gi-s-gv-i a-le i-s-di-go-wa-ti-s-gv-i:"
        intervals [9]:
            xmin = 60.770
            xmax = 61.910
            text = ""
        intervals [10]:
            xmin = 61.910
            xmax = 87.305
            text = "011105: Di-ni-ge-wi a-ni-go-wa-ti-ha, di-ni-yo-u-li-no a-ne-do-ha, a-da-ye-s-gi tsu-ni-tlv-gi du-na-di-wa-s-ga, tsu-ni-li-e-na-no a-na-dv-gi-ha, tsu-ni-yo-hu-sv-hi-no de-ge-ga-le-di-ha u-yo-no i-yu-na-dv-hna-de-gi o-s-dv ka-no-he-dv i-ge-ga-li-tsi-do-ne-ha."
        intervals [11]:
            xmin = 87.305
            xmax = 88.600
            text = ""
        intervals [12]:
            xmin = 88.600
            xmax = 95.485
            text = "011106: A-le o-si-yu i-yu-li-s-da-ne-di gi-lo-ni-di-tsi-yo-de-s-di-s-gv-na i-ge-se-s-di."
        intervals [13]:
            xmin = 95.485
            xmax = 96.895
            text = ""
        intervals [14]:
            xmin = 96.895
            xmax = 112.590
            text = "011107: I-u-ne-nv-no Tsi-sa u-le-nv-hv-gi hi-a ni-du-we-se-lv-gi u-ni-tsa-ti Tsa-ni du-no-he-da-ne-lv-gi; Ga-do i-tsa-ga-ta-nv-se i-na-ge-i?  Wa-so-na-s-go u-no-le u-te-lv-he-s-gv-i?"
        intervals [15]:
            xmin = 112.590
            xmax = 113.210
            text = ""
        intervals [16]:
            xmin = 113.210
            xmax = 126.375
            text = "011108: Ga-do-ge i-tsa-ga-ta-nv-se-i?  A-s-ga-ya-s-go di-wa-na-ge tsu-nu-wa-i?  Gv-ni-yu-quo di-wa-na-ge tsu-na-nu-wa-i u-ni-gv-wi-yu-hi da-ni-ne-lv a-ne-ho-i."
        intervals [17]:
            xmin = 126.375
            xmax = 126.950
            text = ""
        intervals [18]:
            xmin = 126.950
            xmax = 138.435
            text = "011109: Ga-do-ge i-tsa-ga-ta-nv-se-i?  A-do-le-ho-s-gi-s-go?  V-v, i-tsv-yo-se-ha, a-le u-tli-hi-yu e-s-ga-quo a-do-le-ho-s-gi."
        intervals [19]:
            xmin = 138.435
            xmax = 139.435
            text = ""
        intervals [20]:
            xmin = 139.435
            xmax = 158.820
            text = "011110: Na-s-gi-s-gi-ni hi-a na ge-go-we-lv hi-a a-tsi-no-he-lv-s-gv tsi-ni-gv-nv; Gv-ni-yu-quo, tsi-nv-li tsi-nv-si-da-s-di tsa-ka-dv i-gv-yi-di-tlv, na-s-gi da-tsa-dv-nv-i-s-da-ne-li tsa-lo-hi-s-di-yi i-gv-yi-di-tlv."
        intervals [21]:
            xmin = 158.820
            xmax = 159.780
            text = ""
        intervals [22]:
            xmin = 159.780
            xmax = 184.925
            text = "011111: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, A-ni-ge-yv gv-wa-ni-na-nu-go-wi-sv-hi tsi-gi v-tla gi-lo yu-na-nu-go-tsv gv-wa-da-li-ne-hi-de-di Tsa-ni di-da-wo-s-gi; a-se-no u-s-di-ka-ni ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv u-tli a-tsi-lv-quo-di-yu e-s-ga-quo tsa-ni."
        intervals [23]:
            xmin = 184.925
            xmax = 186.020
            text = ""
        intervals [24]:
            xmin = 186.020
            xmax = 204.315
            text = "011112: Tsa-ni-no di-da-wo-s-gi u-na-nu-go-tsv nv-da-gv-wa-da-le-nv-dv go-hi i-ya-s-ti ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv a-na-ne-lu-gi-e-ha, a-na-ne-lu-gi-s-gi-no gv-s-ga-i-s-da-gi da-ni-ni-yi-ha."
        intervals [25]:
            xmin = 204.315
            xmax = 204.990
            text = ""
        intervals [26]:
            xmin = 204.990
            xmax = 214.570
            text = "011113: Na-ni-v-ye-no a-na-do-le-ho-s-gi a-le di-ka-hna-wa-dv-s-di a-na-do-le-ho-s-gv-gi Tsa-ni u-na-nu-go-tsi-lv i-ya-s-ti."
        intervals [27]:
            xmin = 214.570
            xmax = 215.380
            text = ""
        intervals [28]:
            xmin = 215.380
            xmax = 223.975
            text = "011114: I-yu-no di-ge-tsa-da-ni-lv-i-s-di ge-se-s-di, na-s-gi hi-a I-la-ya u-lu-hi-s-di tsi-ge-sv-gi."
        intervals [29]:
            xmin = 223.975
            xmax = 224.665
            text = ""
        intervals [30]:
            xmin = 224.665
            xmax = 229.780
            text = "011115: Gi-lo de-ga-li-lu-ge-s-di u-dv-go-di-yi na-s-gi a-dv-gi-s-ge-s-di."
        intervals [31]:
            xmin = 229.780
            xmax = 230.505
            text = ""
        intervals [32]:
            xmin = 230.505
            xmax = 247.180
            text = "011116: Ga-do-ge do-da-ga-tsi-ya-tli-lo-s-ta-ni hi-a go-hi tsa-ne-ha?  Di-ni-yo-li-quo na-s-gi-ya ga-no-do-di-yi tsa-ni-no-i a-le tsi-wi-da-ni-ya-ni-s-go u-ne-da-s-di;"
        intervals [33]:
            xmin = 247.180
            xmax = 253.885
            text = ""
        intervals [34]:
            xmin = 253.885
            xmax = 274.575
            text = "011117: A-le hi-a tsi-ni-da-ni-we-se-ho-i; a-tse-lu-gi o-gv-ta-nv de-tsv-no-gi-e-lv, a-se-no v-tla yi-tsa-li-s-gi-sv; do-tsi-yv-gv-gi i-tsa-dv-go-di, a-se-no v-tla yi-di-tsa-tlo-yi-lv."
        intervals [35]:
            xmin = 274.575
            xmax = 275.470
            text = ""
        intervals [36]:
            xmin = 275.470
            xmax = 287.750
            text = "011118: Tsa-ni-ye-no u-lu-tsv-gi v-tla ya-li-s-da-yv-hv-s-ge-i a-le v-tla ya-di-ta-s-ge-i, a-se-no ni-a-ni-we-ha; A-s-gi-na u-ya-a."
        intervals [37]:
            xmin = 287.750
            xmax = 289.110
            text = ""
        intervals [38]:
            xmin = 289.110
            xmax = 317.135
            text = "011119: Yv-wi u-we-tsi u-lu-tsv a-li-s-da-yv-hv-s-ga a-le a-di-ta-s-ga, hi-a-no ni-a-ni-we-ha; Gv-ni-yu-quo a-s-ga-ya u-gv-v-s-gi a-li-s-da-yv-di a-le gi-ga-ge--a-di-ta-s-di, a-de-lv a-ni-gi-si-do-hi a-le a-ni-s-de-na u-na-li-i.  A-se-no a-ga-ta-hna-i tsu-we-tsi o-si-yu i-gv-wa-ye-lv-ha."
        intervals [39]:
            xmin = 317.135
            xmax = 318.300
            text = ""
        intervals [40]:
            xmin = 318.300
            xmax = 334.875
            text = "011120: Hna-quo-no u-le-nv-hv-gi du-gv-s-go-lv-nv-gi du-ni-du-hv-i na-hna u-tli i-ga-i u-s-qua-ni-go-di du-lv-wi-s-da-ne-lv-i, nv-da-ga-li-s-do-di-s-gv-gi du-na-da-nv-dv ni-du-ni-ne-tli-yv-sv-na ge-sv-i."
        intervals [41]:
            xmin = 334.875
            xmax = 335.880
            text = ""
        intervals [42]:
            xmin = 335.880
            xmax = 371.760
            text = "011121: U-yo-i-yu i-tsa-li-s-da-ne-di Go-le-si-ni, u-yo-i-yu i-tsa-li-s-da-ne-di Que-tsa-yi-di; i-yu-ye-no u-s-qua-ni-go-di de-ga-lv-wi-s-da-ne-lv ni-hi i-tse-hv yi-do-ga-lv-wi-s-da-ne-le Ta-ya a-le Sa-do-ni, go-hi-gi di-gv-wa-ni-ne-tli-yv-dv yi-ge-se du-na-da-nv-dv-i, tsu-si-de-na yi-du-na-nu-wo-e a-le go-s-du yu-na-da-nv-li-ye-e-i."
        intervals [43]:
            xmin = 371.760
            xmax = 372.740
            text = ""
        intervals [44]:
            xmin = 372.740
            xmax = 388.170
            text = "011122: A-se-no hi-a ni-tsv-we-se-ha; e-s-ga-quo i-ga-i u-ni-gi-li-yo-i-s-di ge-se-s-di Ta-ya a-le Sa-do-ni, di-gu-go-do-di-yi i-ga ge-se-s-di, u-tli-hi-yu ni-hi."
        intervals [45]:
            xmin = 388.170
            xmax = 389.360
            text = ""
        intervals [46]:
            xmin = 389.360
            xmax = 413.825
            text = "011123: Ni-hi-no Ge-qua-ni ga-lv-la-di i-yv-dv tse-tsa-sa-la-da, tsv-s-gi-no-i wv-da-ye-lo-v-ta-ni; i-yu-ye-no u-s-qua-ni-go-di de-ga-lv-wi-s-da-ne-lv ni-hi i-tse-hv yi-do-ga-lv-wi-s-da-ne-le So-da-mi-yi, a-si go-hi ge-sv yi-ni-gv-wa-s-de-quo."
        intervals [47]:
            xmin = 413.825
            xmax = 414.665
            text = ""
        intervals [48]:
            xmin = 414.665
            xmax = 427.965
            text = "011124: A-se-no hi-a ni-tsv-we-se-ha; E-s-ga-quo i-ga-i u-ni-gi-li-yo-i-s-di ge-se-s-di So-li-mi di-gu-go-do-di-yi i-ga ge-se-s-di, u-tli-hi-yu ni-hi."
        intervals [49]:
            xmin = 427.965
            xmax = 428.965
            text = ""
        intervals [50]:
            xmin = 428.965
            xmax = 452.455
            text = "011125: Na-hi-yu Tsi-sa u-ne-tsv hi-a nu-we-sv-gi; Gv-ya-li-e-li-tse-ha E-do-da, Tsa-gv-wi-yu-hi ga-lv-la-di a-le e-lo-hi, na-s-gi hi-a tsi-de-hv-s-ga-la-ne-lv a-ni-si-na-sa-ni a-le a-ne-ya-ta-hi, di-ni-yo-li-no tsi-de-hi-na-nu-go-wi-se-lv."
        intervals [51]:
            xmin = 452.455
            xmax = 454.525
            text = ""
        intervals [52]:
            xmin = 454.525
            xmax = 459.815
            text = "011126: V-v, E-do-da, na-s-gi-ye-no o-si-yu tsa-ye-lv-nv-hi."
        intervals [53]:
            xmin = 459.815
            xmax = 461.280
            text = ""
        intervals [54]:
            xmin = 461.280
            xmax = 483.235
            text = "011127: Ni-ga-v go-hu-s-di da-gi-yo-hi-se-lv E-do-da, a-le v-tla gi-lo ya-ga-ta-ha U-we-tsi U-do-da-quo u-wa-sv; v-tla a-le gi-lo ya-ga-ta-ha a-ga-yv-li-ge-i U-we-tsi u-wa-sv, gi-lo-no na-s-gi tsi-na-nu-go-wi-si e-la U-we-tsi."
        intervals [55]:
            xmin = 483.235
            xmax = 484.715
            text = ""
        intervals [56]:
            xmin = 484.715
            xmax = 501.380
            text = "011128: E-tse-na, a-yv s-gi-lu-tsi, ni-ga-di-yu a-gi-li-ya di-tsi-lv-wi-s-da-ne-hi, a-le ga-ge-dv di-tsa-li-se-hi, a-yv-no da-tsv-ya-we-so-lv-s-ta-ni."
        intervals [57]:
            xmin = 501.380
            xmax = 503.005
            text = ""
        intervals [58]:
            xmin = 503.005
            xmax = 521.845
            text = "011129: I-tsi-yv a-qua-gi-la-na-lo a-le s-gi-ya-de-lo-qua-si, a-qua-da-nv-ti-yu-ye-no a-le a-qua-da-do-li-s-di-yu a-gi-na-wi-yi, da-tsi-wa-dv-hi-no di-tsa-da-nv-do tsu-ya-we-so-lv-s-di-yi."
        intervals [59]:
            xmin = 521.845
            xmax = 522.545
            text = ""
        intervals [60]:
            xmin = 522.545
            xmax = 529.430
            text = "011130: A-qua-gi-la-na-lo-ye-no nu-hi-so-dv-na, ga-li-se-hv-no u-da-sa-ka-hi-yu."
