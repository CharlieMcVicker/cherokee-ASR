item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 273.430
        intervals: size = 40
        intervals [1]:
            xmin = 0.000
            xmax = 4.350
            text = ""
        intervals [2]:
            xmin = 4.350
            xmax = 18.865
            text = "012801: U-na-do-da-quo-nv-hi-no, gi-la i-ga ni-ga-li-s-di-s-ge-i a-le-ni-s-gv su-na-do-da-qua-s-di ge-sv Me-li Ma-gi-de-li e-hi a-le so-i Me-li u-na-ga-ta-ni-le a-tse-li-s-dv-i."
        intervals [3]:
            xmin = 18.865
            xmax = 19.720
            text = ""
        intervals [4]:
            xmin = 19.720
            xmax = 38.045
            text = "012802: A-le gv-ni-yu-quo u-tsa-ti ga-do-hi u-li-te-lv-ne-i, Yi-ho-wa-ye-no u-tse-li di-ka-hna-wa-di-do-hi ga-lv-la-di tsu-tlo-a-se-i, u-lu-tsv-no nv-ya u-we-sa-qua-le-le u-hv-se ga-lo-hi-s-di-yi a-hv-i; a-le u-s-gi-la-ne-i."
        intervals [5]:
            xmin = 38.045
            xmax = 39.130
            text = ""
        intervals [6]:
            xmin = 39.130
            xmax = 49.165
            text = "012803: Di-ka-no-di-yi a-na-ga-li-s-gi na-s-gi-ya ge-se-i, u-nu-wa-v-no v-no-tsi tsi-nu-ne-gi-yv nu-ne-gi-ye-i."
        intervals [7]:
            xmin = 49.165
            xmax = 50.345
            text = ""
        intervals [8]:
            xmin = 50.345
            xmax = 58.715
            text = "012804: A-ni-ga-ti-ya-no a-ni-s-ga-i-hv du-ni-na-we-i, a-le tsu-ni-yo-hu-sv-hi na-s-gi-ya nu-na-li-s-ta-ne-i."
        intervals [9]:
            xmin = 58.715
            xmax = 59.685
            text = ""
        intervals [10]:
            xmin = 59.685
            xmax = 73.005
            text = "012805: Di-ka-hna-wa-di-do-hi-no u-ne-tsv hi-a ni-du-we-se-le a-ni-ge-yv; Tle-s-di ni-hi yi-s-di-s-ga-i-he-s-di, tsi-ga-ta-ha-ye-no Tsi-sa a-ga-dv-nv-hi e-s-di-yo-hv-i."
        intervals [11]:
            xmin = 73.005
            xmax = 73.555
            text = ""
        intervals [12]:
            xmin = 73.555
            xmax = 84.515
            text = "012806: V-tla a-ni ti-ga-na, du-le-nv-ye-no na-s-gi-ya nu-we-sv-i; E-s-de-na e-s-da-ga-ta U-gv-wi-yu-hi a-tsi-nv-nv-i."
        intervals [13]:
            xmin = 84.515
            xmax = 85.100
            text = ""
        intervals [14]:
            xmin = 85.100
            xmax = 104.970
            text = "012807: A-le u-li-s-di-yu i-s-de-na wi-di-s-di-no-hv-si gv-wa-s-da-wa-di-do-hi de-u-le-nv u-yo-hu-sv-i; a-le gv-ni-yu-quo i-gv-yi Ge-li-li nv-da-ye-si, na-hna da-ye-tsi-go-i.  Gv-ni-yu-quo i-s-dv-no-hv-si."
        intervals [15]:
            xmin = 104.970
            xmax = 106.040
            text = ""
        intervals [16]:
            xmin = 106.040
            xmax = 119.775
            text = "012808: U-li-s-di-yu-no a-tse-li-s-dv u-na-da-nv-se-i, a-ni-s-ga-i-he a-le u-tsa-ti a-na-li-he-li-ge-i, a-le du-ni-s-qua-lv-ta-ne gv-wa-s-da-wa-di-do-hi du-ni-no-ne-lv-se-i."
        intervals [17]:
            xmin = 119.775
            xmax = 120.790
            text = ""
        intervals [18]:
            xmin = 120.790
            xmax = 138.420
            text = "012809: A-na-i-sv-no da-ni-no-ne-li-sv gv-wa-s-da-wa-di-do-hi gv-ni-yu-quo Tsi-sa du-na-tlo-se-i; Do-hi-yi de-da-da-go-wa-dv, u-dv-ne-i.  U-ni-lu-tsv-no tsu-la-si-de-ni du-ni-ni-yv-he-i, e-la-di ni-gv-wa-dv-ne-le-i."
        intervals [19]:
            xmin = 138.420
            xmax = 139.430
            text = ""
        intervals [20]:
            xmin = 139.430
            xmax = 155.010
            text = "012810: Hna-quo-no Tsi-sa hi-a ni-du-we-se-le-i, Tle-s-di yi-s-di-s-ga-i-he-s-di; i-s-de-na wi-di-s-di-no-hv-si o-tsa-li-nv-tli Ge-li-li wu-ni-lo-hi-s-di-yi, na-hna-no da-gv-gi-go-hi."
        intervals [21]:
            xmin = 155.010
            xmax = 155.900
            text = ""
        intervals [22]:
            xmin = 155.900
            xmax = 170.375
            text = "012811: A-na-i-sv-no gv-ni-yu-quo i-ga-dv u-ni-ya-wi-sv-hi u-ni-lu-tse ga-du-hv-i, a-le nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi du-ni-no-ne-le ni-ga-dv nu-li-s-ta-ni-do-lv-i."
        intervals [23]:
            xmin = 170.375
            xmax = 171.480
            text = ""
        intervals [24]:
            xmin = 171.480
            xmax = 182.090
            text = "012812: Na-s-gi-no a-le di-ni-la-wi-gi du-ni-la-wi-tsv a-le u-ni-no-he-lv, u-tsa-ti a-de-lv du-ni-ne-le a-ni-ya-wi-s-gi,"
        intervals [25]:
            xmin = 182.090
            xmax = 182.640
            text = ""
        intervals [26]:
            xmin = 182.640
            xmax = 193.870
            text = "012813: Hi-a nu-ni-we-se-i; Hi-a ni-tsi-we-sv-ha; Gv-wa-s-da-wa-di-do-hi sv-no-yi u-ni-lu-tsv-gi, o-tsi-li-nv gv-wa-no-s-gi-sv-gi."
        intervals [27]:
            xmin = 193.870
            xmax = 194.690
            text = ""
        intervals [28]:
            xmin = 194.690
            xmax = 202.200
            text = "012814: I-yu-no na-s-gi a-dv-ga-nv u-gv-wi-yu-hi, da-yo-tsi-s-di-ye-ta-ni, a-le da-tsv-s-de-lv-hi."
        intervals [29]:
            xmin = 202.200
            xmax = 203.020
            text = ""
        intervals [30]:
            xmin = 203.020
            xmax = 213.530
            text = "012815: Du-ni-gi-sv-no a-de-lv, ni-ge-tsi-we-se-lv nu-na-dv-ne-le-i.  Na-s-gi-no hi-a ka-no-he-dv a-si a-ni-no-he-li-do-ha A-ni-tsu-si."
        intervals [31]:
            xmin = 213.530
            xmax = 214.390
            text = ""
        intervals [32]:
            xmin = 214.390
            xmax = 224.010
            text = "012816: Hna-quo-no sa-du i-ya-ni-dv gv-wa-s-da-wa-di-do-hi Ge-li-li u-ne-nv-sv-gi tso-da-lv Tsi-sa u-na-se-he-lv-i."
        intervals [33]:
            xmin = 224.010
            xmax = 224.900
            text = ""
        intervals [34]:
            xmin = 224.900
            xmax = 232.300
            text = "012817: Gv-wa-go-hv-no e-la-di ni-gv-wa-dv-ne-lv-gi.  A-se-no i-ga-dv u-na-dla-si-dv-e-lv-quo."
        intervals [35]:
            xmin = 232.300
            xmax = 232.720
            text = ""
        intervals [36]:
            xmin = 232.720
            xmax = 242.415
            text = "012818: Tsi-sa-no u-lu-tsv du-wo-ne-ta-nv-gi, hi-a nu-we-sv-gi; V-gi-ne-lv ni-ga-v di-gi-lv-wi-s-da-ne-di-yi ga-lv-la-di a-le e-lo-hi."
        intervals [37]:
            xmin = 242.415
            xmax = 243.080
            text = ""
        intervals [38]:
            xmin = 243.080
            xmax = 258.845
            text = "012819: Na-s-gi i-yu-s-di i-tse-na wi-di-tse-yo-hv-ga na-ga-dv nu-na-da-le-sv yv-wi, de-tsa-wo-s-ge-s-di i-tsv-di-s-ge-s-di du-do-v A-ga-yv-li-ge-i a-le U-we-tsi a-le Ga-lv-quo-di-yu A-da-nv-do,"
        intervals [39]:
            xmin = 258.845
            xmax = 259.720
            text = ""
        intervals [40]:
            xmin = 259.720
            xmax = 273.430
            text = "012820: De-tse-yo-hv-s-ge-s-di tsu-ni-ka-hna-wa-dv-s-di-yi ni-ga-v i-tsv-ne-tse-lv-i; gv-ni-yu-quo-no ni-go-hi-lv i-tsv-ye-la-di-do-ha wi-gv-li-s-qua-di-s-gi e-lo-hi.  E-me-nv."
