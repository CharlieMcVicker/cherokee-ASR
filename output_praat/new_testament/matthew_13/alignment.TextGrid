File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 1003.580
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 1003.580
        intervals: size = 116
        intervals [1]:
            xmin = 0.000
            xmax = 4.025
            text = ""
        intervals [2]:
            xmin = 4.025
            xmax = 12.340
            text = "011301: Na-hi-yu i-ga Tsi-sa u-nu-go-tsv-gi a-da-ne-lv-i, a-le v-da-lu-lo-di u-we-nv-gi."
        intervals [3]:
            xmin = 12.340
            xmax = 13.625
            text = ""
        intervals [4]:
            xmin = 13.625
            xmax = 29.790
            text = "011302: U-ni-tsa-ti-no yv-wi gv-wa-da-tlu-wi-s-ta-nv-gi, na-s-gi i-yu-s-di tsi-yu-hi u-tsa-nv-gi, a-le u-we-nv-gi.  Ni-ga-di-yu-no na-s-gi u-ni-tsa-ti a-ma-yu-lo-di a-ni-do-na-v-gi."
        intervals [5]:
            xmin = 29.790
            xmax = 31.230
            text = ""
        intervals [6]:
            xmin = 31.230
            xmax = 43.610
            text = "011303: De-u-wo-ne-ta-nv-no u-tsa-ti tsu-da-le-nv-dv du-tli-lo-s-da-ne-lv-gi; hi-a nu-we-sv-gi; Gv-ni-yu-quo, a-wi-s-gi u-wi-sv-se-i."
        intervals [7]:
            xmin = 43.610
            xmax = 44.740
            text = ""
        intervals [8]:
            xmin = 44.740
            xmax = 55.070
            text = "011304: U-wi-sv-no i-ga-dv nv-no-hu-lo-di u-la-ge-ya-dv-tse-i, tsi-s-qua-no u-ni-lu-tse a-le u-nu-ti-so-ne-i."
        intervals [9]:
            xmin = 55.070
            xmax = 56.210
            text = ""
        intervals [10]:
            xmin = 56.210
            xmax = 72.030
            text = "011305: I-ga-dv-no nv-yo-hi ge-sv u-la-ge-ya-dv-tse-i, ga-yo-li ga-da ga-la-ge-yv-i, gi-la-quo-no i-yv-dv u-li-ye-ne-i, nv-di-ga-li-s-do-di-s-ge sa-ge-i-yu ge-sv ga-da."
        intervals [11]:
            xmin = 72.030
            xmax = 73.080
            text = ""
        intervals [12]:
            xmin = 73.080
            xmax = 83.080
            text = "011306: A-se-no nv-do tsu-ka-lv-tsv u-le-yv-se-i, ni-du-hna-s-de-tlv-na-no ge-sv i-yu-s-di u-hna-s-gv-tse-quo."
        intervals [13]:
            xmin = 83.080
            xmax = 84.010
            text = ""
        intervals [14]:
            xmin = 84.010
            xmax = 92.760
            text = "011307: I-ga-dv-no a-nu-ga-lv-hi u-la-ge-ya-dv-tse-i, a-nu-ga-lv-no tsu-dv-sv u-ne-nu-la-s-ta-ne-i."
        intervals [15]:
            xmin = 92.760
            xmax = 93.740
            text = ""
        intervals [16]:
            xmin = 93.740
            xmax = 115.340
            text = "011308: I-ga-dv-s-gi-ni o-sv ga-do-hi u-la-ge-ya-dv-tse-i, na-s-gi-no u-ga-ta-ta-ne-i, i-ga-dv a-s-go-hi-tsu-qui u-ne-quo-tse-i, i-ga-dv-no su-da-la-s-go-hi u-ne-quo-tse-i, i-ga-dv-no tso-a-s-go-hi u-ne-quo-tse-i."
        intervals [17]:
            xmin = 115.340
            xmax = 116.180
            text = ""
        intervals [18]:
            xmin = 116.180
            xmax = 120.450
            text = "011309: Gi-lo de-ga-lu-ge-s-di u-dv-go-di-yi wa-dv-gv-ga."
        intervals [19]:
            xmin = 120.450
            xmax = 121.850
            text = ""
        intervals [20]:
            xmin = 121.850
            xmax = 132.470
            text = "011310: Gv-wa-s-da-wa-di-do-hi-no gv-wa-lu-tse-lv hi-a ni-gv-wa-we-se-lv-gi; Ga-do-no de-hi-wo-ne-di-s-gv tsi-de-ha-tli-lo-s-da-ne-ha?"
        intervals [21]:
            xmin = 132.470
            xmax = 133.515
            text = ""
        intervals [22]:
            xmin = 133.515
            xmax = 154.900
            text = "011311: U-ne-tsv-no hi-a ni-du-we-se-lv-gi; Nv-di-ga-li-s-do-di-s-gi-ni ni-hi e-tsi-ne-lv-hi ge-sv i-tso-li-s-di-yi u-de-li-dv ge-sv ga-lv-la-di e-hi u-gv wi-yu-hi ge-sv-i, na--s-gi-ni v-tla ge-ga-li-s-go-lv-da-ne-lv-hi yi-gi."
        intervals [23]:
            xmin = 154.900
            xmax = 156.590
            text = ""
        intervals [24]:
            xmin = 156.590
            xmax = 172.530
            text = "011312: Gi-lo-ye-no u-he-s-di a-tsi-ne-di ge-se-s-di, u-tsa-ti-no u-he-s-di; gi-lo-s-gi-ni nu-hv-na ge-se-s-di a-tsi-gi-e-di-quo ge-se-s-di na-s-gi na-s-quo u-hv-i."
        intervals [25]:
            xmin = 172.530
            xmax = 173.590
            text = ""
        intervals [26]:
            xmin = 173.590
            xmax = 186.660
            text = "011313: Na-s-gi nv-di-ga-li-s-do-di-ha tsi-de-ga-tsi-ya-tli-lo-s-da-ne-ha, a-ni-go-wa-ti-s-gv-ye-no v-tla yi-na-dv-gi-ha a-le v-tla yi-no-li-ga."
        intervals [27]:
            xmin = 186.660
            xmax = 191.950
            text = ""
        intervals [28]:
            xmin = 191.950
            xmax = 215.060
            text = "011314: A-le a-ne-hv u-do-hi-yu-nv I-sa-ya tsu-do-le-ho-se-i, hi-a tsi-nu-we-se-i; I-tsa-dv-gi-s-gv i-tsa-dv-gi-s-ge-s-di, a-se-no v-tla yi-tso-li-ge-s-di; a-le i-tsi-go-wa-ti-s-gv i-tsi-go-wa-ti-s-ge-s-di, a-se-no v-tla yi-tsa-do-le-ho-s-ge-s-di."
        intervals [29]:
            xmin = 215.060
            xmax = 216.330
            text = ""
        intervals [30]:
            xmin = 216.330
            xmax = 262.310
            text = "011315: Hi-a-ye-no yv-wi tsu-ni-na-wi du-li-tso-hv-sv, a-le da-ni-li-lu-gv ga-yo-li-yu da-dv-gi-ha, a-le di-ni-ga-do-li du-ni-s-du-nv; na-s-gi di-ni-ga-do-li di-gv-wa-ni-go-wa-dv-do-di ni-ge-sv-na i-yu-li-s-do-di-yi, a-le da-ni-li-lu-gv di-gv-wa-na-dv-go-do-di-ni-ge-sv-na i-yu-li-s-do-di-yi, a-le tsu-ni-na-wi di-gv-wa-no-li-s-do-di ni-ge-sv-na i-yu-li-s-do-di-yi, a-le di-gv-wa-na-da-ne-tli-yv-e-di ni-ge-sv-na du-na-da-nv-dv, a-le di-ga-ga-tsi-nv-wo-di ni-ge-sv-na i-yu-li-s-do-di-yi."
        intervals [31]:
            xmin = 262.310
            xmax = 263.210
            text = ""
        intervals [32]:
            xmin = 263.210
            xmax = 274.900
            text = "011316: Ni-hi-s-gi-ni di-tsi-ga-do-li di-ga-lv-quo-ta-nv-hi, na-s-gi-ye-no da-go-wa-ti-ha, a-le de-tsi-li-lu-gv-i, na-s-gi-ye-no da-dv-gi-ha;"
        intervals [33]:
            xmin = 274.900
            xmax = 276.140
            text = ""
        intervals [34]:
            xmin = 276.140
            xmax = 302.935
            text = "011317: U-do-hi-yu-hi-ya-ye-no hi-a ni-tsv-we-se-ha, u-ni-tsa-ti a-na-do-le-ho-s-gi a-le u-na-da-nv-ti u-na-du-lv-dv u-tsi-go-wa-dv-di-yi hi-a na-s-gi tsi-tsi-go-wa-ti-ha, a-se-no v-tla u-ni-go-hv-hi yi-gi; a-le u-na-dv-go-di-yi hi-a na-s-gi tsi-tsa-dv-gi-ha, a-se-no v-tla u-na-dv-ga-nv-hi yi-gi."
        intervals [35]:
            xmin = 302.935
            xmax = 303.880
            text = ""
        intervals [36]:
            xmin = 303.880
            xmax = 310.070
            text = "011318: Na-s-gi i-yu-s-di ni-hi i-tsa-dv-gv-ga da-tli-lo-s-dv a-wi-s-gi."
        intervals [37]:
            xmin = 310.070
            xmax = 310.910
            text = ""
        intervals [38]:
            xmin = 310.910
            xmax = 334.480
            text = "011319: I-yu-no gi-lo a-dv-gv-ga ka-no-he-dv ga-lv-la-di e-hi u-gv-na-yu-hi ge-sv u-gv-wa-li, ni-go-li-gv-na-no tsi-ge-so-i, hna-quo u-ne-gu-tsi-dv ga-lu-go-i a-le u-gi-e-ho a-wi-sv u-na-wi-yi.  Na-s-gi hi-a u-no-hu-lo-di tsa-wi-se-i."
        intervals [39]:
            xmin = 334.480
            xmax = 335.030
            text = ""
        intervals [40]:
            xmin = 335.030
            xmax = 348.490
            text = "011320: Hi-a-no na-s-gi nv-yo-hi tsa-wi-se-i; na-s-gi tsa-dv-gi-s-go ka-no-he-dv, a-le gi-la-quo i-yv-dv u-li-he-li-tsv-hi tsi-da-da-ni-lv-go-i;"
        intervals [41]:
            xmin = 348.490
            xmax = 349.635
            text = ""
        intervals [42]:
            xmin = 349.635
            xmax = 370.470
            text = "011321: A-se-no ni-du-hna-s-de-tlv-na-quo ge-so-i, a-le tle-ga-quo tsi-da-ka-hna-wa-de-go-i; a-gi-li-yv-ye-no ga-na-nu-go-i a-le ka-no-he-dv dv-li-ye-i-lv-s-da a-ga-de-ya-do-da, gi-la-quo i-yv-dv du-wo-de-hi-ho-i."
        intervals [43]:
            xmin = 370.470
            xmax = 371.550
            text = ""
        intervals [44]:
            xmin = 371.550
            xmax = 392.805
            text = "011322: Hi-a-no na-s-quo a-nu-ga-lv-hi tsa-wi-se-i, na-s-gi tsa-dv-gi-s-go ka-no-he-dv, e-lo-hi-no u-we-li-hi-s-di ge-sv a-le ge-nv-i-s-di ge-sv u-da-li-da-s-dv a-ni-ne-nu-la-s-di-s-go ka-no-he-dv, na-s-gi-no na-ga-ta-dv-s-gv-na-quo ge-so-i."
        intervals [45]:
            xmin = 392.805
            xmax = 393.630
            text = ""
        intervals [46]:
            xmin = 393.630
            xmax = 418.600
            text = "011323: Na-s-gi-s-gi-ni na o-sv ga-do-hi tsa-wi-se-i; na-s-gi tsa-dv-gi-s-go ka-no-he-dv a-le tsi-go-li-go-i, a-le na-s-quo tsa-ga-ta-dv-s-go-i, a-le tsi-ga-na-nu-go-wi-s-go-i, i-ga-dv a-s-go-hi-tsu-qui u-ne-quo-tsv-hi, i-ga-dv-no su-da-la-s-go-hi, i-ga-dv-no tso-a-s-go-hi."
        intervals [47]:
            xmin = 418.600
            xmax = 419.340
            text = ""
        intervals [48]:
            xmin = 419.340
            xmax = 432.610
            text = "011324: Nv-wa-da-le du-tli-lo-s-da-ne-lv-gi, hi-a nu-we-sv-gi; Ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv na-s-gi-ya-quo a-s-ga-ya o-s-dv u-ga-ta u-lo-ge-sv tsu-wi-se-i."
        intervals [49]:
            xmin = 432.610
            xmax = 433.490
            text = ""
        intervals [50]:
            xmin = 433.490
            xmax = 446.470
            text = "011325: A-se-no yv-wi u-ni-li-nv-tsv, u-s-ga-ya u-lu-tse u-yo u-ga-ta u-wi-se u-tsa-le-s-di a-wi-sv u-su-yv-ne-i; a-le i-u-we-nv-se."
        intervals [51]:
            xmin = 446.470
            xmax = 447.400
            text = ""
        intervals [52]:
            xmin = 447.400
            xmax = 454.395
            text = "011326: Hna-quo-no u-li-ye-nv a-le u-ga-ta-ta-nv na-s-quo u-yo u-na-nu-go-tse-i."
        intervals [53]:
            xmin = 454.395
            xmax = 455.230
            text = ""
        intervals [54]:
            xmin = 455.230
            xmax = 474.815
            text = "011327: Hna-quo-no a-s-ga-ya ga-ne-la tsu-nv-si-da-s-di gv-wa-lu-tse-le-i, hi-a ni-gv-wa-we-se-le-i; s-gi-nv-si-da-s-di, Tla-s-go o-s-dv u-ga-ta yi-tsa-wi-se tsa-lo-ge-sv-i?  Ga-do di-ga-li-s-do-da-ha u-yo tsu-ye-ga?"
        intervals [55]:
            xmin = 474.815
            xmax = 475.990
            text = ""
        intervals [56]:
            xmin = 475.990
            xmax = 487.835
            text = "011328: Hi-a-no ni-du-we-se-le-i; Gi-lo a-gi-s-ga-gi na-s-gi nu-dv-ne-lv.  Tsu-nv-si-da-s-di hi-a ni-gv-wa-se-le-i; Tsa-du-li-s-go-no o-gi-ye-hi-sv-s-di-yi?"
        intervals [57]:
            xmin = 487.835
            xmax = 488.600
            text = ""
        intervals [58]:
            xmin = 488.600
            xmax = 499.595
            text = "011329: A-se-no hi-a nu-we-se-i; v-tla, i-tsi-ye-hi-s-gv-ye-no u-yo, yi-de-tsi-hna-s-de-tlv-da na-s-quo u-tsa-le-s-di."
        intervals [59]:
            xmin = 499.595
            xmax = 500.410
            text = ""
        intervals [60]:
            xmin = 500.410
            xmax = 525.235
            text = "011330: U-ne-la-gi i-gu-la-ha wi-da-dv-hi gv-ni a-ga-dv-na-tsv-ha; hna-quo-no a-ga-dv-na-tsv hi-a nv-da-ga-tsi-we-se-li a-ni-s-gu-de-s-gi; I-gv-yi i-tsi-tli-sa u-yo, a-le di-tso-dv-tsa di-go-hv-s-do-di, u-tsa-le-s-di-s-gi-ni i-tsi-tli-sa a-gi-s-qua-ni-go-do-di-yi."
        intervals [61]:
            xmin = 525.235
            xmax = 526.180
            text = ""
        intervals [62]:
            xmin = 526.180
            xmax = 543.260
            text = "011331: Nv-wa-da-le du-tli-lo-s-da-ne-lv-gi, hi-a nu-we-sv-gi; Ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv na-s-gi-ya-quo a-tsi-lv u-ga-ta, a-s-ga-ya tsu-gi-se a-le tsu-wi-se u-lo-ge-sv-i."
        intervals [63]:
            xmin = 543.260
            xmax = 544.320
            text = ""
        intervals [64]:
            xmin = 544.320
            xmax = 571.740
            text = "011332: Na-s-gi u-do-hi-yu-sv tsi-wo-da-go-na-dv-di u-s-di-gi-yu ge-sv ni-ga-v u-ga-ta, a-se-no a-dv-hi tsi-wo-da-go-na-dv-di u-dv-ni-yu ge-sv ni-ga-v u-ye-hna-v-i, a-le tlu-gv tsi-ni-ga-li-s-di-ha, na-s-gi-no tsi-s-qua tsa-ni-lu-go-i, du-wa-ni-ga-lv tsa-na-ha-di-s-go-i."
        intervals [65]:
            xmin = 571.740
            xmax = 573.080
            text = ""
        intervals [66]:
            xmin = 573.080
            xmax = 595.170
            text = "011333: Nv-wa-da-le du-tli-lo-s-da-ne-lv-gi, hi-a nu-wo-sv-gi; Ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv na-s-gi-ya-quo a-go-do-di, na-s-gi a-ge-yv tsu-gi-se a-le tsu-su-yv-ne tso-i i-yu-tli-lo-dv i-sv ga-lv-i, gv-ni ni-ga-dv u-go-so-nv."
        intervals [67]:
            xmin = 595.170
            xmax = 596.330
            text = ""
        intervals [68]:
            xmin = 596.330
            xmax = 609.455
            text = "011334: Na-s-gi hi-a ni-ga-di-yu Tsi-sa du-wo-ne-ta-nv-gi u-ni-tsa-ti du-tli-lo-s-da-ne-lv-gi, ni-da-tli-lo-s-da-ne-hv-na-no ge-sv v-tla yi-du-wo-ne-ta-ne-i."
        intervals [69]:
            xmin = 609.455
            xmax = 610.410
            text = ""
        intervals [70]:
            xmin = 610.410
            xmax = 630.945
            text = "011335: U-do-hi-yu-di-yi a-ye-lv-sv-gi a-do-le-ho-s-gi tsu-ne-tse-i, hi-a tsi-nu-we-se-i; da-tsi-s-du-i-si tsi-o-li de-ga-tli-lo-s-di-s-gv-i, da-tsi-ne-i-s-ta-ni u-de-li-dv a-s-qua-ni-go-dv e-lo-hi tsu-do-tlv-nv nv-da-gv-wa-da-le-nv-dv."
        intervals [71]:
            xmin = 630.945
            xmax = 631.690
            text = ""
        intervals [72]:
            xmin = 631.690
            xmax = 651.690
            text = "011336: Hna-quo-no Tsi-sa du-ye-li-hi-s-ta-nv u-ni-tsa-ti, a-da-ne-lv wu-yv-lv-gi; gv-wa-s-da-wa-di-do-hi-no gv-wa-lu-tse-lv-gi, hi-a nu-ni-we-sv-gi; Di-s-gi-yo-si-sa-si da-tli-lo-s-dv u-yo tsu-li-ye-ne tlo-ge-si."
        intervals [73]:
            xmin = 651.690
            xmax = 652.835
            text = ""
        intervals [74]:
            xmin = 652.835
            xmax = 662.705
            text = "011337: U-ne-tsv-no hi-a ni-du-we-se-lv-gi; na-s-gi na O-s-dv u-ga-ta tsu-wi-se-i na-s-gi yv-wi U-we-tsi;"
        intervals [75]:
            xmin = 662.705
            xmax = 663.650
            text = ""
        intervals [76]:
            xmin = 663.650
            xmax = 680.785
            text = "011338: Tlo-ge-si-no na-s-gi e-la-ni-gv-i; o-s-dv u-ga-ta na-s-gi ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv a-ne-hi; u-yo-no tsu-li-ye-ne na-s-gi u-ne-gu-tsi-dv tsu-we-tsi;"
        intervals [77]:
            xmin = 680.785
            xmax = 681.970
            text = ""
        intervals [78]:
            xmin = 681.970
            xmax = 697.650
            text = "011339: A-ga-s-gi-no na-s-gi tsu-wi-se-i, na-s-gi a-s-gi-na; u-ga-dv-na-i-s-di-yi-no ge-sv na-s-gi a-li-s-qua-dv-ha e-lo-hi; a-ni-s-gu-de-s-gi-no na-s-gi di-ni-ka-hna-wa-di-do-hi."
        intervals [79]:
            xmin = 697.650
            xmax = 699.180
            text = ""
        intervals [80]:
            xmin = 699.180
            xmax = 714.040
            text = "011340: Na-s-gi-no u-yo tsa-ni-tli-si-s-go a-le tsa-na-go-hv-s-di-s-go a-tsi-lv-yi, na-s-gi-ya-s-gi-ni na-s-quo nu-s-de-s-di a-li-s-qua-dv-ha hi-a e-lo-hi."
        intervals [81]:
            xmin = 714.040
            xmax = 715.125
            text = ""
        intervals [82]:
            xmin = 715.125
            xmax = 731.260
            text = "011341: Yv-wi U-we-tsi do-da-ga-nv-si tsu-tse-li di-ni-ka-hna-wa-di-do-hi, a-le na-s-gi u-tse-li-go-hi do-dv-no-tsa-le-si ni-ga-dv di-na-da-do-de-s-di-s-gi a-le ni-ga-dv a-ni-s-ga-nv-gi,"
        intervals [83]:
            xmin = 731.260
            xmax = 732.200
            text = ""
        intervals [84]:
            xmin = 732.200
            xmax = 743.235
            text = "011342: Di-go-tlv-sv-no a-tsi-lv-yi wi-do-dv-na-da-e-si; na-hna da-ni-yv-ge-s-di a-le da-ni-lv-da-gi-s-ge-s-di da-ni-nu-do-gv-i."
        intervals [85]:
            xmin = 743.235
            xmax = 744.110
            text = ""
        intervals [86]:
            xmin = 744.110
            xmax = 761.250
            text = "011343: Hna-quo-no u-na-da-nv-ti gv-wa-ni-ta-lu-gi-s-gi ge-se-s-di U-ni-do-da u-tse-li-go-hi, nv-do na-s-gi-ya-i.  Gi-lo de-ga-li-lu-ge-s-di u-dv-go-di-yi wa-dv-gv-ga."
        intervals [87]:
            xmin = 761.250
            xmax = 762.530
            text = ""
        intervals [88]:
            xmin = 762.530
            xmax = 792.325
            text = "011344: A-le na-s-quo Ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv na-s-gi-ya-quo tsu-gv-wa-lo-di u-de-li-dv tlo-ge-si tsa-ho-i, na-s-gi i-yu a-s-ga-ya a-wa-dv, tsa-de-lv-s-go-i, a-li-he-li-gv-no i-yu-s-ti tse-go-i tsi-wi-ga-na-de-go ni-ga-dv u-s-qua-ni-go-dv-i, a-le tsi-wu-wa-s-go na-s-gi tlo-ge-si."
        intervals [89]:
            xmin = 792.325
            xmax = 792.950
            text = ""
        intervals [90]:
            xmin = 792.950
            xmax = 803.480
            text = "011345: A-le na-s-quo Ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv na-s-gi-ya-quo ga-no-di-s-gi tsi-du-yo-he tsu-wo-du-hi da-gv-na--i-yu-na-s-di."
        intervals [91]:
            xmin = 803.480
            xmax = 804.380
            text = ""
        intervals [92]:
            xmin = 804.380
            xmax = 820.585
            text = "011346: Na-s-gi-no hna-quo u-wa-dv-hv sa-quo u-tsa-ti tsu-gv-wa-lo-di da-gv-na i-yu-s-di u-we-nv-se wu-na-di-nv-se ni-ga-dv u-s-qua-ni-go-dv-i, na-s-gi-no u-wa-se-i."
        intervals [93]:
            xmin = 820.585
            xmax = 821.640
            text = ""
        intervals [94]:
            xmin = 821.640
            xmax = 836.920
            text = "011347: A-le na-s-quo Ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv na-s-gi-ya-quo a-ga-ya-lu-di tsi-wu-na-da-i-nv-se a-me-quo-hi, a-le tsi-du-ni-ni-yv-he na-ni-v tsu-na-da-le-nv-dv;"
        intervals [95]:
            xmin = 836.920
            xmax = 838.100
            text = ""
        intervals [96]:
            xmin = 838.100
            xmax = 854.220
            text = "011348: Na-s-gi-no hna-quo u-ka-li-tsv a-ma-yu-lo-di u-ni-na-si-no-le-i, a-le u-na-nv-ne-i, a-no-s-dv-no di-te-li-do du-ni-lv-ta-ne-i, u-ni-yo-no du-na-da-i-nv-se-i."
        intervals [97]:
            xmin = 854.220
            xmax = 855.070
            text = ""
        intervals [98]:
            xmin = 855.070
            xmax = 868.980
            text = "011349: Na-s-gi-s-gi-ni nu-s-de-s-di e-lo-hi a-li-s-qua-dv-ha; di-ni-ka-hna-wa-di-do-hi dv-ni-lu-tsi, do-dv-na-ga-le-nv-ta-ni u-ni-ne-gu-tsi-dv a-le u-na-da-nv-ti;"
        intervals [99]:
            xmin = 868.980
            xmax = 870.080
            text = ""
        intervals [100]:
            xmin = 870.080
            xmax = 882.310
            text = "011350: U-ni-ne-gu-tsi-dv-no wi-do-dv-na-da-e-si di-go-tlv-sv a-tsi-lv-yi, na-hna da-ni-yv-ge-s-di a-le da-ni-lv-da-gi-s-ge-s-di da-ni-nu-do-gv-i."
        intervals [101]:
            xmin = 882.310
            xmax = 883.135
            text = ""
        intervals [102]:
            xmin = 883.135
            xmax = 891.030
            text = "011351: Tsi-sa-no hi-a ni-du-we-se-lv-gi; i-tso-li-gi-tsu ni-ga-dv hi-a?  v-v, tsa-gv-wi-yu-hi, v-gv-wo-se-lv-gi."
        intervals [103]:
            xmin = 891.030
            xmax = 891.730
            text = ""
        intervals [104]:
            xmin = 891.730
            xmax = 917.050
            text = "011352: Hna-quo-no hi-a ni-du-we-se-lv-gi; Na-s-gi i-yu-s-di gi-lo di-go-we-li-s-gi ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv u-gv-wa-li a-ge-yo-nv-hi tsi-ge-so-i, na-s-gi-ya-quo a-s-ga-ya ga-ne-la tsi-do-di-ga-na-nu-go-wi-s-go tsu-gv-wa-lo-di u-s-qua-ni-go-dv tsu-da-le-nv-dv di-tse a-le tsu-we-ti."
        intervals [105]:
            xmin = 917.050
            xmax = 917.875
            text = ""
        intervals [106]:
            xmin = 917.875
            xmax = 926.090
            text = "011353: Hi-a-no nu-li-s-ta-nv-gi, hna-quo Tsi-sa u-s-qua-dv hi-a na-s-gi da-tli-lo-s-di-s-gv-i, u-ni-gi-sv-gi."
        intervals [107]:
            xmin = 926.090
            xmax = 926.890
            text = ""
        intervals [108]:
            xmin = 926.890
            xmax = 948.540
            text = "011354: Hna-quo-no u-wa-sv u-tse-li-go-hi u-lu-tsv tsu-ni-la-wi-i-s-di-yi du-we-yo-nv-gi; na-s-gi i-yu-s-di u-ni-s-qua-ni-go-sv-gi, a-le hi-a nu-ni-we-sv-gi; Ga-do u-li-s-do-ta-nv hi-a na-s-gi a-s-ga-ya tsa-ga-ta hna-a a-le u-s-qua-ni-go-di tsi-du-lv-wi-s-da-ne-ha?"
        intervals [109]:
            xmin = 948.540
            xmax = 949.360
            text = ""
        intervals [110]:
            xmin = 949.360
            xmax = 964.170
            text = "011355: Hi-a-ka-ni di-ne-s-ge-s-gi u-we-tsi, Me-li-ka-ni u-tsi, a-le-ka-ni a-na-li-nv-tli Tsi-mi, a-le Tso-si a-le Sa-wa-ni a-le Tsu-da-si?"
        intervals [111]:
            xmin = 964.170
            xmax = 964.930
            text = ""
        intervals [112]:
            xmin = 964.930
            xmax = 973.955
            text = "011356: A-le-ka-ni tsu-do ni-ga-dv e-s-ga-ni tsa-ne-ha?  Ga-do-no u-li-s-do-ta-nv hi-a ni-ga-dv tsu-we-ha?"
        intervals [113]:
            xmin = 973.955
            xmax = 974.710
            text = ""
        intervals [114]:
            xmin = 974.710
            xmax = 991.835
            text = "011357: V-gv-wa-go-ne-lo-hi-se-lv-gi-no; a-se-no Tsi-sa hi-a ni-du-we-se-lv-gi; A-do-le-ho-s-gi v-tla na-tsi-lv-quo-dv-na yi-ge-so-i, u-wa-sv-s-gi-ni-no-nv u-tse-li-go-hi a-le u-wa-sv ga-ne-lv-i."
        intervals [115]:
            xmin = 991.835
            xmax = 992.590
            text = ""
        intervals [116]:
            xmin = 992.590
            xmax = 1003.580
            text = "011358: V-tla-no yu-tsa-te u-s-qua-ni-go-di na-hna yi-du-lv-wi-s-da-ne-le-i, na-no-hi-yu-hv-s-ge-na ge-sv nv-da-ga-li-s-do-di-s-gv-gi."
