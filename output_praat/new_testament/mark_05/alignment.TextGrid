tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 599.960
        intervals: size = 86
        intervals [1]:
            xmin = 0.000
            xmax = 3.640
            text = ""
        intervals [2]:
            xmin = 3.640
            xmax = 10.265
            text = "020501: I-s-go-ni-di-tlv-no v-da-li wu-ni-lu-tse A-ni-ge-de-li u-na-tse-li-go-hi."
        intervals [3]:
            xmin = 10.265
            xmax = 11.410
            text = ""
        intervals [4]:
            xmin = 11.410
            xmax = 22.215
            text = "020502: Tsi-yu-hi-no u-tsa-i-sv gi-la-quo i-yv-dv du-tlo-se a-s-ga-ya da-da-ni-sa-hv nv-da-yu-lo-sv-hi ga-da-ha a-da-nv-do u-ya-i,"
        intervals [5]:
            xmin = 22.215
            xmax = 23.005
            text = ""
        intervals [6]:
            xmin = 23.005
            xmax = 32.785
            text = "020503: Na-s-gi da-da-ni-sa-hv-quo e-he-i; v-tla a-le na-s-quo tsu-da-de-sv-dv gv-di gi-lo gv-wa-lv-s-di yi-ge-se-i."
        intervals [7]:
            xmin = 32.785
            xmax = 33.630
            text = ""
        intervals [8]:
            xmin = 33.630
            xmax = 55.485
            text = "020504: Ya-no-gi-yu-ye-no tsa-tsi-nv-tlo-lv-hi ge-se-i, a-le tsu-da-de-sv-dv tsa-ga-lv-s-ta-nv-hi ge-se-i, tsu-da-de-sv-dv-no da-ga-li-s-ge-i, a-le di-ga-nv-tlo-s-di da-s-qua-li-s-ge-i; v-tla a-le gi-lo gv-wa-da-nv-ti-so-di yi-ge-se-i."
        intervals [9]:
            xmin = 55.485
            xmax = 56.660
            text = ""
        intervals [10]:
            xmin = 56.660
            xmax = 68.195
            text = "020505: A-le ni-go-hi-lv, sv-no-yi a-le i-ga, ga-du-si a-le da-da-ni-sa-hv-i, u-we-lu-ge-i, a-le nv-ya gv-di a-da-ye-lo-he-i."
        intervals [11]:
            xmin = 68.195
            xmax = 69.165
            text = ""
        intervals [12]:
            xmin = 69.165
            xmax = 75.875
            text = "020506: A-se-no i-nv-hi-yu wu-go-hv Tsi-sa, du-s-qua-lv-ta-ne a-le u-da-do-li-s-da-ne-le-i,"
        intervals [13]:
            xmin = 75.875
            xmax = 76.860
            text = ""
        intervals [14]:
            xmin = 76.860
            xmax = 98.980
            text = "020507: A-le a-s-da-ya u-we-lu-ne hi-a nu-we-se-i; Ga-do di-gi-na-da-dv-do-di ni-hi Tsi-sa, wa-s-dv ga-lv-la-di-yu e-hi U-ne-la-nv-hi U-we-tsi?  Gv-ne-tse-ha, U-ne-la-nv-hi gv-ne-i-s-da-ne-ha, na-s-gi s-gi-gi-li-yo-i-s-do-di-yi ni-ge-sv-na."
        intervals [15]:
            xmin = 98.980
            xmax = 100.840
            text = ""
        intervals [16]:
            xmin = 100.840
            xmax = 109.915
            text = "020508: Hi-a-ye-no nu-we-se-le-i, E-hi-nu-go-i na-s-gi na a-s-ga-ya, ni-hi hi-ga-da-ha a-da-nv-do."
        intervals [17]:
            xmin = 109.915
            xmax = 111.205
            text = ""
        intervals [18]:
            xmin = 111.205
            xmax = 123.020
            text = "020509: U-dv-dv-ne-no, Ga-do de-tsa-do-v?  U-wo-se-le-i.  Hi-a-no nu-we-se-le-i, Su-na-da-tlu-gi da-qua-do-v; o-gi-tsa-ta-ye-no."
        intervals [19]:
            xmin = 123.020
            xmax = 123.725
            text = ""
        intervals [20]:
            xmin = 123.725
            xmax = 131.625
            text = "020510: A-le u-tsa-ti u-s-di-ye-ta-ne na-hna ge-sv tsu-nu-go-wi-s-di-yi ni-ge-sv-na ge-sv-i."
        intervals [21]:
            xmin = 131.625
            xmax = 132.500
            text = ""
        intervals [22]:
            xmin = 132.500
            xmax = 140.300
            text = "020511: Na-hna-no o-da-lu-lo-di u-ni-tsa-ti su-na-da-tlu-gi si-qua a-na-li-s-da-yv-ni-do-he-i."
        intervals [23]:
            xmin = 140.300
            xmax = 141.150
            text = ""
        intervals [24]:
            xmin = 141.150
            xmax = 152.935
            text = "020512: Ni-ga-dv-no a-ni-s-gi-na gv-wa-s-di-ye-ta-ne hi-a na-ni-we-s-ge-i, U-ne-la-gi si-qua di-ne-do-hv wo-tsi-lo-hi, na-s-gi wi-do-tsi-yv-si."
        intervals [25]:
            xmin = 152.935
            xmax = 153.605
            text = ""
        intervals [26]:
            xmin = 153.605
            xmax = 179.970
            text = "020513: Gi-la-quo-no i-yv-dv Tsi-sa du-li-s-go-lv-da-ne-le-i.  Di-ga-da-ha-no di-da-nv-do u-ni-nu-go-tsv, si-qua wi-du-ni-yv-se-le-i; su-na-da-tlu-gi-no u-na-ne-lu-gi-se u-ni-ga-so-a-se ga-ne-tlu-gi ge-sv v-da-li wu-na-li-ta-di-nv-se-i, (ta-li i-ya-ga-yv-li i-yv-dv na-ni-e-i,) a-le v-da-li du-ni-gv-tse-i."
        intervals [27]:
            xmin = 179.970
            xmax = 181.070
            text = ""
        intervals [28]:
            xmin = 181.070
            xmax = 194.310
            text = "020514: Di-ni-ga-ti-ya-no u-na-li-se-i, a-le ga-du-hv wu-ni-no-ne-i, a-le i-yv-dv da-ne-wa-di-sv-i.  U-ni-nu-go-tse-no u-na-ga-ta-nv-se na-s-gi nu-li-s-ta-nv-i."
        intervals [29]:
            xmin = 194.310
            xmax = 195.630
            text = ""
        intervals [30]:
            xmin = 195.630
            xmax = 214.780
            text = "020515: Tsi-sa-no gv-wa-lu-tse-le-i, a-le gv-wa-go-he na-s-gi a-ni-s-gi-na gv-wa-yv-lv-hi, na-s-gi su-na-da-tlu-gi gv-wa-yv-lv-hi, u-wo-le-i, a-le du-nu-we-i, a-le do-hi u-da-nv-te-i; a-le a-ni-s-ga-i-he-i."
        intervals [31]:
            xmin = 214.780
            xmax = 215.890
            text = ""
        intervals [32]:
            xmin = 215.890
            xmax = 227.020
            text = "020516: Na-s-gi-no u-ni-go-hv-hi, gv-wa-ni-no-ne-le nu-li-s-da-ne-lv a-ni-s-gi-na gv-wa-yv-lv-hi, a-le na-s-quo si-qua nu-na-li-s-da-ne-lv-i."
        intervals [33]:
            xmin = 227.020
            xmax = 228.520
            text = ""
        intervals [34]:
            xmin = 228.520
            xmax = 234.115
            text = "020517: A-le u-na-le-nv-he gv-wa-ta-yo-se-le u-da-nv-s-di-yi u-na-tse-li-go-hi."
        intervals [35]:
            xmin = 234.115
            xmax = 235.310
            text = ""
        intervals [36]:
            xmin = 235.310
            xmax = 246.330
            text = "020518: Tsi-yu-hi-no u-tsa-nv na-s-gi a-ni-s-gi-na gv-wa-yv-lv-hi u-ta-yo-se-le u-ne-la-gi u-we-li-se-di-yi u-s-da-wa-di-da-s-di-yi."
        intervals [37]:
            xmin = 246.330
            xmax = 247.230
            text = ""
        intervals [38]:
            xmin = 247.230
            xmax = 266.550
            text = "020519: A-se-no v-tla yu-li-s-go-lv-da-ne-le-i Tsi-sa, hi-a-quo-s-gi-ni nu-we-se-le-i, Tsi-he-na di-tse-nv-sv go-hu-s-di di-tsv-na di-ne-hv-i, a-le wi-di-no-hv-si ni-ga-v u-s-qua-ni-go-di U-gv-wi-yu-hi ni-tsa-dv-ne-lv-i, a-le tsa-do-li-tsv-i."
        intervals [39]:
            xmin = 266.550
            xmax = 267.650
            text = ""
        intervals [40]:
            xmin = 267.650
            xmax = 282.875
            text = "020520: U-ni-gi-se-no, a-le u-le-nv-he du-no-tsa-la-ne A-s-go-hi--i-ga-du-gi-yi, ni-ga-v u-s-qua-ni-go-di Tsi-sa nu-dv-ne-lv-i; a-le ni-ga-dv yv-wi u-ni-s-qua-ni-go-se-i."
        intervals [41]:
            xmin = 282.875
            xmax = 284.320
            text = ""
        intervals [42]:
            xmin = 284.320
            xmax = 296.960
            text = "020521: Tsi-sa-no ta-li-ne tsi-yu-hi do-u-we-so-tsv i-s-go-na wi-u-lu-tsv, u-ni-tsa-ti yv-wi gv-wa-da-tlu-wi-s-ta-ne-i; a-le v-da-li u-lo-di e-do-he-i."
        intervals [43]:
            xmin = 296.960
            xmax = 297.980
            text = ""
        intervals [44]:
            xmin = 297.980
            xmax = 309.620
            text = "020522: A-le gv-ni-yu-quo u-lu-tse gi-lo i-yu-s-di nu-gv-wi-yu-sa-de-gi di-ga-la-wi-i-s-di-yi, Tse-la tsu-do-i-dv; u-go-hv-no [Tsi-sa] du-la-s-gv u-da-nv-ne-i,"
        intervals [45]:
            xmin = 309.620
            xmax = 310.700
            text = ""
        intervals [46]:
            xmin = 310.700
            xmax = 326.290
            text = "020523: A-le u-tsa-ti u-s-di-ye-ta-ne-i, hi-a nu-we-se-i; A-que-tsi a-ge-yu-tsa hna-quo a-yo-hu-s-ga; a-se-no i-ne-na, hi-ya-si-ta-dv-ha, na-s-gi u-di-wi-s-di-yi, gv-ne-s-di-no."
        intervals [47]:
            xmin = 326.290
            xmax = 327.205
            text = ""
        intervals [48]:
            xmin = 327.205
            xmax = 336.030
            text = "020524: U-ne-nv-se-no; a-le u-ni-tsa-te yv-wi gv-wa-s-da-wa-dv-se-i, a-le gv-wa-ne-nu-la-s-di-s-ge-i."
        intervals [49]:
            xmin = 336.030
            xmax = 337.910
            text = ""
        intervals [50]:
            xmin = 337.910
            xmax = 345.110
            text = "020525: Gi-lo-no i-yu-s-di a-ge-yv ta-la-du tsu-de-ti-yv-dv gv-wa-da-le-nv-dv gi-gv u-we-nv-e-he-i,"
        intervals [51]:
            xmin = 345.110
            xmax = 345.660
            text = ""
        intervals [52]:
            xmin = 345.660
            xmax = 365.940
            text = "020526: A-le a-ni-go-di-yu a-ni-ga-na-ga-ti u-tsa-ti gv-wa-gi-lv-nv-hi ge-se-i, a-le go-hu-s-di u-hv ni-ga-dv u-sv-nv-hi ge-se a-gu-yi-s-gv-i, a-se-no v-tla o-si-yu yi-nu-li-s-da-ne-he-i, ka-ne-quo-ge-quo-s-gi-ni u-tlv-gv-i;"
        intervals [53]:
            xmin = 365.940
            xmax = 367.410
            text = ""
        intervals [54]:
            xmin = 367.410
            xmax = 378.810
            text = "020527: Na-s-gi u-dv-ga-nv Tsi-sa a-tsi-no-he-s-gv-i, o-ni-di-tlv u-nv-ti-dv nu-na-dv-nv u-lu-hi-s-ta-ne, a-le u-sv-ni-le u-nu-wv-i."
        intervals [55]:
            xmin = 378.810
            xmax = 379.580
            text = ""
        intervals [56]:
            xmin = 379.580
            xmax = 385.850
            text = "020528: Hi-a-ye-no nu-we-se-i, Tsu-nu-wo-quo na-s-quo yi-da-qua-sv-ni-lv, ya-qua-di-wi."
        intervals [57]:
            xmin = 385.850
            xmax = 386.570
            text = ""
        intervals [58]:
            xmin = 386.570
            xmax = 397.370
            text = "020529: Gi-la-quo-no i-yv-dv gi-gv u-we-nv-e-hv u-yo-hi-s-ta-ne-i; u-do-le-ho-se-no a-ye-lv u-di-wa-sv na-s-gi u-tlv-gv-i."
        intervals [59]:
            xmin = 397.370
            xmax = 398.510
            text = ""
        intervals [60]:
            xmin = 398.510
            xmax = 417.440
            text = "020530: Tsi-sa-no gi-la-quo i-yv-dv u-do-le-ho-sv u-wa-sv ge-sv u-da-nv-wo-di ge-sv u-nu-go-tsv-i, u-ga-ta-hv-se na-hna u-nv-ti-dv a-ni-do-na-v-i, a-le hi-a nu-we-se-i, Ga-go da-sv-ni-ga di-qua-nu-wo?"
        intervals [61]:
            xmin = 417.440
            xmax = 419.400
            text = ""
        intervals [62]:
            xmin = 419.400
            xmax = 430.980
            text = "020531: Gv-wa-s-da-wa-di-do-hi-no hi-a ni-gv-wa-we-se-le-i, De-gi-go-wa-di-ha u-ni-tsa-ti ge-tsa-ne-nu-la-s-di-s-gv, tsi-go-no Ga-go a-qua-sv-ni-ga i-ha-di-ha?"
        intervals [63]:
            xmin = 430.980
            xmax = 431.900
            text = ""
        intervals [64]:
            xmin = 431.900
            xmax = 438.120
            text = "020532: Gv-wa-du-wi-dv-no u-ga-te-no-le u-go-wa-dv-di-yi na-s-gi hi-a i-yu-dv-ne-lv-hi."
        intervals [65]:
            xmin = 438.120
            xmax = 439.110
            text = ""
        intervals [66]:
            xmin = 439.110
            xmax = 456.340
            text = "020533: Na-s-gi-no a-ge-yv a-s-ga-i-he a-le u-we-na-wi-s-ge-i, a-ga-ta-he nu-li-s-da-ne-lv-i, u-lu-tse a-le e-la-di u-da-nv-ne-le-i, a-le ni-ga-dv du-yu-go-dv u-no-ne-le-i."
        intervals [67]:
            xmin = 456.340
            xmax = 457.270
            text = ""
        intervals [68]:
            xmin = 457.270
            xmax = 469.715
            text = "020534: Hi-a-no nu-we-se-le-i, A-que-tsi, tso-hi-yu-sv tsa-di-wi-s-da; nv-wa-do-hi-ya-dv tsi-he-na, a-le tsa-di-wa-sv-hi ge-se-s-di tsa-tlv-gv-i."
        intervals [69]:
            xmin = 469.715
            xmax = 470.440
            text = ""
        intervals [70]:
            xmin = 470.440
            xmax = 488.320
            text = "020535: A-si-quo ka-ne-ge-i, nu-gv-wi-yu-sa-de-gi di-ga-la-wi-i-s-di-yi ga-ne-lv nv-da-yu-na-da-le-nv-hi u-ni-lu-tse hi-a nu-ni-we-se-i, U-yo-hu-sv tse-tsi; ga-do-no a-si-quo i-hi-ya-de-ya-do-di-ha di-de-yo-hv-s-gi?"
        intervals [71]:
            xmin = 488.320
            xmax = 489.330
            text = ""
        intervals [72]:
            xmin = 489.330
            xmax = 501.455
            text = "020536: U-dv-ga-nv-quo-no Tsi-sa nu-s-dv u-ni-wo-ni-sv-i, hi-a nu-we-se-le nu-gv-wi-yu-sa-de-gi di-ga-la-wi-i-s-di-yi, Tle-s-di yi-s-ga-i-he-s-di, tso-hi-yu-se-s-di-quo."
        intervals [73]:
            xmin = 501.455
            xmax = 502.660
            text = ""
        intervals [74]:
            xmin = 502.660
            xmax = 513.895
            text = "020537: V-tla a-le gi-lo yu-li-s-go-lv-da-ne-le gv-wa-s-da-wa-dv-s-di-yi, Qui-da, a-le Tsi-mi, a-le Tsa-ni Tsi-mi di-na-da-nv-tli u-nv-sv."
        intervals [75]:
            xmin = 513.895
            xmax = 514.830
            text = ""
        intervals [76]:
            xmin = 514.830
            xmax = 528.200
            text = "020538: U-lu-tse-no ga-ne-lv nu-gv-wi-yu-sa-de-gi di-ga-la-wi-i-s-di-yi, a-le du-ga-he u-na-da-su-ye-dv yv-wi, a-le u-tsa-ti da-na-tlo-yi-hv a-le da-ni-yv-gv-i."
        intervals [77]:
            xmin = 528.200
            xmax = 528.670
            text = ""
        intervals [78]:
            xmin = 528.670
            xmax = 541.710
            text = "020539: U-ye-lv-no hi-a ni-du-we-se-le-i, Ga-do-no i-tsa-da-no-yv-li-s-di-ha, a-le do-tsa-tlo-yi-ha?  V-tla yu-yo-hu-sv a-ge-yu-tsa, ga-li-ha-quo-s-gi-ni."
        intervals [79]:
            xmin = 541.710
            xmax = 542.750
            text = ""
        intervals [80]:
            xmin = 542.750
            xmax = 558.300
            text = "020540: I-gv-wa-do-tlv-ta-ne-quo-no.  Ni-ga-dv-no du-nu-go-wi-so-nv, hi-a na-s-gi a-ge-yu-tsa u-do-da a-le u-tsi a-le na-s-gi a-ne-hi du-ti-nv-se, a-le wu-yv-le na-hna a-ge-yu-tsa di-so-nv-i."
        intervals [81]:
            xmin = 558.300
            xmax = 559.120
            text = ""
        intervals [82]:
            xmin = 559.120
            xmax = 572.130
            text = "020541: U-wo-ya-ne-sv-no a-ge-yu-tsa, hi-a nu-we-se-le-i, Ta-li-da Gu-mi; na-s-gi a-ne-tlv-ta-nv-hi hi-a nu-s-di ga-dv-ga; Hi-ge-yu-tsa, gv-yo-se-ha, Ta-le-hv-ga."
        intervals [83]:
            xmin = 572.130
            xmax = 573.120
            text = ""
        intervals [84]:
            xmin = 573.120
            xmax = 585.850
            text = "020542: Gi-la-quo-no i-yv-dv a-ge-yu-tsa du-le-ne-i, a-le u-we-do-le-i; ta-la-du-ye-no i-yu-de-ti-yv-dv ge-se-i.  U-tsa-ta-nv-hi-no u-ni-s-qua-ni-go-se-i."
        intervals [85]:
            xmin = 585.850
            xmax = 587.100
            text = ""
        intervals [86]:
            xmin = 587.100
            xmax = 599.960
            text = "020543: U-li-ni-gi-dv-no du-ne-tse-le du-nv-s-da-de-le gi-lo u-do-le-ho-hi-s-di-yi na-s-gi; a-le u-ne-tse-go-hu-s-di u-li-s-da-yv-di u-ni-ne-di-yi."
    item [2]:
        class = "IntervalTier"
