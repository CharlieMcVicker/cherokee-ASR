        intervals [22]:
            xmin = 18.465
            xmax = 20.210
            text = "nv-da-yu-lo-sv-hi"
        intervals [23]:
            xmin = 20.210
            xmax = 20.355
            text = ""
        intervals [24]:
            xmin = 20.355
            xmax = 20.915
            text = "ga-da-ha"
        intervals [25]:
            xmin = 20.915
            xmax = 21.075
            text = ""
        intervals [26]:
            xmin = 21.075
            xmax = 21.655
            text = "a-da-nv-do"
        intervals [27]:
            xmin = 21.655
            xmax = 21.835
            text = ""
        intervals [28]:
            xmin = 21.835
