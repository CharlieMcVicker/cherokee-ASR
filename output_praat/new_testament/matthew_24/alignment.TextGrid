File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 735.420
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 735.420
        intervals: size = 102
        intervals [1]:
            xmin = 0.000
            xmax = 5.050
            text = ""
        intervals [2]:
            xmin = 5.050
            xmax = 20.210
            text = "012401: Tsi-sa-no u-nu-go-tsv-gi di-ga-la-wi-i-s-di-yi u-da-nv-sv-gi, gv-wa-s-da-wa-di-do-hi-no gv-wa-lu-tse-lv gv-wa-no-ne-lv-gi ni-du-s-dv da-da-ne-lv u-dv-na-di-ga-la-wi-i-s-di-yi."
        intervals [3]:
            xmin = 20.210
            xmax = 21.030
            text = ""
        intervals [4]:
            xmin = 21.030
            xmax = 41.220
            text = "012402: Tsi-sa-no hi-a ni-du-we-se-lv-gi; Tla-s-go ni-ga-dv hi-a yi-di-tsi-go-wa-ti-ha?  U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; v-tla sa-quo-u-nv nv-ya a-ni yi-du-da-sa-tla-he-s-di na-s-gi ni-go-hv-ta-nv-na yi-ge-se-s-di."
        intervals [5]:
            xmin = 41.220
            xmax = 42.370
            text = ""
        intervals [6]:
            xmin = 42.370
            xmax = 65.255
            text = "012403: O-li-wa-yo-no u-sa-hi-lv u-wo-lv-i gv-wa-s-da-wa-di-do-hi u-nv-sv ge-sv gv-wa-lu-tse-lv-gi, hi-a nu-ni-we-sv-gi; S-gi-no-hv-si hi-la-go i-yu hi-a na-s-gi nv-da-ga-li-s-ta-ni; a-le ga-do u-s-di u-ye-lv-dv ge-se-s-di tsa-lu-hi-s-di-yi, a-le go-hi ge-sv u-li-s-qua-di-s-di-yi?"
        intervals [7]:
            xmin = 65.255
            xmax = 66.260
            text = ""
        intervals [8]:
            xmin = 66.260
            xmax = 73.370
            text = "012404: Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-lv-gi; I-tse-ya-ta-he-s-di tle-s-di gi-lo tsi-tsi-lo-nu-he-li;"
        intervals [9]:
            xmin = 73.370
            xmax = 74.880
            text = ""
        intervals [10]:
            xmin = 74.880
            xmax = 86.180
            text = "012405: U-ni-tsa-te-s-di-ye-no a-yv da-qua-do-v a-ni-lu-hi-s-di-s-ge-s-di, a-yv Ga-lo-ne-dv, a-na-di-s-ge-s-di; a-le u-ni-tsa-da-s-di da-ni-lo-nu-he-s-ge-s-di."
        intervals [11]:
            xmin = 86.180
            xmax = 87.530
            text = ""
        intervals [12]:
            xmin = 87.530
            xmax = 109.235
            text = "012406: A-le i-tsa-dv-gi-s-ge-s-di da-hna-wa a-le a-ni-no-he-li-do-hv da-hna-ya; i-tse-ya-ta-he-s-di tle-s-di u-we-li-hi-s-di yi-ni-tsa-li-s-da-ne-le-s-di; na-s-gi-ye-no ni-ga-di-yu a-se i-yu-li-s-do-di, a-se-no u-li-s-qua-di-s-di-yi ge-sv a-si ge-se-s-di."
        intervals [13]:
            xmin = 109.235
            xmax = 110.290
            text = ""
        intervals [14]:
            xmin = 110.290
            xmax = 131.130
            text = "012407: Tsu-na-da-le-nv-dv-ye-no yv-wi do-dv-na-le-ni do-dv-na-da-tlu-ta-ni, a-le a-ye-li du-no-tlv-wa-di-sv do-dv-na-da-tlu-ta-ni, a-le da-go-nu-lo-si-do-he-s-di, a-le v-yu-gi-hi-yu ni-ga-li-s-ta-ni-do-he-s-di, a-le ga-do-hi da-li-te-lv-ni-do-he-s-di."
        intervals [15]:
            xmin = 131.130
            xmax = 132.420
            text = ""
        intervals [16]:
            xmin = 132.420
            xmax = 137.140
            text = "012408: Na-s-gi hi-a ni-ga-dv a-le-ni-s-gv ge-sv a-gi-li-ya ge-sv-i."
        intervals [17]:
            xmin = 137.140
            xmax = 138.510
            text = ""
        intervals [18]:
            xmin = 138.510
            xmax = 156.150
            text = "012409: Hna-quo-no ni-hi wi-do-da-ge-tsi-yo-si i-tsi-gi-li-yo-i-s-di-yi, a-le do-da-ge-tsi-li; a-le ni-ga-di-yu nu-na-da-le-sv yv-wi ge-tsi-s-ga-ge-s-di a-yv da-qua-do-v nv-di-ga-li-s-do-di-s-ge-s-di."
        intervals [19]:
            xmin = 156.150
            xmax = 157.010
            text = ""
        intervals [20]:
            xmin = 157.010
            xmax = 166.590
            text = "012410: Hna-quo-no u-ni-tsa-te-s-di du-no-de-hi-he-s-di, a-le da-na-da-tlu-di-s-ge-s-di a-le da-na-da-s-ga-ge-s-di."
        intervals [21]:
            xmin = 166.590
            xmax = 167.520
            text = ""
        intervals [22]:
            xmin = 167.520
            xmax = 177.315
            text = "012411: A-le u-ni-tsa-te-s-di u-na-tlo-na-s-di a-na-do-le-ho-s-gi a-ni-na-nu-go-ge-s-di, a-le u-ni-tsa-te-s-di da-ni-lo-nu-he-s-ge-s-di."
        intervals [23]:
            xmin = 177.315
            xmax = 178.330
            text = ""
        intervals [24]:
            xmin = 178.330
            xmax = 188.640
            text = "012412: A-le u-tsa-dv a-s-ga-nv-i-s-di ge-sv e-hv na-s-gi i-yu-s-di u-ni-tsa-te-s-di a-da-ge-yu-di ge-sv u-ne-hv dv-yv-dla-di."
        intervals [25]:
            xmin = 188.640
            xmax = 189.450
            text = ""
        intervals [26]:
            xmin = 189.450
            xmax = 196.515
            text = "012413: A-se-no na-s-gi na gv-li-s-qua-di-s-gi a-tli-ni-gv-ne-hi na-s-gi a-tsi-s-de-lv-di ge-se-s-di."
        intervals [27]:
            xmin = 196.515
            xmax = 197.440
            text = ""
        intervals [28]:
            xmin = 197.440
            xmax = 216.170
            text = "012414: Hi-a-no na-s-gi o-s-dv ka-no-he-dv ga-lv-la-di u-tse-li-go-hi e-la-ni-gv u-na-li-tsi-do-ni-ni-da-s-di ge-se-s-di u-na-do-le-ho-hi-s-di-yi na-ni-v tsu-na-da-le-nv-dv yv-wi, gi-la-no hna-quo dv-li-s-qua-di-li."
        intervals [29]:
            xmin = 216.170
            xmax = 217.350
            text = ""
        intervals [30]:
            xmin = 217.350
            xmax = 235.115
            text = "012415: Na-s-gi i-yu-s-di hna-quo i-tsi-go-hv-ha u-s-ga-i-s-di-yu gv-no-sa-dv-hi i-gv-ne-hi, na-s-gi De-ni-li a-do-le-ho-s-gi tsu-ne-i-s-ta-ne-i, ga-do-ge-s-di ga-lv-quo-di-yu ge-sv-i, (gi-lo a-go-li-ye-s-ge-s-di go-li-ge-s-di,)"
        intervals [31]:
            xmin = 235.115
            xmax = 236.070
            text = ""
        intervals [32]:
            xmin = 236.070
            xmax = 242.230
            text = "012416: Hna-quo Tsu-di-yi a-ni-ni a-na-li-sv-ha do-tso-da-lv wa-ni-lo-sv-ha."
        intervals [33]:
            xmin = 242.230
            xmax = 242.910
            text = ""
        intervals [34]:
            xmin = 242.910
            xmax = 251.950
            text = "012417: Gi-lo-no ga-sa-na-li u-gi-le-s-di tle-s-di yv-di-u-tlo-a-se-s-di yu-gi-so-le-s-di go-hu-s-di u-hv ga-ne-lv-i;"
        intervals [35]:
            xmin = 251.950
            xmax = 252.960
            text = ""
        intervals [36]:
            xmin = 252.960
            xmax = 260.940
            text = "012418: A-le gi-lo tlo-ge-si we-do-hi tle-s-di yv-di-u-tsv-se-s-di tsu-nu-wo yi-du-ne-so-le-s-di."
        intervals [37]:
            xmin = 260.940
            xmax = 262.070
            text = ""
        intervals [38]:
            xmin = 262.070
            xmax = 269.650
            text = "012419: A-le u-yo-i-yu i-yu-na-li-s-da-ne-di di-ni-ne-li-dv a-le tsu-ni-s-da-i na-hi-yu ge-sv-i."
        intervals [39]:
            xmin = 269.650
            xmax = 270.600
            text = ""
        intervals [40]:
            xmin = 270.600
            xmax = 281.645
            text = "012420: A-le i-tsa-da-do-li-s-di-s-ge-s-di i-tsi-ta-yo-hi-he-s-di go-la a-le u-na-do-da-qua-s-gv i-tsa-li-s-di-yi ni-ge-sv-na i-yu-li-s-do-di-yi."
        intervals [41]:
            xmin = 281.645
            xmax = 282.550
            text = ""
        intervals [42]:
            xmin = 282.550
            xmax = 300.470
            text = "012421: Na-hi-yu-ye-no u-tsa-te-s-di a-gi-li-ya, na-s-gi i-ga-i v-tla i-lv-hi-yu yi-nu-li-s-ta-no e-lo-hi tsu-do-tlv-nv nv-da-gv-wa-da-le-nv-dv go-hi i-ya-s-ti, v-tla a-le i-lv-hi-yu na-s-gi i-yu-li-s-do-di yi-ge-se-s-di."
        intervals [43]:
            xmin = 300.470
            xmax = 301.350
            text = ""
        intervals [44]:
            xmin = 301.350
            xmax = 319.500
            text = "012422: A-le na-hi-yu i-ga ni-da-s-qua-la-nv-na yi-gi, v-tla u-que-da-li ga-ye-tsi-s-de-lv-di yi-ga-gi; a-se-no ge-ga-su-ye-dv ge-sv nv-di-ga-li-s-do-di-s-ge-s-di na-hi-yu i-ga di-s-qua-lo-di ge-se-s-di"
        intervals [45]:
            xmin = 319.500
            xmax = 320.490
            text = ""
        intervals [46]:
            xmin = 320.490
            xmax = 331.445
            text = "012423: Na-hi-yu ge-sv i-yu-no gi-lo hi-a ni-tsi-we-se-he-s-di, Gv-ni-yu-quo a-ni Ga-lo-ne-dv e-do-ha; a-le a-ni; tle-s-di tsi-tso-hi-yu-ni"
        intervals [47]:
            xmin = 331.445
            xmax = 332.195
            text = ""
        intervals [48]:
            xmin = 332.195
            xmax = 355.170
            text = "012424: Dv-ni-na-nu-go-tsi-ye-no u-na-tlo-na-s-di Ga-lo-ne-dv a-le u-na-tlo-na-s-di a-na-do-le-ho-s-gi, a-le a-ni-na-nu-go-wi-s-ge-s-di ga-lv-quo-di-yu u-ye-lv-dv a-le u-s-qua-ni-go-di; na-s-gi i-yu-s-di i-yu-no ye-li i-gv-wa-li-s-do-di yi-gi yi-da-ni-lo-nu-hv-li na-s-quo ge-ga-su-ye-dv."
        intervals [49]:
            xmin = 355.170
            xmax = 356.020
            text = ""
        intervals [50]:
            xmin = 356.020
            xmax = 358.040
            text = "012425: Gv-ni-yu-quo ni-tsv-no-ne-lv."
        intervals [51]:
            xmin = 358.040
            xmax = 359.350
            text = ""
        intervals [52]:
            xmin = 359.350
            xmax = 375.970
            text = "012426: Na-s-gi i-yu-s-di i-yu-no hi-a ni-ge-tsi-we-se-lv-ha; I-na-ge e-do-ha; tle-s-di na-hna wi-tsi-lo-sv-gi; gv-ni-yu-quo u-de-li-sv ka-nv-su-lv a-ya-a; tle-s-di tsi-tso-hi-yu-ni."
        intervals [53]:
            xmin = 375.970
            xmax = 376.730
            text = ""
        intervals [54]:
            xmin = 376.730
            xmax = 389.890
            text = "012427: A-na-ga-li-s-gi-ye-no di-ka-lv-gv tsv-di-ga-na-nu-go-go-i, wu-de-li-gv-no i-yv-dv tsi-wi-di-ga-lv-sa-da-di-s-go-i, na-s-gi-ya na-s-quo nu-s-de-s-di yv-wi U-we-tsi ga-lu-tsi-lv-ha."
        intervals [55]:
            xmin = 389.890
            xmax = 390.780
            text = ""
        intervals [56]:
            xmin = 390.780
            xmax = 398.155
            text = "012428: I-lv-hi-tlv-ye-no go-hu-s-di u-li-wo-tsv-hi tsi-ga-no-i, na-hna a-wo-ha-li a-na-da-tli-si-s-go-i."
        intervals [57]:
            xmin = 398.155
            xmax = 399.320
            text = ""
        intervals [58]:
            xmin = 399.320
            xmax = 422.920
            text = "012429: I-gv-we-nv-da-quo o-ni na-s-gi na-hi-yu a-gi-li-ya ga-lo-so-nv-ha, nv-do i-ga e-hi dv-li-si-hv-si, a-le nv-do sv-no-yi e-hi v-tla i-ga yu-ti-s-de-s-di, a-le no-qui-si dv-ni-nv-go-a-si, a-le u-ni-tsa-ti ga-lv-lo-i tsa-ni-ka-la dv-na-li-te-lv-ni."
        intervals [59]:
            xmin = 422.920
            xmax = 424.090
            text = ""
        intervals [60]:
            xmin = 424.090
            xmax = 448.860
            text = "012430: Hna-quo-no ga-lv-lo-i da-ga-na-nu-go-tsi yv-wi u-we-tsi u-tse-li u-ye-lv-dv-i, a-le hna-quo ni-ga-dv da-ni-la-s-da-lv e-lo-hi do-dv-ni-yv-la-si, a-le dv-ni-go-hi yv-wi U-we-tsi tsa-i-se-s-di u-lo-gi-lv ga-lv-lo-i, u-li-ni-gi-di-yu ge-sv a-le u-tsa-ti ga-lv-quo-di-yu ge-sv u-nu-wo-s-de-s-di."
        intervals [61]:
            xmin = 448.860
            xmax = 449.775
            text = ""
        intervals [62]:
            xmin = 449.775
            xmax = 466.850
            text = "012431: Hna-quo-no do-da-ga-nv-si tsu-nv-si-da-s-di, a-le a-s-da-yi-yu dv-ni-tse-lu-hi-si, a-le do-dv-ni-tli-sa-ni ge-ga-su-ye-dv nv-gi ni-do-di-ga-lo-s-gv u-no-le, ga-lv-lo i-yv-dv wi-du-li-s-ti-ni-lv."
        intervals [63]:
            xmin = 466.850
            xmax = 467.520
            text = ""
        intervals [64]:
            xmin = 467.520
            xmax = 485.810
            text = "012432: Ka, i-tsa-de-lo-qua da-tli-lo-s-dv sv-ga-ta-i-yu-s-di tlu-gv-i; I-yu-ye-no du-wa-ni-ga-lv di-da-ge ni-de-ga-li-s-da, a-le gi-la-i tsi-ga-la-s-du-hv-s-go-i, i-tsi-ga-ta-ho go-gi na-v-ni-yu ge-sv-i."
        intervals [65]:
            xmin = 485.810
            xmax = 487.050
            text = ""
        intervals [66]:
            xmin = 487.050
            xmax = 501.220
            text = "012433: Na-s-gi-ya-s-gi-ni na-s-quo ni-hi, i-yu-no hna-quo hi-a na-s-gi tsu-da-le-nv-dv i-tsi-go-hv-ha, i-tsi-ga-ta-he-s-di e-s-ga-ni-yu ge-sv-i, ga-lo-hi-s-di-yi-quo ge-sv-i."
        intervals [67]:
            xmin = 501.220
            xmax = 502.030
            text = ""
        intervals [68]:
            xmin = 502.030
            xmax = 513.360
            text = "012434: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; Hi-a go-hi tsa-ne-ha v-tla yv-dv-ni-lo-so-ni, gv-ni ni-ga-dv hi-a tsu-da-le-nv-dv ni-ga-li-s-ta-nv-ha."
        intervals [69]:
            xmin = 513.360
            xmax = 514.330
            text = ""
        intervals [70]:
            xmin = 514.330
            xmax = 521.360
            text = "012435: Ga-lv-lo a-le e-lo-hi do-da-ga-lo-so-ni, a-yv-s-gi-ni a-gi-ne-tsv-i v-tla yv-da-ga-lo-so-ni."
        intervals [71]:
            xmin = 521.360
            xmax = 522.410
            text = ""
        intervals [72]:
            xmin = 522.410
            xmax = 535.900
            text = "012436: A-se-no na-hi-yu i-ga ge-sv a-le i-yu-tli-lo-dv ka-la-wa-di-sv v-tla gi-lo ya-ga-ta-ha, tla na-s-quo di-ni-ka-hna-wa-di-do-hi ga-lv-la-di a-ne-hi, E-do-da-s-gi-ni u-wa-sv-hi-yu."
        intervals [73]:
            xmin = 535.900
            xmax = 536.715
            text = ""
        intervals [74]:
            xmin = 536.715
            xmax = 544.210
            text = "012437: Na-s-gi-ye-no tsi-nu-s-de na-hi-yu No-ya tse-he-i, na-s-gi-ya nu-s-de-s-di yv-wi U-we-tsi ga-lu-tsv-ha."
        intervals [75]:
            xmin = 544.210
            xmax = 545.110
            text = ""
        intervals [76]:
            xmin = 545.110
            xmax = 563.645
            text = "012438: Na-hi-yu-e-no a-si ni-ga-no-hu-gi-s-gv-na tsi-ge-se-i, da-na-li-s-da-yv-hv-s-ge-i, a-le da-na-di-ta-s-ge-i, a-le da-na-de-sv-hv-s-ge-i a-le de-ge-tsi-ye-ge-i, gv-ni na-hi-yu i-ga No-ya u-tsa-nv tsi-yu-hi,"
        intervals [77]:
            xmin = 563.645
            xmax = 564.720
            text = ""
        intervals [78]:
            xmin = 564.720
            xmax = 578.560
            text = "012439: A-le na-ne-li-s-gv-na tsi-ge-se-i, gv-ni u-no-hu-ga-ni-lv, a-le ni-ga-dv du-ni-gv-tsv, na-s-gi-ya-quo-s-gi-ni na-s-quo nu-s-de-s-di yv-wi U-we-tsi ga-lu-tsv-ha."
        intervals [79]:
            xmin = 578.560
            xmax = 579.290
            text = ""
        intervals [80]:
            xmin = 579.290
            xmax = 588.415
            text = "012440: Hna-quo-no a-ni-ta-li tlo-ge-si a-ne-do-he-s-di, a-si-yv-wi a-tsi-ya-nv-di ge-se-s-di so-i-no a-tsi-ka-hi-ya-s-di ge-se-s-di;"
        intervals [81]:
            xmin = 588.415
            xmax = 589.020
            text = ""
        intervals [82]:
            xmin = 589.020
            xmax = 600.260
            text = "012441: A-ni-ta-li a-ni-ge-yv a-ni-s-do-s-ge-s-di a-s-do-s-gi-yi, a-si-yv-wi a-tsi-ya-nv-di ge-se-s-di so-i-no a-tsi-ka-hi-ya-s-di ge-se-s-di."
        intervals [83]:
            xmin = 600.260
            xmax = 601.160
            text = ""
        intervals [84]:
            xmin = 601.160
            xmax = 611.325
            text = "012442: Na-s-gi i-yu-s-di i-tsi-ya-wi-s-ge-s-di, v-tla-ye-no yi-tsi-ga-ta-ha i-yu-quo u-lu-hi-s-di-yi i-tsa-tse-li U-gv-wi-yu-hi."
        intervals [85]:
            xmin = 611.325
            xmax = 612.190
            text = ""
        intervals [86]:
            xmin = 612.190
            xmax = 628.635
            text = "012443: Hi-a-no i-tsa-nv-te-s-di, i-yu-no a-s-ga-ya ga-ne-la yi-a-ga-ta-he i-yu-quo ga-no-s-gi-s-gi u-lu-hi-s-di-yi, yu-ya-wi-se-i, a-le v-tla u-ne-la-gi wa-gi-yv-si ga-li-tso-de yi-gv-we-li-se-i."
        intervals [87]:
            xmin = 628.635
            xmax = 629.650
            text = ""
        intervals [88]:
            xmin = 629.650
            xmax = 641.755
            text = "012444: Na-s-gi i-yu-s-di ni-hi na-s-quo i-tsa-dv-nv-i-s-de-s-di, ni-tse-li-s-gv-na-quo-ye-no ge-sv i-yu yv-wi u-we-tsi da-ga-lu-tsi."
        intervals [89]:
            xmin = 641.755
            xmax = 642.715
            text = ""
        intervals [90]:
            xmin = 642.715
            xmax = 664.280
            text = "012445: Ga-go-ge-no a-ga-li-ya a-le a-si-na-sa-ni a-tsi-nv-si-da-s-di, na-s-gi u-nv-si-do-hi nu-gv-wi-yu-sv i-yu-wa-ne-lv-hi ga-ne-lv du-da-ti-hna-v-i, na-s-gi u-na-li-s-da-yv-di tsu-ne-di-yi u-na-li-s-da-yv-di-yi ni-ga-li-s-ta-ni-sv-i?"
        intervals [91]:
            xmin = 664.280
            xmax = 665.120
            text = ""
        intervals [92]:
            xmin = 665.120
            xmax = 675.155
            text = "012446: O-si-yu i-yu-li-s-da-ne-di na-s-gi na a-tsi-nv-si-da-s-di u-nv-si-do-hi ga-lu-tsv-ha u-wa-dv-hv-ha na-s-gi na-dv-ne-hv-i."
        intervals [93]:
            xmin = 675.155
            xmax = 675.920
            text = ""
        intervals [94]:
            xmin = 675.920
            xmax = 682.370
            text = "012447: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; Ni-ga-dv u-hna-v-i dv-ga-ti-di-s-ta-ni."
        intervals [95]:
            xmin = 682.370
            xmax = 683.240
            text = ""
        intervals [96]:
            xmin = 683.240
            xmax = 694.970
            text = "012448: I-yu-s-gi-ni-no na-s-gi na u-ne-gu-tsi-dv a-tsi-nv-si-da-s-di hi-a ni-ga-we-s-ge-s-di tsu-da-nv-dv-i; A-gi-nv-si-do-hi go-hi-di-ha u-lu-hi-s-di-yi;"
        intervals [97]:
            xmin = 694.970
            xmax = 695.805
            text = ""
        intervals [98]:
            xmin = 695.805
            xmax = 708.990
            text = "012449: A-le a-le-ni-s-ge-s-di do-ga-lv-ni-he-s-di i-tsu-la-ha ge-tsi-nv-si-da-s-di, a-le i-tsu-la-ha a-na-li-s-da-yv-hv-s-ge-s-di a-le da-na-di-ta-s-ge-s-di tsu-ni-yv-s-de-s-gi,"
        intervals [99]:
            xmin = 708.990
            xmax = 709.675
            text = ""
        intervals [100]:
            xmin = 709.675
            xmax = 722.005
            text = "012450: Na-s-gi a-tsi-nv-si-da-s-di u-nv-si-do-hi da-ga-lu-tsi na-hi-yu i-ga na-da-ga-te-no-hv-na ge-sv-i, a-le i-yu ne-li-s-gv-na ge-sv-i,"
        intervals [101]:
            xmin = 722.005
            xmax = 722.810
            text = ""
        intervals [102]:
            xmin = 722.810
            xmax = 735.420
            text = "012451: A-le do-da-yu-ga-li-si, a-le u-na-tlo-na-s-di wa-ne-hv wv-da-yu-se-he-li; na-hna da-ni-yv-ge-s-di a-le da-ni-lv-da-gi-s-ge-s-di da-ni-nu-do-gv-i."
