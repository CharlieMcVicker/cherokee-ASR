item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 397.100
        intervals: size = 50
        intervals [1]:
            xmin = 0.000
            xmax = 2.835
            text = ""
        intervals [2]:
            xmin = 2.835
            xmax = 10.230
            text = "010401: Hna-quo-no A-da-nv-do i-na-ge wu-ti-nv-s-ta-ne Tsi-sa, a-s-gi-na u-go-li-ye-di-yi a-ye-lv-se-i."
        intervals [3]:
            xmin = 10.230
            xmax = 11.745
            text = ""
        intervals [4]:
            xmin = 11.745
            xmax = 19.825
            text = "010402: Nv-ga-s-go-hi-no tsu-do-da-qua-dv a-le nv-ga-s-go-hi tsu-sv-hi-dv a-ma-tli u-wa-nv gi-la u-yo-si-sa-ne-i"
        intervals [5]:
            xmin = 19.825
            xmax = 20.980
            text = ""
        intervals [6]:
            xmin = 20.980
            xmax = 34.370
            text = "010403: Hna-quo-no u-go-li-ye-s-gi u-lu-tse-lv hi-a nu-we-se-i; I-yu-no ni-hi U-ne-la-nv-hi U-we-tsi ge-se-s-di, hi-a nv-ya ga-du u-na-do-tlv-di-yi hi-ne-gi."
        intervals [7]:
            xmin = 34.370
            xmax = 35.800
            text = ""
        intervals [8]:
            xmin = 35.800
            xmax = 53.165
            text = "010404: A-se-no u-ne-tsv, hi-a nu-we-se-i; Hi-a ni-gv-nv go-we-la, yv-wi v-tla ga-du-quo u-wa-sv yi-gv-hna-di-s-di, ni-ga-v-s-gi-ni ka-no-he-dv U-ne-la-nv-hi a-ho-li nv-da-yu-na-nu-go-tsv-hi."
        intervals [9]:
            xmin = 53.165
            xmax = 54.270
            text = ""
        intervals [10]:
            xmin = 54.270
            xmax = 65.835
            text = "010405: Hna-quo-no a-s-gi-na ga-lv-quo-di-yu di-ga-du-hv wu-ti-nv-s-ta-ne-i, a-le wu-gi-lv-ta-ne u-s-go-li u-dv-nv--di-ga-la-wi-i-s-di-yi;"
        intervals [11]:
            xmin = 65.835
            xmax = 67.480
            text = ""
        intervals [12]:
            xmin = 67.480
            xmax = 97.895
            text = "010406: Hi-a-no nu-we-se-le-i; I-yu-no ni-hi U-ne-la-nv-hi U-we-tsi ge-se-s-di, ha-da-lo-v-da tsv-sv; hi-a-ye-no ni-gv-nv i-go-we-la; A-se do-da-ka-ne-tse-li gu-tse-li di-ni-ka-hna-wa-di-do-hi ni-sa ge-sv u-gv-wa-li, a-le tsu-no-ye-ni ge-tsa-sa-la-do-de-s-di na-s-gi i-lv-hi-yu nv-yo-hi tsa-na-s-qua-lo-s-do-di-yi ni-ge-sv-na."
        intervals [13]:
            xmin = 97.895
            xmax = 99.165
            text = ""
        intervals [14]:
            xmin = 99.165
            xmax = 109.820
            text = "010407: Tsi-sa hi-a nu-we-se-le-i; Hi-a na-s-quo ni-gv-nv i-go-we-la; Tle-s-di hi-go-li-ye-v-gi Yi-ho-wa Tsa-ne-la-nv-hi."
        intervals [15]:
            xmin = 109.820
            xmax = 111.160
            text = ""
        intervals [16]:
            xmin = 111.160
            xmax = 129.525
            text = "010408: Hna-qua-le a-s-gi-na u-tsa-ti i-nv--i-ga-ti o-da-lv wi-u-ti-nv-s-ta-ne-i, a-le du-se-he-le ni-ga-v a-ye-li de-go-tlv-wa-di-sv e-la-ni-gv-i, a-le na-s-gi ni-du-wo-du-sv-i;"
        intervals [17]:
            xmin = 129.525
            xmax = 130.455
            text = ""
        intervals [18]:
            xmin = 130.455
            xmax = 140.510
            text = "010409: A-le hi-a nu-we-se-le-i; Hi-a ni-ga-dv yi-de-gv-yo-hi-si, i-yu-no yi-tsa-da-nv-nv, a-le yi-s-qua-da-do-li-s-da-ne-lv."
        intervals [19]:
            xmin = 140.510
            xmax = 141.820
            text = ""
        intervals [20]:
            xmin = 141.820
            xmax = 161.180
            text = "010410: Hna-quo-no Tsi-sa hi-a nu-we-se-le-i; U-tli wi-lo-hi, Se-da-ni, hi-a-ye-no ni-gv-nv i-go-we-la; a-se hi-ya-da-do-li-s-da-ne-he-s-di Yi-ho-wa Tsa-ne-la-nv-hi, a-le na-s-gi-quo u-wa-sv-hi-yu de-hi-ya-ne-lo-de-s-di."
        intervals [21]:
            xmin = 161.180
            xmax = 162.045
            text = ""
        intervals [22]:
            xmin = 162.045
            xmax = 171.440
            text = "010411: Gi-la-no a-s-gi-na u-da-nv-e-le-i, gv-ni-yu-quo-no di-ni-ka-hna-wa-di-do-hi u-ni-lu-tse-i, a-le gv-wa-s-de-lv-hi-do-le-i."
        intervals [23]:
            xmin = 171.440
            xmax = 172.570
            text = ""
        intervals [24]:
            xmin = 172.570
            xmax = 178.640
            text = "010412: Tsi-sa-no u-dv-ga-nv Tsa-ni a-tsi-s-du-hv-i, Ge-li-li wu-lo-se-i."
        intervals [25]:
            xmin = 178.640
            xmax = 180.160
            text = ""
        intervals [26]:
            xmin = 180.160
            xmax = 197.490
            text = "010413: Na-se-li-di-no u-da-nv-sv ge-qua-ni ge-lu-tse na-hna wu-de-ne-i, na-s-gi v-da-li a-ma-yu-lo-di tsi-ga-du-ha, Tse-qua-la-ni a-le Ne-wa-ta-li u-na-tse-li-go-hi,"
        intervals [27]:
            xmin = 197.490
            xmax = 198.640
            text = ""
        intervals [28]:
            xmin = 198.640
            xmax = 204.250
            text = "010414: U-do-hi-yu-di-yi a-do-le-ho-s-gi I-sa-ya tsu-ne-tse-i, hi-a tsi-nu-we-se-i;"
        intervals [29]:
            xmin = 204.250
            xmax = 205.340
            text = ""
        intervals [30]:
            xmin = 205.340
            xmax = 219.470
            text = "010415: Tse-qua-la-ni u-na-tse-li-go-hi, a-le Ne-wa-ta-li u-na-tse-li-go-hi, i-da-li i-di-tlv, Tso-da-ni u-di-di-tlv, Ge-li-li Tsu-na-da-le-nv-dv yv-wi da-ni-ne-lv-i,"
        intervals [31]:
            xmin = 219.470
            xmax = 221.335
            text = ""
        intervals [32]:
            xmin = 221.335
            xmax = 237.465
            text = "010416: Yv-wi u-li-si-gv tsa-ni-nv-gi u-tsa-ti i-ga-ga-ti u-ni-go-hv, na-no a-yo-hu-hi-s-di-yi ge-sv u-tse-li-go-hi a-le u-da-wa-di-s-gv tsa-ni-nv-gi, i-ga-ga-ti u-ni-na-nu-go-tse-lv."
        intervals [33]:
            xmin = 237.465
            xmax = 238.450
            text = ""
        intervals [34]:
            xmin = 238.450
            xmax = 255.420
            text = "010417: Na-hi-yu Tsi-sa u-le-nv-he a-li-tsi-do-hv-s-ge-i, hi-a ni-ga-we-s-ge-i; di-tsi-ne-tli-yv-na de-tsa-da-nv-dv-i, hna-quo-ye-no ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv e-s-ga-ni-yu da-ya-i."
        intervals [35]:
            xmin = 255.420
            xmax = 256.420
            text = ""
        intervals [36]:
            xmin = 256.420
            xmax = 275.690
            text = "010418: Tsi-sa-no a-i-sv Ge-li-li v-da-lu-lo-di du-go-he a-ni-ta-li a-na-li-nv-tli, Sa-wa-ni Qui-da tsa-no-se-ho-i u-nv-tli-no E-ni-di, v-da-li a-ni-ga-ya-lu-v-s-ge-i--a-ni-ga-ya-lu-v-s-gi-ye-no ge-se-i."
        intervals [37]:
            xmin = 275.690
            xmax = 276.480
            text = ""
        intervals [38]:
            xmin = 276.480
            xmax = 284.190
            text = "010419: Hi-a-no ni-du-we-se-le-i; S-gi-ni-s-da-wa-du-ga, yv-wi-no i-s-di-ga-ya-lu-v-s-gi nv-da-s-dv-yv-ne-li."
        intervals [39]:
            xmin = 284.190
            xmax = 285.110
            text = ""
        intervals [40]:
            xmin = 285.110
            xmax = 291.415
            text = "010420: Gi-la-quo-no i-yv-dv du-ni-yo-se di-ga-ya-lu-di a-le gv-wa-s-da-wa-dv-se-i."
        intervals [41]:
            xmin = 291.415
            xmax = 292.950
            text = ""
        intervals [42]:
            xmin = 292.950
            xmax = 316.295
            text = "010421: Na-hna-no wi-u-we-nv, a-ni-ta-li nv-wa-na-da-le a-na-li-nv-tli du-go-he-i, Tsi-mi Tse-qui-di u-we-tsi u-nv-tli-no Tsa-ni, tse-qui-di u-ni-do-da tsi-yu-hi u-na-tsa-e-i, da-no-tlv-hi-si-s-ge tsu-ni-ga-ya-lu-di; wi-du-ya-nv-he-no."
        intervals [43]:
            xmin = 316.295
            xmax = 317.085
            text = ""
        intervals [44]:
            xmin = 317.085
            xmax = 325.010
            text = "010422: Gi-la-quo-no i-yv-dv du-ni-yo-se tsi-yu a-le u-ni-do-da, a-le gv-wa-s-da-wa-dv-se-i."
        intervals [45]:
            xmin = 325.010
            xmax = 326.050
            text = ""
        intervals [46]:
            xmin = 326.050
            xmax = 351.200
            text = "010423: Tsi-sa-no ni-gv-na-dv Ge-li-li e-do-he-i da-de-yo-hv-s-ge tsu-ni-la-wi-i-s-di-yi, a-le a-li-tsi-do-hv-s-ge o-s-dv ka-no-he-dv, U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv ka-no-he-s-ge-i, a-le de-ka-nv-wi-s-ge tsu-li-le-nv-dv du-ni-tlv-gv-i, a-le tsu-da-le-nv-dv v-yu-gi yv-wi u-ne-hv-i."
        intervals [47]:
            xmin = 351.200
            xmax = 352.300
            text = ""
        intervals [48]:
            xmin = 352.300
            xmax = 379.730
            text = "010424: De-ga-no-tsa-lv-no ni-gv-na-dv Si-li-yi u-ye-li-se-i; de-gv-wa-ti-no-he-le-no ni-ga-dv tsu-ni-tlv-gi, tsu-da-le-nv-dv v-yu-gi a-le e-hi-s-di u-ni-yi-li-do-hi, a-le na-s-quo a-ni-s-gi-na di-gv-wa-ni-ya-i, a-le na-s-quo tsu-ni-lv-no-ti-s-gi, a-le na-s-quo tsu-ni-na-wi-s-gi; du-nv-wa-ne-no."
        intervals [49]:
            xmin = 379.730
            xmax = 380.530
            text = ""
        intervals [50]:
            xmin = 380.530
            xmax = 397.100
            text = "010425: U-ni-tsa-ti-no yv-wi gv-wa-s-da-wa-dv-se-i nv-da-yu-ni-lo-sv-hi ge-li-li, A-s-go-hi-no--Ga-du-gi-yi, a-le Tsi-lu-si-li-mi, a-le Tsu-di-yi, a-le Tso-da-ni s-go-ni-di-tlv."
