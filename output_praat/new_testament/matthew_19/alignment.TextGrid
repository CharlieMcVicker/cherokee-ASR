item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 495.115
        intervals: size = 60
        intervals [1]:
            xmin = 0.000
            xmax = 6.400
            text = ""
        intervals [2]:
            xmin = 6.400
            xmax = 19.160
            text = "011901: Hi-a-no nu-li-s-ta-nv-gi, Tsi-sa u-s-qua-dv na-s-gi hi-a ni-ga-we-s-gv-i, Ge-li-li u-da-nv-sv-gi, Tsu-di-yi a-s-dv wu-lu-tsv-gi Tso-da-ni a-s-go-ni-di-tlv."
        intervals [3]:
            xmin = 19.160
            xmax = 20.620
            text = ""
        intervals [4]:
            xmin = 20.620
            xmax = 25.885
            text = "011902: U-ni-tsa-ti-no gv-wa-s-da-wa-dv-sv-gi, a-le na-hna du-nv-wa-nv-gi."
        intervals [5]:
            xmin = 25.885
            xmax = 27.155
            text = ""
        intervals [6]:
            xmin = 27.155
            xmax = 44.010
            text = "011903: A-ni-qua-li-si na-s-quo gv-wa-lu-tse-lv gv-wa-go-li-ye-s-gv-gi, hi-a ni-gv-wa-we-se-hv-gi; Du-yu-go-di-s-go a-s-ga-ya u-da-i-nv-di-yi u-da-li-i ni-ga-v-quo go-hu-s-di yv-di-li-ye-i-lv-s-di-ha?"
        intervals [7]:
            xmin = 44.010
            xmax = 45.320
            text = ""
        intervals [8]:
            xmin = 45.320
            xmax = 59.400
            text = "011904: U-ne-tsv-no hi-a ni-du-we-se-lv-gi; Tla-s-go yi-tsi-go-li-ye-o, na-s-gi di-da-le-ni-s-gv tsu-we-tlv-nv-hi a-s-ga-ya a-le a-ge-yv du-wo-tlv-nv-i?"
        intervals [9]:
            xmin = 59.400
            xmax = 60.450
            text = ""
        intervals [10]:
            xmin = 60.450
            xmax = 77.110
            text = "011905: A-le hi-a nu-we-sv-i; Na-s-gi i-yu-s-di a-s-ga-ya de-gv-de-ge-s-di u-do-da a-le u-tsi, a-le a-dla-wi-s-di-s-ge-s-di u-da-li-i, a-le na-s-gi a-ni-ta-li sa-quo-quo u-ni-que-da-lv-i?"
        intervals [11]:
            xmin = 77.110
            xmax = 78.740
            text = ""
        intervals [12]:
            xmin = 78.740
            xmax = 95.320
            text = "011906: Na-s-gi i-yu-s-di v-tla hna-quo a-ni-ta-li yi-gi; sa-quo-quo-s-gi-ni u-ni-que-da-lv-i.  Na-s-gi i-yu-s-di U-ne-la-nv-hi tsu-wu-da-ta-nv-hi ge-sv tle-s-di yv-wi yi-du-ga-le-nv-ta-ne-s-di."
        intervals [13]:
            xmin = 95.320
            xmax = 96.730
            text = ""
        intervals [14]:
            xmin = 96.730
            xmax = 108.120
            text = "011907: Hi-a-no nv-gv-wa-we-se-lv-gi; Ga-do-no Yi-si tsu-ne-tse go-we-li ga-nv-ne-di-yi di-ga-le-nv-do-di, a-le a-ge-hi-da-s-di-yi?"
        intervals [15]:
            xmin = 108.120
            xmax = 109.380
            text = ""
        intervals [16]:
            xmin = 109.380
            xmax = 127.730
            text = "011908: Hi-a-no ni-du-we-se-lv-gi; di-s-da-yi-yu ge-sv i-yu-s-di di-tsi-na-wi Mo-si u-na-ne-la-gi da-ni-ge-do-hi-he-s-di tsu-na-da-li-i, i-tse-li-se-lv-gi; di-da-le-ni-s-gv-s-gi-ni v-tla na-s-gi yi-nu-s-de-i."
        intervals [17]:
            xmin = 127.730
            xmax = 128.990
            text = ""
        intervals [18]:
            xmin = 128.990
            xmax = 152.760
            text = "011909: A-se-no hi-a ni-tsv-we-se-ha; Gi-lo u-da-li-i i-a-ge-hi-do-he-s-di tsu-ni-si-nv-hi-s-gi-ni-no-nv i-ge-se-s-di, nv-wa-da-le-no i-a-da-ye-ge-s-di, a-da-yo-ne-he-s-di.  Gi-lo-no a-tsi-ge-hi-do-lv-hi a-da-ye-ge-s-di a-da-yo-ne-he-s-di."
        intervals [19]:
            xmin = 152.760
            xmax = 154.210
            text = ""
        intervals [20]:
            xmin = 154.210
            xmax = 168.265
            text = "011910: Gv-wa-s-da-wa-di-do-hi hi-a ni-gv-wa-we-se-lv-gi; I-yu-no na-s-gi yi-nu-s-di a-s-ga-ya u-da-li-i da-na-tse-hv-i, v-tla o-si-yu yi-gi a-de-sv-hv-s-di-yi."
        intervals [21]:
            xmin = 168.265
            xmax = 169.390
            text = ""
        intervals [22]:
            xmin = 169.390
            xmax = 180.540
            text = "011911: Hi-a-no ni-du-we-se-lv-gi, V-tla na-ni-v hi-a tsi-ni-tsi wi yi-do-gv-na-da-ni-lv-gi, ge-ga-li-s-go-lv-da-ne-lv-hi u-nv-sv."
        intervals [23]:
            xmin = 180.540
            xmax = 181.380
            text = ""
        intervals [24]:
            xmin = 181.380
            xmax = 209.000
            text = "011912: A-ne-ha-ye-no a-ni-na-li nv-wa-na-s-do tsu-ni-tsi gv-wa-ni-na-nu-go-wi-sv, a-le a-ne-ha a-ni-na-li yv-wi gv-wa-ni-na-li-dv-hi, a-le a-ne-ha a-ni-na-li u-nv-sv u-na-da-na-li-dv-hi ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv di-li-ye-i-lv-s-di-s-gv-i.  Gi-lo di-gv-wa-da-ni-lv-i-s-di ge-se-s-di na-s-gi da-da-ni-lv-ge-s-di."
        intervals [25]:
            xmin = 209.000
            xmax = 209.740
            text = ""
        intervals [26]:
            xmin = 209.740
            xmax = 222.970
            text = "011913: Hna-quo-no da-ga-ti-no-he-lv-gi tsu-na-s-di di-ni-yo-li na-s-gi tsu-si-ta-di-s-di-yi a-le u-da-do-li-s-do-di-yi; gv-wa-s-da-wa-di-do-hi-no du-ni-nv-s-da-de-lv-gi."
        intervals [27]:
            xmin = 222.970
            xmax = 223.870
            text = ""
        intervals [28]:
            xmin = 223.870
            xmax = 239.440
            text = "011914: Tsi-sa-no hi-a nu-we-sv-gi; U-na-ne-la-gi di-tse-li-si tsu-na-s-di di-ni-yo-li, a-le tle-s-di di-tsi-nv-s-da-de-lv-gi gv-gi-lu-tse-di-yi; na-s-gi-ye-no nu-na-s-di ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv."
        intervals [29]:
            xmin = 239.440
            xmax = 240.130
            text = ""
        intervals [30]:
            xmin = 240.130
            xmax = 243.175
            text = "011915: Du-si-ta-dv-no na-hna u-da-nv-sv-gi."
        intervals [31]:
            xmin = 243.175
            xmax = 243.760
            text = ""
        intervals [32]:
            xmin = 243.760
            xmax = 260.520
            text = "011916: Gv-ni-yu-quo-no a-si-yv-wi u-lu-tse-lv-gi hi-a nu-we-se-lv-gi; Ho-s-dv Ta-de-yo-hv-s-gi, ga-do u-s-di o-s-dv go-hu-s-di da-ga-dv-ne-li a-gi-wa-dv-do-di wi-na-s-dv-na gv-ni-dv?"
        intervals [33]:
            xmin = 260.520
            xmax = 261.010
            text = ""
        intervals [34]:
            xmin = 261.010
            xmax = 280.890
            text = "011917: Hi-a-no nu-we-se-lv-gi; Ga-do-no ho-s-dv i-s-quo-se-ha?  V-tla gi-lo o-s-dv yi-gi sa-quo u-wa-sv-hi-yu, na-s-gi U-ne-la-nv-hi.  A-se-no tsa-du-li-s-ge-s-di gv-ni-dv di-ge-sv wi-tsa-na-nu-go-i-s-di-yi ti-s-qua-ni-go-da di-ka-hna-wa-dv-s-di."
        intervals [35]:
            xmin = 280.890
            xmax = 281.770
            text = ""
        intervals [36]:
            xmin = 281.770
            xmax = 299.480
            text = "011918: Hi-a nu-we-se-lv-gi; Ga-do u-s-di?  Tsi-sa hi-a nu-we-e-gi; Hi-a, Tle-s-di tsa-da-lv-gi; Tle-s-di tsa-da-yo-ne-lv-gi; Tle-s-di tsa-no-s-gi-sv-gi; da-na-da-yi-li-do-hv Tle-s-di ga-ye-go-gi tsa-no-he-lv-gi;"
        intervals [37]:
            xmin = 299.480
            xmax = 300.330
            text = ""
        intervals [38]:
            xmin = 300.330
            xmax = 312.660
            text = "011919: Hi-lv-quo-de-s-di tsa-do-da a-le tsa-tsi; a-le na-s-quo hi-a; Tsv-sv ni-tsa-da-ge-yu-sv ni-ge-yu-se-s-di na-v i-di-s-da-da-la."
        intervals [39]:
            xmin = 312.660
            xmax = 313.830
            text = ""
        intervals [40]:
            xmin = 313.830
            xmax = 324.640
            text = "011920: A-wi-nv hi-a nu-we-se-lv-gi; Hi-a na-s-gi ni-ga-dv da-gi-ka-hna-wa-de-nv tsi-tsu-tsa ge-sv nv-da-gv-wa-da-le-nv-dv, ga-do a-si a-gi-lu-la?"
        intervals [41]:
            xmin = 324.640
            xmax = 325.700
            text = ""
        intervals [42]:
            xmin = 325.700
            xmax = 345.145
            text = "011921: Tsi-sa hi-a nu-we-se-lv-gi; I-yu-no tsa-s-qua-di-s-di-yi tsa-du-li-s-ge-s-di, he-na, wi-na-du-ga tsa-hna-v-i, a-le ti-hv-si u-yo i-yu-na-dv-hna-de-gi, ga-lv-la-di-no wi-tsa-he-s-di tsu-gv-wa-lo-di; a-le te-sv s-gi-s-da-wa-de-sv-ha."
        intervals [43]:
            xmin = 345.145
            xmax = 346.100
            text = ""
        intervals [44]:
            xmin = 346.100
            xmax = 356.280
            text = "011922: A-se-no a-wi-nv na-s-gi u-dv-ga-nv u-da-nv-sv-gi u-yo-i-yu u-ye-lv-nv-gi, u-tsa-ti-ye-no u-we-hna-i-yu ge-sv-gi."
        intervals [45]:
            xmin = 356.280
            xmax = 357.180
            text = ""
        intervals [46]:
            xmin = 357.180
            xmax = 370.980
            text = "011923: Hna-quo-no tsi-sa hi-a ni-du-we-se-lv gv-wa-s-da-wa-di-do-hi; U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; u-we-hna-i yv-wi a-s-da-yi-yu wu-yv-s-di-yi ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv-i."
        intervals [47]:
            xmin = 370.980
            xmax = 372.160
            text = ""
        intervals [48]:
            xmin = 372.160
            xmax = 387.030
            text = "011924: A-le-wo hi-a ni-tsv-we-se-ha; u-tli a-hi-di-yu ge-mi-li u-ga-dv-le-hi-s-di-yi yv-gi ga-si-ne-na-dv-di-yi e-s-ga-quo u-we-hna-i yv-wi wu-yv-s-di-yi U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv-i."
        intervals [49]:
            xmin = 387.030
            xmax = 387.720
            text = ""
        intervals [50]:
            xmin = 387.720
            xmax = 399.400
            text = "011925: Gv-wa-s-da-wa-di-do-hi-no u-na-dv-ga-nv u-tsa-ta-nv-hi u-ni-s-qua-ni-go-sv-gi, hi-a nu-ni-we-sv-gi Ga-go-no ye-li ya-tsi-s-de-lv?"
        intervals [51]:
            xmin = 399.400
            xmax = 400.250
            text = ""
        intervals [52]:
            xmin = 400.250
            xmax = 416.200
            text = "011926: Tsi-sa-no na-s-gi du-ka-hna-nv hi-a ni-du-we-se-lv-gi; Yv-wi ge-sv v-tla na-s-gi yi-nv-ga-li-s-da, U-ne-la-nv-hi-s-gi-ni ge-sv ni-ga-v go-hu-s-di i-yu-li-s-do-di-quo."
        intervals [53]:
            xmin = 416.200
            xmax = 417.250
            text = ""
        intervals [54]:
            xmin = 417.250
            xmax = 429.780
            text = "011927: Hna-quo-no Qui-da u-ne-tsv hi-a nu-we-se-lv-gi; Gv-ni-yu-quo a-yv ni-ga-di-yu do-gi-yo-so-nv a-le i-tsv-s-da-wa-de-nv; ga-do-no a-yv da-yo-tsi-wa-dv-hi?"
        intervals [55]:
            xmin = 429.780
            xmax = 430.730
            text = ""
        intervals [56]:
            xmin = 430.730
            xmax = 456.030
            text = "011928: Tsi-sa-no hi-a ni-du-we-se-lv-gi; U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; a-da-ne-tli-yv-sv-i, Yv-wi U-we-tsi ga-nv-ha ga-lv-quo-di-yu u-we-s-gi-lv-i, ni-hi s-gi-s-da-wa-dv-dv na-s-quo i-tsi-ne-s-di ta-la-du de-ga-s-gi-lv-i, de-tsu-go-da-ne-he-s-di ta-la-du na-ni-la-s-da-lv I-si-li."
        intervals [57]:
            xmin = 456.030
            xmax = 457.190
            text = ""
        intervals [58]:
            xmin = 457.190
            xmax = 485.030
            text = "011929: A-le na-ni-v gi-lo tsu-nv-de-tsv-hi da-ni-ne-lv-i, a-le a-na-li-nv-tli a-le tsu-ni-do, a-le tsu-ni-do-da, a-le tsu-ni-tsi, a-le tsu-na-da-li-i, a-le tsu-ne-tsi, a-le ga-do-hi, da-qua-do-v nv-di-ga-li-s-do-di-s-ge-s-di, u-ni-wa-dv-di ge-se-s-di a-s-go-hi-tsu-qui u-ne-quo-tsv-hi, a-le u-na-tse-li i-yu-li-s-do-di ge-se-s-di gv-ni-dv wi-na-s-dv-na."
        intervals [59]:
            xmin = 485.030
            xmax = 485.880
            text = ""
        intervals [60]:
            xmin = 485.880
            xmax = 495.115
            text = "011930: A-se-no u-ni-tsa-ta i-gv-yi tsi-gi o-ni-yi ge-se-s-di; o-ni-yi-no tsi-gi i-gv-yi-i-ge-se-s-di."
