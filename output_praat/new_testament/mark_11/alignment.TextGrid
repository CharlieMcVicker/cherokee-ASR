item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 509.860
        intervals: size = 66
        intervals [1]:
            xmin = 0.000
            xmax = 3.730
            text = ""
        intervals [2]:
            xmin = 3.730
            xmax = 16.230
            text = "021101: Tsi-lu-si-li-mi-no na-v wu-ni-lu-tsv na-s-gi Sv-ga-do-hi a-le Que-di-ni-yi i-yv-dv, O-li-wa-yo-hi u-sa-hi-lv-i, a-ni-ta-li gv-wa-s-da-wa-di-do-hi du-nv-se-i,"
        intervals [3]:
            xmin = 16.230
            xmax = 16.905
            text = ""
        intervals [4]:
            xmin = 16.905
            xmax = 41.780
            text = "021102: A-le hi-a ni-du-we-se-le-i, I-s-de-na na de-s-di-do-gv tsu-yu-go-di tsv-di-ga-du-ha wi-s-di-tsa-hi; wi-s-di-yv-lv-quo-no na-hna-ni, da-ye-s-di-wa-dv-hi di-ga-li-a-nv-hi-dv a-gi-na ge-li-sa-de-s-di, na-s-gi v-tla gi-lo yv-wi u-gi-lv-ta-nv-hi yi-gi; e-s-de-li-sa-de-sv-ha a-le tse-s-da-ti-ne-sv-ha."
        intervals [5]:
            xmin = 41.780
            xmax = 42.760
            text = ""
        intervals [6]:
            xmin = 42.760
            xmax = 57.445
            text = "021103: I-yu-no gi-lo Ga-do-no na-s-gi ni-s-da-dv-ne-ha i-s-do-se-lv-ha?  U-gv-wi-yu-hi u-du-li-ha, i-s-da-dv-nv-ha; gi-la-quo-no i-yv-dv do-da-yu-yo-si a-ni e-s-da-ti-no-hi-s-di-yi."
        intervals [7]:
            xmin = 57.445
            xmax = 58.050
            text = ""
        intervals [8]:
            xmin = 58.050
            xmax = 71.040
            text = "021104: U-ne-nv-se-no, a-le wu-ni-wa-dv-he a-gi-na ge-li-sa-de ga-lo-hi-s-di-yu-lo-di do-yi-di-tlv, na-hna de-ga-nv-nv da-tlo-s-gv-i; u-ne-li-sa-de-se-no."
        intervals [9]:
            xmin = 71.040
            xmax = 71.585
            text = ""
        intervals [10]:
            xmin = 71.585
            xmax = 79.835
            text = "021105: Gi-lo-no i-yu-na-s-di na-hna di-ni-do-gi hi-a ni-du-ni-we-se-le-i, Ga-do-no i-e-s-de-li-sa-de a-gi-wi?"
        intervals [11]:
            xmin = 79.835
            xmax = 80.660
            text = ""
        intervals [12]:
            xmin = 80.660
            xmax = 88.040
            text = "021106: A-le na-s-gi-ya-quo Tsi-sa nu-we-sv u-ne-tsv ni-du-ni-we-se-le-i:  du-ni-yo-se-no."
        intervals [13]:
            xmin = 88.040
            xmax = 88.845
            text = ""
        intervals [14]:
            xmin = 88.845
            xmax = 97.930
            text = "021107: A-gi-na-no Tsi-sa u-na-ti-no-he-le-i, a-le tsu-na-nu-wo du-ni-tlv-ne-le-i; Tsi-sa-no u-gi-lv-ta-ne-i."
        intervals [15]:
            xmin = 97.930
            xmax = 98.620
            text = ""
        intervals [16]:
            xmin = 98.620
            xmax = 108.710
            text = "021108: U-ni-tsa-te-no tsu-na-nu-wo nv-no-hi du-nu-ye-s-dv-ne-i; i-ga-dv-no de-tlu-gv du-nv-ni-ga-lv-he-i, a-le nv-no-hi du-ni-la-ge-ya-dv-ne-i."
        intervals [17]:
            xmin = 108.710
            xmax = 114.000
            text = ""
        intervals [18]:
            xmin = 114.000
            xmax = 130.915
            text = "021109: I-gv-yi-i a-ne-gi, a-le o-ni a-ne-gi, u-ne-lu-ge-i, hi-a na-ni-we-s-ge-i, Ho-sa-na, Ga-lv-quo-di-yu ge-se-s-di Yi-ho-wa de-u-do-s-dv tsi-ga-lu-hi-s-di-da."
        intervals [19]:
            xmin = 130.915
            xmax = 131.730
            text = ""
        intervals [20]:
            xmin = 131.730
            xmax = 145.480
            text = "021110: Ga-lv-quo-di-yu ge-se-s-di De-wi i-gi-do-da u-tse-li u-gv-wi-yu-hi ge-sv-i, na-s-gi Yi-ho-wa du-do-s-dv tsi-ga-lu-hi-s-di-ha; Ho-sa-na wa-s-dv ga-lv-la-di-yu."
        intervals [21]:
            xmin = 145.480
            xmax = 146.260
            text = ""
        intervals [22]:
            xmin = 146.260
            xmax = 168.560
            text = "021111: Tsi-sa-no Tsi-lu-si-li-mi wu-yv-le-i, a-le u-ta-nv--di-ga-la-wi-i-s-di-yi wu-yv-le-i; hna-quo-no gv-wa-du-wi-dv du-ka-hna-ni-do-lv ni-ga-dv tsu-da-le-nv-dv du-ka-hna-nv, a-le hna-quo u-sv-hi-yv-yi ge-se-i, u-nu-go-tse Que-di-ni-yi wu-lo-se a-ne-he ta-la-du i-ya-ni-dv."
        intervals [23]:
            xmin = 168.560
            xmax = 169.310
            text = ""
        intervals [24]:
            xmin = 169.310
            xmax = 174.450
            text = "021112: U-gi-tsv-dv-no Que-di-ni-yi tsu-ni-lo-sv a-go-nu u-yo-si-s-ge-i;"
        intervals [25]:
            xmin = 174.450
            xmax = 175.200
            text = ""
        intervals [26]:
            xmin = 175.200
            xmax = 201.610
            text = "021113: Wu-go-he-no ge i-yv-dv di-tlu-ge sv-ga-la-i-yu-s-di, u-li-s-du-se-i, wu-lu-tse-i, ya-se-ga-gi yi-tsi-wa-dv go-hu-s-di yu-ta u-we-li-se-i; na-hna-no wu-lu-tsv v-tla go-hu-s-di yu-wa-dv-he u-li-s-du-sv-quo u-wa-sv; v-tla-ye-no a-si yu-s-qua-lv-he sv-ga-ta-i-yu-na-s-di u-nv-ni-s-di-yi."
        intervals [27]:
            xmin = 201.610
            xmax = 202.220
            text = ""
        intervals [28]:
            xmin = 202.220
            xmax = 216.540
            text = "021114: Tsi-sa-no u-ne-tsv hi-a nu-we-se-le-i, Tle-s-di gi-lo i-lv-hi-yu tsi-a-gi ni-hi tsa-da-ta-nv-hi go-hi i-yu-da-le-nv-dv.  Gv-wa-s-da-wa-di-do-hi-no u-na-dv-ga-ne-i."
        intervals [29]:
            xmin = 216.540
            xmax = 217.465
            text = ""
        intervals [30]:
            xmin = 217.465
            xmax = 244.555
            text = "021115: Tsi-lu-si-li-mi-no u-ni-lu-tse-i; Tsi-sa-no u-ta-nv--di-ga-ta-wi-i-s-di-yi wu-yv-lv, u-le-nv-he du-nu-go-wi-se a-ni-na-de-gi a-le u-ni-wa-e-v-s-gi na-hna u-ta-nv--di-ga-la-wi-i-s-di-yi, a-le du-lu-qua-di-nv-se du-ni-s-gi-lv a-de-lv di-ni-tli-yv-s-gi, a-le u-na-nv-di-yi gu-le--di-ni-s-go-ni-hi di-ni-na-de-gi;"
        intervals [31]:
            xmin = 244.555
            xmax = 245.390
            text = ""
        intervals [32]:
            xmin = 245.390
            xmax = 254.845
            text = "021116: A-le v-tla u-ne-la-gi yu-we-li-se-le gi-lo go-hu-s-di u-s-di a-te-li-do u-yv-do-di-yi u-dv-nv--di-ga-la-wi-i-s-di-yi."
        intervals [33]:
            xmin = 254.845
            xmax = 255.800
            text = ""
        intervals [34]:
            xmin = 255.800
            xmax = 278.985
            text = "021117: Du-de-yo-ne-no, hi-a ni-du-we-se-le-i, tla-s-go hi-a yi-ni-gv-nv yi-go-we-la, a-qua-tse-li a-da-ne-lv ni-ga-di-yu tsu-na-da-le-nv-dv yv-wi u-na-da-do-li-s-do-di-yi du-do-e-s-di?  Ni-hi-s-gi-ni a-ni-no-s-gi-s-gi u-ni-yv-s-di-yi u-s-da-ga-lv ni-tsv-ne-lv."
        intervals [35]:
            xmin = 278.985
            xmax = 280.210
            text = ""
        intervals [36]:
            xmin = 280.210
            xmax = 300.530
            text = "021118: Di-no-we-li-s-gi-no a-le nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi u-na-dv-ga-ne-i, a-le u-ni-yo-le i-yu-nv-ne-di-yi u-ni-hi-s-di-yi; gv-wa-na-ye-s-ge-ye-no, nv-di-ga-li-s-do-di-s-ge ni-ga-dv yv-wi u-ni-s-qua-ni-go-s-gv nu-s-dv da-de-yo-hv-s-gv-i."
        intervals [37]:
            xmin = 300.530
            xmax = 301.330
            text = ""
        intervals [38]:
            xmin = 301.330
            xmax = 304.390
            text = "021119: U-sv-no nu-li-s-ta-nv u-nu-go-tse ga-du-hv-i."
        intervals [39]:
            xmin = 304.390
            xmax = 305.060
            text = ""
        intervals [40]:
            xmin = 305.060
            xmax = 316.610
            text = "021120: Su-na-le-no a-na-i-sv-i, u-ni-go-he e-ga-ta-i-yu-s-di tlu-gv u-wa-yv-sv-hi ge-se du-hna-s-de-tlv nv-da-gv-wa-da-le-nv-dv."
        intervals [41]:
            xmin = 316.610
            xmax = 317.420
            text = ""
        intervals [42]:
            xmin = 317.420
            xmax = 327.930
            text = "021121: Qui-da-no u-nv-da-dv hi-a nu-we-se-le-i, Ta-de-yo-hv-s-gi, gv-ni-yu-quo, e-ga-ta---i-yu-s-di tlu-gv tsi-s-ga-tsv-gi u-wa-yv-so-nv."
        intervals [43]:
            xmin = 327.930
            xmax = 328.790
            text = ""
        intervals [44]:
            xmin = 328.790
            xmax = 334.340
            text = "021122: Tsi-sa-no u-ne-tsv, hi-a ni-du-we-se-le-i, U-ne-la-nv-hi e-tso-i-yu-se-s-di."
        intervals [45]:
            xmin = 334.340
            xmax = 335.310
            text = ""
        intervals [46]:
            xmin = 335.310
            xmax = 361.960
            text = "021123: U-do-hi-yu-hi-ya-ye-no hi-a ni-tsv-we-se-ha, Gi-lo hi-a ni-ga-we-se-he-s-di hi-a tso-da-lv, We-tsa-hv-na, a-le a-me-quo-hi we-tsa-du-ga; a-le nu-dla-si-dv-e-hv-na i-ge-se-s-di u-na-wi-yi, go-hi-yu-hv-s-ge-s-di-quo-s-gi-ni na-s-gi ni-ga-we-s-gv a-se i-yu-li-s-do-di ge-sv-i; na-s-gi u-he-s-di ni-ga-v nu-we-sv-i."
        intervals [47]:
            xmin = 361.960
            xmax = 363.340
            text = ""
        intervals [48]:
            xmin = 363.340
            xmax = 375.840
            text = "021124: na-s-gi i-yu-s-di hi-a ni-tsv-we-se-ha, Ni-ga-v go-hu-s-di i-tsi-ta-yo-ha i-tsa-da-do-li-s-da, i-tso-hi-yu-hv-s-ge-s-di e-tsi-ne-i ge-sv-i, a-le a-se i-tsi-he-s-di."
        intervals [49]:
            xmin = 375.840
            xmax = 376.520
            text = ""
        intervals [50]:
            xmin = 376.520
            xmax = 397.180
            text = "021125: I-yu-no i-tsa-le-hv-s-ge-s-di i-tsa-da-do-li-s-di-s-ge-s-di, ge-tsa-da-ne-he-s-di e-tsi-s-ga-nv-tse-lv-i, i-yu-no go-hu-s-di e-tse-li-se-he-s-di gi-lo-i; na-s-gi na-s-quo I-tsi-do-da ga-lv-ta-di tse-ha ga-ge-tsi-ne-di-yi hi-a i-tsi-s-ga-nv-tsv-i."
        intervals [51]:
            xmin = 397.180
            xmax = 397.850
            text = ""
        intervals [52]:
            xmin = 397.850
            xmax = 409.990
            text = "021126: I-yu-s-gi-ni ni-tsa-da-ne-hv-na i-ge-se-s-di e-tsi-s-ga-nv-tse-lv-i, v-tla na-s-quo I-tsi-do-da ga-lv-la-di e-hi yv-ge-tsi-do-li-gi i-tsi-s-ga-nv-tsv-i."
        intervals [53]:
            xmin = 409.990
            xmax = 410.445
            text = ""
        intervals [54]:
            xmin = 410.445
            xmax = 425.200
            text = "021127: Tsi-lu-si-li-mi-no ta-li-ne u-ni-lu-tse-i; u-dv-nv-no--di-ga-la-wi-i-s-di-yi e-do-he-i, gv-wa-lu-tse-le nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi, a-le di-no-we-li-s-gi, a-le di-ni-la-wi-gi,"
        intervals [55]:
            xmin = 425.200
            xmax = 426.140
            text = ""
        intervals [56]:
            xmin = 426.140
            xmax = 438.030
            text = "021128: A-le hi-a ni-gv-wa-we-se-le-i, Ga-do tsa-li-s-ga-s-do-di hi-a na-s-gi tsi-hna-dv-ne-ha?  A-le ga-go tsa-ne-le na-s-gi hi-a i-tsa-dv-ne-di-yi?"
        intervals [57]:
            xmin = 438.030
            xmax = 438.730
            text = ""
        intervals [58]:
            xmin = 438.730
            xmax = 454.000
            text = "021129: Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-le-i, A-yv na-s-gi su-da-le-gi dv-tsv-ya-dv-dv-ni, a-le s-gi-no-hv-si, a-yv-no da-tsv-no-ne-li nu-s-dv a-qua-li-s-ga-s-do-dv hi-a na-s-gi tsi-ni-ga-dv-ne-ha."
        intervals [59]:
            xmin = 454.000
            xmax = 454.870
            text = ""
        intervals [60]:
            xmin = 454.870
            xmax = 463.580
            text = "021130: Tsa-ni tsi-da-da-wo-s-gv-gi, ga-lv-la-s-go tsu-da-le-ne-i, yv-wi-quo-ge a-ne-hv-i?  S-gi-no-hv-si."
        intervals [61]:
            xmin = 463.580
            xmax = 464.630
            text = ""
        intervals [62]:
            xmin = 464.630
            xmax = 478.215
            text = "021131: U-nv-sv-no ge-sv u-na-li-no-he-le-i, hi-a nu-ni-we-se-i, I-yu-no ga-lv-la-di nv-da-yu-da-le-nv-hi yi-ga-dv-nv, hi-a yi-ni-ga-wi, Ga-do-no tla yi-e-tso-i-yu-ne-i?"
        intervals [63]:
            xmin = 478.215
            xmax = 478.880
            text = ""
        intervals [64]:
            xmin = 478.880
            xmax = 491.760
            text = "021132: I-yu-no yv-wi-quo a-ne-hv yi-ga-dv-nv,^na-s-gi da-ni-s-ga-i-he yv-wi; ni-ga-dv-ye-no yv-wi a-do-le-ho-s-gi u-do-hi-yu-hi gv-wa-ye-lv-ha Tsa-ni."
        intervals [65]:
            xmin = 491.760
            xmax = 492.460
            text = ""
        intervals [66]:
            xmin = 492.460
            xmax = 509.860
            text = "021133: U-ni-ne-tsv-no hi-a nu-ni-we-se-le Tsi-sa, V-tla yo-tsi-ga-ta-ha.  Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-le-i, V-tla na-s-quo a-yv yv-da-tsv-no-ne-li i-yu-s-di a-qua-li-s-ga-s-do-dv hi-a na-s-gi tsi-ni-ga-dv-ne-ha."
