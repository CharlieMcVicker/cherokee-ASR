File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 1143.670
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 1143.670
        intervals: size = 150
        intervals [1]:
            xmin = 0.000
            xmax = 4.120
            text = ""
        intervals [2]:
            xmin = 4.120
            xmax = 16.270
            text = "012601: Hi-a-no nu-li-s-ta-nv-gi, na-s-gi Tsi-sa u-s-qua-dv ni-ga-dv hi-a na-s-gi ni-ga-we-s-gv-i, hi-a ni-du-we-se-lv-gi gv-wa-s-da-wa-di-do-hi;"
        intervals [3]:
            xmin = 16.270
            xmax = 17.210
            text = ""
        intervals [4]:
            xmin = 17.210
            xmax = 28.620
            text = "012602: I-tsi-ga-ta-ha ta-li i-yu-sv-hi ka-no-hi-ye-gi di-li-s-da-yv-di-yi ge-sv-i, a-le yv-wi U-we-tsi tsa-ga-tlu-ta-ni-sv a-ga-dv-di-yi."
        intervals [5]:
            xmin = 28.620
            xmax = 29.740
            text = ""
        intervals [6]:
            xmin = 29.740
            xmax = 47.130
            text = "012603: Hna-quo-no du-ni-la-wi-tse nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le di-no-we-li-s-gi a-le di-ni-la-wi-gi a-ne-hv yv-wi, ga-ne-lv nu-gv-wi-yu-sv a-tsi-lv--ge-lo-hi Ka-ya-qua tsu-do-i-dv;"
        intervals [7]:
            xmin = 47.130
            xmax = 48.390
            text = ""
        intervals [8]:
            xmin = 48.390
            xmax = 57.960
            text = "012604: U-ni-no-he-le-no ga-lo-nu-he-dv u-nv-do-di-yi u-ni-ni-yv-di-yi Tsi-sa, a-le u-ni-hi-s-di-yi."
        intervals [9]:
            xmin = 57.960
            xmax = 58.920
            text = ""
        intervals [10]:
            xmin = 58.920
            xmax = 70.635
            text = "012605: A-se-no hi-a nu-ni-we-se-i; Tle-s-di di-li-s-da-yv-di-yi ge-sv-i, na-hi-yu-ye-no yi-gi u-tsa-ti ya-na-li-te-lv-hv-ga yv-wi."
        intervals [11]:
            xmin = 70.635
            xmax = 71.470
            text = ""
        intervals [12]:
            xmin = 71.470
            xmax = 78.300
            text = "012606: Tsi-sa-no Que-di-ni-yi e-do-hv-i, Sa-wa-ni a-da-ye-s-gi u-tlv-gi ga-ne-lv-i,"
        intervals [13]:
            xmin = 78.300
            xmax = 79.340
            text = ""
        intervals [14]:
            xmin = 79.340
            xmax = 97.450
            text = "012607: U-lu-tse-lv-gi a-ge-yv a-ye-hv-gi gu-gu nv-ya u-ne-gv go-tlv-ta-nv-hi a-tli-s-dv-gi u-tsa-ti tsu-gv-wa-lo-di a-tlo-ne-di, a-le u-lo-ne-ta-nv-gi a-s-go-li ga-nv-gv a-li-s-da-yv-hv-s-gv-i."
        intervals [15]:
            xmin = 97.450
            xmax = 98.310
            text = ""
        intervals [16]:
            xmin = 98.310
            xmax = 107.950
            text = "012608: Gv-wa-s-da-wa-di-do-hi-no gv-wa-go-hv u-ni-ta-la-wo-sv-gi, hi-a nu-ni-we-sv-gi; Ga-do-no hi-a tsa-tse-wo-gi?"
        intervals [17]:
            xmin = 107.950
            xmax = 108.810
            text = ""
        intervals [18]:
            xmin = 108.810
            xmax = 119.840
            text = "012609: Hi-a-ye-no a-tlo-ne-di yu-na-di-nv-se u-tsa-ti yi-du-gv-wa-la-ne-i, a-le na-s-gi u-yo i-yu-na-dv-hna-de-gi di-ne-di yi-ge-se-i."
        intervals [19]:
            xmin = 119.840
            xmax = 120.860
            text = ""
        intervals [20]:
            xmin = 120.860
            xmax = 132.340
            text = "012610: Tsi-sa-no u-do-le-ho-sv, hi-a ni-du-we-se-lv-gi; Ga-do-no i-e-tsa-de-ya-do-di a-ge-yv?  O-si-yu-ye-no du-lv-wi-s-da-si tsi-na-quv-ga."
        intervals [21]:
            xmin = 132.340
            xmax = 133.470
            text = ""
        intervals [22]:
            xmin = 133.470
            xmax = 142.250
            text = "012611: U-yo-ye-no i-yu-na-dv-hna-de-gi ni-go-hi-lv ge-tse-la-di-do-ha, a-yv-s-gi-ni v-tla ni-go-hi-lv yi-tsv-ye-la-di-do-ha."
        intervals [23]:
            xmin = 142.250
            xmax = 143.320
            text = ""
        intervals [24]:
            xmin = 143.320
            xmax = 151.240
            text = "012612: Hi-a-ye-no a-tlo-ne-di tsi-ye-lv-i tsa-gi-lo-ne-da, v-gi-ni-so-di-yi a-qua-dv-nv-i-s-di-ha."
        intervals [25]:
            xmin = 151.240
            xmax = 152.575
            text = ""
        intervals [26]:
            xmin = 152.575
            xmax = 170.480
            text = "012613: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; A-na-li-tsi-do-ni-do-lv-ha hi-a o-s-dv ka-no-he-dv i-lv-hi-tlv e-la-ni-gv-i, na-s-quo hi-a a-ge-yv tsi-na-dv-ga u-ni-no-he-di ge-se-s-di, na-s-gi a-ga-nv-da-di-s-do-di."
        intervals [27]:
            xmin = 170.480
            xmax = 171.460
            text = ""
        intervals [28]:
            xmin = 171.460
            xmax = 182.370
            text = "012614: Hna-quo-no a-si-yv-wi ta-la-du i-ya-ni-dv ge-sv-i, Tsu-da-si I-s-ga-la-di tsu-do-i-dv, nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi wi-du-lu-tse-le-i,"
        intervals [29]:
            xmin = 182.370
            xmax = 183.190
            text = ""
        intervals [30]:
            xmin = 183.190
            xmax = 196.570
            text = "012615: Hi-a wi-ni-du-we-se-le-i; Ga-do da-s-gi-ne-li a-yv-no do-da-tsv-yo-hi-se-li?  Tso-a-s-go-hi-no a-ye-li--a-de-lv de-gv-wa-sa-s-da-ne-le-i."
        intervals [31]:
            xmin = 196.570
            xmax = 197.650
            text = ""
        intervals [32]:
            xmin = 197.650
            xmax = 204.065
            text = "012616: Na-hi-yu-quo-no u-le-nv-hv-gi u-yo-lv i-yu-dv-ne-di-yi u-lo-nu-he-di-yi."
        intervals [33]:
            xmin = 204.065
            xmax = 205.490
            text = ""
        intervals [34]:
            xmin = 205.490
            xmax = 223.790
            text = "012617: I-gv-yi-yi-quo-no i-ga na-go-ta-nv-na ga-du a-gi-s-di-yi ge-sv gv-wa-s-da-wa-di-do-hi gv-wa-lu-tse-lv Tsi-sa, hi-a ni-gv-wa-we-se-lv-gi, Ha-tlv tsa-du-li-ha o-ga-dv-nv-i-s-do-di-yi tsa-li-s-da-yv-di-yi ka-no-hi-ye-gi."
        intervals [35]:
            xmin = 223.790
            xmax = 224.510
            text = ""
        intervals [36]:
            xmin = 224.510
            xmax = 247.380
            text = "012618: Hi-a-no nu-we-sv-gi; I-tse-na di-ga-du-hv-i, na-hna tse-hv a-s-ga-ya, hi-a-no na-tsi-we-se-lv-ha; Di-de-yo-hv-s-gi hi-a ni-ga-we-ha; Hna-quo a-gi-s-qua-lv-e-li-di, gv-gi-s-da-wa-di-do-hi hi-ne-lv da-yo-tsi-s-qua-ni-go-ta-ni ka-no-hi-ye-gi di-li-s-da-yv-di-yi ge-sv-i."
        intervals [37]:
            xmin = 247.380
            xmax = 248.520
            text = ""
        intervals [38]:
            xmin = 248.520
            xmax = 259.490
            text = "012619: Gv-wa-s-da-wa-di-do-hi-no nu-s-dv Tsi-sa du-ne-tse-lv na-s-gi nu-na-dv-ne-lv-gi, a-le o-s-dv nu-nv-ne-lv-gi ka-no-hi-ye-gi di-li-s-da-yv-di-yi."
        intervals [39]:
            xmin = 259.490
            xmax = 260.510
            text = ""
        intervals [40]:
            xmin = 260.510
            xmax = 267.140
            text = "012620: U-sv-no nu-li-s-ta-nv u-na-ni-tlv-nv-gi [Tsi-sa] ta-la-du i-ya-ni-dv gv-wa-s-da-wa-di-do-hi"
        intervals [41]:
            xmin = 267.140
            xmax = 268.000
            text = ""
        intervals [42]:
            xmin = 268.000
            xmax = 280.590
            text = "012621: A-na-li-s-da-yv-hv-s-gv-no hi-a nu-we-sv-gi; U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; hi-a tsi-ni-tsa-dv-nv sa-quo u-da-su-ya dv-qua-tlu-ta-ni."
        intervals [43]:
            xmin = 280.590
            xmax = 281.710
            text = ""
        intervals [44]:
            xmin = 281.710
            xmax = 293.070
            text = "012622: U-tsa-ti-no u-yo-i-yu u-ni-ye-lv-nv-gi, a-le u-na-le-nv-hv-gi a-ni-si-yv-wi-ha hi-a ni-gv-wa-we-se-lv-gi; Tsa-gv-wi-yu-hi, tsi-go a-yv?"
        intervals [45]:
            xmin = 293.070
            xmax = 293.960
            text = ""
        intervals [46]:
            xmin = 293.960
            xmax = 302.970
            text = "012623: U-ne-tsv-no hi-a nu-we-sv-gi; i-tsu-la-ha tso-s-da-su-wi-s-ga a-te-li-do-gi-hi na-s-gi dv-qua-tlu-ta-ni."
        intervals [47]:
            xmin = 302.970
            xmax = 303.800
            text = ""
        intervals [48]:
            xmin = 303.800
            xmax = 323.470
            text = "012624: Yv-wi U-we-tsi a-i nu-s-dv go-we-li a-tsi-no-he-s-gv-i; a-se-no u-yo-i-yu i-yu-li-s-da-ne-di na-s-gi a-s-ga-ya a-wi U-we-tsi a-tlu-di-s-gi.  O-si-yu yi-ge-se na-s-gi a-s-ga-ya nu-de-nv-na-quo yi-ge-se-i."
        intervals [49]:
            xmin = 323.470
            xmax = 324.380
            text = ""
        intervals [50]:
            xmin = 324.380
            xmax = 336.080
            text = "012625: Tsu-da-si-no a-da-tlu-di-s-gi u-ne-tsv hi-a nu-we-sv-gi; Ta-de-yo-hv-s-gi, tsi-go a-yv?  Hi-a nu-we-se-lv-gi; Ye-li ni-wi."
        intervals [51]:
            xmin = 336.080
            xmax = 337.100
            text = ""
        intervals [52]:
            xmin = 337.100
            xmax = 358.100
            text = "012626: A-na-li-s-da-yv-hv-s-gv-no Tsi-sa ga-du u-gi-sv-gi, a-le u-li-he-li-tsv-gi, a-le u-gv-ha-lu-yv-gi, a-le du-ne-lv gv-wa-s-da-wa-di-do-hi, hi-a-no nu-we-sv-gi; I-tsi-gi, i-tsi-ga, hi-a na-s-gi a-yv tsi-ye-lv-i."
        intervals [53]:
            xmin = 358.100
            xmax = 359.285
            text = ""
        intervals [54]:
            xmin = 359.285
            xmax = 369.610
            text = "012627: U-li-s-qui-di-no u-gi-sv a-le u-li-he-li-tsv du-ne-ne-lv-gi, hi-a nu-we-sv-gi; Ni-tsi-v i-tsa-di-ta;"
        intervals [55]:
            xmin = 369.610
            xmax = 370.990
            text = ""
        intervals [56]:
            xmin = 370.990
            xmax = 383.180
            text = "012628: Na-s-gi-ye-no hi-a a-gi-gi-gv i-tse ka-no-he-dv da-tlo-hi-s-dv-i, na-s-gi u-ni-tsa-ti tsi-ge-ga-tse-we-lv, ga-ge-tsi-ne-di-yi u-ni-s-ga-nv-tsv-i."
        intervals [57]:
            xmin = 383.180
            xmax = 384.560
            text = ""
        intervals [58]:
            xmin = 384.560
            xmax = 402.850
            text = "012629: A-se-no hi-a ni-tsv-we-se-ha; v-tla i-lv-hi-yu go-gi i-yu-da-le-nv-dv yv-ga-ga-di-ta hi-a te-lv-la-di u-na-nu-go-wi-sv-hi, gv-ni na-hi-yu i-ga i-tsu-la-ha i-tse i-da-di-ta-hv-ha E-do-da u-tse-li-go-hi."
        intervals [59]:
            xmin = 402.850
            xmax = 404.640
            text = ""
        intervals [60]:
            xmin = 404.640
            xmax = 412.920
            text = "012630: Du-ni-no-gi-sv-no di-ka-no-gi-s-di u-ni-nu-go-tsv-gi, O-li-wa-yo-i u-sa-hi-lv wu-ni-lo-sv-gi."
        intervals [61]:
            xmin = 412.920
            xmax = 413.980
            text = ""
        intervals [62]:
            xmin = 413.980
            xmax = 436.280
            text = "012631: Hna-quo-no Tsi-sa hi-a ni-du-we-se-lv-gi; ni-hi ni-tsi-v do-da-tso-de-li go-hi sv-no-yi tsi-gi, a-yv nv-di-ga-li-s-do-di-s-ge-s-di.  Hi-a-ye-no ni-gv-nv i-go-we-la, da-tsi-yv-ni-li A-wi--di-ga-ti-ya, a-wi-no u-na-da-tlu-gv dv-na-di-ga-le-yo-tsi."
        intervals [63]:
            xmin = 436.280
            xmax = 437.290
            text = ""
        intervals [64]:
            xmin = 437.290
            xmax = 443.510
            text = "012632: A-se-no di-qua-le-nv-hi ge-se-s-di i-gv-yi nv-da-tsv-ye-nv-e-li Ge-li-li."
        intervals [65]:
            xmin = 443.510
            xmax = 444.265
            text = ""
        intervals [66]:
            xmin = 444.265
            xmax = 456.550
            text = "012633: Qui-da u-ne-tsv hi-a nu-we-se-lv-gi; Na-s-quo ni-ga-dv yi-du-no-de-lv ni-hi yi-nv-di-ga-li-s-do-di-ha, a-se a-yv v-tla yi-do-gv-quo-de-ga."
        intervals [67]:
            xmin = 456.550
            xmax = 457.520
            text = ""
        intervals [68]:
            xmin = 457.520
            xmax = 471.030
            text = "012634: Tsi-sa-no hi-a nu-we-se-lv-gi; U-do-hi-yu-hi-ya hi-a ni-gv-we-se-ha; Go-hi-quo sv-no-yi tsi-gi a-si tsa-ta-ga na-ni-yv-gv-na ge-se-s-di tso-i nv-da-s-qua-da-yi-li."
        intervals [69]:
            xmin = 471.030
            xmax = 472.000
            text = ""
        intervals [70]:
            xmin = 472.000
            xmax = 486.830
            text = "012635: Qui-da-no hi-a nu-we-se-lv-gi; na-s-quo i-tsu-la-ha di-yi-ni-yo-hu-hi-s-di yi-gi, a-se v-tla yv-ga-gv-ya-da-yi-ga.  Na-s-gi-ya na-s-quo ni-ga-dv gv-wa-s-da-wa-di-do-hi na-s-gi nu-ni-we-sv-gi."
        intervals [71]:
            xmin = 486.830
            xmax = 487.720
            text = ""
        intervals [72]:
            xmin = 487.720
            xmax = 506.280
            text = "012636: Hna-quo-no Tsi-sa a-le gv-wa-s-da-wa-di-do-hi u-ni-lu-tsv-gi Ge-si-mi-ni du-do-v-i, hi-a-no ni-du-we-se-lv gv-wa-s-da-wa-di-do-hi; A-ni i-tsi-ne-s-di gv-ni i-tlv wi-ga-da-do-li-s-ta-nv-ha."
        intervals [73]:
            xmin = 506.280
            xmax = 507.150
            text = ""
        intervals [74]:
            xmin = 507.150
            xmax = 522.950
            text = "012637: Du-ti-nv-sv-gi-no Qui-da a-le a-ni-ta-li Tse-qui-di tsu-we-tsi, a-le u-le-nv-he e-hi-s-di u-da-nv-da-de-i, a-le u-tsa-ti ga-ge-di-yu nu-li-s-da-ne-le u-da-nv-dv-i."
        intervals [75]:
            xmin = 522.950
            xmax = 523.770
            text = ""
        intervals [76]:
            xmin = 523.770
            xmax = 539.200
            text = "012638: Hna-quo-no hi-a ni-du-we-se-le-i; A-qua-da-nv-dv u-ka-li-tsv-hi u-tsa-ti e-hi-s-di ge-sv-i a-yo-hu-hi-s-di ge-sv i-ga-i.  A-ni i-tsi-ne-s-di a-le i-tsu-la-ha i-di-ya-wi-s-ge-s-di."
        intervals [77]:
            xmin = 539.200
            xmax = 540.090
            text = ""
        intervals [78]:
            xmin = 540.090
            xmax = 563.340
            text = "012639: U-s-di-gi-dv-no u-di-di-tlv-s-do-di i-yv-dv wu-lu-tse-i, a-le u-li-ya-s-du-ne-i, a-le u-da-do-li-s-ta-ne-i, hi-a nu-we-se-i; E-do-da, i-yu-no ye-li i-gv-wa-li-s-do-di ge-se-s-di wa-gi-lo-hi-si-quo hi-a u-li-s-qui-di; v-tla-s-gi-ni-no-nv a-yv nu-s-dv ga-da-nv-te-s-gv-i, ni-hi-s-gi-ni."
        intervals [79]:
            xmin = 563.340
            xmax = 564.170
            text = ""
        intervals [80]:
            xmin = 564.170
            xmax = 582.780
            text = "012640: Gv-wa-s-da-wa-di-do-hi-no a-ni-nv di-u-lu-tsv du-wa-dv-he a-ni-li-ne-i, hi-a-no nu-we-se-le Qui-da; Ga-do-quo, tla-s-go tsi-ya-wi-s-gv sa-quo i-yu-tli-lo-dv i-go-hi-dv ge-tsi-ya-wi-s-di yi-gi?"
        intervals [81]:
            xmin = 582.780
            xmax = 583.850
            text = ""
        intervals [82]:
            xmin = 583.850
            xmax = 601.170
            text = "012641: I-tsi-ya-wi-s-ge-s-di a-le i-tsa-da-do-li-s-di-s-ge-s-di na-s-gi u-da-go-li-ye-di-yi ge-sv wi-tsi-na-nu-go-i-s-di-yi ni-ge-sv-na ge-sv-i.  A-da-nv-do u-do-hi-yu-hi u-dv-nv-i-s-di, u-que-da-lv-s-gi-ni wa-na-ga-la-hi-yu."
        intervals [83]:
            xmin = 601.170
            xmax = 602.400
            text = ""
        intervals [84]:
            xmin = 602.400
            xmax = 620.970
            text = "012642: Ta-li-ne-no u-we-nv-se-i, wu-da-do-li-s-ta-ne-i, hi-a wi-nu-we-se-i; E-do-da, i-yu-no hi-a u-li-s-qui-di gv-gi-lo-hi-se-di-quo ni-ge-sv-na yi-gi, gv-ni ya-qua-di-ta-hv, nu-s-dv ha-da-nv-te-s-gv wi-ni-ga-li-s-da."
        intervals [85]:
            xmin = 620.970
            xmax = 622.000
            text = ""
        intervals [86]:
            xmin = 622.000
            xmax = 631.050
            text = "012643: Di-u-lu-tsv-no du-wa-dv-he ta-li-ne a-ni-li-na-e-i, di-ni-ga-do-li-ye-no di-ga-ge-di-yu ge-se-i."
        intervals [87]:
            xmin = 631.050
            xmax = 631.950
            text = ""
        intervals [88]:
            xmin = 631.950
            xmax = 641.290
            text = "012644: Ta-li-ne-no du-wv-de-tse a-le u-da-nv-se-i, a-le tso-i-ne wu-da-do-li-s-ta-ne-i, na-s-gi-ya wi-nu-we-se-i."
        intervals [89]:
            xmin = 641.290
            xmax = 642.260
            text = ""
        intervals [90]:
            xmin = 642.260
            xmax = 664.590
            text = "012645: Hna-quo-no di-u-lu-tsv gv-wa-s-da-wa-di-do-hi a-ni-nv-i, hi-a ni-du-we-se-le-i; Hna-quo i-tsi-li-nv-gi a-le i-tsi-ya-we-so-lv-ga; gv-ni-yu-quo i-yu ge-sv u-s-qua-lv-hi-di, yv-wi-no U-we-tsi a-ga-tlu-ta-nv u-ni-ne-gu-tsi-dv yv-wi de-ge-tsi-yo-hi-se-lv."
        intervals [91]:
            xmin = 664.590
            xmax = 665.480
            text = ""
        intervals [92]:
            xmin = 665.480
            xmax = 672.320
            text = "012646: Di-tsa-le-hv-ga!  i-da-i-se-s-di!  gv-ni-yu-quo a-quo da-ya-i a-qua-tlu-di-s-gi."
        intervals [93]:
            xmin = 672.320
            xmax = 673.190
            text = ""
        intervals [94]:
            xmin = 673.190
            xmax = 698.160
            text = "012647: A-si-quo-no ga-wo-ni-s-gv-i gv-ni-yu-quo Tsu-da-si a-si-yv-wi ta-la-du i-ya-ni-dv ge-sv u-lu-tsv-gi, a-le da-ti-ne-hv-gi u-ni-tsa-ti yv-wi, a-ye-la-s-di--di-ga-nv-hi-dv a-le a-da di-ni-ne-hi, nv-da-gv-ni-nv-si-dv nu-ni-gv-wi-yu-sv a-tsi-lv-a-ne-lo-hi di-ni-la-wi-gi a-ne-hv yv-wi."
        intervals [95]:
            xmin = 698.160
            xmax = 699.470
            text = ""
        intervals [96]:
            xmin = 699.470
            xmax = 714.360
            text = "012648: U-tlu-di-s-gi-no tsu-no-ne-lv-hi ge-se u-na-do-le-ho-hi-s-do-di hi-a i-yu-we-sv-hi ge-se-i; gi-lo tsi-ya-du-tsa-la-nv-ha na-s-gi ge-se-s-di, a-s-da-ya de-tsi-ni-yv-hv-ha."
        intervals [97]:
            xmin = 714.360
            xmax = 716.240
            text = ""
        intervals [98]:
            xmin = 716.240
            xmax = 728.620
            text = "012649: U-li-s-di-yu-no Tsi-sa ga-do-gv u-lu-tsv-gi, hi-a nu-we-sv-gi; Do-hi-yi de-na-da-go-wa-dv, S-gi-na-tla-i; a-le u-du-tsa-la-nv-gi."
        intervals [99]:
            xmin = 728.620
            xmax = 729.380
            text = ""
        intervals [100]:
            xmin = 729.380
            xmax = 742.310
            text = "012650: Tsi-sa-no hi-a nu-we-se-lv-gi; Gi-na-li-i, ga-do-no v-hi-lu-gi.  Hna-quo-no u-ni-lu-tsv-gi a-le de-gv-wa-si-ta-dv-gi Tsi-sa, gv-wa-ni-yv-hv-gi."
        intervals [101]:
            xmin = 742.310
            xmax = 743.135
            text = ""
        intervals [102]:
            xmin = 743.135
            xmax = 761.640
            text = "012651: A-le gv-ni-yu-quo a-si-yv-wi Tsi-sa a-ne-hi u-sa-la-da-nv-gi ka-no-ge-ni u-lv-hv-gi a-ye-la-s-di--ga-nv-hi-dv, a-le u-lu-yv u-gv-wi-yu-hi a-tsi-lv--ge-lo-hi u-nv-si-da-s-di, a-le u-li-s-de-s-ta-nv-gi."
        intervals [103]:
            xmin = 761.640
            xmax = 762.630
            text = ""
        intervals [104]:
            xmin = 762.630
            xmax = 779.410
            text = "012652: Hna-quo-no Tsi-sa hi-a nu-we-se-lv-gi; Ga-la-di-s-di-yi tsi-hi-la-da tsa-tse-li a-ye-la-s-di-ga-nv-hi-dv, ni-ga-dv-ye-no a-ye-la-s-di--ga-nv-hi-dv a-ni-yi-s-gi a-ye-la-s-di--ga-nv-hi-dv tsu-ni-yo-hu-hi-s-do-di ge-se-s-di."
        intervals [105]:
            xmin = 779.410
            xmax = 780.170
            text = ""
        intervals [106]:
            xmin = 780.170
            xmax = 795.790
            text = "012653: Tla-s-go ya-da-nv-te-ha ye-li ga-tsi-ya-da-do-li-s-da-ne-di ge-sv E-do-da, gi-la-quo-no i-yv-dv v-tla ta-la-du-quo i-yu-na-da-tlu-gi di-ni-ka-hna-wa-di-do-hi yi-do-gv-gi-ka-si?"
        intervals [107]:
            xmin = 795.790
            xmax = 797.020
            text = ""
        intervals [108]:
            xmin = 797.020
            xmax = 806.170
            text = "012654: A-se-no ga-do yi-ga-li-s-do-da ya-do-hi-yu-hv-ga nu-s-dv go-we-lv-i, a-se na-s-gi i-yu-li-s-do-di tsi-gi?"
        intervals [109]:
            xmin = 806.170
            xmax = 807.110
            text = ""
        intervals [110]:
            xmin = 807.110
            xmax = 831.900
            text = "012655: Na-hi-yu-no Tsi-sa hi-a ni-du-we-se-lv-gi u-ni-tsa-ti; Tsi-go ga-no-s-gi-s-gi tsi-tsi-yo-ho na-s-gi-ya i-tsi-lu-gi s-gi-ni-yv-hi-ga, a-ye-la-s-di-di-ga-nv-hi-dv a-le a-da di-tsi-ne-hi?  Ni-du-gi-tsv-ni-sv i-tsu-la-ha i-di-nv-gi de-ga-de-yo-hv-s-gv-gi u-dv-na--di-ga-la-wi-i-s-di-yi, v-tla-no yi-s-gi-ni-yi-s-ge-i."
        intervals [111]:
            xmin = 831.900
            xmax = 832.820
            text = ""
        intervals [112]:
            xmin = 832.820
            xmax = 847.805
            text = "012656: A-se-no ni-ga-dv na-s-gi hi-a nu-li-s-ta-nv-gi u-do-hi-yu-di-yi a-na-do-le-ho-s-gi u-no-we-la-nv-hi.  Hna-quo-no ni-ga-dv gv-wa-s-da-wa-di-do-hi gv-wa-de-tsv-gi a-le u-na-li-sv-gi."
        intervals [113]:
            xmin = 847.805
            xmax = 848.530
            text = ""
        intervals [114]:
            xmin = 848.530
            xmax = 862.060
            text = "012657: Tsi-sa-no u-ni-ni-yv-dv ka-ya-quo-i wu-na-ti-nv-s-ta-nv-gi na-s-gi nu-gv-wi-yu-sv a-tsi-lv-ge-lo-hi, na-hna di-no-we-li-s-gi a-le di-ni-la-wi-gi da-ni-la-wi-v-i."
        intervals [115]:
            xmin = 862.060
            xmax = 863.000
            text = ""
        intervals [116]:
            xmin = 863.000
            xmax = 880.230
            text = "012658: Qui-da-no u-s-da-wa-dv-se ge i-yv-dv tsa-i-se nu-gv-wi-yu-sv a-tsi-lv--ge-lo-hi di-ga-ne-lv gv-di-s-gi, u-yv-le-i, a-le ge-tsi-nv-si-da-s-di i-tsu-la-ha a-ni-ne-i, u-go-wa-dv-di-yi u-ye-lv-se wa-li-s-qua-di-hi-hv-i."
        intervals [117]:
            xmin = 880.230
            xmax = 885.835
            text = ""
        intervals [118]:
            xmin = 885.835
            xmax = 907.570
            text = "012659: Nu-ni-gv-wi-yu-sv-no a-tsi-lv--a-ne-lo-hi a-le tsu-na-dv-so-nv-hi a-le ni-ga-dv di-ni-la-wi-gi u-ni-yo-le ga-ye-go-gi u-ni-no-he-lv-hi Tsi-sa u-tlu-di-s-gi, na-s-gi u-ni-hi-s-di-yi u-na-du-li-s-ge-i;"
        intervals [119]:
            xmin = 907.570
            xmax = 908.850
            text = ""
        intervals [120]:
            xmin = 908.850
            xmax = 928.170
            text = "012660: A-se-no u-na-tlo-tse-quo; u-ni-tsa-te-s-gi-ni-no-nv ga-ye-go-gi a-ni-no-he-s-gi u-ni-na-nu-go-tse-i, a-se-no u-na-tlo-tse-quo.  O-ni-yi-s-gi-ni-no-nv a-ni-ta-li ga-ye-go-gi a-ni-no-he-s-gi u-ni-lu-tse-i, hi-a nu-ni-we-se-i;"
        intervals [121]:
            xmin = 928.170
            xmax = 928.770
            text = ""
        intervals [122]:
            xmin = 928.770
            xmax = 941.720
            text = "012661: Hi-a ni-du-we-sv-gi; Ye-li-quo yi-tsi-yo-s-da U-ne-la-nv-hi u-tse-li u-dv-na--di-ga-la-wi-i-s-di-yi, tso-i-quo-no tsu-do-da-qua-dv [ta-li-ne] yv-ga-ne-s-gv-li."
        intervals [123]:
            xmin = 941.720
            xmax = 942.660
            text = ""
        intervals [124]:
            xmin = 942.660
            xmax = 955.270
            text = "012662: Nu-gv-wi-yu-sv-no a-tsi-lv--ge-lo-hi du-le-ne-i, hi-a nu-we-se-le-i; Tla-s-go yi-ne-ga?  Ga-do hi-a a-ni-ga-ta-hv tsa-ni-no-he-ha tsi-ge-tsa-tlu-di-ha?"
        intervals [125]:
            xmin = 955.270
            xmax = 956.320
            text = ""
        intervals [126]:
            xmin = 956.320
            xmax = 976.680
            text = "012663: A-se-no Tsi-sa e-la-we-yi-quo ge-se-i.  Nu-gv-wi-yu-sv-no a-tsi-lv--ge-lo-hi i-u-ne-tsv hi-a nu-we-se-le-i; Gv-la-yo-si U-ne-la-nv-hi gv-ni-dv hi-ne-i-s-do-di-yi, s-gi-no-hv-si, tsi-go ni-hi Ga-lo-ne-dv U-ne-la-nv-hi U-we-tsi?"
        intervals [127]:
            xmin = 976.680
            xmax = 977.500
            text = ""
        intervals [128]:
            xmin = 977.500
            xmax = 996.630
            text = "012664: Tsi-sa-no hi-a nu-we-se-le-i; Ye-li ni-wi.  A-se-no hi-a ni-tsv-we-se-ha; i-lv-hi-yu da-ye-tsi-go-i yv-wi U-we-tsi a-ga-ti-si i-di-tlv u-li-ni-gv-gv u-wo-le-s-di, a-le tsa-i-se-s-di u-lo-gi-lv ga-lv-lo-i."
        intervals [129]:
            xmin = 996.630
            xmax = 997.360
            text = ""
        intervals [130]:
            xmin = 997.360
            xmax = 1015.310
            text = "012665: Hna-quo-no nu-gv-wi-yu-sv a-tsi-lv--ge-lo-hi du-nu-wa-v du-we-tsa-ga-lv-he-i; A-so-tlv-i-s-da, u-dv-ne-i; ga-do-no a-si a-ni-ga-ta-hi ya-ni-no-he-ha?  Gv-ni-yu-quo hna-quo i-tsa-dv-gv-ga a-so-tlv-i-s-di-s-gv-i."
        intervals [131]:
            xmin = 1015.310
            xmax = 1017.040
            text = ""
        intervals [132]:
            xmin = 1017.040
            xmax = 1024.600
            text = "012666: Ga-do i-tse-li-ha?  U-ni-ne-tsv-no hi-a nu-ni-we-se-i; Ye-li-quo gv-wa-yo-hu-hi-s-di."
        intervals [133]:
            xmin = 1024.600
            xmax = 1025.800
            text = ""
        intervals [134]:
            xmin = 1025.800
            xmax = 1038.775
            text = "012667: Hna-quo-no u-ka-dv du-na-li-tsi-s-que-i, a-le a-s-qui-nv de-gv-wa-na-s-di-s-ge-i a-le a-ni-so-i tsu-no-ye-ni de-gv-wa-na-s-di-s-ge-i,"
        intervals [135]:
            xmin = 1038.775
            xmax = 1039.590
            text = ""
        intervals [136]:
            xmin = 1039.590
            xmax = 1046.700
            text = "012668: Hi-a na-ni-we-s-ge-i; S-gi-ya-do-le-o-hi-si, Ga-lo-ne-dv, Ga-go tsi-tsv-ni-ga?"
        intervals [137]:
            xmin = 1046.700
            xmax = 1047.450
            text = ""
        intervals [138]:
            xmin = 1047.450
            xmax = 1058.760
            text = "012669: Qui-da-no u-wo-le u-dla-nv-dv-i, u-lu-tse-le-no a-dv hi-a nu-we-se-i; Ni-hi na-s-quo s-de-do-hv-gi Tsi-sa Ge-li-li e-hi."
        intervals [139]:
            xmin = 1058.760
            xmax = 1059.960
            text = ""
        intervals [140]:
            xmin = 1059.960
            xmax = 1068.180
            text = "012670: A-se-no ni-ga-dv a-ni-ga-ta-hv u-da-yi-le-i, hi-a nu-we-se-i; V-tla yi-tsi-ga-ta-ha ni-we-s-gv-i."
        intervals [141]:
            xmin = 1068.180
            xmax = 1068.860
            text = ""
        intervals [142]:
            xmin = 1068.860
            xmax = 1082.600
            text = "012671: Do-yi-tlv-no wu-lo-sv nv-wa-da-le u-go-he-i, a-le hi-a ni-du-we-se-le na-hna a-ne-do-hi; Na-s-quo hi-a Tsi-sa Na-se-li-di e-hi da-ne-do-hv-gi."
        intervals [143]:
            xmin = 1082.600
            xmax = 1083.940
            text = ""
        intervals [144]:
            xmin = 1083.940
            xmax = 1093.300
            text = "012672: Ta-li-ne-no u-da-yi-le-i, u-ne-la-nv-hi u-ne-i-s-ta-ne-i; tla yi-tsi-ga-ta-ha na a-s-ga-ya, u-dv-ne-i."
        intervals [145]:
            xmin = 1093.300
            xmax = 1094.260
            text = ""
        intervals [146]:
            xmin = 1094.260
            xmax = 1111.140
            text = "012673: Go-hi-yi-no i-yv-dv gv-wa-lu-tse-le na-v a-ni-do-na-i, hi-a ni-gv-wa-we-se-le Qui-da; U-do-hi-yu-hi na-s-quo ni-hi i-tse-do-lv-hi, hi-wo-ni-s-gv-ye-no gv-ni-ge-sv ni-tsv-ne-ha."
        intervals [147]:
            xmin = 1111.140
            xmax = 1112.200
            text = ""
        intervals [148]:
            xmin = 1112.200
            xmax = 1126.550
            text = "012674: Hna-quo-no u-le-nv-he u-s-gi-nv-de-i, a-le u-ne-la-nv-hi u-ne-i-s-ta-ne-i; Tla yi-tsi-ga-ta-ha na a-s-ga-ya, u-dv-ne-i; gi-la-quo-no i-yv-dv tsa-ta-ga u-yv-la-se-i."
        intervals [149]:
            xmin = 1126.550
            xmax = 1127.200
            text = ""
        intervals [150]:
            xmin = 1127.200
            xmax = 1143.670
            text = "012675: Qui-da-no u-nv-da-de Tsi-sa u-ne-tsv-hi, hi-a tsi-nu-we-se-le-i; A-si tsa-ta-ga na-ni-yv-gv-na ge-se-s-di tso-i nv-da-s-qua-da-yi-li.  U-nu-go-tsv-no e-hi-s-di wi-du-tlo-yi-le-i."
