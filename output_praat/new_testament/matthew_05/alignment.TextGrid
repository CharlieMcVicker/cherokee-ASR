tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 782.460
        intervals: size = 97
        intervals [1]:
            xmin = 0.000
            xmax = 3.590
            text = ""
        intervals [2]:
            xmin = 3.590
            xmax = 12.530
            text = "010501: U-ni-tsa-ti-no wi-du-go-hv u-sa-hi-lv u-hna-lu-se-i, u-we-nv-no gv-wa-s-da-wa-di-do-hi gv-wa-lu-tse-le-i."
        intervals [3]:
            xmin = 12.530
            xmax = 13.505
            text = ""
        intervals [4]:
            xmin = 13.505
            xmax = 18.065
            text = "010502: A-ho-li-no u-s-du-i-sv du-we-yo-ne hi-a nu-we-se-i;"
        intervals [5]:
            xmin = 18.065
            xmax = 19.155
            text = ""
        intervals [6]:
            xmin = 19.155
            xmax = 30.720
            text = "010503: O-si-yu i-yu-na-li-s-da-ne-di u-yo i-yu-na-dv-hna-de-gi du-na-da-nv-dv-i; u-na-tse-li-ye-no ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv-i."
        intervals [7]:
            xmin = 30.720
            xmax = 31.965
            text = ""
        intervals [8]:
            xmin = 31.965
            xmax = 39.160
            text = "010504: O-si-yu i-yu-na-li-s-da-ne-di u-yo u-na-da-nv-ta-wa-de-gi, dv-ge-tsi-nu-wo-hi-s-ta-ni-ye-no."
        intervals [9]:
            xmin = 39.160
            xmax = 40.680
            text = ""
        intervals [10]:
            xmin = 40.680
            xmax = 48.665
            text = "010505: O-si-yu i-yu-na-li-s-da-ne-di u-na-da-nv-ti, ga-do-hi-ye-no u-na-tse-li i-yu-li-s-do-di."
        intervals [11]:
            xmin = 48.665
            xmax = 49.860
            text = ""
        intervals [12]:
            xmin = 49.860
            xmax = 62.730
            text = "010506: O-si-yu i-yu-na-li-s-da-ne-di u-ni-yo-si-s-gi a-le u-ni-ta-de-gi-s-gi u-na-da-nv-ti i-yu-na-li-s-do-di-yi; dv-ge-tsi-ka-li-li-ye-no."
        intervals [13]:
            xmin = 62.730
            xmax = 64.605
            text = ""
        intervals [14]:
            xmin = 64.605
            xmax = 70.860
            text = "010507: O-si-yu i-yu-na-li-s-da-ne-di u-na-da-do-li-tsa-ti, dv-ge-tsi-do-li-tsi-ye-no."
        intervals [15]:
            xmin = 70.860
            xmax = 72.550
            text = ""
        intervals [16]:
            xmin = 72.550
            xmax = 81.380
            text = "010508: O-si-yu i-yu-na-li-s-da-ne-di tsu-da-nv-ga-lv-dv tsu-ni-na-wi, U-ne-la-nv-hi-ye-no u-ni-go-wa-dv-di;"
        intervals [17]:
            xmin = 81.380
            xmax = 82.830
            text = ""
        intervals [18]:
            xmin = 82.830
            xmax = 90.415
            text = "010509: O-si-yu i-yu-na-li-s-da-ne-di a-no-hi-s-di-s-gi, U-ne-la-nv-hi-ye-no tsu-we-tsi dv-ge-go-se-li."
        intervals [19]:
            xmin = 90.415
            xmax = 91.470
            text = ""
        intervals [20]:
            xmin = 91.470
            xmax = 104.245
            text = "010510: O-si-yu i-yu-na-li-s-da-ne-di u-yo i-ge-gv-na-de-gi du-yu-go-dv ge-sv u-ni-s-dv-di-s-gi, u-na-tse-li-ye-no ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv-i."
        intervals [21]:
            xmin = 104.245
            xmax = 106.475
            text = ""
        intervals [22]:
            xmin = 106.475
            xmax = 125.795
            text = "010511: O-si-yu i-tsa-li-s-da-ne-di i-yu-no yv-wi u-so-nv ni-ge-tsi-we-se-he-s-di a-le u-yo ni-ge-tsv-ne-he-s-di, a-le ni-ga-v tsu-da-le-nv-dv u-so-nv ga-ye-go-gi ge-tsi-no-he-s-ge-s-di a-yv ge-sv i-tsi-s-dv-di-s-ge-s-di."
        intervals [23]:
            xmin = 125.795
            xmax = 127.825
            text = ""
        intervals [24]:
            xmin = 127.825
            xmax = 145.280
            text = "010512: I-tsa-li-he-li-ge-s-di a-le u-tsa-ta-nv-hi o-s-dv i-tsa-da-nv-te-s-di, u-tsa-ti-ye-no e-tsa-gu-yv-e-di ga-lv-la-di; na-s-gi-ya-ye-no u-tsi ni-du-nv-ne-lv-gi a-na-do-le-ho-s-gi i-gv-yi tsi-ni-ge-tse-nv-e-lv."
        intervals [25]:
            xmin = 145.280
            xmax = 146.945
            text = ""
        intervals [26]:
            xmin = 146.945
            xmax = 169.460
            text = "010513: Ni-hi a-ma e-lo-hi u-tse-li-ga; i-yu-s-gi-ni a-ma yu-tsi-s-go-lv ga-do yi-ga-li-s-do-da a-ma ya-do-tlv-na; v-tla hna-quo go-hu-s-di gv-do-di yi-ga-gi, a-di-nv-di-quo u-wa-sv, a-le yv-wi-quo u-na-la-s-da-e-di."
        intervals [27]:
            xmin = 169.460
            xmax = 170.505
            text = ""
        intervals [28]:
            xmin = 170.505
            xmax = 181.635
            text = "010514: Ni-hi i-ga i-tsa-ti-s-di-s-gi e-lo-hi.  Ga-du-hv u-sa-hi-lv tsi-ga-ka-ho-i v-tla ye-li yv-ga-ye-gv-s-ga-lv-ga."
        intervals [29]:
            xmin = 181.635
            xmax = 183.115
            text = ""
        intervals [30]:
            xmin = 183.115
            xmax = 200.720
            text = "010515: V-tla a-le yv-wi a-ni-tsv-s-dv-ga a-tsv-s-do-di a-tli-lo-s-di ya-nu-tlv-di-s-go-i, ga-go-di-yi-s-gi-ni a-ni-ka-hv-s-go-i, i-ga-no u-na-ti-s-da-ne-ho ni-ga-dv ga-li-tso-de a-ni-ya-i."
        intervals [31]:
            xmin = 200.720
            xmax = 201.965
            text = ""
        intervals [32]:
            xmin = 201.965
            xmax = 219.800
            text = "010516: I-ga i-tsa-ti-s-di-s-gv du-ni-lv-sa-da-de-he-s-di yv-wi, na-s-gi-no o-s-dv de-tsi-lv-wi-s-da-ne-hv a-ni-go-wa-ti-s-ge-s-di, a-le a-ni-lv-quo-di-s-ge-s-di I-tsi-do-da ga-lv-la-di e-hi."
        intervals [33]:
            xmin = 219.800
            xmax = 221.110
            text = ""
        intervals [34]:
            xmin = 221.110
            xmax = 235.910
            text = "010517: Tle-s-di di-ka-hna-wa-dv-s-di a-le a-na-do-le-ho-s-gi du-yo-s-ta-ni-lv yi-s-gi-ye-li-se-he-s-di; v-tla-s-gi-ni yi-da-gi-yo-s-ta-ni-lv, da-gi-ka-li-li-lv-s-gi-ni."
        intervals [35]:
            xmin = 235.910
            xmax = 237.040
            text = ""
        intervals [36]:
            xmin = 237.040
            xmax = 257.045
            text = "010518: U-do-hi-yu-hi-ya-ye-no hi-a ni-tsv-we-se-ha, gv-ni ga-lv-lo-i a-le e-lo-hi a-ni-lo-so-nv-ha sa-quo u-s-di a-le sa-quo wu-s-di-gv di-ka-hna-wa-dv-s-di v-tla yv-ga-lo-hi gv-ni ni-ga-di-yu a-ka-li-tsv-ha."
        intervals [37]:
            xmin = 257.045
            xmax = 258.575
            text = ""
        intervals [38]:
            xmin = 258.575
            xmax = 294.105
            text = "010519: Na-s-gi i-yu-s-di gi-lo a-yo-s-di-s-ge-s-di sa-quo hi-a u-s-di-ka-ni u-li-ne-tsv-i, a-le na-s-gi nu-s-de-s-di yv-wi de-ge-yo-hv-s-ge-s-di, na-s-gi u-s-di-ka-ni a-go-se-he-s-di ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv-i; gi-lo-s-gi-ni da-ka-hna-wa-de-ge-s-di, a-le na-s-gi nu-s-de-s-di da-de-yo-hv-s-ge-s-di, ga-lv-quo-di-yu a-go-se-he-s-di ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv-i."
        intervals [39]:
            xmin = 294.105
            xmax = 295.355
            text = ""
        intervals [40]:
            xmin = 295.355
            xmax = 314.410
            text = "010520: Hi-a-ye-no ni-tsv-we-se-ha, i-tsv-no na-s-gi i-tsa-da-nv-ti ge-sv ni-di-tsi-go-na-dv-ta-nv-na i-ge-se-s-di di-no-we-li-s-gi a-le A-ni-qua-li-si, v-tla ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv yv-ge-tsi-yv-ha."
        intervals [41]:
            xmin = 314.410
            xmax = 315.250
            text = ""
        intervals [42]:
            xmin = 315.250
            xmax = 330.655
            text = "010521: I-tsa-dv-ga-nv-hi i-gi hi-a tsi-ni-ge-tsi-we-se-le e-ti tsa-ne-he-i; Tle-s-di tsa-da-lv-gi; a-le gi-lo a-da-hi-he-s-di gv-wa-s-dv-di-s-di ge-se-s-di di-nu-go-di-s-gi-yi."
        intervals [43]:
            xmin = 330.655
            xmax = 332.330
            text = ""
        intervals [44]:
            xmin = 332.330
            xmax = 365.290
            text = "010522: A-se-no a-yv hi-a ni-tsv-we-se-ha; Gi-lo di-na-da-nv-tli a-s-ga-ge-s-di go-hu-s-di nu-s-dv-di-s-gv-na i-ge-se-s-di, gv-wa-s-dv-di-s-di ge-se-s-di di-nu-go-di-s-gi-yi; gi-lo-no di-na-da-nv-tli Ni-tsa-da-nv-dv-na i-go-se-he-s-di, de-ga-la-wi-v gv-wa-s-dv-di-s-di ge-se-s-di; gi-lo-no Tsa-ne-gu i-go-se-he-s-di, gv-wa-s-dv-di-s-di ge-se-s-di tsv-s-gi-no a-tsi-lv-yi."
        intervals [45]:
            xmin = 365.290
            xmax = 366.780
            text = ""
        intervals [46]:
            xmin = 366.780
            xmax = 380.880
            text = "010523: Na-s-gi i-yu-s-di i-yu-no a-tsi-lv-ge-la-s-di-yi hi-yo-hi-he-s-di tsa-da-ne-di, na-hna-no i-ha-nv-da-di-s-ge-s-di di-s-da-da-nv-tli go-hu-s-di tse-li-se-hv-i,"
        intervals [47]:
            xmin = 380.880
            xmax = 382.255
            text = ""
        intervals [48]:
            xmin = 382.255
            xmax = 400.415
            text = "010524: Na-hna a-tsi-lv--ge-la-s-di-yi hi-hi-ya-s-ge-s-di tsa-da-ne-di a-le ha-da-nv-s-ge-s-di, i-gv-yi o-s-dv ni-s-dv-ne-he-s-di di-s-da-da-nv-tli; gi-la-no hi-lu-ge-s-di ha-li-s-go-lv-di-s-ge-s-di tsa-da-ne-di."
        intervals [49]:
            xmin = 400.415
            xmax = 401.690
            text = ""
        intervals [50]:
            xmin = 401.690
            xmax = 422.990
            text = "010525: Nu-la-quo o-s-dv ni-s-dv tsa-yi-li-do-hi, a-si-quo i-s-da-i-sv-i, di-gu-go-di-s-gi-yi-na-si wi-yi-tsa-ka-hv-ga tsa-yi-li-do-hi, di-gu-go-di-s-gi-no di-da-ni-yi-s-gi-yi wi-yi-tsa-ka-hv-ga, a-le di-da-s-du-di-yi yi-we-tsa-yv-da."
        intervals [51]:
            xmin = 422.990
            xmax = 424.370
            text = ""
        intervals [52]:
            xmin = 424.370
            xmax = 436.140
            text = "010526: U-do-hi-yu-hi-ya hi-a ni-gv-we-se-ha, V-tla yv-dv-ga-hi-nu-go-i, gv-ni u-li-s-qua-lv-di a-ye-li-i-ya-da-nv-te-di ha-gu-yv-hv-ha."
        intervals [53]:
            xmin = 436.140
            xmax = 437.025
            text = ""
        intervals [54]:
            xmin = 437.025
            xmax = 445.680
            text = "010527: I-tsa-dv-ga-nv-hi i-gi hi-a tsi-ni-ge-tsi-we-se-le e-ti tsa-ne-he-i; Tle-s-di tsa-da-yo-ne-lv-gi."
        intervals [55]:
            xmin = 445.680
            xmax = 446.600
            text = ""
        intervals [56]:
            xmin = 446.600
            xmax = 461.665
            text = "010528: A-se-no a-yv hi-a ni-tsv-we-se-ha; Gi-lo a-ge-yv da-ka-ni-s-ge-s-di tsu-na-ni-si-di-yi u-du-li-s-ge-s-di, ga-yu-la u-da-yo-ne-lv-hi ge-se-s-di tsu-da-nv-dv-i."
        intervals [57]:
            xmin = 461.665
            xmax = 463.380
            text = ""
        intervals [58]:
            xmin = 463.380
            xmax = 484.945
            text = "010529: I-yu-no hi-ga-do-li hi-ga-ti-si de-tso-de-s-di-s-ge-s-di, ha-da-ga-te-do-i-s-ge-s-di, a-le tsa-de-ge-s-di; o-si-yu-ye-no i-tsa-li-s-da-ne-di sa-quo-quo tsa-li-gv-ha-lv-dv yi-tsa-yo-hu-se-ha, a-no u-no-s-dv hi-ye-lv tsv-s-gi-no wi-ye-tsa-da-i-ne-ha."
        intervals [59]:
            xmin = 484.945
            xmax = 485.870
            text = ""
        intervals [60]:
            xmin = 485.870
            xmax = 508.015
            text = "010530: I-yu-no tso-ye-ni hi-ga-ti-si de-tso-de-s-di-s-ge-s-di, hi-s-qua-li-s-ge-s-di, a-le tsa-de-ge-s-di; o-si-yu-ye-no i-tsa-li-s-da-ne-di sa-quo-quo tsa-li-gv-ha-lv-dv yi-tsa-yo-hu-se-ha, a-no u-no-s-dv hi-ye-lv tsv-s-gi-no wi-ye-tsa-da-i-ne-ha."
        intervals [61]:
            xmin = 508.015
            xmax = 509.530
            text = ""
        intervals [62]:
            xmin = 509.530
            xmax = 520.655
            text = "010531: Hi-a i-ga-we-dv i-gi; Gi-lo u-da-li-i i-ga-ka-hv-s-ge-s-di, ga-nv-ne-he-s-di go-we-li na-s-gi du-na-ga-le-nv-hv-i."
        intervals [63]:
            xmin = 520.655
            xmax = 522.220
            text = ""
        intervals [64]:
            xmin = 522.220
            xmax = 543.160
            text = "010532: A-se-no a-yv hi-a ni-tsv-we-se-ha; Gi-lo u-da-li-i i-ga-ka-hv-s-ge-s-di, tsu-ni-si-nv-hi-s-gi-ni-no-nv i-ge-se-s-di, u-da-yo-ne-di-yi-quo ni-gv-ni-sa-ne-he-s-di; gi-lo-no a-tsi-ka-nv-hi a-da-ye-ge-s-di a-da-yo-ne-he-s-di."
        intervals [65]:
            xmin = 543.160
            xmax = 544.530
            text = ""
        intervals [66]:
            xmin = 544.530
            xmax = 558.115
            text = "010533: A-le i-tsa-dv-ga-nv-hi i-gi hi-a tsi-ni-ge-tsi-we-se-le e-ti tsa-ne-he-i; Tle-s-di tsa-yo-s-ta-nv tsa-se-li-ta-nv-i, yi-ho-wa-s-gi-ni ni-ya-dv-ne-he-s-di nu-s-dv tsa-ne-tsv-i."
        intervals [67]:
            xmin = 558.115
            xmax = 559.155
            text = ""
        intervals [68]:
            xmin = 559.155
            xmax = 574.770
            text = "010534: A-se-no a-yv hi-a ni-tsv-we-se-ha; Tle-s-di yi-tsa-se-li-ta-ne-s-di yi-tsa-ne-i-s-ta-ne-s-di go-hu-s-di, tle-s-di ga-lv-la-di yi-tsa-ne-i-s-ta-ne-s-di, U-ne-la-nv-hi-ye-no u-we-di-yi na-s-gi;"
        intervals [69]:
            xmin = 574.770
            xmax = 576.420
            text = ""
        intervals [70]:
            xmin = 576.420
            xmax = 589.330
            text = "010535: Tle-s-di a-le e-lo-hi, tsu-la-si-di-yi-ye-no na-s-gi; a-le Tsi-lu-si-li-mi, na-s-gi-ye-no a-tsi-lv-quo-di U-gv-wi-yu-hi u-tse-li ga-du-hv-i;"
        intervals [71]:
            xmin = 589.330
            xmax = 590.560
            text = ""
        intervals [72]:
            xmin = 590.560
            xmax = 598.925
            text = "010536: Tle-s-di a-le hi-s-go-li yi-tsa-ne-i-s-ta-ne-s-di, tla-ye-no ye-li sa-quo gi-tlv u-ne-gv a-le gv-hna-ge yi-nv-ga-hv-ga."
        intervals [73]:
            xmin = 598.925
            xmax = 599.940
            text = ""
        intervals [74]:
            xmin = 599.940
            xmax = 612.595
            text = "010537: I-tsi-ne-gv-s-gi-ni hi-a nu-s-de-s-di, V-v, V-v; V-tla, V-tla; u-tli-ye-no tsi-ni-ga-o u-yo-quo ge-sv di-da-le-ni-s-go-i."
        intervals [75]:
            xmin = 612.595
            xmax = 614.060
            text = ""
        intervals [76]:
            xmin = 614.060
            xmax = 626.375
            text = "010538: I-tsa-dv-ga-nv-hi i-gi hi-a i-ga-we-dv ge-sv-i, A-ga-ta a-ga-ta-quo da-gv-wa-lv-s-ge-s-di, ka-yu-ga-no ka-yu-ga-quo da-gv-wa-lv-s-ge-s-di."
        intervals [77]:
            xmin = 626.375
            xmax = 627.395
            text = ""
        intervals [78]:
            xmin = 627.395
            xmax = 644.945
            text = "010539: A-se-no a-yv hi-a ni-tsa-we-se-ha; Tle-s-di yi-tsa-tle-ge-s-di u-so-nv ne-tsv-ne-lv-i; gi-lo-s-gi-ni hi-ga-ti-si tsa-go-que-lu-hv-s-ge-s-di, so-i na-s-quo hi-ya-li-s-go-lv-da-ne-he-s-di."
        intervals [79]:
            xmin = 644.945
            xmax = 645.900
            text = ""
        intervals [80]:
            xmin = 645.900
            xmax = 657.885
            text = "010540: Gi-lo-no u-du-li-s-ge-s-di tsa-yi-li-da-s-di-yi, a-le tsa-na-e-di-yi ha-wi-ni tsa-nu-wo, u-dv-no-hi na-s-quo hi-nv-ne-he-s-di."
        intervals [81]:
            xmin = 657.885
            xmax = 659.100
            text = ""
        intervals [82]:
            xmin = 659.100
            xmax = 666.490
            text = "010541: Gi-lo-no su-tli-lo-dv i-s-de-nv-s-di-yi ni-tsv-ne-he-s-di, ta-li i-yu-tli-lo-dv i-s-de-ge-s-di."
        intervals [83]:
            xmin = 666.490
            xmax = 667.450
            text = ""
        intervals [84]:
            xmin = 667.450
            xmax = 676.995
            text = "010542: Tsa-ta-yo-se-hi hi-ne-he-s-di, tsa-do-lv-e-di-yi-no u-du-li-s-gi tle-s-di i-yv-dv i-hi-ya-dv-ne-lv-gi."
        intervals [85]:
            xmin = 676.995
            xmax = 678.070
            text = ""
        intervals [86]:
            xmin = 678.070
            xmax = 689.210
            text = "010543: I-tsa-dv-ga-nv-hi i-gi hi-a i-ga-we-dv ge-sv-i; Hi-ge-yu-se-s-di na-v i-di-s-da-da-la, hi-s-ga-ge-s-di-no tsa-s-ga-gi."
        intervals [87]:
            xmin = 689.210
            xmax = 690.480
            text = ""
        intervals [88]:
            xmin = 690.480
            xmax = 716.750
            text = "010544: A-se-no a-yv hi-a ni-tsv-we-se-ha; De-tsi-ge-yu-se-s-di ge-tsi-s-ga-gi; o-s-dv de-tsi-ne-tse-he-s-di ge-tsi-s-gi-nv-di-s-gi, o-s-dv ni-de-tsa-dv-ne-he-s-di ge-tsi-ni-qua-ti-hi, a-le o-s-dv i-yu-na-li-s-da-ne-di-yi i-tsa-da-do-li-s-di-s-ge-s-di ga-ye-go-gi ge-tsi-no-he-s-gi a-le u-yo i-ge-tsv-ne-hi."
        intervals [89]:
            xmin = 716.750
            xmax = 717.710
            text = ""
        intervals [90]:
            xmin = 717.710
            xmax = 737.065
            text = "010545: Na-s-gi-no ga-lv-la-di e-hi I-tsi-do-da tsu-we-tsi ni-tsa-li-s-di-s-ge-s-di; na-s-gi-ye-no u-tse-li nv-do de-ga-na-nu-go-wi-se-ho u-ni-yo a-le a-no-s-dv, a-le da-ga-nv-da-ne-ho u-na-da-nv-ti a-le u-ni-ne-gu-tsi-dv."
        intervals [91]:
            xmin = 737.065
