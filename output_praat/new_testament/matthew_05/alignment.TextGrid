        intervals [94]:
            xmin = 754.295
            xmax = 771.360
            text = "010547: I-yu a-le i-tsa-da-nv-tli-quo u-nv-sv yi-di-tsi-yo-li-ha, ga-do i-tsa-dv-ne-hv de-tsi-go-na-dv-di a-ni-so-i?  Tla-s-go na-s-gi yi-na-na-dv-ne-ho a-ye-li--a-de-lv a-ni-gi-si-do-hi?"
