        intervals [94]:
            xmin = 707.640
            xmax = 729.625
            text = "020947: I-yu a-le hi-ga-do-li do-tso-de-s-di-s-ge-s-di, ha-da-ga-te-do-i-s-ge-s-di; u-tli-ye-no o-si-yu i-tsa-li-s-da-ne-di sa-quo-quo yi-ka-nv U-ne-la-nv-hi u-tse-li-go-hi yi-wi-tsa-yv-lv a-no i-tsu-la yi-ti-ka-nv tsv-s-gi-no a-tsi-lv-yi yi-we-tsa-da-i-nv;"
