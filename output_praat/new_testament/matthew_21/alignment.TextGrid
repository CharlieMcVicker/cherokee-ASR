File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 788.300
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 788.300
        intervals: size = 92
        intervals [1]:
            xmin = 0.000
            xmax = 4.930
            text = ""
        intervals [2]:
            xmin = 4.930
            xmax = 16.610
            text = "012101: Hna-quo-no Tsi-lu-si-li-mi na-v u-ni-lu-tsv, Sv-ga-do-hi, O-li-wa u-sa-hi-lv-i i-yv-dv, Tsi-sa a-ni-ta-li gv-wa-s-da-wa-di-do-hi du-nv-sv-gi,"
        intervals [3]:
            xmin = 16.610
            xmax = 17.370
            text = ""
        intervals [4]:
            xmin = 17.370
            xmax = 38.400
            text = "012102: Hi-a ni-du-we-se-lv-gi; i-s-de-na i-tlv na tsv-di-ga-du-ha, gi-la-quo-no i-yv-dv da-ye-s-di-wa-dv-hi so-qui-li--di-ga-li-a-nv-hi-dv ge-li-sa-de-s-di, a-le a-gi-na a-ti-ne-he-s-di, de-s-de-li-sa-de-sv-ha, a-le de-s-gi-na-ti-no-he-lv-ha."
        intervals [5]:
            xmin = 38.400
            xmax = 39.695
            text = ""
        intervals [6]:
            xmin = 39.695
            xmax = 52.260
            text = "012103: I-yu-no gi-lo go-hu-s-di i-s-do-se-lv-ha, hi-a ne-s-di-we-se-lv-ha; U-gv-wi-yu-hi du-du-li-ha; gi-la-quo-no i-yv-dv do-da-yu-yo-si."
        intervals [7]:
            xmin = 52.260
            xmax = 53.015
            text = ""
        intervals [8]:
            xmin = 53.015
            xmax = 62.745
            text = "012104: Na-s-gi hi-a ni-ga-dv nu-li-s-ta-nv-gi, u-do-hi-yu-di-yi a-ye-lv-sv-i a-do-le-ho-s-gi tsu-ne-tse-i, hi-a tsi-nu-we-se-i;"
        intervals [9]:
            xmin = 62.745
            xmax = 63.685
            text = ""
        intervals [10]:
            xmin = 63.685
            xmax = 84.970
            text = "012105: Hi-a ne-tsi-we-si Sa-ya-ni u-we-tsi a-ge-yv; Gv-ni-yu-quo U-gv-wi-yu-hi tsa-tse-li da-ya-i, da-tsa-lu-tse-li u-da-do-li-s-di-yu, a-le u-gi-lv-de-s-di so-qui-li--di-ga-li-a-nv-hi-dv go-hu-s-di a-dv-ne-hi u-we-tsi a-gi-na."
        intervals [11]:
            xmin = 84.970
            xmax = 86.280
            text = ""
        intervals [12]:
            xmin = 86.280
            xmax = 94.190
            text = "012106: Gv-wa-s-da-wa-di-do-hi-no u-ne-nv-sv-gi, Tsi-sa nu-ni-we-se-lv na-s-gi-ya wi-nu-na-dv-ne-lv-gi;"
        intervals [13]:
            xmin = 94.190
            xmax = 95.480
            text = ""
        intervals [14]:
            xmin = 95.480
            xmax = 108.300
            text = "012107: So-qui-li--di-ga-li-a-nv-hi-dv a-le a-gi-na du-na-ti-no-lv-gi; di-ni-so-hi-yi-no tsu-na-nu-wo du-ni-tlv-nv-gi, a-le na-hna u-na-gi-lv-ta-nv-gi."
        intervals [15]:
            xmin = 108.300
            xmax = 109.950
            text = ""
        intervals [16]:
            xmin = 109.950
            xmax = 127.415
            text = "012108: U-tli-no i-ya-ni-i yv-wi tsu-na-nu-wo du-ni-ye-s-dv-nv-gi nv-no-hi, i-ga-dv-no du-nv-ni-ga-lv-hv-gi tsu-we-yo-ta de-tlu-gv-i, a-le nv-no-hi du-ni-yo-ta-nv-nv-gi."
        intervals [17]:
            xmin = 127.415
            xmax = 128.760
            text = ""
        intervals [18]:
            xmin = 128.760
            xmax = 151.200
            text = "012109: U-ni-tsa-ti-no i-gv-yi a-ne-gi, a-le o-ni a-ne-gi u-ne-lu-gv-gi, hi-a na-ni-we-s-gv-gi; Ho-sa-na De-wi U-we-tsi!  a-tsi-lv-quo-di-yu ge-se-s-di Yi-ho-wa de-u-do-v tsi-ga-lu-hi-s-di-ha!  Ho-sa-na wa-s-dv ga-lv-la-di-yu!"
        intervals [19]:
            xmin = 151.200
            xmax = 152.175
            text = ""
        intervals [20]:
            xmin = 152.175
            xmax = 161.850
            text = "012110: Tsi-lu-si-li-mi-no u-lu-tsv ni-gv ga-du-hv u-na-li-te-lv-nv-gi, hi-a na-ni-we-s-gv-gi; Ga-go hi-a?"
        intervals [21]:
            xmin = 161.850
            xmax = 163.130
            text = ""
        intervals [22]:
            xmin = 163.130
            xmax = 172.220
            text = "012111: U-ni-tsa-ti-no hi-a nu-ni-we-sv-gi; Hi-a Tsi-sa a-do-le-ho-s-gi, Na-se-li-di e-hi Ge-li-li ga-du-hv-i."
        intervals [23]:
            xmin = 172.220
            xmax = 173.840
            text = ""
        intervals [24]:
            xmin = 173.840
            xmax = 200.000
            text = "012112: Tsi-sa-no wu-yv-lv-gi u-dv-na--di-ga-la-wi-i-s-di-yi U-ne-la-nv-hi u-tse-li-ga, a-le du-nu-go-wi-sv-gi ni-ga-dv a-ni-na-de-gi a-le u-ni-wa-s-gi na-hna di-ga-la-wi-i-s-di-yi, a-le du-lu-qua-di-nv-sv-gi du-ni-s-gi-lv a-de-lv di-ni-ne-tli-yv-s-gi, a-le gu-le di-ni-s-go-ni-hi di-ni-na-de-gi u-na-nv-di-yi."
        intervals [25]:
            xmin = 200.000
            xmax = 201.600
            text = ""
        intervals [26]:
            xmin = 201.600
            xmax = 219.940
            text = "012113: Hi-a-no ni-du-we-se-lv-gi; Hi-a ni-gv-nv-go-we-la; A-qua-tse-li ga-li-tso-de a-da-do-li-s-do-di-yi ga-li-tso-de du-do-e-s-di; a-se-no hi-a a-ni-no-s-gi-s-gi u-ni-yv-s-di-yi ni-tsv-ne-lv."
        intervals [27]:
            xmin = 219.940
            xmax = 220.935
            text = ""
        intervals [28]:
            xmin = 220.935
            xmax = 229.270
            text = "012114: Di-ni-ge-wi-no a-le di-ni-yo-u-li gv-wa-lu-tse-lv-gi di-ga-la-wi-i-s-di-yi, a-le du-nv-wa-nv-gi."
        intervals [29]:
            xmin = 229.270
            xmax = 230.210
            text = ""
        intervals [30]:
            xmin = 230.210
            xmax = 255.125
            text = "012115: Hna-quo-no nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le di-no-we-li-s-gi u-na-do-le-ho-sv u-s-qua-ni-go-di-yu du-lv-wi-s-da-ne-hv-i, a-le di-ni-yo-li u-ne-lu-gv u-dv-na--di-ga-la-wi-i-s-di-yi hi-a na-ni-we-s-gv-i, Ho-sa-na De-wi U-we-tsi!  u-tsa-ti u-ni-so-nv-tse-lv-gi;"
        intervals [31]:
            xmin = 255.125
            xmax = 256.250
            text = ""
        intervals [32]:
            xmin = 256.250
            xmax = 281.470
            text = "012116: A-le hi-a ni-gv-wa-we-se-lv-gi; Ha-dv-gi-s-go hi-a tsi-na-ni-we-ha?  Tsi-sa-no hi-a ni-du-we-se-lv-gi; V-v, Tla-s-go hi-lv-hi-yu hi-a yi-tsi-go-li-ye-o-i; Tsu-na-s-di di-ni-yo-li a-le di-ni-s-da-i a-ni-ho-li u-nu-go-tsv-hi tsa-wa-dv-do-ta-nv e-tsa-lv-quo-do-di-yi?"
        intervals [33]:
            xmin = 281.470
            xmax = 282.660
            text = ""
        intervals [34]:
            xmin = 282.660
            xmax = 291.455
            text = "012117: Du-da-nv-e-lv-gi-no, a-le ga-du-hv u-nu-go-tsv-gi, Que-di-ni-yi wu-lu-tsv-gi, a-le na-hna u-sv-lv-gi."
        intervals [35]:
            xmin = 291.455
            xmax = 292.770
            text = ""
        intervals [36]:
            xmin = 292.770
            xmax = 298.640
            text = "012118: Su-na-le-no di-ga-du-hv wv-a-ga-dv-i a-go-nu u-yo-si-sa-nv-gi."
        intervals [37]:
            xmin = 298.640
            xmax = 299.500
            text = ""
        intervals [38]:
            xmin = 299.500
            xmax = 324.955
            text = "012119: U-go-hv-no sv-ga-ta--i-yu-s-di tlu-gv nv-no-hu-lo-di, na-hna wu-lu-tsv-gi; a-se-no v-tla go-hu-s-di yu-wa-dv-he-i, u-la-s-du-sv u-wa-sv; hi-a-no nu-we-se-lv-gi; Tle-s-di i-lv-hi-yu go-hi i-yu-da-le-nv-dv yi-tsa-da-ta-ne-s-di.  Gi-la-quo-no i-yv-dv sv-ga-ta--i-yu-s-di tlu-gv u-wa-yv-sv-gi."
        intervals [39]:
            xmin = 324.955
            xmax = 326.230
            text = ""
        intervals [40]:
            xmin = 326.230
            xmax = 337.550
            text = "012120: Gv-wa-s-da-wa-di-do-hi-no u-ni-go-hv u-ni-s-qua-ni-go-sv-gi, hi-a nu-ni-we-sv-gi; Na-tle-gv-quo gv-yv-hi sv-ga-ta--i-yu-s-di tlu-gv-i!"
        intervals [41]:
            xmin = 337.550
            xmax = 338.410
            text = ""
        intervals [42]:
            xmin = 338.410
            xmax = 368.260
            text = "012121: Tsi-sa u-ne-tsv hi-a ni-du-we-se-lv-gi; U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; i-yu-no yi-tso-hi-yu-ha, a-le ni-tsa-dla-si-dv-e-hv-na yi-gi, v-tla hi-a-quo sv-ga-ta--i-yu-s-di tlu-gv tsi-na-gv-ga yi-nv-ge-tsa-dv-ga, na-s-quo-s-gi-ni hi-a yi-ni-tsi-we-se-lv hi-a tso-da-lv, Ha-da-nv-na, a-le a-me-quo-hi we-tsa-du-ga, a-se na-s-gi i-yu-li-s-do-di."
        intervals [43]:
            xmin = 368.260
            xmax = 368.920
            text = ""
        intervals [44]:
            xmin = 368.920
            xmax = 379.715
            text = "012122: Ni-ga-v-no go-hu-s-di i-tsi-ta-yo-hi-he-s-di, i-tsa-da-do-li-s-di-s-gv-i, i-tso-hi-yu-hv-s-ge-s-di, i-tsi-wa-ti-s-ge-s-di."
        intervals [45]:
            xmin = 379.715
            xmax = 381.070
            text = ""
        intervals [46]:
            xmin = 381.070
            xmax = 403.740
            text = "012123: U-dv-na-no di-ga-la-wi-i-s-di-yi u-lu-tsv, nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le tsu-na-dv-so-nv-hi yv-wi a-ne-hv gv-wa-lu-tse-lv-gi da-de-yo-hv-s-gv-i, hi-a nu-ni-we-sv-gi; Ga-do tsa-li-s-ga-s-do-di hi-a na-s-gi tsi-de-tsa-lv-wi-s-da-ne-ha?  A-le ga-go tsa-ne-tse-lv-hi?"
        intervals [47]:
            xmin = 403.740
            xmax = 404.650
            text = ""
        intervals [48]:
            xmin = 404.650
            xmax = 421.660
            text = "012124: Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-lv-gi; a-yv na-s-gi su-da-le-gi da-tsv-ya-dv-dv-ni, i-yu-no na-s-gi i-s-gi-no-ne-lv na-s-gi a-yv da-tsv-no-ne-li i-yu-s-di a-qua-li-s-ga-s-do-dv-i, hi-a na-s-gi tsi-da-gi-lv-wi-s-da-ne-ha."
        intervals [49]:
            xmin = 421.660
            xmax = 422.420
            text = ""
        intervals [50]:
            xmin = 422.420
            xmax = 444.160
            text = "012125: Tsa-ni tsi-da-da-wo-s-gv-gi ha-tlv tsu-da-le-ne-i? Ga-lv-la-di-s-go, yv-wi-quo-ge a-ne-hv tsu-da-le-ne-i?  E-la-we-yi-no u-na-da-nv-te-lv-gi, hi-a na-ni-we-s-gv-gi; i-yu-no ga-lv-la-di, yo-ga-dv-nv, Ga-do-no tla yi-e-tso-i-yu-ne-i?  Yo-go-si."
        intervals [51]:
            xmin = 444.160
            xmax = 444.970
            text = ""
        intervals [52]:
            xmin = 444.970
            xmax = 456.710
            text = "012126: I-yu-no yv-wi-quo a-ne-hv tsu-da-le-ne-i yo-ga-dv-nv, do-tsi-s-ga-i-ha-quo yv-wi; ni-ga-dv-ye-no a-do-le-ho-s-gi u-ni-ye-lv-ha Tsa-ni."
        intervals [53]:
            xmin = 456.710
            xmax = 458.155
            text = ""
        intervals [54]:
            xmin = 458.155
            xmax = 475.705
            text = "012127: U-ni-ne-tsv-no hi-a nv-gv-wa-we-se-lv Tsi-sa; V-tla yo-tsi-ga-ta-ha.  Hi-a-no ni-du-we-se-lv-gi; V-tla na-s-quo a-yv yv-ge-tsv-no-hv-si i-yu-s-di a-qua-li-s-ga-s-do-dv-i hi-a na-s-gi tsi-da-gi-lv-wi-s-da-ne-ha."
        intervals [55]:
            xmin = 475.705
            xmax = 476.395
            text = ""
        intervals [56]:
            xmin = 476.395
            xmax = 500.480
            text = "012128: A-se-no ga-do i-tse-li-ha?  Gi-lo a-s-ga-ya a-ni-ta-li tsu-we-tsi a-ni-s-ga-ya a-ne-he-i; a-si-yv-wi-no i-gv-yi wu-lu-tse-lv, hi-a nu-we-se-le-i; A-que-tsi, he-na go-hi wi-di-tsa-lv-wi-s-da-si te-lv-la-di da-gi-wi-sv-i."
        intervals [57]:
            xmin = 500.480
            xmax = 501.185
            text = ""
        intervals [58]:
            xmin = 501.185
            xmax = 509.965
            text = "012129: Tsu-ne-tsv-no, v-tla, u-dv-ne-i; a-se-no o-ni u-ne-tli-yv-se u-da-nv-dv-i, a-le u-we-nv-se-i."
        intervals [59]:
            xmin = 509.965
            xmax = 510.800
            text = ""
        intervals [60]:
            xmin = 510.800
            xmax = 520.340
            text = "012130: So-i-no wu-lu-tse-lv na-s-gi-ya nu-we-se-le-i.  Tsu-ne-tsv-no, da-ge-si, u-dv-ne-i; a-se-no nu-we-nv-sv-na-quo i-ge-se-i."
        intervals [61]:
            xmin = 520.340
            xmax = 521.215
            text = ""
        intervals [62]:
            xmin = 521.215
            xmax = 547.880
            text = "012131: Ga-go hi-a a-ni-ta-li u-do-da u-ne-tsv nu-dv-ne-le-i?  I-gv-yi wu-lu-tse-lv-hi, v-gv-wo-se-lv-gi.  Tsi-sa-no hi-a ni-du-we-se-lv-gi; U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, a-de-lv a-ni-gi-si-do-hi a-le tsu-na-tse-sa-ti a-ni-ge-yv U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv wa-ni-yv-hi-ha de-ge-tsi-go-ni-ha."
        intervals [63]:
            xmin = 547.880
            xmax = 549.320
            text = ""
        intervals [64]:
            xmin = 549.320
            xmax = 574.185
            text = "012132: Tsa-ni-ye-no du-yu-go-dv du-lv-wi-s-da-ne-hv i-tsi-lu-tse-lv-gi, a-le v-tla ye-tso-i-yu-ne-i, a-de-lv-s-gi-ni a-ni-gi-si-do-hi a-le a-ni-ge-yv tsu-na-tse-sa-ti tsi-gv-wo-hi-yu-nv-gi; ni-hi-no i-tsa-do-le-ho-sv v-tla o-ni yi-di-tsi-ne-tli-yv-se de-tsa-da-nv-dv e-tso-i-yu-di-yi."
        intervals [65]:
            xmin = 574.185
            xmax = 575.475
            text = ""
        intervals [66]:
            xmin = 575.475
            xmax = 606.080
            text = "012133: Nv-wa-da-le da-tli-lo-s-dv i-tsa-dv-gv-ga; E-he gi-lo a-s-ga-ya ga-ne-la, na-s-gi te-lv-la-di du-wi-se-i, a-le u-so-yo-le gv-wa-du-wi-dv, a-le u-s-go-se gi-ga-ge--a-di-ta-s-di go-tlv-di-yi, a-le u-ne-s-ge-he i-nv i-ga-ti, a-le du-do-la-s-ta-ne tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi, i-nv-no wu-lo-se-i."
        intervals [67]:
            xmin = 606.080
            xmax = 607.080
            text = ""
        intervals [68]:
            xmin = 607.080
            xmax = 619.950
            text = "012134: Hna-quo-no na-v-ni-yu ge-se u-nv-ni-s-di-yi du-nv-se tsu-nv-si-da-s-di tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi di-ne-hv-i, du-ni-ne-sv-se u-na-da-dv-nv-hi."
        intervals [69]:
            xmin = 619.950
            xmax = 621.300
            text = ""
        intervals [70]:
            xmin = 621.300
            xmax = 636.350
            text = "012135: Tlo-ge-si-no tsu-ni-lv-wi-s-da-ne-hi du-ni-ni-yv-he tsu-nv-si-da-s-di, a-si-yv-wi u-ni-lv-ni-le-i, so-i-no u-ni-le-i, so-i-no nv-ya du-nv-ni-s-ta-ne-i."
        intervals [71]:
            xmin = 636.350
            xmax = 637.080
            text = ""
        intervals [72]:
            xmin = 637.080
            xmax = 645.470
            text = "012136: Ta-li-ne-no du-nv-se nv-wa-na-da-le tsu-nv-si-da-s-di u-tli i-ya-ni-i; na-s-gi-ya-quo-no ni-du-nv-ne-le-i."
        intervals [73]:
            xmin = 645.470
            xmax = 646.930
            text = ""
        intervals [74]:
            xmin = 646.930
            xmax = 653.835
            text = "012137: O-ni-yi-no u-we-tsi u-nv-se-i, hi-a nu-we-se-i; A-se dv-ni-lv-quo-ta-ni a-que-tsi."
        intervals [75]:
            xmin = 653.835
            xmax = 654.805
            text = ""
        intervals [76]:
            xmin = 654.805
            xmax = 671.680
            text = "012138: A-se-no tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi u-ni-go-hv u-we-tsi hi-a ni-du-na-da-we-se-le-i; Na-s-gi hi-a u-tse-li i-yu-li-s-do-di; ka e-di-lu-ga, a-le e-di-wo-nv u-tse-li i-yu-li-s-do-di tsi-gi."
        intervals [77]:
            xmin = 671.680
            xmax = 672.875
            text = ""
        intervals [78]:
            xmin = 672.875
            xmax = 679.370
            text = "012139: U-ni-ni-yv-he-no, a-le u-ni-nu-go-wi-se te-lv-la-di da-wi-sv-i, a-le u-ni-le-i."
        intervals [79]:
            xmin = 679.370
            xmax = 680.550
            text = ""
        intervals [80]:
            xmin = 680.550
            xmax = 690.990
            text = "012140: Hna-quo-no na-s-gi te-lv-la-di da-wi-sv u-tse-li-ga ga-lu-tsv-ha, ga-do do-da-gv-ne-li na tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi?"
        intervals [81]:
            xmin = 690.990
            xmax = 692.315
            text = ""
        intervals [82]:
            xmin = 692.315
            xmax = 712.665
            text = "012141: Hi-a-no nv-gv-wa-we-se-lv-gi; u-yo-i-yu ni-do-da-gv-ne-li do-dv-li na-s-gi na u-ni-yo-i, a-le nv-wa-na-da-le tlo-ge-si tsu-ni-lv-wi-s-da-ne-hi do-dv-do-la-s-ta-ni, na-s-gi ye-li gv-wa-na-gu-yv-di na-nv-na-si-sv-i."
        intervals [83]:
            xmin = 712.665
            xmax = 713.950
            text = ""
        intervals [84]:
            xmin = 713.950
            xmax = 737.980
            text = "012142: Tsi-sa-no hi-a ni-du-we-se-lv-gi; tla-s-go i-lv-hi-yu yi-tsi-go-li-ye-o hi-a tsi-ni-gv-nv tsi-go-we-la?  A-na-ne-s-ge-s-gi u-ni-yo-i-se-lv-hi nv-ya nu-gv-wi-yu-sv u-nv-si-yv a-di nu-li-s-ta-nv; na-s-gi hi-a Yi-ho-wa nu-dv-ne-lv, a-le u-s-qua-ni-go-di-yu de-da-ka-ni-s-gv-i."
        intervals [85]:
            xmin = 737.980
            xmax = 738.640
            text = ""
        intervals [86]:
            xmin = 738.640
            xmax = 754.725
            text = "012143: Na-s-gi i-yu-s-di hi-a ni-tsv-we-se-ha; U-ne-la-nv-hi u-tse-li-go-hi da-ye-tsi-gi-sv-li, nv-wa-na-da-le-no da-ge-tsi-ne-li, na-s-gi ye-li gv-wa-ni-na-nu-go-wi-s-di u-da-ta-nv-hi."
        intervals [87]:
            xmin = 754.725
            xmax = 756.330
