        intervals [90]:
            xmin = 766.400
            xmax = 778.670
            text = "012145: Hna-quo-no nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le A-ni-qua-li-si u-na-dv-ga-nv da-tli-lo-s-di-s-gv-i, u-na-do-le-ho-sv-gi u-nv-sv ge-tsi-dv-gv-i."
