item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 621.240
        intervals: size = 78
        intervals [1]:
            xmin = 0.000
            xmax = 3.695
            text = ""
        intervals [2]:
            xmin = 3.695
            xmax = 13.400
            text = "011501: Hna-quo-no Tsi-sa gv-wa-lu-tse-lv-gi di-no-we-li-s-gi a-le A-ni-qua-li-si Tsi-lu-si-li-mi a-ne-hi, hi-a nu-ni-we-sv-gi;"
        intervals [3]:
            xmin = 13.400
            xmax = 14.315
            text = ""
        intervals [4]:
            xmin = 14.315
            xmax = 27.140
            text = "011502: Ga-do-no ge-tsa-s-da-wa-di-do-hi a-ni-yo-s-di-s-go e-ti a-ne-hi u-ni-no-he-lv-hi?  Tla-ye-no yi-da-no-su-le-s-go tsu-no-ye-ni tsv-di-na-li-s-da-yv-ni-so-i."
        intervals [5]:
            xmin = 27.140
            xmax = 28.220
            text = ""
        intervals [6]:
            xmin = 28.220
            xmax = 40.805
            text = "011503: A-se-no u-ne-tsv hi-a ni-du-we-se-lv-gi; ga-do-no na-s-quo ni-hi e-ti a-ne-hi u-ni-no-he-lv-hi i-tsv-di-s-go i-tsi-yo-s-di-s-go U-ne-la-nv-hi u-ne-tsv-hi?"
        intervals [7]:
            xmin = 40.805
            xmax = 41.955
            text = ""
        intervals [8]:
            xmin = 41.955
            xmax = 61.630
            text = "011504: U-ne-la-nv-hi-ye-no u-ne-tse hi-a nu-we-se-i; Hi-lv-quo-de-s-di tsa-do-da a-le tsa-tsi; a-le na-s-quo hi-a; Gi-lo da-s-gi-nv-di-s-ge-s-di u-do-da a-le u-tsi a-se u-yo-hu-hi-s-di ge-se-s-di."
        intervals [9]:
            xmin = 61.630
            xmax = 62.660
            text = ""
        intervals [10]:
            xmin = 62.660
            xmax = 80.820
            text = "011505: A-se-no ni-hi hi-a ni-tsi-we-s-go-i; I-yu-no gi-lo hi-a ni-ga-we-se-he-s-di u-do-da, a-le u-tsi, A-qua-li-s-go-lv-ta-nv-hi ye-li ge-tsa-li-s-de-lv-do-di ge-sv-i ni-tsa-dv-ne-hv,"
        intervals [11]:
            xmin = 80.820
            xmax = 81.700
            text = ""
        intervals [12]:
            xmin = 81.700
            xmax = 104.640
            text = "011506: Ni-ga-lv-quo-di-s-gv-na-no i-ge-se-s-di u-do-da, a-le u-tsi, [v-tla u-s-ga-nv-tsv-hi yi-ge-se-s-di,] i-tsa-di-s-go-i.  Na-s-gi hi-a e-ti a-ne-hi u-ni-no-he-lv-hi i-tsv-ta-nv a-se-quo ni-tsv-ne-lv U-ne-la-nv-hi u-ne-tsv-hi."
        intervals [13]:
            xmin = 104.640
            xmax = 105.730
            text = ""
        intervals [14]:
            xmin = 105.730
            xmax = 115.235
            text = "011507: I-tsa-tlo-na-s-di, ye-li-quo I-sa-ya tsu-do-le-ho-se tsi-tsi-dv-ge-i, hi-a tsi-nu-we-se-i;"
        intervals [15]:
            xmin = 115.235
            xmax = 116.305
            text = ""
        intervals [16]:
            xmin = 116.305
            xmax = 131.340
            text = "011508: Hi-a yv-wi na-v gv-gi-lu-tse-ha a-ni-ho-li a-nv-di-ha, a-le du-ni-ha-ne-ga-lv da-nv-di gv-gi-lv-quo-di-ha, a-se-no u-ni-na-wi i-nv-hi-yu nu-nv-nv."
        intervals [17]:
            xmin = 131.340
            xmax = 132.570
            text = ""
        intervals [18]:
            xmin = 132.570
            xmax = 142.830
            text = "011509: A-se-quo-s-gi-ni na-na-dv-ne-ha gv-qua-da-do-li-s-da-ne-ha, tsi-da-na-de-yo-hv-s-ga da-na-de-yo-hv-s-gv yv-wi-quo u-ni-ne-tsv-hi."
        intervals [19]:
            xmin = 142.830
            xmax = 143.900
            text = ""
        intervals [20]:
            xmin = 143.900
            xmax = 150.955
            text = "011510: Wi-du-ya-hv-no u-ni-tsa-ti hi-a ni-du-we-se-lv-gi; I-tsa-dv-gv-ga a-le i-tso-li-gi."
        intervals [21]:
            xmin = 150.955
            xmax = 152.135
            text = ""
        intervals [22]:
            xmin = 152.135
            xmax = 165.450
            text = "011511: V-tla-s-gi-ni na-s-gi na a-ho-li wu-yv-lv-hi ga-da-ha yi-nu-wa-ne-ho yv-wi, a-ho-li-s-gi-ni nv-da-yu-nu-go-tsv-hi na-s-gi ga-da-ha nu-wa-ne-ho yv-wi."
        intervals [23]:
            xmin = 165.450
            xmax = 166.560
            text = ""
        intervals [24]:
            xmin = 166.560
            xmax = 180.975
            text = "011512: Hna-quo-no gv-wa-s-da-wa-di-do-hi u-ni-lu-tsv hi-a ni-gv-wa-se-lv-gi; Hi-ga-ta-ha-s-go A-ni-qua-li-si u-ni-hna-lv-tsv-i u-na-dv-ga-nv na-s-gi hi-a ni-tsa-we-sv-i."
        intervals [25]:
            xmin = 180.975
            xmax = 182.160
            text = ""
        intervals [26]:
            xmin = 182.160
            xmax = 194.650
            text = "011513: A-se-no u-ne-tsv-gi hi-a nu-we-sv-gi; ni-ga-v du-ye-gv E-do-da tsu-wi-sv-hi ni-ge-sv-na di-ye-hi-s-di ge-se-s-di."
        intervals [27]:
            xmin = 194.650
            xmax = 195.590
            text = ""
        intervals [28]:
            xmin = 195.590
            xmax = 208.035
            text = "011514: U-na-ne-la-gi, di-ni-ge-wi-quo di-ni-ge-wi di-na-ti-ni-do-hi; i-yu-no di-ge-wi ya-ti-ni di-ge-wi i-tsu-la a-ta-le-sv tsu-ni-lv-i-s-di."
        intervals [29]:
            xmin = 208.035
            xmax = 209.100
            text = ""
        intervals [30]:
            xmin = 209.100
            xmax = 217.495
            text = "011515: Qui-da-no u-ne-tsv hi-a nu-we-se-lv-gi; di-s-gi-yo-si-sa-si hi-a na-s-gi da-tli-lo-s-dv-i."
        intervals [31]:
            xmin = 217.495
            xmax = 218.720
            text = ""
        intervals [32]:
            xmin = 218.720
            xmax = 225.615
            text = "011516: Tsi-sa-no hi-a nu-we-se-lv-gi; A-si-s-go na-s-quo ni-hi ni-tso-li-gv-na-quo i-gi?"
        intervals [33]:
            xmin = 225.615
            xmax = 227.000
            text = ""
        intervals [34]:
            xmin = 227.000
            xmax = 241.740
            text = "011517: Tla-s-go a-si yi-tso-li-ga na-s-gi ni-ga-v go-hu-s-di v-ho-li u-yv-s-ta-nv-hi ge-sv o-s-quo-li-yi wi-ga-lu-gv-i, na-s-gi-no wi-ga-lo-hi-s-di-s-gv-quo?"
        intervals [35]:
            xmin = 241.740
            xmax = 242.735
            text = ""
        intervals [36]:
            xmin = 242.735
            xmax = 252.915
            text = "011518: Na-s-gi-ni v-ho-li nv-da-yu-nu-go-tsv-hi o-na-wi-yi di-da-le-hv-s-go-i, na-s-gi-no ga-da-ha nu-wa-ne-ho yv-wi."
        intervals [37]:
            xmin = 252.915
            xmax = 254.030
            text = ""
        intervals [38]:
            xmin = 254.030
            xmax = 279.890
            text = "011519: O-na-wi-yi-ye-no di-da-le-hv-s-go u-so-nv a-da-nv-te-di ge-sv-i, a-le a-da-hi-s-di-yi ge-sv-i, a-le a-da-yo-ne-di-yi ge-sv-i, a-le u-de-li-dv di-ni-si-di-yi ge-sv-i, a-le ga-no-s-gi-s-di-yi ge-sv-i, a-le a-tsi-go-di-yi da-na-da-yi-li-do-hv-i, a-le a-so-tlv-i-s-do-di-yi ge-sv-i."
        intervals [39]:
            xmin = 279.890
            xmax = 281.070
            text = ""
        intervals [40]:
            xmin = 281.070
            xmax = 293.060
            text = "011520: Na-s-gi-s-gi-ni hi-a ga-da-ha i-yu-wa-ne-hi yv-wi; ni-da-su-le-hv-na-s-gi-ni a-li-s-da-yv-di-yi v-tla ga-da-ha yi-nu-wa-ne-ho yv-wi."
        intervals [41]:
            xmin = 293.060
            xmax = 293.865
            text = ""
        intervals [42]:
            xmin = 293.865
            xmax = 301.655
            text = "011521: Tsi-sa-no na-hna u-ni-gi-sv Ta-yo-i a-le Sa-do-ni-yi wu-lo-sv-gi."
        intervals [43]:
            xmin = 301.655
            xmax = 302.650
            text = ""
        intervals [44]:
            xmin = 302.650
            xmax = 321.725
            text = "011522: Gv-ni-yu-quo-no Ge-na-ni e-hi a-ge-yv na-hna na-v nv-da-yu-lo-sv-hi u-we-lu-nv-gi, hi-a nu-we-se-lv-gi; S-gi-do-li-gi, Tsa-gv-wi-yu-hi De-wi u-we-tsi, a-que-tsi a-ge-yv u-tsa-ta-nv-hi u-de-ya-do-di-ha a-s-gi-na."
        intervals [45]:
            xmin = 321.725
            xmax = 322.370
            text = ""
        intervals [46]:
            xmin = 322.370
            xmax = 337.335
            text = "011523: A-se-no nu-ne-tse-lv-na-quo v-ge-sv-gi.  Gv-wa-s-da-wa-di-do-hi-no gv-wa-lu-tse-lv-gi, gv-wa-ta-yo-se-lv-gi, hi-a nu-ni-we-sv-gi; Wi-e-na, i-gi-s-go-ni-ha-ye-no."
        intervals [47]:
            xmin = 337.335
            xmax = 338.245
            text = ""
        intervals [48]:
            xmin = 338.245
            xmax = 353.620
            text = "011524: U-ne-tsv-no hi-a nu-we-sv-gi; v-tla gi-lo di-tsi-wa-dv-di-yi yv-gi-ne-tse-lv, a-wi u-ni-no-de-na u-na-le-na-lv-hi u-nv-sv I-si-li si-da-ne-lv-hi gv-sv-i."
        intervals [49]:
            xmin = 353.620
            xmax = 354.805
            text = ""
        intervals [50]:
            xmin = 354.805
            xmax = 363.410
            text = "011525: Hna-quo-no a-ge-yv u-lu-tsv u-da-do-li-s-da-ne-lv-gi hi-a nu-we-sv-gi; Tsa-gv-wi-yu-hi, s-gi-s-de-lv."
        intervals [51]:
            xmin = 363.410
            xmax = 364.460
            text = ""
        intervals [52]:
            xmin = 364.460
            xmax = 376.750
            text = "011526: U-ne-tsv-no hi-a nu-we-sv-gi; v-tla yi-du-yu-go-di di-gi-e-di-yi di-ni-yo-li u-na-tse-li ga-du, gi-li-no wi-da-di-ne-di-yi."
        intervals [53]:
            xmin = 376.750
            xmax = 377.630
            text = ""
        intervals [54]:
            xmin = 377.630
            xmax = 392.260
            text = "011527: A-ge-yv-no hi-a nu-we-sv-gi; U-do-hi-yu-hi, Tsa-gv-wi-yu-hi, a-se-no gi-li a-na-li-s-da-yv-di-s-go u-nv-go-o-sv-hi di-gv-wa-ni-na-tla-i du-ni-s-gi-lv-i."
        intervals [55]:
            xmin = 392.260
            xmax = 393.205
            text = ""
        intervals [56]:
            xmin = 393.205
            xmax = 408.890
            text = "011528: Hna-quo-no Tsi-sa u-ne-tsv hi-a nu-we-se-lv-gi; Hi-ge-yv u-tsa-ti tso-hi-yu-ha; nu-s-dv tsa-du-li-s-gv wi-ni-tsa-li-s-da-si.  Na-hi-yu-quo-no u-we-tsi u-di-wa-se-i."
        intervals [57]:
            xmin = 408.890
            xmax = 410.040
            text = ""
        intervals [58]:
            xmin = 410.040
            xmax = 421.265
            text = "011529: Tsi-sa-no na-hna u-ni-gi-sv Ge-li-li v-da-lu-lo-di u-lu-tsv-gi, u-hna-lu-sv-no u-sa-hi-lv na-hna u-we-nv-gi."
        intervals [59]:
            xmin = 421.265
            xmax = 422.755
            text = ""
        intervals [60]:
            xmin = 422.755
            xmax = 451.640
            text = "011530: U-ni-tsa-ti-no yv-wi gv-wa-lu-tse-lv-gi, da-na-ti-ne-hv di-ni-yo-u-li, a-le di-ni-ge-wi, a-le tsu-nv-ge-wi, a-le go-hu-s-di u-s-dv di-ni-ye-lv tsu-ni-yo-hu-se-lv-hi, a-le u-ni-tsa-ti nv-wa-na-da-le-i, a-le Tsi-sa du-la-s-gv na-v du-ni-nv-nv-gi, du-nv-wa-nv-gi-no."
        intervals [61]:
            xmin = 451.640
            xmax = 453.660
            text = ""
        intervals [62]:
            xmin = 453.660
            xmax = 487.220
            text = "011531: Na-s-gi i-yu-s-di u-ni-tsa-ti ge-sv u-ni-s-qua-ni-go-sv-gi, du-ni-go-hv tsu-nv-ge-wi a-ni-wo-ni-s-go-i, a-le a-hu-s-di u-s-dv di-ni-ye-lv tsu-ni-yo-hu-se-lv-hi u-ni-no-s-dv nu-na-li-s-ta-nv-i, a-le di-di-yo-u-li, gv-wa-ne-da-s-di nu-li-s-ta-nv-i a-le di-ni-ge-wi gv-wa-ni-go-wa-dv-di nu-li-s-ta-nv-i; u-ni-lv-quo-ta-nv-gi-no U-ne-la-nv-hi I-si-li u-na-tse-li-ga."
        intervals [63]:
            xmin = 487.220
            xmax = 488.575
            text = ""
        intervals [64]:
            xmin = 488.575
            xmax = 524.380
            text = "011532: Tsi-sa-no wi-du-ya-nv-hv gv-wa-s-da-wa-di-do-hi, hi-a nu-we-sv-gi; ga-tsi-ya-do-li-ga hi-a u-ni-tsa-ti ge-sv-i, tso-i-ye-no na-do-da-qua a-ni ge-do-hv a-ne-do-ha, a-le v-tla yi-ni-ye-ha u-na-li-s-da-yv-di.  A-le i-tla ya-qua-du-li-ha do-u-ne-nv-s-di-yi di-gv-wa-ni-yo-si-s-gi, wa-na-ye-no yi-da-ni-wa-ni-ga-lo-gi wa-na-i-sv-i."
        intervals [65]:
            xmin = 524.380
            xmax = 528.840
            text = ""
        intervals [66]:
            xmin = 528.840
            xmax = 542.890
            text = "011533: Gv-wa-s-da-wa-di-do-hi-no hi-a nv-gv-wa-we-se-lv-gi; Ha-tlv-no yo-tsi-gi na-s-gi i-ga-i a-li-s-da-yv-di i-na-ge-i, na-s-gi i-yu-ni-tsa-ti ye-li tsu-no-lv-hi-s-di?"
        intervals [67]:
            xmin = 542.890
            xmax = 544.380
            text = ""
        intervals [68]:
            xmin = 544.380
            xmax = 556.930
            text = "011534: Tsi-sa-no hi-a ni-du-we-se-lv-gi; I-la-go ga-du de-tsi-ye-ha?  Ga-li-quo-gi, i-lv-s-gi-no tsu-na-s-di a-tsa-di, u-na-dv-nv-gi."
        intervals [69]:
            xmin = 556.930
            xmax = 558.485
            text = ""
        intervals [70]:
            xmin = 558.485
            xmax = 563.360
            text = "011535: U-ni-tsa-ti-no du-ne-tse-lv-gi ga-do-hi u-na-nv-di-yi."
        intervals [71]:
            xmin = 563.360
            xmax = 564.710
            text = ""
        intervals [72]:
            xmin = 564.710
            xmax = 582.485
            text = "011536: Ga-li-quo-gi-no ga-du du-gi-sv-gi a-le du-ne-sv a-tsa-di, u-li-he-li-tsv-no, du-gv-ha-lu-yv-gi, a-le gv-wa-s-da-wa-di-do-hi wi-du-ne-lv-gi, gv-wa-s-da-wa-di-do-hi-no u-ni-tsa-ti wi-du-ni-ne-lv-gi."
        intervals [73]:
            xmin = 582.485
            xmax = 583.260
            text = ""
        intervals [74]:
            xmin = 583.260
            xmax = 596.930
            text = "011537: A-le ni-ga-dv u-na-li-s-da-yv-nv-gi, a-le du-no-lv-sv-gi.  A-le u-nu-te-sv-gi u-li-gv-ha-lu-yv-hi ga-li-quo-gi i-ya-ka-li-i ta-lu-tsa."
        intervals [75]:
            xmin = 596.930
            xmax = 597.805
            text = ""
        intervals [76]:
            xmin = 597.805
            xmax = 610.250
            text = "011538: U-na-li-s-da-yv-hi-no nv-gi-ha i-ya-ga-yv-li na-ni-v-gi a-ni-s-ga-ya, ni-da-ne-tlv-dv-na a-ni-ge-yv a-le di-ni-yo-li."
        intervals [77]:
            xmin = 610.250
            xmax = 610.820
            text = ""
        intervals [78]:
            xmin = 610.820
            xmax = 621.240
            text = "011539: A-le u-ni-tsa-ti du-ye-li-hi-s-ta-nv-gi, a-le tsi-yu-hi wu-tsa-nv-gi, a-le ma-gi-de-li wu-na-nu-go-tsv-gi."
