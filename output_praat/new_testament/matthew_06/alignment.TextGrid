item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 614.940
        intervals: size = 68
        intervals [1]:
            xmin = 0.000
            xmax = 4.705
            text = ""
        intervals [2]:
            xmin = 4.705
            xmax = 23.990
            text = "010601: I-tse-ya-ta-he-s-di tle-s-di yi-tsa-da-ne-he-s-di a-ni-ga-ta-hv yv-wi ge-tsi-go-wa-dv-di-yi-quo yi-tsi-ye-lv-s-ge-s-di, i-yu-ye-no na-s-gi-quo yi-nu-s-di v-tla yv-ge-tsa-gu-yv-si I-tsi-do-da ga-lv-la-di e-hi."
        intervals [3]:
            xmin = 23.990
            xmax = 25.120
            text = ""
        intervals [4]:
            xmin = 25.120
            xmax = 53.220
            text = "010602: Na-s-gi i-yu-s-di i-yu-no ha-da-ne-he-s-di tle-s-di a-tse-lu-gi i-gv-yi wi-yi-no-yv-li-s-di-s-ge-s-di na-s-gi tsi-na-na-dv-ne-ho u-na-tlo-na-s-di tsu-la-wi-i-s-di-yi a-le e-na-i-da-s-di-yi de-ga-la-nv-dv-i, yv-wi-quo gv-wa-ni-lv-quo-do-di-yi tsu-ni-ye-lv-so-i; u-do-hi-yu-hi-ya i-tsv-yo-se-ha, ge-ga-gu-yv-e-lv."
        intervals [5]:
            xmin = 53.220
            xmax = 54.095
            text = ""
        intervals [6]:
            xmin = 54.095
            xmax = 63.605
            text = "010603: Ni-hi-s-gi-ni ha-da-ne-he-s-di tle-s-di tso-ye-ni hi-ga-s-ga-ni u-do-le-ho-sv hi-ga-ti-si tso-ye-ni na-dv-ne-hv-i."
        intervals [7]:
            xmin = 63.605
            xmax = 64.790
            text = ""
        intervals [8]:
            xmin = 64.790
            xmax = 78.210
            text = "010604: Na-s-gi-no ha-da-ne-hv u-de-li-sv ge-se-s-di, Tsa-do-da-no u-de-li-sv a-go-wa-ti-s-gi u-wa-sv a-se tsa-gu-yv-e-di ge-se-s-di gv-ni-ge-sv-i."
        intervals [9]:
            xmin = 78.210
            xmax = 79.390
            text = ""
        intervals [10]:
            xmin = 79.390
            xmax = 109.905
            text = "010605: I-yu a-le ha-da-do-li-s-di-s-ge-s-di, a-ha tle-s-di nu-na-s-dv u-na-tlo-na-s-di yi-ni-tsa-s-de-s-di; na-s-gi-ye-no o-so u-ni-ye-lv-so u-na-da-do-li-s-do-di-yi u-na-le-di-yi di-ga-la-wi-i-s-di-yi a-le du-nv-si-ya-nv de-ga-la-nv-dv e-na-i-da-s-di-yi, yv-wi-quo gv-wa-ni-go-wa-dv-di-yi u-na-du-li-s-go-i.  U-do-hi-yu-hi-ya i-tsv-yo-se-ha, ge-ga-gu-yv-e-lv."
        intervals [11]:
            xmin = 109.905
            xmax = 110.370
            text = ""
        intervals [12]:
            xmin = 110.370
            xmax = 135.285
            text = "010606: Ni-hi-s-gi-ni i-yu-no ta-da-do-li-s-ta-ni-se-s-di wi-yv-hi-he-s-di ka-nv-su-lv-i, hna-quo-no tsa-s-du-ne-s-di ga-lo-hi-s-di-yi, hi-ya-da-do-li-s-da-ne-he-s-di tsa-do-da u-de-li-sv e-hi, tsa-do-li-no u-de-li-sv a-go-wa-ti-s-gi a-se tsa-gu-yv-e-di ge-se-s-di gv-ni-ge-sv-i."
        intervals [13]:
            xmin = 135.285
            xmax = 136.040
            text = ""
        intervals [14]:
            xmin = 136.040
            xmax = 155.425
            text = "010607: A-se-no i-tsa-da-do-li-s-di-s-ge-s-di tle-s-di a-se-quo yi-tsv-gu-ti-lo-s-ge-s-di na-s-gi tsi-na-na-dv-ne-ho tsu-na-da-le-nv-dv yv-wi; u-tsa-ti-ye-no o-tsi-ne-gv u-da-ga-li-s-do-ta-ni da-yo-ga-dv-ga-ne-li a-ne-li-s-go-i."
        intervals [15]:
            xmin = 155.425
            xmax = 156.205
            text = ""
        intervals [16]:
            xmin = 156.205
            xmax = 169.730
            text = "010608: Ni-hi-s-gi-ni tle-s-di na-s-gi nu-na-s-dv yi-ni-tsa-s-de-s-di, I-tsi-do-da-ye-no a-ga-ta-ho i-yu-s-di i-tsi-ni-gv-gv a-si-quo ne-tsi-ta-yo-se-lv-na tsi-ge-so-i."
        intervals [17]:
            xmin = 169.730
            xmax = 170.860
            text = ""
        intervals [18]:
            xmin = 170.860
            xmax = 183.020
            text = "010609: Ni-hi-s-gi-ni i-tsa-da-do-li-s-di-s-gv hi-a nu-s-de-s-di; O-gi-do-da ga-lv-la-di ge-hi, ga-lv-quo-di-yu ge-se-s-di de-tsa-do-v-i."
        intervals [19]:
            xmin = 183.020
            xmax = 184.640
            text = ""
        intervals [20]:
            xmin = 184.640
            xmax = 194.170
            text = "010610: Tsa-gv-wi-yu-hi ge-sv wi-ga-na-nu-go-i.  A-ni e-lo-hi wi-ni-ga-li-s-da ha-da-nv-te-s-gv-i, na-s-gi-ya ga-lv-la-di tsi-ni-ga-li-s-di-ha."
        intervals [21]:
            xmin = 194.170
            xmax = 195.720
            text = ""
        intervals [22]:
            xmin = 195.720
            xmax = 200.560
            text = "010611: Ni-da-do-da-qui-sv o-ga-li-s-da-yv-di s-gi-v-si go-hi i-ga."
        intervals [23]:
            xmin = 200.560
            xmax = 201.855
            text = ""
        intervals [24]:
            xmin = 201.855
            xmax = 208.305
            text = "010612: Di-ge-s-gi-v-si-quo-no de-s-gi-du-gv-i, na-s-gi-ya tsi-di-ga-yo-tsi-ne-ho tso-tsi-du-gi."
        intervals [25]:
            xmin = 208.305
            xmax = 209.960
            text = ""
        intervals [26]:
            xmin = 209.960
            xmax = 231.770
            text = "010613: A-le tle-s-di u-da-go-li-ye-di-yi ge-sv wi-di-s-gi-ya-ti-nv-s-ta-nv-gi, s-gi-yu-da-le-s-ge-s-di-quo-s-gi-ni u-tsi ge-sv-i.  Tsa-tse-li-ga-ye-no tsa-gv-wi-yu-hi ge-sv-i, a-le tsa-li-ni-gi-di-yi ge-sv-i, a-le e-tsa-lv-quo-di-yu ge-sv ni-go-hi-lv-i.  E-me-nv."
        intervals [27]:
            xmin = 231.770
            xmax = 233.455
            text = ""
        intervals [28]:
            xmin = 233.455
            xmax = 243.845
            text = "010614: I-yu-ye-no yv-wi ge-tsi-s-ga-nv-tse-hv yi-di-ge-tsi-ne-ha, na-s-quo i-tsi-do-da ga-lv-la-di e-hi i-tsi-do-li-s-di ge-se-s-di."
        intervals [29]:
            xmin = 243.845
            xmax = 244.820
            text = ""
        intervals [30]:
            xmin = 244.820
            xmax = 255.270
            text = "010615: I-yu-s-gi-ni ni-di-ge-tsi-ne-hv-na yi-gi yv-wi ge-tsi-s-ga-nv-tse-hv-i, na-s-quo I-tsi-do-da v-tla yi-do-ge-tsi-hv-si i-tsi-s-ga-nv-tsv-i."
        intervals [31]:
            xmin = 255.270
            xmax = 256.800
            text = ""
        intervals [32]:
            xmin = 256.800
            xmax = 288.985
            text = "010616: A-le na-s-quo a-ma-tli i-tsv-s-ge-s-di, tle-s-di nv-na-tlo-na-s-di nu-na-s-dv yi-ni-tsa-s-de-s-di, u-na-da-do-li-s-di tsi-ge-so di-ka-no-di-yi, ni-da-tse-lv-na-ye-no ni-da-nv-ne-ho du-na-ka-dv-i, yv-wi-quo u-na-do-le-ho-hi-s-di-yi u-na-du-li-s-go a-ma-tli a-nv-s-gv-i.  U-do-hi-yu-hi-ya ni-tsv-we-se-ha ge-ga-gu-yv-e-lv."
        intervals [33]:
            xmin = 288.985
            xmax = 289.955
            text = ""
        intervals [34]:
            xmin = 289.955
            xmax = 298.360
            text = "010617: Ni-hi-s-gi-ni a-ma-tli hv-s-ge-s-di, ha-tlo-ne-s-ge-s-di, a-le ha-gv-s-quo-s-ge-s-di,"
        intervals [35]:
            xmin = 298.360
            xmax = 299.725
            text = ""
        intervals [36]:
            xmin = 299.725
            xmax = 320.085
            text = "010618: Na-s-gi tle-s-di yv-wi-quo ge-tsa-do-le-ho-hi-se-di-yi yi-tsa-ye-li-se-s-di a-ma-tli tsv-sv-i, Tsa-do-da-s-gi-ni u-de-li-sv e-hi, Tsa-do-da-no u-de-li-sv a-go-wa-ti-s-gi, a-se tsa-gu-yv-e-di gv-ni-ge-sv-i."
        intervals [37]:
            xmin = 320.085
            xmax = 321.430
            text = ""
        intervals [38]:
            xmin = 321.430
            xmax = 338.965
            text = "010619: Tle-s-di tsu-gv-wa-lo-di e-lo-hi yi-tsi-tli-si-s-ge-s-di, tsi-s-go-yv a-le a-ya-s-dla-di-s-gi u-ni-yo-s-do-di-yi a-le a-ni-no-s-gi-s-gi u-ni-yv-s-di-yi a-le u-ni-no-s-gi-s-di-yi;"
        intervals [39]:
            xmin = 338.965
            xmax = 339.840
            text = ""
        intervals [40]:
            xmin = 339.840
            xmax = 359.420
            text = "010620: Ga-lv-la-di-s-gi-ni wi-tsi-tli-si-s-ge-s-di tsu-gv-wa-lo-di, na-hna-ni tsi-s-go-yv a-ya-s-dla-di-s-gi-no u-ni-yo-s-do-di-yi ni-ge-sv-na ge-sv-i, a-le a-ni-no-s-gi-s-gi u-ni-yv-s-di-yi a-le u-ni-no-s-gi-s-di-yi ni-ge-sv-na ge-sv-i."
        intervals [41]:
            xmin = 359.420
            xmax = 360.965
            text = ""
        intervals [42]:
            xmin = 360.965
            xmax = 366.725
            text = "010621: Na-hna-ye-no tsu-gv-wa-lo-di wi-tsi-hv-i a-se na-s-quo wi-da-he-s-di di-tsa-da-nv-do."
        intervals [43]:
            xmin = 366.725
            xmax = 367.650
            text = ""
        intervals [44]:
            xmin = 367.650
            xmax = 382.170
            text = "010622: A-ga-ta a-ye-lv i-ga ga-ti-s-di-s-gi, i-yu-s-gi-ni hi-ga-do-li go-hu-s-di nu-s-dv-na ge-se-s-di, ni-gv hi-ye-lv-i u-ka-li-tso-nv-hi ge-se-s-di i-ga-ga-ti."
        intervals [45]:
            xmin = 382.170
            xmax = 383.230
            text = ""
        intervals [46]:
            xmin = 383.230
            xmax = 402.910
            text = "010623: I-yu-s-gi-ni hi-ga-do-li u-yo i-ge-se-s-di, ni-gv hi-ye-lv-i u-ka-li-tso-nv-hi ge-se-s-di u-li-si-gi.  I-yu-s-gi-ni-no i-ga-ga-ti ha-wi-ni tse-hv u-li-si-gi-quo i-ge-se-s-di, na-s-gi u-li-si-gi ni-ga e-quo-hi-yu!"
        intervals [47]:
            xmin = 402.910
            xmax = 403.765
            text = ""
        intervals [48]:
            xmin = 403.765
            xmax = 430.510
            text = "010624: V-tla gi-lo ye-li a-ni-ta-li gv-wa-na-tla-i go-hu-s-di yi-do-gv-dv-ni-si, yi-a-s-ga-ga-ye-no sa-quo yi-nv-ge-yu-ha-no so-i, a-le yi-do-u-ni-yv-ha sa-quo yi-ga-ni-qua-ti-ha-no so-i.  Tla-s-gi-ni ye-li U-ne-la-nv-hi a-le Ma-ma-ni go-hu-s-di-yi-do-ge-tsa-dv-ni-si."
        intervals [49]:
            xmin = 430.510
            xmax = 431.740
            text = ""
        intervals [50]:
            xmin = 431.740
            xmax = 461.880
            text = "010625: Na-s-gi i-yu-s-di hi-a ni-tsv-we-se-ha, Tle-s-di yi-tse-li-hi-s-ge-s-di de-tsv-nv-i, i-yu-s-di i-tsi-gi-s-di-yi a-le i-yu-s-di i-tsa-di-ta-s-di-yi, tle-s-di a-le di-tsi-ye-lv-i yi-tse-li-hi-s-ge-s-di i-yu-s-di di-tsa-nu-wo-s-di-yi.  Tla-s-go a-gv-nv u-tli-hi-yu yi-gi e-s-ga-quo a-li-s-da-yv-di?  A-le tla-s-go a-ye-lv-i e-s-ga-quo di-nu-wo?"
        intervals [51]:
            xmin = 461.880
            xmax = 463.080
            text = ""
        intervals [52]:
            xmin = 463.080
            xmax = 489.940
            text = "010626: Di-tsa-ka-nv-ga tsi-s-qua ga-lv-lo-i a-ne-hi, tla-ye-no ya-ni-wi-s-go-i, a-le tla ya-ni-ne-tsa-i-s-go-i, tla a-le da-da-ne-lv ya-ni-tli-si-s-go-i, a-se-no I-tsi-do-da ga-lv-la-di e-hi do-ge-lo-ho-i.  Tla-s-go ni-hi u-tli yi-ne-tsi-lv-quo-di e-s-ga-quo na-s-gi?"
        intervals [53]:
            xmin = 489.940
            xmax = 490.855
            text = ""
        intervals [54]:
            xmin = 490.855
            xmax = 502.645
            text = "010627: Ga-go-no ni-hi tsi-ni-tsa-dv-nv u-da-su-ya u-we-li-hi-s-gv-quo ye-li sa-quo i-yu-tli-lo-dv yi-ka-ne-quo-tsa gv-nv-i?"
        intervals [55]:
            xmin = 502.645
            xmax = 503.950
            text = ""
        intervals [56]:
            xmin = 503.950
            xmax = 521.590
            text = "010628: A-le ga-do-no di-nu-wo do-tse-li-hi-s-go-i?  Di-tsa-da-nv-dv-li tsu-tsi-lv-hi tlo-ge-si tse-hi da-dv-s-gv-i.  V-tla yi-du-ni-lv-wi-s-da-ne-ho-i, a-le v-tla ya-ni-s-do-ho-i."
        intervals [57]:
            xmin = 521.590
            xmax = 522.430
            text = ""
        intervals [58]:
            xmin = 522.430
            xmax = 536.165
            text = "010629: A-se-no hi-a ni-tsv-we-se-ha, na-s-quo so-li-ma-nv ni-ga-v nu-wo-du-sv-i tla na-s-gi yi-nu-s-de du-nu-wv-i sa-quo hi-a nu-s-dv-i."
        intervals [59]:
            xmin = 536.165
            xmax = 537.635
            text = ""
        intervals [60]:
            xmin = 537.635
            xmax = 559.535
            text = "010630: I-yu-ye-no U-ne-la-nv-hi na-s-gi yi-ni-gv-ne-ha yi-ga-nu-wo-ha ka-ne-s-ga tlo-ge-si e-hi, go-hi i-ga tse-ha, u-gi-tsv-nv-no di-ga-du-di-yi wu-na-di-nv-di tsi-gi, tla-s-go u-tli-hi-yu yi-ni-do-ge-tsi-nu-wo-tsa, u-s-di i-tso-hi-yu-hi?"
        intervals [61]:
            xmin = 559.535
            xmax = 560.490
            text = ""
        intervals [62]:
            xmin = 560.490
            xmax = 572.905
            text = "010631: Na-s-gi i-yu-s-di tle-s-di yi-tse-li-hi-s-ge-s-di hi-a yi-ni-tsi-we-s-ge-s-di; ga-do da-yo-tsi-gi, a-le ga-do da-yo-tsa-di-ta-hi, a-le ga-do da-yo-tsa-nu-wo-i?"
        intervals [63]:
            xmin = 572.905
            xmax = 573.830
            text = ""
        intervals [64]:
            xmin = 573.830
            xmax = 587.650
            text = "010632: Ni-ga-dv-ye-no na-s-gi hi-a u-ni-yo-ho Tsu-na-te-le-nv-dv yv-wi.  Ga-lv-la-di-ye-no e-hi I-tsi-do-da a-ga-ta-ha na-s-gi hi-a ni-ga-dv i-tsi-ni-gv-se-hv-i."
        intervals [65]:
            xmin = 587.650
            xmax = 588.330
            text = ""
        intervals [66]:
            xmin = 588.330
            xmax = 598.715
            text = "010633: I-gv-yi-s-gi-ni i-tsi-yo-ga ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv a-le u-tse-li du-yu-go-dv-i, hi-a-no ni-ga-di-yu da-ye-tsi-ne-quo-e-li."
        intervals [67]:
            xmin = 598.715
            xmax = 599.590
            text = ""
        intervals [68]:
            xmin = 599.590
            xmax = 614.940
            text = "010634: Na-s-gi i-yu-s-di tle-s-di u-gi-tsv-nv i-yv-dv yi-wi-tse-li-hi-s-ge-s-di, u-gi-tsv-nv-ye-no u-wa-sv tsu-da-le-nv-dv dv-de-li-hi-s-ta-ni.  Ye-li-quo u-yo i-ga u-we-hv-i."
