item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 622.525
        intervals: size = 70
        intervals [1]:
            xmin = 0.000
            xmax = 3.335
            text = ""
        intervals [2]:
            xmin = 3.335
            xmax = 15.270
            text = "011801: Na-hi-yu Tsi-sa gv-wa-lu-tse-lv gv-wa-s-da-wa-di-do-hi, hi-a ni-gv-wa-we-se-lv-gi; Ga-go u-tli-a tsi-lv-quo-di-yu na-hna ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv-i."
        intervals [3]:
            xmin = 15.270
            xmax = 16.450
            text = ""
        intervals [4]:
            xmin = 16.450
            xmax = 23.490
            text = "011802: Tsi-sa-no a-yo-li wu-ya-nv-hv a-ye-li a-ni-nv u-we-ka-nv-gi, a-le hi-a nu-we-sv-gi;"
        intervals [5]:
            xmin = 23.490
            xmax = 24.430
            text = ""
        intervals [6]:
            xmin = 24.430
            xmax = 41.090
            text = "011803: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; I-yu-no ni-tsa-da-ne-tli-yv-sv-na i-ge-se-s-di, a-le di-ni-yo-li tsi-nu-na-s-di ni-tsa-li-s-ta-nv-na i-ge-se-s-di, v-tla ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv yv-ge-tsi-yv-ha."
        intervals [7]:
            xmin = 41.090
            xmax = 42.230
            text = ""
        intervals [8]:
            xmin = 42.230
            xmax = 55.730
            text = "011804: Na-s-gi i-yu-s-di gi-lo u-da-do-li-s-di ge-se-s-di na-s-gi-ya hi-a a-yo-li, na-s-gi u-tli a-tsi-lv-quo-di-yu ge-se-s-di na-hna ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv-i."
        intervals [9]:
            xmin = 55.730
            xmax = 56.640
            text = ""
        intervals [10]:
            xmin = 56.640
            xmax = 67.920
            text = "011805: A-le gi-lo da-da-ni-lv-ge-s-di sa-quo na-s-gi hi-a i-yu-s-di a-yo-li da-qua-do-v nv-di-ga-li-s-do-di-s-ge-s-di, a-yv da-qua-da-ni-lv-ge-s-di."
        intervals [11]:
            xmin = 67.920
            xmax = 68.850
            text = ""
        intervals [12]:
            xmin = 68.850
            xmax = 87.740
            text = "011806: Gi-lo-s-gi-ni de-go-de-s-di-s-ge-s-di sa-quo hi-a tsu-na-s-di-ga ge-sv na-s-gi gv-quo-hi-yu-hv-s-gi, u-tli o-si-yu a-s-do-s-gi nv-ya ya-tsi-ya-tla-nv, a-le a-s-dv-gv a-me-quo-hi ya-tsi-gv-yv."
        intervals [13]:
            xmin = 87.740
            xmax = 88.810
            text = ""
        intervals [14]:
            xmin = 88.810
            xmax = 109.340
            text = "011807: U-ni-i-yu i-yu-li-s-da-ne-di ge-se-s-di e-lo-hi nv-di-ga-li-s-do-di-ha di-na-da-do-de-s-di-s-gi, a-se-ye-no di-na-da-do-de-s-di-s-gi u-ni-na-nu-go-i-s-di; a-se-no u-yo-i-yu i-yu-li-s-da-ne-di na-s-gi na a-s-ga-ya di-da-do-de-s-di-s-gi u-na-nu-go-wi-sv-hi."
        intervals [15]:
            xmin = 109.340
            xmax = 110.780
            text = ""
        intervals [16]:
            xmin = 110.780
            xmax = 145.340
            text = "011808: Na-s-gi i-yu-s-di i-yu-no tso-ye-ni a-le tsa-la-si-de-ni de-tso-de-s-di-s-ge-s-di, hi-s-qua-li-s-ge-s-di a-le wi-tsa-de-ge-s-di; u-tli o-si-yu i-tsa-li-s-da-ne-di tso-ye-ni a-le tsa-la-si-de-ni tsa-yo-hu-se-lv-hi yi-gi gv-ni-dv di-ge-sv wi-yi-tsa-yv-lv, a-no i-tsu-la yi-ti-ye-sa-da a-le i-tsu-la di-tsa-la-si-de-ni wi-ye-tsa-da-i-nv ni-gv-tlo-s-gv-na ge-sv a-tsi-lv-yi."
        intervals [17]:
            xmin = 145.340
            xmax = 146.140
            text = ""
        intervals [18]:
            xmin = 146.140
            xmax = 170.775
            text = "011809: I-yu a-le hi-ga-do-li de-tso-de-s-di-s-ge-s-di, ha-da-ga-te-do-i-s-ge-s-di a-le wi-tsa-de-ge-s-di; u-tli o-si-yu i-tsa-li-s-da-ne-di sa-quo yi-ka-hna gv-ni-dv di-ge-sv wi-yi-tsa-yv-lv, a-no i-tsu-la yi-ti-ka-hna tsv-s-gi-no-i a-tsi-lv-yi wi-ye-tsa-da-i-nv."
        intervals [19]:
            xmin = 170.775
            xmax = 172.500
            text = ""
        intervals [20]:
            xmin = 172.500
            xmax = 191.700
            text = "011810: I-tse-ya-ta-he-s-di tsi-ga-ye-tsi-so-tlv-ta-ni sa-quo hi-a tsu-na-s-di-ga; hi-a-ye-no ni-tsv-we-se-ha; Ga-lv-la-di tso-sv tsu-na-tse-li-ga di-ni-ka-hna-wa-di-do-hi ni-go-hi-lv a-ni-go-wa-ti-s-go u-ka-dv E-do-da ga-lv-la-di e-hi."
        intervals [21]:
            xmin = 191.700
            xmax = 192.510
            text = ""
        intervals [22]:
            xmin = 192.510
            xmax = 198.520
            text = "011811: Yv-wi-ye-no U-we-tsi u-lu-tsv u-s-de-lv-hi-lv u-le-na-lv-hi."
        intervals [23]:
            xmin = 198.520
            xmax = 199.420
            text = ""
        intervals [24]:
            xmin = 199.420
            xmax = 224.020
            text = "011812: Ga-do i-tse-li-ha; I-yu-no gi-lo a-s-ga-ya a-s-go-hi-tsu-qui a-wi yi-du-na-tla-a, sa-quo-no yu-le-yo-e-lv, tla-s-go so-o-ne-la-s-go-hi so-o-ne-la-ga-li i-ya-ni-dv yi-di-gv-de-go-i, a-le yi-di-ka-na-lu-si-do-ho ga-du-si yu-yo-ho u-le-yo-e-lv-hi?"
        intervals [25]:
            xmin = 224.020
            xmax = 225.080
            text = ""
        intervals [26]:
            xmin = 225.080
            xmax = 243.170
            text = "011813: I-yu-no a-wa-dv, u-do-hi-yu-hi-ya i-tsv-yo-se-ha, u-tli ni-ga-o a-li-he-li-go na-s-gi ge-sv i-yu-s-di, e-s-ga-quo so-o-ne-la-s-go-hi so-o-ne-la-ga-li i-ya-ni-dv nu-na-le-yo-v-na."
        intervals [27]:
            xmin = 243.170
            xmax = 244.520
            text = ""
        intervals [28]:
            xmin = 244.520
            xmax = 254.740
            text = "011814: Na-s-gi-ya na-s-quo v-tla yu-du-li I-tsi-do-da ga-lv-la-di e-hi, sa-quo hi-a tsu-na-s-di-ga ge-sv tsu-ni-yo-hu-hi-s-di-yi."
        intervals [29]:
            xmin = 254.740
            xmax = 256.100
            text = ""
        intervals [30]:
            xmin = 256.100
            xmax = 273.510
            text = "011815: I-yu-no di-s-da-da-nv-tli i-tsa-s-ga-nv-tse-he-s-di, he-ge-s-di hi-no-ne-he-s-di u-s-ga-nv-tsv i-s-dv-sv-quo ge-sv-i; i-yu-no i-tsa-dv-da-s-da-ne-he-s-di, hi-wa-dv-he-s-di di-s-da-da-nv-tli."
        intervals [31]:
            xmin = 273.510
            xmax = 274.770
            text = ""
        intervals [32]:
            xmin = 274.770
            xmax = 295.925
            text = "011816: I-yu-s-gi-ni-no ni-tsa-dv-da-s-da-ne-hv-na-quo i-ge-se-s-di, a-si-yv-wi a-le a-ni-ta-li de-ha-ti-ne-ge-s-di, na-s-gi-no a-ni-no-he-s-gv a-ni-ta-li a-le a-ni-tso-i a-ni-ga-ta-hi ni-ga-dv tsa-ne-tsv a-s-da-yo-s-ge-s-di."
        intervals [33]:
            xmin = 295.925
            xmax = 297.060
            text = ""
        intervals [34]:
            xmin = 297.060
            xmax = 323.255
            text = "011817: I-yu-no na-s-gi ni-da-dv-da-s-da-ne-hv-na-quo i-ge-se-s-di tsu-na-ne-lo-di u-na-da-tlu-gv hi-no-hv-s-ge-s-di; i-yu-s-gi-ni-no tsu-na-ne-lo-di u-na-da-tlu-gv ni-da-dv-da-s-da-ne-hv-na i-ge-se-s-di, nv-wa-da-le-quo yv-wi a-le a-ye-li-quo--a-de-lv a-gi-si-do-hi na-s-gi-ya hi-ya-da-nv-te-s-ge-s-di."
        intervals [35]:
            xmin = 323.255
            xmax = 324.845
            text = ""
        intervals [36]:
            xmin = 324.845
            xmax = 342.520
            text = "011818: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; Ni-ga-v go-hu-s-di i-tsa-lv-i-he-s-di e-lo-hi, ga-lv-s-di ge-se-s-di ga-lv-la-di; ni-ga-v-no go-hu-s-di i-tsa-lv-gi-s-ge-s-di e-lo-hi ga-lv-gi-s-di ge-se-s-di ga-lv-la-di."
        intervals [37]:
            xmin = 342.520
            xmax = 343.950
            text = ""
        intervals [38]:
            xmin = 343.950
            xmax = 367.360
            text = "011819: A-le-wo hi-a ni-tsv-we-se-ha; i-yu-no a-ni-ta-li ni-hi tsi-tse-do-ha a-na-li-go-hv-s-ge-s-di a-ni e-lo-hi ni-ga-v-quo go-hu-s-di a-ni-ta-yo-hi-he-s-di, na-s-gi i-yu-na-dv-ne-di ge-se-s-di E-do-da ga-lv-la-di e-hi."
        intervals [39]:
            xmin = 367.360
            xmax = 368.655
            text = ""
        intervals [40]:
            xmin = 368.655
            xmax = 380.815
            text = "011820: I-lv-hi-tlv-ye-no a-ni-ta-li a-le a-ni-tso-i tsi-da-ni-la-wi-o a-yv da-qua-do-v tsi-nv-di-ga-li-s-do-di-s-go-i, na-hna a-ye-li a-qua-da-su-yo-i."
        intervals [41]:
            xmin = 380.815
            xmax = 381.680
            text = ""
        intervals [42]:
            xmin = 381.680
            xmax = 396.560
            text = "011821: Hna-quo-no Qui-da u-lu-tse-lv hi-a nu-we-sv-gi; Tsa-gv-wi-yu-hi, i-la-go na-gi-s-ga-nv-tse-he-s-di tso-s-da-da-nv-tli, a-si-quo i-tsi-ya-do-li-ge-s-di?  Ga-li-quo-gi-s-go?"
        intervals [43]:
            xmin = 396.560
            xmax = 397.535
            text = ""
        intervals [44]:
            xmin = 397.535
            xmax = 407.060
            text = "011822: Tsi-sa hi-a nu-we-se-lv-gi; V-tla ga-li-quo-gi-quo yi-gv-yo-se-ha, ga-li-qua-s-go-hi-s-gi-ni ga-lv-quo-gi i-yu-lo-sv-hi."
        intervals [45]:
            xmin = 407.060
            xmax = 408.150
            text = ""
        intervals [46]:
            xmin = 408.150
            xmax = 422.890
            text = "011823: Na-s-gi i-yu-s-di ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv na-s-gi-ya-quo gi-lo U-gv-wi-yu-hi tsu-da-nv-te-le o-s-dv i-yu-nv-ne-di-yi du-du-gv tsu-nv-si-da-s-di."
        intervals [47]:
            xmin = 422.890
            xmax = 423.990
            text = ""
        intervals [48]:
            xmin = 423.990
            xmax = 435.225
            text = "011824: Hna-quo-no u-na-le-nv-hv o-s-dv nu-nv-ne-lv, sa-quo a-ga-ti-no-he-le a-s-go-hi i-yu-qua-di-nv-dv a-de-lv u-du-gi."
        intervals [49]:
            xmin = 435.225
            xmax = 436.310
            text = ""
        intervals [50]:
            xmin = 436.310
            xmax = 454.295
            text = "011825: A-se-no go-hu-s-di u-da-yv-do-di nu-hv-na ge-sv i-yu-s-di, u-na-tla-i u-ne-tse a-tsi-na-di-nv-di-yi a-le u-da-li-i a-le tsu-we-tsi a-le ni-ga-v go-hu-s-di u-hv-i, a-da-yv-di-yi-no."
        intervals [51]:
            xmin = 454.295
            xmax = 455.140
            text = ""
        intervals [52]:
            xmin = 455.140
            xmax = 470.895
            text = "011826: Na-s-gi i-yu-s-di a-tsi-nv-si-da-s-di e-la-di u-da-nv-ne-i, a-le u-da-do-li-s-da-ne-le-i, hi-a nu-we-se-i; S-gi-na-tla-i, s-gi-do-li-gi s-gi-ga-ti-da, ni-ga-dv-no da-gv-ya-gu-yv-e-li."
        intervals [53]:
            xmin = 470.895
            xmax = 472.110
            text = ""
        intervals [54]:
            xmin = 472.110
            xmax = 483.200
            text = "011827: Na-s-gi-no a-tsi-nv-si-da-s-di u-na-tla-i u-we-do-li-tse-i, a-le u-we-ka-ne-i, a-le u-du-gv u-ne-la-gi u-we-li-se-le-i."
        intervals [55]:
            xmin = 483.200
            xmax = 484.090
            text = ""
        intervals [56]:
            xmin = 484.090
            xmax = 510.135
            text = "011828: A-se-no na-s-gi na a-tsi-nv-si-da-s-di u-nu-go-tsv, u-wa-dv-he a-si-yv-wi i-tsu-la-ha ge-tsi-nv-si-da-s-di na-s-gi u-ne-tsv-hi u-gu-yv-e-di-yi a-s-go-hi-tsu-qui a-gi-si tsu-na-gv-wa-lo-di; u-ni-yv-he-no, a-le u-yv-s-gi-yv-he-i; s-qua-gu-yv-si tsi-gv-du-ga, u-dv-ne-i."
        intervals [57]:
            xmin = 510.135
            xmax = 511.040
            text = ""
        intervals [58]:
            xmin = 511.040
            xmax = 528.605
            text = "011829: I-tsu-la-ha-no ge-tsi-nv-si-da-s-di du-la-s-gv e-la-di u-da-nv-ne u-da-do-li-s-da-ne-le-i, hi-a nu-we-se-i; S-gi-do-li-gi s-gi-ga-ti-da, ni-ga-dv-no da-gv-ya-gu-yv-e-li."
        intervals [59]:
            xmin = 528.605
            xmax = 529.630
            text = ""
        intervals [60]:
            xmin = 529.630
            xmax = 544.640
            text = "011830: A-se-no v-tla yu-wo-hi-yu-ne-i, di-da-s-du-di-yi-quo wu-lo-se-i, a-le na-hna wu-yv-ta-ne u-gu-yv-di-yi a-tsi-du-gv i-go-hi-dv."
        intervals [61]:
            xmin = 544.640
            xmax = 545.625
            text = ""
        intervals [62]:
            xmin = 545.625
            xmax = 563.540
            text = "011831: Na-quo-no na-s-gi i-tsu-la-ha ge-tsi-nv-si-da-s-di u-na-do-le-ho-sv nu-li-s-ta-nv-i u-tsa-ti u-yo u-ni-ye-lv-ne-i, a-le u-ni-lu-tse u-ni-no-ne-le tsu-ni-na-tla-i ni-ga-dv nu-li-s-ta-ni-do-lv-i."
        intervals [63]:
            xmin = 563.540
            xmax = 564.390
            text = ""
        intervals [64]:
            xmin = 564.390
            xmax = 582.980
            text = "011832: Hna-quo-no u-na-tla-i wu-ya-nv-hv hi-a nu-we-se-le-i; tsa-ne-gu-tsi-dv gv-nv-si-da-s-di, u-ne-la-gi gv-ye-li-se-lv-gi ni-ga-dv ni-hi tsi-gv-du-gv-gi, s-gi-ta-yo-se-lv i-yu-s-di."
        intervals [65]:
            xmin = 582.980
            xmax = 583.440
            text = ""
        intervals [66]:
            xmin = 583.440
            xmax = 593.540
            text = "011833: Tla-s-go na-s-quo ni-hi ga-hi-ya-do-li-s-di yi-ge-se i-tsu-la-ha e-s-di-nv-si-da-s-di, na-s-gi-ya gv-ya-do-li-tsv-i?"
        intervals [67]:
            xmin = 593.540
            xmax = 594.190
            text = ""
        intervals [68]:
            xmin = 594.190
            xmax = 605.655
            text = "011834: U-ta-la-wu-se-no u-na-tla-i, a-le wi-du-yo-hi-se-le di-na-da-s-du-hv-s-gi u-gu-yv-ho-hv-s-di-yi ni-ga-dv a-tsi-du-gv i-go-hi-dv."
        intervals [69]:
            xmin = 605.655
            xmax = 606.440
            text = ""
        intervals [70]:
            xmin = 606.440
            xmax = 622.525
            text = "011835: Na-s-gi-ya na-s-quo nv-da-tsv-yv-ne-li e-do-da ga-lv-la-di e-hi, i-yu-no di-tsa-da-nv-dv i-yv-dv i-tsi-si-yv-wi-ha ge-sv ni-di-tsi-do-li-gv-na i-ge-se-s-di i-tsa-da-nv-tli u-ni-s-ga-nv-tsv-i."
