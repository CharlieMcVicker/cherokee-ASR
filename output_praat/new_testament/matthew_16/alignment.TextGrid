item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 473.830
        intervals: size = 57
        intervals [1]:
            xmin = 0.000
            xmax = 4.200
            text = ""
        intervals [2]:
            xmin = 4.200
            xmax = 17.975
            text = "011601: A-ni-qua-li-si-no a-le A-ni-sa-du-si u-ni-lu-tsv-gi, gv-wa-go-li-ye-s-gv-no gv-wa-ta-yo-se-lv-gi tsu-na-nu-go-wi-se-di-yi u-ye-lv-dv ga-lv-la-di nv-da-yu-lo-sv-hi."
        intervals [3]:
            xmin = 17.975
            xmax = 19.410
            text = ""
        intervals [4]:
            xmin = 19.410
            xmax = 31.355
            text = "011602: U-ne-tsv-no hi-a ni-du-we-se-lv-gi; U-sv-ni-ga-li-s-da hi-a ni-tsi-we-s-go-i; u-lv-ga-li-yi-sa-dv ge-se-s-di, ga-lv-lo-ye-no gi-ga-ge-i-yu i-gi."
        intervals [5]:
            xmin = 31.355
            xmax = 32.085
            text = ""
        intervals [6]:
            xmin = 32.085
            xmax = 64.360
            text = "011603: Su-na-le-no tsi-ge-so-i, Go-hi i-ga tsi-gi dv-ga-hna-ni, ga-lv-lo-ye-no gi-ga-ge-i-yu i-gi, a-le i-ga-lo-gi-li-ye-ha, i-tsa-di-s-go-i.  I-tsa-tlo-na-s-di, ye-li-quo i-tsa-do-le-ho-s-go nu-s-dv ga-lv-lo-i, tla-s-go-no ye-li ge-tsa-do-le-ho-hi-s-di yi-gi u-ye-lv-dv i-yu li-s-ta-ni-da-s-di ge-sv-i?"
        intervals [7]:
            xmin = 64.360
            xmax = 65.230
            text = ""
        intervals [8]:
            xmin = 65.230
            xmax = 85.900
            text = "011604: U-ni-yo a-le u-ni-ne-gu-tsi-dv tsa-ne-ha u-ni-yo-ho u-ye-lv-dv-i, a-se-no v-tla yv-ga-ge-ga-li-s-go-lv-da-si u-ye-lv-dv-i, Tso-na a-do-le-ho-s-gi u-tse-li u-ye-lv-dv u-wa-sv.  Du-da-nv-e-lv-no u-ni-gi-sv-gi."
        intervals [9]:
            xmin = 85.900
            xmax = 86.660
            text = ""
        intervals [10]:
            xmin = 86.660
            xmax = 92.575
            text = "011605: Gv-wa-s-da-wa-di-do-hi-no du-ni-so-tsv u-nv-ge-wi-sv-hi ge-sv-gi u-na-de-no-di-yi."
        intervals [11]:
            xmin = 92.575
            xmax = 93.100
            text = ""
        intervals [12]:
            xmin = 93.100
            xmax = 101.990
            text = "011606: Tsi-sa-no hi-a ni-du-we-se-lv-gi; I-tse-ya-ta-he-s-di a-go-do-di A-ni-qua-li-si a-le A-ni-sa-du-si u-na-tse-li-ga."
        intervals [13]:
            xmin = 101.990
            xmax = 102.635
            text = ""
        intervals [14]:
            xmin = 102.635
            xmax = 111.740
            text = "011607: U-ni-no-he-lv-gi-no ge-sv u-nv-sv, hi-a nu-ni-we-sv-gi; Ni-ga-de-nv-na tsi-gi nv-di-ga-li-s-do-di-ha."
        intervals [15]:
            xmin = 111.740
            xmax = 112.825
            text = ""
        intervals [16]:
            xmin = 112.825
            xmax = 126.890
            text = "011608: Tsi-sa-no na-s-gi u-do-le-ho-sv hi-a ni-du-we-se-lv-gi; U-s-di i-tso-hi-yu-hi, ga-do-no i-tsv-sv ge-sv i-tsi-no-he-ha a-li-s-da-yv-di ni-tsi-ye-hv-na ge-sv-i?"
        intervals [17]:
            xmin = 126.890
            xmax = 127.480
            text = ""
        intervals [18]:
            xmin = 127.480
            xmax = 141.920
            text = "011609: Tla-s-go a-si yi-tso-li-ga, a-le tla-s-go yi-tsa-nv-ta hi-s-gi ga-du a-le hi-s-gi i-ya-ga-yv-li tsi-na-ni-v-gi, a-le i-ya-ka-li-i ta-lu-tsa i-tsu-te-sv-i?"
        intervals [19]:
            xmin = 141.920
            xmax = 142.695
            text = ""
        intervals [20]:
            xmin = 142.695
            xmax = 152.080
            text = "011610: A-le ga-li-quo-gi ga-du nv-gi-no i-ya-ga-yv-li tsi-na-ni-v-gi, a-le i-ya-ka-li-i ta-la-tsa i-tsu-te-sv-i?"
        intervals [21]:
            xmin = 152.080
            xmax = 153.750
            text = ""
        intervals [22]:
            xmin = 153.750
            xmax = 173.965
            text = "011611: Ga-do di-ga-li-s-do-di ni-tso-li-gv-na tsi-gi, na-s-gi hi-a tsi-ni-tsv-we-si tla-s-gi-ni ga-du yi-tsi-dv-ga, i-tse-ya-ta-he-s-di a-go-do-di A-ni-qua-li-si A-le A-ni-sa-du-si u-na-tse-li-ga, tsi-tsv-yo-si?"
        intervals [23]:
            xmin = 173.965
            xmax = 175.510
            text = ""
        intervals [24]:
            xmin = 175.510
            xmax = 189.555
            text = "011612: Hna-quo-no u-no-li-tsv-gi nu-ni-ne-tse-hv-na ge-sv u-ne-ya-do-i-s-di-yi ga-du a-go-do-di, da-na-de-yo-hv-s-gv-s-gi-ni A-ni-qua-li-si a-le A-ni-sa-du-si."
        intervals [25]:
            xmin = 189.555
            xmax = 191.020
            text = ""
        intervals [26]:
            xmin = 191.020
            xmax = 206.455
            text = "011613: Tsi-sa-no u-lu-tsv Si-sa-li-yi Que-li-gi-yi, du-dv-dv-nv-gi gv-wa-s-da-wa-di-do-hi, hi-a ni-du-we-se-lv-gi; A-yv yv-wi U-we-tsi tsi-gi ga-go gv-quo-se-ho yv-wi?"
        intervals [27]:
            xmin = 206.455
            xmax = 207.320
            text = ""
        intervals [28]:
            xmin = 207.320
            xmax = 223.595
            text = "011614: Hi-a-no nu-ni-we-sv-gi; I-ga-dv Tsa-ni di-da-wo-s-gi [ge-tso-se-ho-i,] i-ga-dv-no I-la-ya, a-ni-so-i-no Tse-li-ma-ya a-le gi-lo i-yu-s-di a-na-do-le-ho-s-gi ge-sv-i."
        intervals [29]:
            xmin = 223.595
            xmax = 224.735
            text = ""
        intervals [30]:
            xmin = 224.735
            xmax = 230.305
            text = "011615: Hi-a-no ni-du-we-se-lv-gi; ni-hi-na-no ga-go s-gi-yo-se-ha?"
        intervals [31]:
            xmin = 230.305
            xmax = 231.300
            text = ""
        intervals [32]:
            xmin = 231.300
            xmax = 239.300
            text = "011616: Sa-wa-ni-no Qui-da u-ne-tsv hi-a nu-we-sv-gi; Ga-lo-ne-dv ni-hi, gv-ni-dv U-ne-la-nv-hi U-we-tsi."
        intervals [33]:
            xmin = 239.300
            xmax = 241.175
            text = ""
        intervals [34]:
            xmin = 241.175
            xmax = 259.405
            text = "011617: Tsi-sa-no u-ne-tsv hi-a nu-we-se-lv-gi; O-si-yu i-tsa-li-s-da-ne-di ni-hi Sa-wa-ni Tso-na u-we-tsi; v-tla-ye-no u-que-da-li a-le gi-gv na-s-gi yi-tsa-na-nu-go-wi-se-lv, E-do-da-s-gi-ni ga-lv-la-di e-hi."
        intervals [35]:
            xmin = 259.405
            xmax = 260.445
            text = ""
        intervals [36]:
            xmin = 260.445
            xmax = 281.210
            text = "011618: A-yv-no hi-a ni-gv-we-se-ha; Qui-da ni-hi a-le na-s-gi a-ni hi-a nv-yo-hi da-ga-ne-s-ge-hi a-qua-tse-li tsu-na-ne-lo-di u-na-da-tlu-gv-i, a-le tsv-s-gi-no-i da-s-du-hv-i e-s-ga i-yu-nv-ne-di ni-ge-sv-na ge-se-s-di."
        intervals [37]:
            xmin = 281.210
            xmax = 282.415
            text = ""
        intervals [38]:
            xmin = 282.415
            xmax = 305.940
            text = "011619: A-le di-s-du-i-s-di ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv tsu-tse-li do-da-gv-de-li, ni-ga-v-no go-hu-s-di ha-lv-i-he-s-di e-lo-hi, ga-lv-s-di ge-se-s-di ga-lv-la-di, ni-ga-v-no go-hu-s-di ha-lv-gi-s-ge-s-di e-lo-hi ga-lv-gi-s-di ge-se-s-di ga-lv-la-di."
        intervals [39]:
            xmin = 305.940
            xmax = 306.980
            text = ""
        intervals [40]:
            xmin = 306.980
            xmax = 315.855
            text = "011620: Hna-quo-no du-nv-s-da-de-lv-gi gv-wa-s-da-wa-di-do-hi gi-lo u-ni-no-ne-di-yi na-s-gi u-wa-sv Ga-lo-ne-dv ge-sv-i."
        intervals [41]:
            xmin = 315.855
            xmax = 316.620
            text = ""
        intervals [42]:
            xmin = 316.620
            xmax = 341.555
            text = "011621: Hna-quo-no Tsi-sa u-le-nv-hv-gi du-no-ne-lv-gi gv-wa-s-da-wa-di-do-hi a-se u-we-nv-s-di-yi ge-sv Tsi-lu-si-li-mi, A-le tsu-da-le-nv-dv tsu-gi-li-yo-tse-di-yi di-ni-la-wi-gi a-le nu-ni-gv-wi-yu-sv a-tsi-lv-a-ne-lo-hi a-le di-no-we-li-s-gi; a-le a-tsi-i-s-di-yi, a-le tso-i-ne i-ga tsu-le-di-yi."
        intervals [43]:
            xmin = 341.555
            xmax = 342.400
            text = ""
        intervals [44]:
            xmin = 342.400
            xmax = 357.940
            text = "011622: Hna-quo-no Qui-da i-yv-dv wu-ti-nv-s-ta-nv u-le-nv-hv-gi u-da-nv-s-da-de-lv-gi, hi-a nu-we-sv-gi, U-ne-la-nv-hi wu-nv-s-do-hi, Tsa-gv-wi-yu-hi, v-tla na-s-gi yi-nv-ge-tsa-li-s-da-si."
        intervals [45]:
            xmin = 357.940
            xmax = 359.040
            text = ""
        intervals [46]:
            xmin = 359.040
            xmax = 379.505
            text = "011623: U-ga-ta-hv-sv-no hi-a na-tsi-we-se-lv Qui-da; A-qua-so-ha-dv ha-le-hv-ga, Se-da-ni, di-s-quo-de-s-di-s-gi-quo ni-hi, v-tla-ye-no ya-da-nv-de-ha U-ne-la-nv-hi u-tse-li-ga, yv-wi-quo-s-gi-ni u-na-tse-li ha-da-nv-de-ha."
        intervals [47]:
            xmin = 379.505
            xmax = 380.485
            text = ""
        intervals [48]:
            xmin = 380.485
            xmax = 397.810
            text = "011624: Hna-quo-no Tsi-sa hi-a ni-du-we-se-lv-gi gv-wa-s-da-wa-di-do-hi; I-yu-no gi-lo u-du-li-s-ge-s-di a-gi-s-du-wa-dv-s-di-yi, a-da-da-yi-he-s-di u-wa-sv, a-le tsu-da-hna-wa-dv a-yi-s-ge-s-di, a-le a-gi-s-da-wa-de-ge-s-di."
        intervals [49]:
            xmin = 397.810
            xmax = 398.550
            text = ""
        intervals [50]:
            xmin = 398.550
            xmax = 413.890
            text = "011625: Gi-lo-ye-no u-du-li-s-ge-s-di u-s-de-lv-di-yi gv-nv-i, u-yo-hu-se-di ge-se-s-di; gi-lo-no u-yo-hu-se-he-s-di gv-nv-i, a-yv nv-di-ga-li-s-do-di-s-ge-s-di, u-wa-dv-di ge-se-s-di."
        intervals [51]:
            xmin = 413.890
            xmax = 414.590
            text = ""
        intervals [52]:
            xmin = 414.590
            xmax = 432.165
            text = "011626: Ga-do yv-wi yu-ne-quo-tsi i-yu-no e-la-ni-gv u-tse-li yi-nu-li-s-ta-nv, u-da-nv-do-no yu-yo-hu-se-lv; a-le ga-do ya-hv-ga yv-wi yi-ga-ne-tli-yv-s-da u-da-nv-do."
        intervals [53]:
            xmin = 432.165
            xmax = 433.310
            text = ""
        intervals [54]:
            xmin = 433.310
            xmax = 452.640
            text = "011627: Yv-wi-ye-no U-we-tsi da-ga-lu-tsi U-do-da u-tse-li ga-lv-quo-di-yu ge-sv u-nu-wo-s-de-s-di, a-le di-ni-ka-hna-wa-di-do-hi da-ti-ne-he-s-di; hna-quo-no do-dv-gu-yv-e-li na-ni-v yv-wi nu-s-dv du-ni-lv-wi-s-da-ne-lv-i."
        intervals [55]:
            xmin = 452.640
            xmax = 453.740
            text = ""
        intervals [56]:
            xmin = 453.740
            xmax = 473.550
            text = "011628: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, Gi-lo a-ni da-ni-do-ga v-tla yv-dv-na-do-le-ho-si a-yo-hu-hi-s-di ge-sv-i, gv-ni a-ni-go-hv-ha yv-wi U-we-tsi na-hna u-gv-wi-yu-hi ge-sv ga-na-nu-go-tsi-lv-ha."
        intervals [57]:
            xmin = 473.550
            xmax = 473.830
            text = ""
