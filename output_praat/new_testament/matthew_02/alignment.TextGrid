item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 440.735
        intervals: size = 47
        intervals [1]:
            xmin = 0.000
            xmax = 4.600
            text = ""
        intervals [2]:
            xmin = 4.600
            xmax = 22.755
            text = "010201: Tsi-sa-no u-de-nv Ga-du-yi ga-du-hv Tsu-di-yi, na-hi-yu tse-he E-lo-dv u-gv-wi-yu-hi, gv-ni-yu-quo u-ni-lu-tse Tsi-lu-si-li-mi a-ni-ga-ta-hna-i nv-do di-ka-lv-gv i-di-tlv tsu-ni-lo-se-i,"
        intervals [3]:
            xmin = 22.755
            xmax = 24.450
            text = ""
        intervals [4]:
            xmin = 24.450
            xmax = 41.310
            text = "010202: Hi-a nu-ni-we-se-i; ha-tlv na tsu-de-nv U-gv-wi-yu-hi A-ni-tsu-si u-na-tse-li-ga, o-gi-go-hv-ye-no u-tse-li no-qui-si di-ka-lv-gv i-di-tlv, a-le o-tsa-da-do-li-s-da-ne-li-ga."
        intervals [5]:
            xmin = 41.310
            xmax = 43.110
            text = ""
        intervals [6]:
            xmin = 43.110
            xmax = 52.940
            text = "010203: E-lo-dv-no u-gv-wi-yu-hi u-dv-ga-nv na-s-gi, u-we-li-hi-s-di u-da-nv-da-de-i, a-le ni-ga-dv Tsi-lu-si-li-mi a-ne-hi."
        intervals [7]:
            xmin = 52.940
            xmax = 54.260
            text = ""
        intervals [8]:
            xmin = 54.260
            xmax = 68.100
            text = "010204: Du-la-wi-dv-no ni-ga-dv nu-ni-gv-wi-yu-sv a-tsi-lv a-ne-lo-hi, a-le yv-wi di-no-we-la-ne-hi, du-dv-dv-ne-i, na-hna u-de-di ge-sv Ga-lo-ne-dv."
        intervals [9]:
            xmin = 68.100
            xmax = 69.880
            text = ""
        intervals [10]:
            xmin = 69.880
            xmax = 79.975
            text = "010205: Hi-a-no ni-gv-wa-we-se-le-i; Tsu-di-yi Ga-du-yi ga-du-hv-i; hi-a-ye-no nu-wa-nv u-wo-we-la a-do-le-ho-s-gi;"
        intervals [11]:
            xmin = 79.975
            xmax = 81.100
            text = ""
        intervals [12]:
            xmin = 81.100
            xmax = 99.700
            text = "010206: A-le ni-hi Ga-du-yi ga-du-hv Tsu-di-yi, v-tla-s-gi-ni tsa-s-di-ka-ni yi-gi, tsi-lo-da-su-ya nu-ni-gv-wi-yu-sv Tsu-di-yi, ni-hi-ye-no da-tsa-nu-go-tsi di-qua-tse-li yv-wi I-si-li--di-ka-ne-tse-hi."
        intervals [13]:
            xmin = 99.700
            xmax = 101.795
            text = ""
        intervals [14]:
            xmin = 101.795
            xmax = 114.875
            text = "010207: Hna-quo-no E-lo-dv u-de-li-dv wi-du-ya-nv-hv na-s-gi a-ni-ga-ta-hna-i, o-s-dv du-dv-ti-sa-ne i-yu-quo na-s-gi no-qui-si u-na-nu-go-tsv-i."
        intervals [15]:
            xmin = 114.875
            xmax = 116.795
            text = ""
        intervals [16]:
            xmin = 116.795
            xmax = 137.270
            text = "010208: A-le du-nv-se Ga-du-yi, hi-a nu-we-se-i; I-tse-na o-s-dv we-tsi-yo-ga na-s-gi u-s-di a-yo-li, i-yu-no e-tsi-wa-dv-hv-ha, i-s-gi-no-ne-li-lv-ha, a-yv-no na-s-quo wi-tsi-lu-tsv-ha, a-le tsi-ya-da-do-li-s-da-ne-lv-ha."
        intervals [17]:
            xmin = 137.270
            xmax = 138.640
            text = ""
        intervals [18]:
            xmin = 138.640
            xmax = 161.975
            text = "010209: U-na-dv-ga-no-ne-lv-no u-gv-wi-yu-hi u-na-ni-gi-se-i, gv-ni-yu-quo-no no-qui-si, na-s-gi u-ni-go-hv-hi di-ka-lv-gv i-di-tlv, i-gv-yi u-ne-nv-e-le-i, gv-ni wu-lu-tsi-lv a-le u-le-wi-s-ta-nv ga-lv-la-di-tlv na-hna a-tsi-li e-hv-i."
        intervals [19]:
            xmin = 161.975
            xmax = 163.635
            text = ""
        intervals [20]:
            xmin = 163.635
            xmax = 169.305
            text = "010210: U-ni-go-hv-no na-s-gi no-qui-si, u-lo-ta-nv-hi u-na-li-he-li-tse-i."
        intervals [21]:
            xmin = 169.305
            xmax = 170.790
            text = ""
        intervals [22]:
            xmin = 170.790
            xmax = 201.615
            text = "010211: A-da-ne-lv-no u-ni-yv-lv u-ni-go-he a-yo-tla a-le u-tsi Me-li, a-le e-la-di du-na-da-nv-ne-i, u-na-da-do-li-s-da-ne-le-i, a-le tsu-gv-wa-lo-di u-ni-la-nv-dv du-ni-s-du-i-sv u-ni-ne-lv-ne nv-na-li-s-go-lv-ta-nv-hi, a-de-lv--da-lo-ni-dv, a-le u-ga-na-s-dv ga-wa-sv-gi a-dla, a-le mi-la."
        intervals [23]:
            xmin = 201.615
            xmax = 202.785
            text = ""
        intervals [24]:
            xmin = 202.785
            xmax = 219.940
            text = "010212: A-na-s-gi-da-s-gv-no U-ne-la-nv-hi du-ne-tse-lv E-lo-dv-yi wu-ni-lo-hi-s-di-yi ni-ge-sv-na, u-na-ni-gi-sv u-tsa-ti-ni-quo i-di-tlv wu-ni-lo-se i-u-ne-nv u-na-tse-li-go-hi."
        intervals [25]:
            xmin = 219.940
            xmax = 220.980
            text = ""
        intervals [26]:
            xmin = 220.980
            xmax = 253.590
            text = "010213: U-na-ni-gi-sv-no gv-ni-yu-quo di-ka-hna-wa-di-do-hi u-nv-si-dv Yi-ho-wa gv-ni-ge-sv nu-dv-ne-le Tso-wa a-s-gi-da-s-gv-i, hi-a nu-we-se-le-i; Ta-le-hv-ga, a-le ta-ti-nu-ga a-yo-li a-le u-tsi a-le ha-li-ti, I-tsi-qui wi-lo-hi, na-hna-no we-he-s-di gv-ni wi-gv-ne-tse-lv-ha, E-lo-dv-ye-no a-se dv-yo-li u-s-di a-yo-li u-hi-s-di-yi."
        intervals [27]:
            xmin = 253.590
            xmax = 254.520
            text = ""
        intervals [28]:
            xmin = 254.520
            xmax = 264.140
            text = "010214: Hna-quo-no du-le-nv u-ti-nv-se a-yo-li a-le u-tsi sv-no-yi, a-le I-tsi-dv-yi wu-lo-se-i."
        intervals [29]:
            xmin = 264.140
            xmax = 265.345
            text = ""
        intervals [30]:
            xmin = 265.345
            xmax = 282.765
            text = "010215: A-le na-hna we-he gv-ni E-lo-dv u-yo-hu-sv; u-do-hi-yu-ne U-ne-la-nv-hi u-ne-tsv-i, a-do-le-ho-s-gi tsu-wv-ta-ne-i, hi-a tsi-nu-we-se-i; I-tsi-qui-yi wi-tsi-ya-nv-hv a-que-tsi."
        intervals [31]:
            xmin = 282.765
            xmax = 284.070
            text = ""
        intervals [32]:
            xmin = 284.070
            xmax = 318.840
            text = "010216: Hna-quo-no E-lo-dv u-do-le-ho-sv a-ni-ga-ta-hna-i gv-wa-li-da-s-ta-nv-i, u-tsa-ta-nv-hi u-ta-la-wo-se-i, a-le u-da-nv-se wi-du-ni-ho-ne ni-ga-dv di-ni-yo-li ga-du-yi a-ne-hi, a-le ni-ga-dv ni-gv-na-dv na-hna-ni, ta-li i-yu-na-de-ti-yv-dv wa-s-ti, na-hi-yu nv-da-yu-da-le-nv-dv tsi-da-li-si-na-hi-s-da-ne-he tsi-da-dv-dv-he-lv-v-s-ge a-ni-ga-ta-hna-i."
        intervals [33]:
            xmin = 318.840
            xmax = 320.470
            text = ""
        intervals [34]:
            xmin = 320.470
            xmax = 328.235
            text = "010217: Hna-quo-no u-do-hi-yu-ne Tse-li-ma-ya a-do-le-ho-s-gi u-ne-tsv-hi, a-le tsi-nu-we-se-i;"
        intervals [35]:
            xmin = 328.235
            xmax = 329.100
            text = ""
        intervals [36]:
            xmin = 329.100
            xmax = 358.320
            text = "010218: Le-ma-yi ka-ne-gv u-na-dv-ga-nv-gi, da-ni-yv-gv-i, a-le da-na-tlo-yi-hv-i, a-le u-tsa-ti u-ne-lu-gv-i; le-tsi-li da-s-go-ni-hv tsu-we-tsi, a-le nu-du-li-s-gv-na ge-sv u-nu-wo-hi-s-di-yi, nv-di-ga-li-s-do-di-s-gv na-ne-hv-na-quo ge-sv-i."
        intervals [37]:
            xmin = 358.320
            xmax = 359.690
            text = ""
        intervals [38]:
            xmin = 359.690
            xmax = 372.170
            text = "010219: Hna-quo-no E-lo-dv u-yo-hu-sv, gv-ni-yu-quo di-ka-hna-wa-di-do-hi Yi-ho-wa u-tse-li-ga gv-ni-ge-sv nu-dv-ne-le Tso-wa a-s-gi-da-s-gv I-tsi-qui-yi,"
        intervals [39]:
            xmin = 372.170
            xmax = 373.485
            text = ""
        intervals [40]:
            xmin = 373.485
            xmax = 388.050
            text = "010220: Hi-a nu-we-se-le-i; Ta-le-hv-ga a-le ha-ti-nu-ga a-yo-li a-le u-tsi, a-le he-na I-si-li-yi, hna-quo-ye-no du-ni-yo-hu-sv a-yo-li gv-nv tsu-ni-yo-hv-gi."
        intervals [41]:
            xmin = 388.050
            xmax = 388.920
            text = ""
        intervals [42]:
            xmin = 388.920
            xmax = 395.600
            text = "010221: Du-le-nv-no u-ti-nv-se a-yo-li a-le u-tsi, a-le I-si-li-yi wu-lu-tse-i."
        intervals [43]:
            xmin = 395.600
            xmax = 396.690
            text = ""
        intervals [44]:
            xmin = 396.690
            xmax = 421.215
            text = "010222: A-se-no u-dv-ga-nv A-tsi-la u-gv-wi-yu-hi ge-sv Tsu-di-yi u-do-da E-lo-dv u-da-ne-tli-yv-s-da-ne-lv-i, u-s-ga-le na-hna wu-lo-hi-s-di-yi; a-se-no U-ne-la-nv-hi u-we-ya-ta-nv-hi ge-sv a-s-gi-da-s-gv-i, Ge-li-li wu-go-lv-s-ta-ne-i;"
        intervals [45]:
            xmin = 421.215
            xmax = 422.625
            text = ""
        intervals [46]:
            xmin = 422.625
            xmax = 440.055
            text = "010223: Ga-du-hv-no Na-se-li-di tsu-do-i-dv wu-lu-tsv na-hna e-he-i.  Na-s-gi-no u-do-hi-yu-ne a-na-do-le-ho-s-gi tsu-ni-ne-tse-i, Na-se-li-di e-hi a-go-se-he-s-di, tsu-na-dv-ne-i."
        intervals [47]:
            xmin = 440.055
            xmax = 440.735
            text = ""
