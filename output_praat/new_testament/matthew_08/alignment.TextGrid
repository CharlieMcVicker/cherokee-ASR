item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 538.965
        intervals: size = 69
        intervals [1]:
            xmin = 0.000
            xmax = 3.795
            text = ""
        intervals [2]:
            xmin = 3.795
            xmax = 10.935
            text = "010801: Hna-quo-no tsu-ga-so-a-sv u-sa-hi-lv-i, u-ni-tsa-ti gv-wa-s-da-wa-dv-se-i."
        intervals [3]:
            xmin = 10.935
            xmax = 11.750
            text = ""
        intervals [4]:
            xmin = 11.750
            xmax = 27.155
            text = "010802: A-le gv-ni-yu-quo a-da-ye-s-gi u-tlv-gi u-lu-tse u-da-do-li-s-da-ne-le-i, hi-a nu-we-se-i; Tsa-gv-wi-yu-hi, i-yu-no yi-tsa-da-nv-te-lv ye-li-quo yi-s-gi-nv-ga-lv."
        intervals [5]:
            xmin = 27.155
            xmax = 28.410
            text = ""
        intervals [6]:
            xmin = 28.410
            xmax = 45.020
            text = "010803: Tsi-sa-no u-do-ya-nv-hi-dv u-sv-ni-le-i, ga-da-nv-dv-li, tsa-da-nv-ga-lv-dv ge-se-s-di, u-wo-se-le-i; gi-la-quo-no i-yv-dv a-da-ye-s-gi u-tlv-gv u-da-nv-ga-lv-he-i."
        intervals [7]:
            xmin = 45.020
            xmax = 45.840
            text = ""
        intervals [8]:
            xmin = 45.840
            xmax = 67.090
            text = "010804: Hi-a-no Tsi-sa nu-we-se-le-i; Ka tle-s-di gi-lo tsi-hi-no-ne-li, he-na-quo-s-gi-ni, wi-tsa-go-wa-dv a-tsi-lv--ge-lo-hi, a-le a-li-s-go-lv-do-di wi-hv-ga Mo-si u-ne-tsv a-li-s-go-lv-do-di na-s-gi u-na-do-le-ho-hi-s-do-di."
        intervals [9]:
            xmin = 67.090
            xmax = 68.695
            text = ""
        intervals [10]:
            xmin = 68.695
            xmax = 81.350
            text = "010805: Hna-quo-no Tsi-sa Ge-qua-ni wi-u-lu-tsv, u-lu-tse-le a-s-go-hi-gu-qui a-ni-ya-wi-s-gi di-ti-ni-do-hi, u-s-di-ye-ta-ne-i,"
        intervals [11]:
            xmin = 81.350
            xmax = 82.690
            text = ""
        intervals [12]:
            xmin = 82.690
            xmax = 95.480
            text = "010806: Hi-a nu-we-se-le-i; Tsa-gv-wi-yu-hi, tsi-nv-si-da-s-di ga-nv-ga di-que-nv-sv u-tlv-ga u-lv-da-lv-v-s-ga u-tsa-ta-nv-hi a-gi-li-yo-ga."
        intervals [13]:
            xmin = 95.480
            xmax = 96.220
            text = ""
        intervals [14]:
            xmin = 96.220
            xmax = 100.970
            text = "010807: Tsi-sa-no hi-a nu-we-se-le-i; Da-ge-si da-tsi-nv-wa-ne-si."
        intervals [15]:
            xmin = 100.970
            xmax = 102.460
            text = ""
        intervals [16]:
            xmin = 102.460
            xmax = 119.500
            text = "010808: A-s-go-hi-tsu-qui-no di-ti-ni-do-hi di-u-ne-tsv hi-a nu-we-se-i; Tsa-gv-wi-yu-hi, tla-ye-li yi-ni-go-i tsi-ne-lv tsa-yv-s-di-yi; hi-ne-gi-quo-s-gi-ni u-wa-sv, tsi-nv-si-da-s-di-no da-yu-di-wa-si."
        intervals [17]:
            xmin = 119.500
            xmax = 120.370
            text = ""
        intervals [18]:
            xmin = 120.370
            xmax = 144.690
            text = "010809: A-yv-ye-no di-qua-da-ne-lo-di-quo, a-le da-gi-ka-ha a-ni-ya-wi-s-gi na-s-gi de-gv-qua-ne-lo-do-i, gi-lo-no He-na tsi-yo-si, e-go-i; nv-wa-da-le-no E-he-na tsi-yo-si, di-e-go-i; tsi-nv-si-da-s-di-no, hi-a hna-dv-ga tsi-yo-si, na-s-gi na-dv-ne-ho-i."
        intervals [19]:
            xmin = 144.690
            xmax = 146.025
            text = ""
        intervals [20]:
            xmin = 146.025
            xmax = 165.220
            text = "010810: Tsi-sa-no u-dv-ga-nv u-s-qua-ni-go-se-i, a-le hi-a ni-du-we-se-le Nv-da-gv-wa-s-da-wa-dv-dv, u-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, v-tla na-s-quo I-si-li du-do-v na-s-gi i-ga-i go-hi-yu-di ge-sv ya-gi-wa-dv-hv."
        intervals [21]:
            xmin = 165.220
            xmax = 166.235
            text = ""
        intervals [22]:
            xmin = 166.235
            xmax = 187.635
            text = "010811: A-le hi-a ni-tsv-we-se-ha; U-ni-tsa-ti di-ka-lv-gv a-le wu-de-li-gv i-di-tlv di-ni-lo-s-ge-s-di, a-le i-tsu-la-ha a-na-nv-v-s-ge-s-di E-qua-ha-mi, a-le E-si-gi, a-le Tse-ga-qui, ga-lv-la-di e-hi na-hna u-gv-wi-yu-hi ge-sv-i,"
        intervals [23]:
            xmin = 187.635
            xmax = 188.900
            text = ""
        intervals [24]:
            xmin = 188.900
            xmax = 208.075
            text = "010812: Ga-lv-la-di-s-gi-ni e-hi na-hna u-gv-wi-yu-hi ge-e a-ne-hi da-ge-tsi-nu-go-wi-si wi-do-da-ge-ga-da-e-si tsu-li-si-gv do-yi-di-tlv, na-hna da-ni-yv-ge-s-di, a-le da-ni-lv-da-gi-s-ge-s-di da-ni-nu-do-gv-i."
        intervals [25]:
            xmin = 208.075
            xmax = 209.215
            text = ""
        intervals [26]:
            xmin = 209.215
            xmax = 224.540
            text = "010813: Tsi-sa-no hi-a nu-we-se-le a-s-go-hi-tsu-qui di-ti-ni-do-hi; He-na, a-le nu-s-dv tso-hi-yu-nv na-s-gi wi-ni-tsa-li-s-da-si.  U-nv-si-da-s-di-no na-hi-yu-quo u-di-wa-se-i."
        intervals [27]:
            xmin = 224.540
            xmax = 225.780
            text = ""
        intervals [28]:
            xmin = 225.780
            xmax = 235.425
            text = "010814: Tsi-sa-no Qui-da ga-ne-lv u-lu-tsv, u-go-he Qui-da u-da-li-i u-tsi ga-nv-ge u-di-le-hv-s-ge-i."
        intervals [29]:
            xmin = 235.425
            xmax = 236.500
            text = ""
        intervals [30]:
            xmin = 236.500
            xmax = 245.360
            text = "010815: U-sv-ni-le-no u-wo-ye-ni, u-di-le-hv-s-gv-no u-di-wa-ha-i.  Du-le-ne-no a-le du-s-de-lv-hi-do-le-i."
        intervals [31]:
            xmin = 245.360
            xmax = 246.460
            text = ""
        intervals [32]:
            xmin = 246.460
            xmax = 264.075
            text = "010816: U-sv-no nu-li-s-ta-nv, u-ni-tsa-te a-ni-s-gi-na di-gv-wa-ni-ya-i de-gv-wa-ti-no-he-le-i; du-nu-go-wi-se-no a-ni-s-gi-na ka-ne-gv-quo gv-di-s-ge-i, a-le ni-ga-dv tsu-ni-tlv-gi du-nv-wa-ne-i."
        intervals [33]:
            xmin = 264.075
            xmax = 265.085
            text = ""
        intervals [34]:
            xmin = 265.085
            xmax = 283.795
            text = "010817: U-do-hi-yu-di-yi a-ye-lv-sv-gi I-sa-ya a-do-le-ho-s-gi tsu-ne-tse-i, hi-a tsi-nu-we-se-i; U-wa-sv i-gi-gi-s-da-ne-lv-gi di-di-wa-na-ga-la-hi-yu ge-sv-i, de-gi-tlv-gv-no tsu-tse-li ni-du-wa-ne-lv-gi."
        intervals [35]:
            xmin = 283.795
            xmax = 284.810
            text = ""
        intervals [36]:
            xmin = 284.810
            xmax = 294.020
            text = "010818: Tsi-sa-no du-go-hv u-ni-tsa-ti yv-wi gv-wa-dla-wi-s-di-s-gv-i, u-ne-tse i-s-go-nv wu-ni-lo-hi-s-di-yi."
        intervals [37]:
            xmin = 294.020
            xmax = 294.645
            text = ""
        intervals [38]:
            xmin = 294.645
            xmax = 305.425
            text = "010819: Gi-lo-no i-yu-s-di di-go-we-li-s-gi u-lu-tse-i, hi-a nu-we-se-le-i; Ta-de-yo-hv-s-gi da-gv-s-da-wa-di-do-li ni-ga-v he-do-hv-i."
        intervals [39]:
            xmin = 305.425
            xmax = 306.180
            text = ""
        intervals [40]:
            xmin = 306.180
            xmax = 321.385
            text = "010820: Tsi-sa-no hi-a nu-we-se-le-i; Tsu-la du-ni-ta-le-so-i, tsi-s-qua-no ga-lv-lo a-ne-hi du-na-ne-s-da-tla-ho-i, yv-wi-s-gi-ni U-we-tsi v-tla i-lv-hi-tlv a-s-go-li u-di-yi yi-gi."
        intervals [41]:
            xmin = 321.385
            xmax = 322.085
            text = ""
        intervals [42]:
            xmin = 322.085
            xmax = 331.180
            text = "010821: Nv-wa-da-le-no u-s-da-wa-di-do-hi hi-a nu-we-se-le-i; Tsa-gv-wi-yu-hi, i-gv-yi ge-na tsi-ni-sa-nu-ga e-do-da."
        intervals [43]:
            xmin = 331.180
            xmax = 332.390
            text = ""
        intervals [44]:
            xmin = 332.390
            xmax = 344.080
            text = "010822: Tsi-sa-no hi-a nu-we-ha-le-i; S-gi-s-da-wa-du-ga, u-na-ne-la-gi-no tsu-ni-yo-hu-sv-hi da-ni-ni-si-s-ge-s-di tsu-na-tse-li tsu-ni-yo-hu-sv-hi."
        intervals [45]:
            xmin = 344.080
            xmax = 344.920
            text = ""
        intervals [46]:
            xmin = 344.920
            xmax = 350.930
            text = "010823: Hna-quo-no tsi-yu-hi wu-tsa-nv gv-wa-s-da-wa-di-do-hi gv-wa-s-da-wa-dv-se-i."
        intervals [47]:
            xmin = 350.930
            xmax = 352.020
            text = ""
        intervals [48]:
            xmin = 352.020
            xmax = 364.650
            text = "010824: Gv-ni-yu-quo-no u-tsa-ti u-yi-lo-le u-no-le i-da-li; tsi-yu-ye-no a-ma da-li-s-di-la-ne-gv u-wu-tlv-v-s-ge-i; a-se-no i-ga-li-he-quo."
        intervals [49]:
            xmin = 364.650
            xmax = 365.400
            text = ""
        intervals [50]:
            xmin = 365.400
            xmax = 376.190
            text = "010825: Gv-wa-s-da-wa-di-do-hi-no gv-wa-lu-tse-le gv-wa-ye-s-ta-ne-i, hi-a ni-gv-wa-we-se-le-i; Tsa-gv-wi-yu-hi, s-gi-s-de-lv, da-yo-tsa-di-sv-ni-quo."
        intervals [51]:
            xmin = 376.190
            xmax = 377.010
            text = ""
        intervals [52]:
            xmin = 377.010
            xmax = 392.880
            text = "010826: Hi-a-no ni-du-we-se-le-i, Ga-do-no i-tsi-s-ga-i-ha?  U-s-di i-tso-hi-yu-hi!  Hna-quo-no du-le-nv du-s-ga-tse u-no-le a-le v-da-li, u-tsa-ti-no u-da-tsi-na-s-dv-hi nu-li-s-ta-ne-i."
        intervals [53]:
            xmin = 392.880
            xmax = 394.105
            text = ""
        intervals [54]:
            xmin = 394.105
            xmax = 407.020
            text = "010827: A-ni-s-ga-ya-no u-ni-s-qua-ni-go-se-i, hi-a nu-ni-we-se-i; Ga-do u-s-di hi-a a-s-ga-ya, na-s-quo-ye-no u-no-le a-le v-da-li i-gv-wo-hi-yu-hv-s-ga."
        intervals [55]:
            xmin = 407.020
            xmax = 408.380
            text = ""
        intervals [56]:
            xmin = 408.380
            xmax = 433.710
            text = "010828: I-s-go-ni-di-tlv-no wu-lu-tsv Ga-gi-si-ni u-na-tse-li-go-hi, a-ni-ta-li a-ni-s-gi-na di-gv-wa-ni-ya-i de-gv-wa-tlo-se-i, da-da-ni-sa-hv tsu-ni-nu-go-tse-i, u-tsa-ta-nv-hi u-ni-hna-lv-hi-yu ge-se-i, na-s-gi v-tla gi-lo na-hna gv-wa-lo-hi-s-di yi-ge-se-i."
        intervals [57]:
            xmin = 433.710
            xmax = 434.640
            text = ""
        intervals [58]:
            xmin = 434.640
            xmax = 455.290
            text = "010829: A-le gv-ni-yu-quo u-ne-lu-ne-i, hi-a nu-ni-we-se-i; v-tla go-hu-s-di di-ga-da-dv-do-di yi-gi ni-hi, Tsi-sa U-ne-la-nv-hi U-we-tsi, tsi-go a-ni tsa-lu-tsi-lv s-gi-ni-gi-li-yo-i-s-do-di-yi-quo a-si-quo na-s-qua-li-s-gv-na?"
        intervals [59]:
            xmin = 455.290
            xmax = 455.900
            text = ""
        intervals [60]:
            xmin = 455.900
            xmax = 464.140
            text = "010830: Ge-hi-no i-yv-dv di-ne-do-he u-ni-tsa-ti su-na-da-tlu-gi si-qua a-na-li-s-da-yv-ni-do-he-i."
        intervals [61]:
            xmin = 464.140
            xmax = 464.765
            text = ""
        intervals [62]:
            xmin = 464.765
            xmax = 479.985
            text = "010831: A-ni-s-gi-na-no gv-wa-ta-yo-se-le-i, hi-a ni-gv-wa-we-se-le-i; i-yu-no s-gi-ni-nu-go-wi-sv-ha, u-na-ne-la-gi s-gi-ne-li-se-lv-ha si-qua su-na-da-tlu-gi wi-go-s-di-yv-s-di-yi."
        intervals [63]:
            xmin = 479.985
            xmax = 480.670
            text = ""
        intervals [64]:
            xmin = 480.670
            xmax = 509.020
            text = "010832: Hi-a-no ni-du-we-se-le-i; S-de-na.  U-ni-nu-go-tsv-no, si-qua su-na-da-tlu-gi wi-du-ni-yv-le-i.  A-le gv-ni-yu-quo ni-ga-dv su-na-da-tlu-gi si-qua a-ya-nu-li-yu u-na-li-se-i, wu-ni-ga-so-a-se ga-ne-tlu-gi gv-sv-i, v-da-li wu-na-li-ta-di-nv-se-i, a-le a-ma-yi du-ni-li-wo-tse-i."
        intervals [65]:
            xmin = 509.020
            xmax = 510.020
            text = ""
        intervals [66]:
            xmin = 510.020
            xmax = 522.705
            text = "010833: Di-ni-ga-ti-ya-no u-na-li-se-i, di-ga-du-hv wu-ni-lo-se-i, ni-ga-dv wu-ni-no-he-le-i, a-le a-ni-s-gi-na gv-wa-ni-ya-i nu-na-li-s-da-ne-lv-i."
        intervals [67]:
            xmin = 522.705
            xmax = 523.530
            text = ""
        intervals [68]:
            xmin = 523.530
            xmax = 538.495
            text = "010834: Gv-ni-yu-quo-no ni-ga-di-yu s-ga-du-gi tsu-ni-nu-go-tse-i, tsi-sa de-gv-wa-tlo-si-le-i; gv-wa-go-hv-no gv-wa-ta-yo-se-le u-da-nv-s-di-yi-quo u-na-tse-li-go-hi ge-sv-i."
        intervals [69]:
            xmin = 538.495
            xmax = 538.965
            text = ""
