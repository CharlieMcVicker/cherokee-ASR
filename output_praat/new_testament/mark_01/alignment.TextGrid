        intervals [14]:
            xmin = 14.090
            xmax = 14.850
            text = "u-tse-li-ga."
        intervals [15]:
            xmin = 14.850
            xmax = 16.350
            text = ""
        intervals [16]:
            xmin = 16.350
            xmax = 17.270
            text = "Na-s-gi-ya hi-a"
        intervals [17]:
            xmin = 17.270
            xmax = 17.490
            text = ""
        intervals [18]:
            xmin = 17.490
            xmax = 18.170
            text = "tsi-ni-gv-nv"
        intervals [19]:
            xmin = 18.170
            xmax = 18.370
            text = ""
