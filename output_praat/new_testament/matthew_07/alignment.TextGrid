item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 442.810
        intervals: size = 59
        intervals [1]:
            xmin = 0.000
            xmax = 3.365
            text = ""
        intervals [2]:
            xmin = 3.365
            xmax = 10.795
            text = "010701: Tle-s-di tsi-tsa-da-la-wi-se-li na-s-gi-no ni-hi tle-s-di e-tsi-la-wi-se-lv-gi."
        intervals [3]:
            xmin = 10.795
            xmax = 12.530
            text = ""
        intervals [4]:
            xmin = 12.530
            xmax = 23.310
            text = "010702: Na-s-gi-ye-no nu-s-dv i-tsa-da-la-wi-se-lv a-se na-s-quo dv-e-tsi-la-wi-se-li, a-le nu-s-dv i-tsa-da-tli-lo-sv-lv na-s-quo dv-e-tsa-tli-lo-e-li."
        intervals [5]:
            xmin = 23.310
            xmax = 25.060
            text = ""
        intervals [6]:
            xmin = 25.060
            xmax = 37.395
            text = "010703: A-le ga-do-no i-hi-go-wa-ti-s-go u-tlv-da-lv-dv u-ga-su-hv-i di-s-da-da-nv-tli, ne-li-s-gv-na-no i-ge-so u-no-s-dv a-da tsv-sv tsa-ga-su-hv-i."
        intervals [7]:
            xmin = 37.395
            xmax = 38.660
            text = ""
        intervals [8]:
            xmin = 38.660
            xmax = 52.210
            text = "010704: A-le ga-do yi-ga-li-s-do-da hi-a yi-ni-we-si di-s-da-da-nv-tli, Gv-lv-si u-tlv-da-lv-dv tsa-ga-su-hv-i, gv-ni-yu-quo-no u-no-s-dv a-da tsv-sv tsa-ga-su-ha."
        intervals [9]:
            xmin = 52.210
            xmax = 53.755
            text = ""
        intervals [10]:
            xmin = 53.755
            xmax = 71.395
            text = "010705: Tsa-tlo-na-s-di!  i-gv-yi hi-lv u-no-s-dv a-da tsv-sv tsa-ga-su-hv-i, hna-quo-no gv-ni-ge-sv-i-yu tsa-go-wa-dv-di-yi ge-se-s-di hi-lv-e-di-yi u-tlv-da-lv-dv di-s-da-da-nv-tli u-ga-su-hv-i."
        intervals [11]:
            xmin = 71.395
            xmax = 72.555
            text = ""
        intervals [12]:
            xmin = 72.555
            xmax = 92.845
            text = "010706: Tle-s-di go-hu-s-di ga-lv-quo-di gi-li di-tsi-ne-lv-gi, tle-s-di a-le da-gv-na--i-yu-na-s-di di-tsa-tse-li-ga si-qua wi-di-tsa-di-ne-lv-gi, yi-da-na-la-s-da-v-li-quo-ye-no, a-le ya-na-ga-ta-hv-na yv-ge-tsi-da-ga-lv-v-ga."
        intervals [13]:
            xmin = 92.845
            xmax = 93.860
            text = ""
        intervals [14]:
            xmin = 93.860
            xmax = 105.035
            text = "010707: I-tsi-ta-yo-ha, a-se da-ye-tsi-ne-li; i-tsi-yo-ga, a-se da-tsi-wa-dv-hi; i-tsv-ni-ga, a-se da-ye-tsi-s-du-i-e-li."
        intervals [15]:
            xmin = 105.035
            xmax = 106.030
            text = ""
        intervals [16]:
            xmin = 106.030
            xmax = 117.865
            text = "010708: Gi-lo-ye-no tsa-ta-yo-hi-ho a-tsi-ne-ho-i, gi-lo-no tsu-yo-ho a-wa-ti-s-go-i, gi-lo-no tsi-wi-gv-ni-ho a-tsi-s-du-i-e-ho-i."
        intervals [17]:
            xmin = 117.865
            xmax = 119.085
            text = ""
        intervals [18]:
            xmin = 119.085
            xmax = 129.050
            text = "010709: Ga-go-ge a-s-ga-ya hi-a tsi-ni-tsa-dv-nv, i-yu-no u-we-tsi ga-du yu-ta-yo-se-ha, nv-ya-quo ya-hv-si?"
        intervals [19]:
            xmin = 129.050
            xmax = 130.035
            text = ""
        intervals [20]:
            xmin = 130.035
            xmax = 135.140
            text = "010710: A-le a-tsa-di ya-ta-yo-hi-ha, tsi-go i-na-dv-quo yv-ga-nv-v-si?"
        intervals [21]:
            xmin = 135.140
            xmax = 136.640
            text = ""
        intervals [22]:
            xmin = 136.640
            xmax = 154.620
            text = "010711: I-yu-no ni-hi i-tsi-yo-i yi-tsi-si-na-hi o-s-dv ge-sv di-tsi-ne-di-yi di-tse-tsi, u-tli-hi-yu u-do-hi-yu-hi-ya I-tsi-do-da ga-lv-la-di e-hi o-s-dv da-ne-he-s-di gv-wa-ta-yo-se-hi."
        intervals [23]:
            xmin = 154.620
            xmax = 155.610
            text = ""
        intervals [24]:
            xmin = 155.610
            xmax = 170.590
            text = "010712: Na-s-gi i-yu-s-di ni-ga-v go-hu-s-di i-tsa-du-li-s-gv yv-wi i-ge-tsa-dv-ne-di-yi, na-s-gi-ya na-s-quo ni-de-tsa-dv-ne-he-s-di; na-s-gi-ye-no hi-a nu-s-di di-ka-hna-wa-dv-s-di a-le a-na-do-le-ho-s-gi"
        intervals [25]:
            xmin = 170.590
            xmax = 171.540
            text = ""
        intervals [26]:
            xmin = 171.540
            xmax = 188.505
            text = "010713: A-ya-do-li ga-lo-hi-s-di-yi i-tsi-yv-s-da A-ya-te-ni-ye-no ga-lo-hi-s-di-yi a-le a-ya-te-ni nv-no-hi a-yo-hu-hi-s-di-yi wi-ga-na-nu-go-gv-i, u-ni tsa-ta-no na-hna a-ni-lo-s-ga."
        intervals [27]:
            xmin = 188.505
            xmax = 190.200
            text = ""
        intervals [28]:
            xmin = 190.200
            xmax = 203.180
            text = "010714: A-ya-do-li-yu-ye-no ga-lo-hi-s-di-yi a-le a-ya-do-li-yu nv-no-hi gv-ni-dv wi-ga-na-nu-go-gv-i, a-le a-ni-ga-yo-li-yu a-ni-wa-ti-ha."
        intervals [29]:
            xmin = 203.180
            xmax = 204.120
            text = ""
        intervals [30]:
            xmin = 204.120
            xmax = 221.605
            text = "010715: De-tse-ya-do-tse-he-s-di u-na-tlo-na-s-di a-na-do-le-ho-s-gi, a-wi u-ni-no-de-na ga-ne-ga tsu-na-nu-wa-i tsi-ge-tsi-lu-tse-ho-i; a-se-no ha-wi-ni ge-sv wa-ya u-ni-gv-v-s-gi ge-so-i."
        intervals [31]:
            xmin = 221.605
            xmax = 222.480
            text = ""
        intervals [32]:
            xmin = 222.480
            xmax = 239.890
            text = "010716: Nu-s-dv a-na-da-dv-s-gv-i do-da-tso-li-s-ta-ni.   Tsi-go yv-wi te-lv-la-di da-na-de-s-go tsi-s-du-ni-gi-s-di-hi?  A-le sv-ga-ta--i-yu-na-s-di tsi-go-tsi-tsi-hi da-na-de-s-go-i?"
        intervals [33]:
            xmin = 239.890
            xmax = 240.925
            text = ""
        intervals [34]:
            xmin = 240.925
            xmax = 250.280
            text = "010717: Na-s-gi-s-gi-ni nu-s-di ni-ga-v o-s-dv tlu-gv o-s-dv a-da-dv-s-go-i, u-yo-no tlu-gv u-yo a-da-dv-s-go-i."
        intervals [35]:
            xmin = 250.280
            xmax = 251.435
            text = ""
        intervals [36]:
            xmin = 251.435
            xmax = 260.195
            text = "010718: O-s-dv tlu-gv v-tla ye-li u-yo yv-gv-da-dv-ga, a-le u-yo tlu-gv v-tla ye-li o-s-dv yv-gv-da-dv-ga."
        intervals [37]:
            xmin = 260.195
            xmax = 261.590
            text = ""
        intervals [38]:
            xmin = 261.590
            xmax = 272.145
            text = "010719: Ni-ga-v-s-gi-ni de-tlu-gv o-s-dv na-na-da-dv-s-gv-na, di-ga-le-yv-s-do-di ge-se-s-di, a-le a-tsi-lv-yi wi-da-di-nv-di."
        intervals [39]:
            xmin = 272.145
            xmax = 273.060
            text = ""
        intervals [40]:
            xmin = 273.060
            xmax = 278.080
            text = "010720: Na-s-gi i-yu-s-di do-da-tso-li-s-ta-ni nu-s-dv a-na-da-dv-s-gv-i."
        intervals [41]:
            xmin = 278.080
            xmax = 279.440
            text = ""
        intervals [42]:
            xmin = 279.440
            xmax = 296.805
            text = "010721: V-tla-ye-no na-ni-v, Tsa-gv-wi-yu-hi, Tsa-gv-wi-yu-hi, gv-quo-se-hi, ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv wu-ni-na-nu-go-i-s-di yi-gi, na-s-gi-s-gi-ni na E-do-da ga-lv-la-di e-hi a-da-nv-te-s-gv tsu-ni-lv-wi-s-da-ne-hi."
        intervals [43]:
            xmin = 296.805
            xmax = 298.400
            text = ""
        intervals [44]:
            xmin = 298.400
            xmax = 328.340
            text = "010722: Na-hi-yu i-ga ge-se-s-di u-ni-tsa-ti-s-di hi-a nv-da-gv-gi-we-ha-li; Tsa-gv-wi-yu-hi, Tsa-gv-wi-yu-hi, tla-s-go de-tsa-do-v yo-tsv-di-s-ge yo-tsa-do-le-ho-s-ge-i?  A-le tla-s-go de-tsa-do-v yo-tsv-di-s-ge a-ni-s-gi-na yi-do-tsi-nu-go-wi-s-ge-i?  A-le tla-s-go de-tsa-do-v yo-tsv-di-s-ge u-tsa-ti u-s-qua-ni-go-di yi-do-gi-lv-wi-s-da-ne-he-i?"
        intervals [45]:
            xmin = 328.340
            xmax = 329.675
            text = ""
        intervals [46]:
            xmin = 329.675
            xmax = 339.705
            text = "010723: Hna-quo-no hi-a nv-da-ga-tsi-we-se-li; v-tla i-lv-hi-yu yi-tsv-ga-ta-he-i; u-tli wi-tsi-lo-hi u-yo di-tsi-lv-wi-s-da-ne-hi."
        intervals [47]:
            xmin = 339.705
            xmax = 341.260
            text = ""
        intervals [48]:
            xmin = 341.260
            xmax = 359.575
            text = "010724: Na-s-gi i-yu-s-di na-ni-v gi-lo hi-a tsi-ni-tsi-we-a a-na-dv-gi-s-ge-s-di, a-le na-s-gi na-na-dv-ne-he-s-di, a-ga-ta-hna-i a-s-ga-ya do-da-ga-tsi-ya-tli-lo-s-ta-ni, na-s-gi nv-yo-hi tsu-ne-s-ge-he-i;"
        intervals [49]:
            xmin = 359.575
            xmax = 360.780
            text = ""
        intervals [50]:
            xmin = 360.780
            xmax = 376.840
            text = "010725: Hna-quo-no tsu-ga-hna-ne-i, a-le tsi-du-no-hu-ga-ne-i, a-le tsu-no-lv-ne-i, na-hna a-da-ne-lv tsi-du-yi-lo-le-i; a-se-no v-tla yu-yo-tse-i, nv-tsi-hi-ye-no ga-ka-he-i."
        intervals [51]:
            xmin = 376.840
            xmax = 378.330
            text = ""
        intervals [52]:
            xmin = 378.330
            xmax = 397.725
            text = "010726: Na-ni-v-no gi-lo hi-a tsi-ni-tsi-we-a a-na-dv-gi-s-ge-s-di, na-s-gi-no na-na-dv-ne-hv-na i-ge-se-s-di, u-ne-gu a-s-ga-ya di-ge-ga-tli-lo-s-do-di ge-se-s-di na-s-gi no-yu-hi tsu-ne-s-ge-he-i."
        intervals [53]:
            xmin = 397.725
            xmax = 399.435
            text = ""
        intervals [54]:
            xmin = 399.435
            xmax = 416.500
            text = "010727: Hna-quo-no tsu-ga-hna-ne-i, a-le tsi-du-no-hu-ga-ne-i, a-le tsu-no-lv-ne-i, na-hna a-da-ne-lv tsi-du-yi-lo-le-i, a-le tsu-yo-tse-i, a-le u-s-ga-se-di-yu tsi-nu-li-s-ta-ne u-yo-tsv."
        intervals [55]:
            xmin = 416.500
            xmax = 417.750
            text = ""
        intervals [56]:
            xmin = 417.750
            xmax = 428.350
            text = "010728: Hi-a-no nu-li-s-ta-ne-i, na-s-gi Tsi-sa u-s-qua-dv na-s-gi ni-ga-we-s-gv-i, u-ni-s-qua-ni-go-se da-de-yo-hv-s-gv-i."
        intervals [57]:
            xmin = 428.350
            xmax = 429.730
            text = ""
        intervals [58]:
            xmin = 429.730
            xmax = 442.015
            text = "010729: U-tse-li-ga-ye-no tsi-da-de-yo-hv-s-go i-yu-s-di ge-se-i, v-tla-no di-no-we-li-s-gi-quo tsi-da-na-de-yo-hv-s-go i-yu-s-di yi-ge-se-i."
        intervals [59]:
            xmin = 442.015
            xmax = 442.810
            text = ""
