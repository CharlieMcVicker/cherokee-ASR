File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 797.230
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 797.230
        intervals: size = 105
        intervals [1]:
            xmin = 0.000
            xmax = 3.335
            text = ""
        intervals [2]:
            xmin = 3.335
            xmax = 22.520
            text = "021001: Na-hna-no du-le-nv, Tsu-di-yi ga-da a-hv-i u-lu-tse-i, Tso-da-ni a-s-go-ni-di-tlv tsu-lo-hi-s-ta-ne-i; a-le u-ni-tsa-ti yv-wi ta-li-ne i-gv-wa-da-tli-sa-ne-le-i; a-le i-yu-dv-ne-di ge-sv nu-dv-ne-le-i, ta-li-ne du-we-yo-ne-i."
        intervals [3]:
            xmin = 22.520
            xmax = 23.425
            text = ""
        intervals [4]:
            xmin = 23.425
            xmax = 36.970
            text = "021002: A-ni-qua-li-si-no gv-wa-lu-tse-lv gv-wa-dv-dv-ne-i, hi-a nu-ni-we-se-i, Du-yu-go-di-s-go a-s-ga-ya u-da-i-nv-di-yi u-da-li-i?  Gv-wa-go-li-ye-s-ge-i."
        intervals [5]:
            xmin = 36.970
            xmax = 37.945
            text = ""
        intervals [6]:
            xmin = 37.945
            xmax = 43.600
            text = "021003: U-ne-tsv-no hi-a ni-su-we-se-le-i, Ga-do u-s-de i-tsi-ne-tse-le Mo-si?"
        intervals [7]:
            xmin = 43.600
            xmax = 45.165
            text = ""
        intervals [8]:
            xmin = 45.165
            xmax = 54.965
            text = "021004: Hi-a-no nu-ni-we-se-i, Mo-si u-li-s-go-lv-ta-ne go-we-lo-di-yi do-ga-le-nv-hv-i, a-le a-da-i-nv-di-yi."
        intervals [9]:
            xmin = 54.965
            xmax = 56.175
            text = ""
        intervals [10]:
            xmin = 56.175
            xmax = 67.495
            text = "021005: Tsi-sa-no u-ne-tsv, hi-a ni-du-we-se-le-i, Di-s-da-yi-yu ge-sv i-yu-s-di di-tsi-na-wi hi-a na-s-gi di-ka-hna-wa-dv-s-di i-tso-we-la-ne-le-i;"
        intervals [11]:
            xmin = 67.495
            xmax = 68.110
            text = ""
        intervals [12]:
            xmin = 68.110
            xmax = 76.290
            text = "021006: Di-da-le-ni-s-gv-s-gi-ni u-we-tlv-nv-nv-i, U-ne-la-nv-hi a-s-ga-ya a-le a-ge-yv du-wo-tlv-ne-i."
        intervals [13]:
            xmin = 76.290
            xmax = 77.280
            text = ""
        intervals [14]:
            xmin = 77.280
            xmax = 86.040
            text = "021007: Na-s-gi i-yu-s-di a-s-ga-ya de-gv-de-ge-s-di u-do-da a-le u-tsi, a-le u-da-li-i a-dla-wa-s-di-s-ge-s-di;"
        intervals [15]:
            xmin = 86.040
            xmax = 86.710
            text = ""
        intervals [16]:
            xmin = 86.710
            xmax = 97.770
            text = "021008: Na-s-gi-no a-ni-ta-li sa-quo-quo ge-se-s-di u-ni-que-da-lv-i; na-s-gi-no v-tla hna-quo a-ni-ta-li yi-gi, sa-quo-quo-s-gi-ni u-ni-que-da-lv-i."
        intervals [17]:
            xmin = 97.770
            xmax = 98.610
            text = ""
        intervals [18]:
            xmin = 98.610
            xmax = 105.915
            text = "021009: Na-s-gi i-yu-s-di U-ne-la-nv-hi tsu-wu-da-ta-nv-hi tle-s-di yv-wi tsu-ga-le-nv-ta-nv-gi."
        intervals [19]:
            xmin = 105.915
            xmax = 107.085
            text = ""
        intervals [20]:
            xmin = 107.085
            xmax = 116.685
            text = "021010: Ga-li-tso-de-no a-ni-ya-v gv-wa-s-da-wa-di-do-hi ta-li-ne i-gv-wa-dv-dv-ne na-s-gi u-gv-wa-li."
        intervals [21]:
            xmin = 116.685
            xmax = 117.820
            text = ""
        intervals [22]:
            xmin = 117.820
            xmax = 131.170
            text = "021011: Hi-a-no ni-du-we-se-le-i, Gi-lo u-da-li-i a-da-e-ge-s-di, a-le nv-wa-da-le a-da-ye-ge-s-di, na-s-gi a-da-yo-ne-he-s-di a-s-ga-nv-tse-he-s-di na-s-gi."
        intervals [23]:
            xmin = 131.170
            xmax = 132.045
            text = ""
        intervals [24]:
            xmin = 132.045
            xmax = 141.890
            text = "021012: I-yu a-le a-ge-yv u-ye-hi a-da-e-ge-s-di, a-le nv-wa-da-le da-na-tse-ge-s-di, na-s-gi a-da-yo-ne-he-s-di."
        intervals [25]:
            xmin = 141.890
            xmax = 142.600
            text = ""
        intervals [26]:
            xmin = 142.600
            xmax = 155.225
            text = "021013: Tsu-na-s-di-no di-ni-yo-li de-gv-wa-ti-no-he-le-i, na-s-gi tsu-sv-ni-s-di-yi; gv-wa-s-da-wa-di-do-hi-no du-ni-gv-s-go-lv-ne na-s-gi tsu-na-ti-no-lv-hi."
        intervals [27]:
            xmin = 155.225
            xmax = 156.050
            text = ""
        intervals [28]:
            xmin = 156.050
            xmax = 175.655
            text = "021014: Tsi-sa-s-gi-ni u-go-hv u-tsa-ti sv-s-ga u-ye-lv-ne-i, a-le hi-a ni-du-we-se-le-i, U-ne-la-gi de-tse-li-se-he-s-di tsu-na-s-di di-ni-yo-li gv-gi-lu-tse-di-yi, a-le tle-s-di yi-di-tsi-nv-s-da-de-he-s-di; na-s-gi-ye-no nu-na-s-di U-ne-la-nv-hi u-tse-li-go-hi."
        intervals [29]:
            xmin = 175.655
            xmax = 176.650
            text = ""
        intervals [30]:
            xmin = 176.650
            xmax = 192.465
            text = "021015: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, i-yu-no gi-lo U-ne-la-nv-hi u-gv-wi-yu-hi ge-sv ni-da-da-ni-lv-gv-na i-ge-se-s-di na-s-gi-ya a-yo-li tsi-da-da-ni-lv-go-i, v-tla na-hna yi-wv-gv-yv-ha."
        intervals [31]:
            xmin = 192.465
            xmax = 193.340
            text = ""
        intervals [32]:
            xmin = 193.340
            xmax = 197.295
            text = "021016: Du-ne-sv-no a-le du-si-ta-dv, o-s-dv du-ne-tse-le-i."
        intervals [33]:
            xmin = 197.295
            xmax = 198.430
            text = ""
        intervals [34]:
            xmin = 198.430
            xmax = 219.720
            text = "021017: U-ni-gi-sv-no ga-nv-nv wu-lu-tsv, gi-lo i-yu-s-di u-di-tlo-e-lv-gi, a-le du-li-ni-qua-nv-ne-lv-gi, u-dv-dv-ne hi-a nu-we-se-le-i, Ho-s-dv Ta-de-yo-hv-s-gi, ga-do da-ga-dv-ne-li u-li-s-qua-di-s-di ni-ge-sv-na gv-ni-dv a-qua-tse-li i-yu-li-s-do-di-yi?"
        intervals [35]:
            xmin = 219.720
            xmax = 220.815
            text = ""
        intervals [36]:
            xmin = 220.815
            xmax = 232.960
            text = "021018: Tsi-sa-no hi-a nu-we-se-le-i, Ga-do-no ho-s-dv i-s-quo-se-ha a-yv?  V-tla gi-lo o-s-dv yi-gi, sa-quo u-wa-sv-hi-yu, na-s-gi U-ne-la-nv-hi."
        intervals [37]:
            xmin = 232.960
            xmax = 233.825
            text = ""
        intervals [38]:
            xmin = 233.825
            xmax = 255.265
            text = "021019: De-hi-ga-ta-ha di-ka-hna-wa-dv-s-di, na-s-gi, Tle-s-di tsa-da-yo-ne-lv-gi, Tle-s-di tsa-da-lv-gi, Tle-s-di tsa-no-s-gi-sv-gi, Tle-s-di ga-ye-go-gi tsa-no-he-lv-gi, Tle-s-di tsa-da-lo-nu-he-lv-gi, Tsa-do-da a-le tsa-tsi de-hi-lv-quo-de-s-di."
        intervals [39]:
            xmin = 255.265
            xmax = 256.305
            text = ""
        intervals [40]:
            xmin = 256.305
            xmax = 266.760
            text = "021020: U-ne-tsv-no hi-a nu-we-se-le-i, Ta-de-yo-hv-s-gi, hi-a na-s-gi ni-ga-dv da-gi-s-qua-ni-go-ta-nv tsi-tsu-tsa ge-sv nv-da-gv-wa-da-le-nv-dv."
        intervals [41]:
            xmin = 266.760
            xmax = 267.620
            text = ""
        intervals [42]:
            xmin = 267.620
            xmax = 294.740
            text = "021021: Tsi-sa-no du-ka-hna-nv, u-ge-yu-hi-yu nu-li-s-ta-ne-i, a-le hi-a nu-we-se-le-i, Su-da-le-gi tsa-lu-la; he-na wi-na-du-ga ni-ga-v go-hu-s-di tsa-na-v-i, a-le u-yo i-yu-na-dv-hna-de-gi gi-ne-lv-ha, tso-sv-no wi-tsa-he-s-di tsu-gv-wa-lo-di; a-le te-sv-ha, tsu-da-hna-wa-dv hi-yv-hv-ha, a-le s-gi-s-da-wa-de-sv-ha."
        intervals [43]:
            xmin = 294.740
            xmax = 295.785
            text = ""
        intervals [44]:
            xmin = 295.785
            xmax = 307.395
            text = "021022: U-yo-no u-ye-lv-ne na-s-gi na-tsi-we-se-lv, a-le e-hi-s-di gv-wa-da-nv-ti u-da-nv-se-i; u-tsa-ti-ye-no u-hna-e-i."
        intervals [45]:
            xmin = 307.395
            xmax = 308.365
            text = ""
        intervals [46]:
            xmin = 308.365
            xmax = 321.880
            text = "021023: Tsi-sa-no u-du-wi-dv du-ka-hna-ni-do-lv, hi-a ni-du-we-se-le gv-wa-s-da-wa-di-do-hi, Na-s-da-ya tsu-gv-wa-lo-di u-ni-hi U-ne-la-hv-hi u-tse-li-go-hi wu-ni-yv-s-di-yi."
        intervals [47]:
            xmin = 321.880
            xmax = 322.825
            text = ""
        intervals [48]:
            xmin = 322.825
            xmax = 345.385
            text = "021024: Gv-wa-s-da-wa-di-do-hi-no gv-wa-s-qua-ni-go-se-le na-s-gi nu-we-sv-i.  A-se-no Tsi-sa ta-li-ne i-u-ne-tsv, hi-a ni-du-we-se-le-i, Di-tsi-yo-li.  na-s-da-ya na-s-gi ge-nv-i-s-di ge-sv a-na-li-s-ga-s-do-di-s-gi, U-ne-la-nv-hi u-tse-li-go-hi wu-ni-yv-s-di-yi."
        intervals [49]:
            xmin = 345.385
            xmax = 346.180
            text = ""
        intervals [50]:
            xmin = 346.180
            xmax = 357.315
            text = "021025: U-tli a-hi-di-yu ge-mi-li yv-gi ga-sa-ne-na-dv-di-yi u-ga-dv-le-hi-s-di-yi, a-no u-we-hna-i yv-wi U-ne-la-nv-hi u-tse-li-go-hi wu-yv-s-di-yi."
        intervals [51]:
            xmin = 357.315
            xmax = 358.030
            text = ""
        intervals [52]:
            xmin = 358.030
            xmax = 367.180
            text = "021026: U-lo-sv-s-ta-nv-hi-no u-ni-s-qua-ni-go-s-ge-i, hi-a ni-da-na-da-we-se-he-i, Ga-go-ge ye-li ga-ye-tsi-s-de-lv-di?"
        intervals [53]:
            xmin = 367.180
            xmax = 367.935
            text = ""
        intervals [54]:
            xmin = 367.935
            xmax = 385.290
            text = "021027: Tsi-sa-no na-s-gi du-ka-hna-nv, hi-a nu-we-se-i, Yv-wi ge-sv na-s-gi i-gv-dv-ne-di ni-ge-sv-na, U-ne-la-nv-hi-s-gi-ni ge-sv v-tla; U-ne-la-nv-hi-ye-no ge-sv ni-ga-v go-hu-s-di i-gv-dv-ne-di."
        intervals [55]:
            xmin = 385.290
            xmax = 386.350
            text = ""
        intervals [56]:
            xmin = 386.350
            xmax = 396.610
            text = "021028: Hna-quo-no Qui-da u-le-nv-he hi-a nu-we-se-le-i, Gv-ni-yu-quo a-yv ni-ga-di-yu o-gv-de-tso-nv, a-le ni-hi i-tsv-s-da-wa-de-nv."
        intervals [57]:
            xmin = 396.610
            xmax = 397.405
            text = ""
        intervals [58]:
            xmin = 397.405
            xmax = 431.155
            text = "021029: Tsi-sa-no u-ne-tsv hi-a nu-we-se-i; U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, v-tla gi-lo ye-ha na-s-gi u-wv-de-tsv-hi i-ge-se-s-di a-da-ne-lv-i, a-le a-na-li-nv-tli, a-le tsu-do, a-le u-do-da, a-le u-tsi, a-le u-da-li-i, a-le tsu-we-tsi, a-le du-lo-ge-sv-i, a-yv ge-sv nv-di-ga-li-s-do-di-s-ge-s-di, a-le o-s-dv ka-no-he-dv nv-di-ga-li-s-do-di-s-ge-s-di,"
        intervals [59]:
            xmin = 431.155
            xmax = 432.080
            text = ""
        intervals [60]:
            xmin = 432.080
            xmax = 460.735
            text = "021030: Na-s-gi go-hi ge-sv a-tsi-ne-di ni-ge-sv-na ge-sv a-s-go-hi-tsu-qui i-yu-wa-gu-di u-lo-sv-s-di da-da-ne-lv-i, a-le a-na-li-nv-tli, a-le tsu-do, a-le tsu-tsi, a-le tsu-we-tsi, a-le de-ga-lo-ge-sv-i, a-gi-li-yo-i-s-di ge-sv ta-li u-dv-di; so-i-yi-no di-ge-sv u-li-s-qua-di-s-di ni-ge-sv-na gv-ni-dv."
        intervals [61]:
            xmin = 460.735
            xmax = 461.660
            text = ""
        intervals [62]:
            xmin = 461.660
            xmax = 470.565
            text = "021031: A-se-no u-ni-tsa-ta na-s-gi i-gv-yi tsi-gi, o-ni ge-se-s-di; o-ni-no tsi-gi, i-gv-yi ge-se-s-di."
        intervals [63]:
            xmin = 470.565
            xmax = 472.350
            text = ""
        intervals [64]:
            xmin = 472.350
            xmax = 496.940
            text = "021032: Ga-nv-nv-no a-na-i-se Tsi-lu-si-li-mi tsa-ni-ga-te-i; tsi-sa-no i-gv-yi du-we-nv-e-le-i; u-ni-s-qua-ni-go-se-no; na-s-gi-no a-na-li-s-da-wa-di-sv a-ni-s-ga-i-he-i.  Ta-li-ne-no du-ya-nv-hv ta-la-du i-ya-ni-dv, u-le-nv-he du-no-ne-le na-s-gi i-yu-li-s-da-ne-li-da-s-di ge-sv-i."
        intervals [65]:
            xmin = 496.940
            xmax = 497.720
            text = ""
        intervals [66]:
            xmin = 497.720
            xmax = 521.650
            text = "021033: [Hi-a ni-ga-we-s-ge-i;] Gv-ni-yu-quo Tsi-lu-si-li-mi wi-di-ga-ti; a-le yv-wi U-we-tsi do-da-ye-tsi-yo-si nu-ni-gv-wi-yu-sv a-tsi-lv a-ne-lo-hi a-le di-no-we-li-s-gi do-da-ge-tsi-yo-hi-se-li; a-le do-da-gv-wu-go-da-ne-li u-yo-hu-hi-s-di-yi, a-le tsu-na-da-le-nv-dv yv-wi wi-do-dv-ni-yo-hi-se-li;"
        intervals [67]:
            xmin = 521.650
            xmax = 522.380
            text = ""
        intervals [68]:
            xmin = 522.380
            xmax = 533.650
            text = "021034: A-le da-gv-wa-so-tlv-i-s-ta-ni, a-le da-gv-wa-li-v-ni-li, a-le do-da-gv-wa-li-tsi-s-qui, a-le da-gv-wa-li; tso-i-ne-no i-ga ta-li-ne do-dv-a-le-ni."
        intervals [69]:
            xmin = 533.650
            xmax = 534.525
            text = ""
        intervals [70]:
            xmin = 534.525
            xmax = 549.210
            text = "021035: Tsi-mi-no a-le Tsa-ni, Tse-qui-di tsu-we-tsi gv-wa-lu-tse-le-i, hi-a nu-ni-we-se-i, Ta-de-yo-hv-s-gi, s-gi-na-du-li-ha i-s-gi-na-dv-ne-di-yi nu-s-dv i-s-dv-ta-yo-se-di ge-sv-i."
        intervals [71]:
            xmin = 549.210
            xmax = 550.005
            text = ""
        intervals [72]:
            xmin = 550.005
            xmax = 555.405
            text = "021036: Hi-a-no ni-du-we-se-le-i, Ga-do-no i-s-da-du-li i-s-dv-ya-dv-ne-di-yi?"
        intervals [73]:
            xmin = 555.405
            xmax = 556.585
            text = ""
        intervals [74]:
            xmin = 556.585
            xmax = 571.695
            text = "021037: Hi-a-no ni-gv-wa-we-se-le-i, S-gi-na-li-s-go-lv-da-si, na-s-gi tso-gi-ni-di-yi, a-si-yv-wi hi-ga-ti-si-di-tlv, so-i-no hi-ga-s-ga-ni-di-tlv, tsa-tse-li ga-lv-quo-di-yu ge-sv-i."
        intervals [75]:
            xmin = 571.695
            xmax = 572.550
            text = ""
        intervals [76]:
            xmin = 572.550
            xmax = 594.035
            text = "021038: A-se-no Tsi-sa hi-a ni-du-we-se-le-i, v-tla yi-s-di-ga-ta-ha nu-s-dv i-s-di-ta-yo-hi-hv-i.  Tsi-sa ye-li-quo ge-s-da-di-ta-s-di u-li-s-qui-di na-s-gi a-qua-di-ta-s-di tsi-gi?  A-le di-ga-ye-s-da-wo-s-di na-s-gi di-da-wo-s-di ge-sv na-s-gi v-qua-wo-s-do-di tsi-gi?"
        intervals [77]:
            xmin = 594.035
            xmax = 594.920
            text = ""
        intervals [78]:
            xmin = 594.920
            xmax = 612.505
            text = "021039: Hi-a-no ni-gv-wa-we-se-le-i, ye-li-quo.  Tsi-sa-no hi-a ni-du-we-se-le-i, U-do-hi-yu-hi da-s-da-di-ta-hi u-li-s-qui-di na-s-gi a-yv a-qua-di-ta-s-di tsi-gi, a-le di-da-wo-s-di ge-sv a-yv v-qua-wo-s-do-di tsi-gi, na-s-gi do-da-ye-s-da-wo-s-ta-ni;"
        intervals [79]:
            xmin = 612.505
            xmax = 613.500
            text = ""
        intervals [80]:
            xmin = 613.500
            xmax = 627.835
            text = "021040: U-we-di-yi-s-gi-ni a-quo-lv tsi-ga-ti-si i-di-tlv, a-le tsi-ga-s-ga-ni i-di-tlv, v-tla a-yv a-qua-da-ne-di yi-gi; u-nv-sv-s-gi-ni na-s-gi ge-ga-dv-nv-i-s-da-ne-lv-hi tsi-gi"
        intervals [81]:
            xmin = 627.835
            xmax = 628.525
            text = ""
        intervals [82]:
            xmin = 628.525
            xmax = 636.905
            text = "021041: A-s-go-hi-no i-ya-ni-dv u-na-dv-ga-nv, u-na-le-nv-he u-tsa-ti e-s-ga du-ni-ye-lv-na-ne-le Tsi-mi a-le Tsa-ni."
        intervals [83]:
            xmin = 636.905
            xmax = 637.615
            text = ""
        intervals [84]:
            xmin = 637.615
            xmax = 657.295
            text = "021042: A-se-no tsi-sa wi-du-ya-nv-hv hi-a ni-du-we-se-le-i; I-tsi-ga-ta-ha na-s-gi u-ni-gv-wi-yu-hi ge-tsi-ye-lv-i ge-sv tsu-na-da-le-nv-dv yv-wi da-ne-wa-di-sv-i, di-gv-wa-na-ne-lo-do-di-yi na-nv-ne-ho-i; tsu-ni-lv-quo-di-no ge-sv gv-wa-na-da-li-ne-hi-de-ho-i."
        intervals [85]:
            xmin = 657.295
            xmax = 658.595
            text = ""
        intervals [86]:
            xmin = 658.595
            xmax = 670.625
            text = "021043: Ni-hi-s-gi-ni i-tse-hv v-tle-s-di na-s-gi yi-ni-tsv-ne-s-di; gi-lo-s-gi-ni a-tsi-lv-quo-di i-yu-li-s-do-di-yi u-du-li-s-ge-s-di, na-s-gi e-tsi-nv-si-da-s-di ge-se-s-di."
        intervals [87]:
            xmin = 670.625
            xmax = 671.540
            text = ""
        intervals [88]:
            xmin = 671.540
            xmax = 682.050
            text = "021044: A-le gi-lo ni-hi ni-tsa-dv-nv nu-gv-wi-yu-sv i-yu-li-s-do-di-yi u-du-li-s-ge-s-di, na-s-gi ni-ga-dv gv-wa-nv-si-do-hi ge-se-s-di."
        intervals [89]:
            xmin = 682.050
            xmax = 683.260
            text = ""
        intervals [90]:
            xmin = 683.260
            xmax = 697.040
            text = "021045: Na-s-quo-ye-no yv-wi U-we-tsi v-tla yu-lu-tsv go-hu-s-di a-ga-dv-ne-di-yi, go-hu-s-di-s-gi-ni u-da-dv-ne-di-yi, a-le gv-nv tsu-yo-hi-s-di-yi tsu-gu-yv-do-di-yi u-ni-tsa-ti."
        intervals [91]:
            xmin = 697.040
            xmax = 697.900
            text = ""
        intervals [92]:
            xmin = 697.900
            xmax = 717.790
            text = "021046: Tse-li-go-no u-ni-lu-tse-i, a-le na-s-gi Tse-li-go i-u-nu-go-tsv a-le na-s-gi gv-wa-s-da-wa-di-do-hi, a-le u-ni-tsa-ti yv-wi, di-ge-wi Qua-di-mi-ya, na-s-gi Di-mi-ya u-we-tsi, u-wo-le nv-no-hu-lo-di a-du-la-di-s-ge-i."
        intervals [93]:
            xmin = 717.790
            xmax = 718.860
            text = ""
        intervals [94]:
            xmin = 718.860
            xmax = 731.065
            text = "021047: U-dv-ga-nv-no na-s-gi Tsi-sa Na-se-li-di e-hi ge-sv-i, u-le-nv-he u-we-lu-ne, hi-a nu-we-se-i, De-wi U-we-tsi, Tsi-sa, s-gi-do-li-gi."
        intervals [95]:
            xmin = 731.065
            xmax = 731.905
            text = ""
        intervals [96]:
            xmin = 731.905
            xmax = 748.035
            text = "021048: U-ni-tsa-te-no gv-wa-gv-s-go-lv-ne gv-wa-ne-tse-le e-la-we-yi u-wv-di-yi; a-se-no u-tli-quo i-ga-i u-we-lu-ne-i, De-wi U-we-tsi s-gi-do-li-gi, a-di-s-ge-i."
        intervals [97]:
            xmin = 748.035
            xmax = 749.025
            text = ""
        intervals [98]:
            xmin = 749.025
            xmax = 762.040
            text = "021049: Tsi-sa-no u-le-wi-s-ta-nv u-ne-tse wa-tsi-ya-nv-di-yi.  U-ni-ya-nv-he-no di-ge-wi, hi-a nu-ni-we-se-le-i, U-ga-li-s-di-quo ha-da-nv-da-da; ta-le-hv-ga; di-tsa-ya-ni-ha."
        intervals [99]:
            xmin = 762.040
            xmax = 762.775
            text = ""
        intervals [100]:
            xmin = 762.775
            xmax = 768.655
            text = "021050: Na-s-gi-no u-da-i-nv u-nu-wo du-le-ne-i, a-le Tsi-sa wu-lu-tse-le-i."
        intervals [101]:
            xmin = 768.655
            xmax = 769.570
            text = ""
        intervals [102]:
            xmin = 769.570
            xmax = 782.425
            text = "021051: Tsi-sa-no u-ne-tsv hi-a nu-we-se-le-i, Ga-do tsa-du-li gv-ya-dv-ne-di-yi?  Di-ge-wi-no hi-a nu-we-se-le-i, Tsa-gv-wi-yu-hi, v-a-gi-go-wa-dv-di-yi [a-qua-du-li-ha.]"
        intervals [103]:
            xmin = 782.425
            xmax = 783.410
            text = ""
        intervals [104]:
            xmin = 783.410
            xmax = 796.705
            text = "021052: Tsi-sa-no hi-a nu-we-se-le-i, He-na-quo-no; tso-hi-yu-sv tsa-s-de-lv.  Gi-la-quo-no i-yv-dv gv-wa-go-wa-dv-di nu-li-s-ta-ne-i, a-le u-s-da-wa-dv-se Tsi-sa a-i-sv-i."
        intervals [105]:
            xmin = 796.705
            xmax = 797.230
            text = ""
