File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 711.920
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 711.920
        intervals: size = 93
        intervals [1]:
            xmin = 0.000
            xmax = 4.310
            text = ""
        intervals [2]:
            xmin = 4.310
            xmax = 19.325
            text = "012501: Hna-quo-no ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv na-s-gi-ya ge-se-s-di a-s-go-hi i-ya-ni-dv a-na-dv, na-s-gi tsi-du-ni-nv-se di-tsv-s-do-di a-le tsi-du-na-tlo-sv-se a-de-sv-hv-s-gi."
        intervals [3]:
            xmin = 19.325
            xmax = 20.240
            text = ""
        intervals [4]:
            xmin = 20.240
            xmax = 25.580
            text = "012502: Hi-s-gi-no i-ya-ni-dv a-ni-ga-ta-hna-i ge-se-i, hi-s-gi-no u-ni-ne-gu."
        intervals [5]:
            xmin = 25.580
            xmax = 26.730
            text = ""
        intervals [6]:
            xmin = 26.730
            xmax = 34.450
            text = "012503: U-ni-ne-gu du-ni-nv-se di-tsv-s-do-di a-se-no go-i nu-ni-ne-tsv-sv-na ge-se-i,"
        intervals [7]:
            xmin = 34.450
            xmax = 35.530
            text = ""
        intervals [8]:
            xmin = 35.530
            xmax = 46.310
            text = "012504: A-ni-ga-ta-hna-i-s-gi-ni du-ni-nv-se tsu-ni-tsv-s-do-di, a-le na-s-quo go-i u-ni-ne-tsv-se du-ni-tli-s-ta-ne di-te-li-do."
        intervals [9]:
            xmin = 46.310
            xmax = 47.340
            text = ""
        intervals [10]:
            xmin = 47.340
            xmax = 55.875
            text = "012505: A-si-no u-go-ni-yo-ge a-de-sv-hv-s-gi, ni-ga-dv a-ni-li-nv-ge-i, a-le u-ni-li-nv-tse-i."
        intervals [11]:
            xmin = 55.875
            xmax = 57.030
            text = ""
        intervals [12]:
            xmin = 57.030
            xmax = 67.420
            text = "012506: Sv-no-yi-no a-ye-li gi-lo a-s-da-ya u-ne-tse-i, hi-a nu-we-se-i; Gv-ni-yu-quo a-de-sv-hv-s-gi da-ya-i!  wi-de-tsa-tlo-i!"
        intervals [13]:
            xmin = 67.420
            xmax = 68.550
            text = ""
        intervals [14]:
            xmin = 68.550
            xmax = 76.725
            text = "012507: Hna-quo-no ni-ga-dv a-na-dv u-na-di-da-ne-se-i, a-le du-ni-tsi-no-s-ga-lv-he du-ni-tsv-s-dv-i."
        intervals [15]:
            xmin = 76.725
            xmax = 77.580
            text = ""
        intervals [16]:
            xmin = 77.580
            xmax = 90.010
            text = "012508: U-ni-ne-gu-no hi-a ni-du-ni-we-se-le a-ni-ga-ta-hna-i; I-ga-dv go-i i-tsa-tse-li s-gi-ne-v-si, do-gv-tlo-hi-se-ha-ye-no do-gi-tsv-s-dv-i."
        intervals [17]:
            xmin = 90.010
            xmax = 90.830
            text = ""
        intervals [18]:
            xmin = 90.830
            xmax = 105.860
            text = "012509: A-se-no a-ni-ga-ta-hna-i u-ni-ne-tsv hi-a nu-ni-we-se-i; Tla-ge ye-li yi-do-ge-gi-ye-li-ga ni-ga-dv, i-tse-na-quo-s-gi-ni di-ni-no-di-s-gv, i-tsv-sv wi-tsi-wa-hi."
        intervals [19]:
            xmin = 105.860
            xmax = 106.770
            text = ""
        intervals [20]:
            xmin = 106.770
            xmax = 120.260
            text = "012510: U-ni-wa-se-nv-no a-de-sv-hv-s-gi u-lu-tse-i, u-na-dv-nv-i-s-di-no na-s-gi i-tsu-la-ha tsa-ga-tsv-s-do-di-yi wu-ni-yv-le-i, a-le u-ni-s-du-ne ga-lo-hi-s-di-yi."
        intervals [21]:
            xmin = 120.260
            xmax = 121.640
            text = ""
        intervals [22]:
            xmin = 121.640
            xmax = 130.055
            text = "012511: O-ni-no na-s-quo a-ni-so-i a-na-dv u-ni-lu-tse-i, hi-a nu-ni-we-se-i; Tsa-gv-wi-yu-hi, Tsa-gv-wi-yu-hi, e-s-gi-s-du-gi."
        intervals [23]:
            xmin = 130.055
            xmax = 131.120
            text = ""
        intervals [24]:
            xmin = 131.120
            xmax = 138.705
            text = "012512: A-se-no tsu-ne-tsv hi-a nu-we-se-i; U-do-hi-yu-hi-ya i-tsv-yo-se-ha, v-tla yi-tsv-ga-ta-ha."
        intervals [25]:
            xmin = 138.705
            xmax = 139.495
            text = ""
        intervals [26]:
            xmin = 139.495
            xmax = 151.105
            text = "012513: Na-s-gi i-yu-s-di i-tsi-ya-wi-s-ge-s-di, v-tla-ye-no yi-tsi-ga-ta-ha na-hi-yu i-ga ge-sv a-le i-yu-tli-lo-dv ka-la-wa-di-sv u-lu-hi-s-di-yi yv-wi U-we-tsi."
        intervals [27]:
            xmin = 151.105
            xmax = 151.830
            text = ""
        intervals [28]:
            xmin = 151.830
            xmax = 164.280
            text = "012514: Na-s-gi-ya-quo-ye-no gi-lo a-s-ga-ya i-nv-tsi-wv-di-ga-lo-si-se-i, a-le tsi-wi-du-ya-nv-he tsu-nv-si-da-s-di, a-le tsi-du-yo-hi-se-le u-hna-v-i."
        intervals [29]:
            xmin = 164.280
            xmax = 165.190
            text = ""
        intervals [30]:
            xmin = 165.190
            xmax = 181.910
            text = "012515: A-si-yv-wi-no hi-s-gi i-ya-ga-yv-li a-de-lv du-ne-le-i, so-i-no ta-li i-ya-ga-yv-li, so-i-no sa-quo i-ya-ga-yv-li, a-ni-si-yv-wi-ha na-s-gi ye-li i-gv-wa-na-dv-ne-di ge-sv-i.  Hna-quo-no u-ni-gi-se-i."
        intervals [31]:
            xmin = 181.910
            xmax = 182.775
            text = ""
        intervals [32]:
            xmin = 182.775
            xmax = 192.845
            text = "012516: Hna-quo-no hi-s-gi i-ya-ga-yv-li tsa-tsi-ne-lv-hi u-we-nv-se wu-no-ta-ne-i, hi-s-gi-no i-ya-ga-yv-li u-ne-quo-tse-le-i."
        intervals [33]:
            xmin = 192.845
            xmax = 194.075
            text = ""
        intervals [34]:
            xmin = 194.075
            xmax = 201.740
            text = "012517: Na-s-quo a-le na ta-li i-ya-ga-yv-li tsa-tsi-ne-lv-hi na-s-quo ta-li i-ya-ga-yv-li u-ne-quo-tse-le-i."
        intervals [35]:
            xmin = 201.740
            xmax = 202.510
            text = ""
        intervals [36]:
            xmin = 202.510
            xmax = 216.725
            text = "012518: Sa-quo-s-gi-ni i-ya-ga-yv-li tsa-tsi-ne-lv-hi u-we-nv-se-i, wu-s-go-ha ga-do-hi, a-le wi-du-wa-s-ga-la-ne u-na-tla-i tsu-tse-li a-de-lv."
        intervals [37]:
            xmin = 216.725
            xmax = 217.565
            text = ""
        intervals [38]:
            xmin = 217.565
            xmax = 226.990
            text = "012519: I-lv-hi-yu-no i-yv-dv u-lu-tse na-s-gi ge-tsi-nv-si-da-s-di u-ni-na-tla-i, o-s-dv-no nu-nv-ne-le-i."
        intervals [39]:
            xmin = 226.990
            xmax = 227.890
            text = ""
        intervals [40]:
            xmin = 227.890
            xmax = 251.840
            text = "012520: Hi-s-gi-no i-ya-ga-yv-li tsa-tsi-ne-lv-hi u-lu-tse-i, a-le du-yo-le nv-wa-na-da-le hi-s-gi i-ya-ga-yv-li a-de-lv, hi-a nu-we-se-i; S-gi-na-tla-i, hi-s-gi i-ya-ga-yv-li a-de-lv de-s-gi-yo-hi-se-lv-gi; gv-ni-yu-quo nv-wa-na-da-le hi-s-gi i-ya-de-yv-li gv-gi-ne-quo-tse-lv."
        intervals [41]:
            xmin = 251.840
            xmax = 253.085
            text = ""
        intervals [42]:
            xmin = 253.085
            xmax = 280.970
            text = "012521: U-na-tla-i-no hi-a nu-we-se-le-i; O-si-yu!  ho-s-dv a-le hi-ga-li-ya e-tsa-nv-si-da-s-di!  du-yu-go-dv ni-tsa-dv-ne-lv u-s-di tsu-da-le-nv-dv de-tsa-lv-wi-s-da-ne-lv-i; u-tsa-ti tsu-da-le-nv-dv tsa-gv-wi-yu-sa-de-gi nv-da-gv-yv-ne-li; hi-yv-ha o-s-dv a-da-nv-da-di-s-di-yi tsa-na-tla-i u-tse-li-go-hi."
        intervals [43]:
            xmin = 280.970
            xmax = 281.960
            text = ""
        intervals [44]:
            xmin = 281.960
            xmax = 300.020
            text = "012522: Na-s-quo-no ta-li i-ya-ga-yv-li tsa-tsi-ne-lv-hi u-lu-tsv hi-a nu-we-se-i; S-gi-na-tla-i, ta-li i-ya-ga-yv-li a-de-lv de-s-gi-yo-hi-se-lv-gi; gv-ni-yu-quo nv-wa-na-da-le ta-li i-ya-ga-yv-li gv-gi-ne-quo-tse-lv."
        intervals [45]:
            xmin = 300.020
            xmax = 300.850
            text = ""
        intervals [46]:
            xmin = 300.850
            xmax = 327.155
            text = "012523: U-na-tla-i hi-a nu-we-se-le-i; O-si-yu!  ho-s-dv a-le hi-ga-li-ya e-tsa-nv-si-da-s-di!  du-yu-go-dv ni-tsa-dv-ne-lv u-s-di tsu-da-le-nv-dv de-tsa-lv-wi-s-da-ne-lv-i; u-tsa-ti tsu-da-le-nv-dv tsa-gv-wi-yu-sa-de-gi nv-da-gv-yv-ne-li; hi-yv-ha o-s-dv a-da-nv-da-di-s-di-yi tsa-na-tla-i u-tse-li-go-hi."
        intervals [47]:
            xmin = 327.155
            xmax = 328.060
            text = ""
        intervals [48]:
            xmin = 328.060
            xmax = 351.615
            text = "012524: Hna-quo-no sa-quo i-ya-ga-yv-li tsa-tsi-ne-lv-hi u-lu-tsv hi-a nu-we-se-i; S-gi-na-tla-i, gv-ga-ta-hv-gi, hi-s-da-yi-yu ge-sv-i, a-le hi-s-gu-de-s-gv-i na-hna ni-tsa-wi-sv-na ge-sv-i, a-le hu-te-s-gv-i na-hna ni-tsa-le-la-dv-nv-na ge-sv-i."
        intervals [49]:
            xmin = 351.615
            xmax = 352.470
            text = ""
        intervals [50]:
            xmin = 352.470
            xmax = 363.490
            text = "012525: A-le tsi-s-ga-i-hv-i a-que-nv-sv-gi, wi-da-gv-s-ga-la-nv-gi ga-do-hi a-de-lv di-tsa-tse-li-ga; gv-ni-yu-quo a-ni na-s-gi di-tsa-tse-li-ga."
        intervals [51]:
            xmin = 363.490
            xmax = 364.560
            text = ""
        intervals [52]:
            xmin = 364.560
            xmax = 384.975
            text = "012526: U-na-tla-i-no u-ne-tsv hi-a nu-we-se-le-i; Tsa-ne-gu-tsi-dv a-le tsa-da-nu-lv-di e-tsa-nv-si-da-s-di!  hi-ga-ta-hv-gi tsi-s-gu-de-s-gv na-hna na-gi-wi-sv-na ge-sv-i, a-le gu-te-s-gv na-hna na-gi-le-la-dv-nv-na ge-sv-i!"
        intervals [53]:
            xmin = 384.975
            xmax = 385.745
            text = ""
        intervals [54]:
            xmin = 385.745
            xmax = 400.610
            text = "012527: A-de-lv di-ni-s-qua-ni-go-di-s-gi-yi yi-wi-do-tsa-ne a-de-lv di-qua-tse-li-ga, na-s-gi-no go-hi tsi-tsi-lu-gi yi-da-gi-go-he di-qua-tse-li a-le u-ni-ne-quo-tsv-hi."
        intervals [55]:
            xmin = 400.610
            xmax = 401.510
            text = ""
        intervals [56]:
            xmin = 401.510
            xmax = 411.880
            text = "012528: Na-s-gi i-yu-s-di tsi-do-e-tsi-gi-si-quo sa-quo i-ya-ga-yv-li a-de-lv, a-s-go-hi-no i-ya-ga-yv-li tsu-hi tse-tsi-v-si."
        intervals [57]:
            xmin = 411.880
            xmax = 412.760
            text = ""
        intervals [58]:
            xmin = 412.760
            xmax = 426.600
            text = "012529: Gi-lo-ye-no u-he-s-di a-tsi-ne-di ge-se-s-di, u-tsa-ti-no u-s-qua-ni-go-de-s-di; gi-lo-s-gi-ni nu-hv-na ge-se-s-di a-tsi-gi-e-di-quo ge-se-s-di na-s-gi na-s-quo u-hv-i."
        intervals [59]:
            xmin = 426.600
            xmax = 427.520
            text = ""
        intervals [60]:
            xmin = 427.520
            xmax = 443.330
            text = "012530: Hi-a-no go-hu-s-di gv-do-di ni-ge-sv-na ga-nv-si-da-s-di do-yi-di-tlv tsu-li-si-gv we-tsa-da-u-ga; na-hna da-ni-yv-ge-s-di a-le da-ni-lv-da-gi-s-ge-s-di da-ni-nu-do-gv-i."
        intervals [61]:
            xmin = 443.330
            xmax = 444.540
            text = ""
        intervals [62]:
            xmin = 444.540
            xmax = 462.295
            text = "012531: I-yu-no hna-quo yv-wi U-we-tsi ga-lu-tsv-ha u-wa-sv u-tse-li-ga ga-lv-quo-di-yu ge-sv u-nu-wo-s-de-s-di, a-le ni-ga-dv ge-tsi-lv-quo-di di-ni-ka-hna-wa-di-do-hi da-ti-ne-he-s-di, hna-quo da-ga-ni ga-lv-quo-di-yu u-we-s-gi-lv-i;"
        intervals [63]:
            xmin = 462.295
            xmax = 463.575
            text = ""
        intervals [64]:
            xmin = 463.575
            xmax = 481.690
            text = "012532: I-gv-yi-di-tlv-no do-da-ge-tsi-la-wi-di ni-ga-di-yu nu-na-da-le-sv yv-wi, a-le do-dv-ga-le-nv-ta-ni na-s-gi-ya a-wi--di-ga-ti-ya tsi-da-ga-le-nv-di-s-go tsu-tse-li a-wi u-ni-no-de-na a-le a-wi di-ni-ha-nu-lv-hi."
        intervals [65]:
            xmin = 481.690
            xmax = 482.750
            text = ""
        intervals [66]:
            xmin = 482.750
            xmax = 492.625
            text = "012533: A-wi-no u-ni-no-de-na a-ga-ti-si i-di-tlv do-da-ga-go-ta-ni, a-wi-no di-ni-ha-nu-lv-hi a-ga-s-ga-ni i-di-tlv;"
        intervals [67]:
            xmin = 492.625
            xmax = 493.470
            text = ""
        intervals [68]:
            xmin = 493.470
            xmax = 514.130
            text = "012534: Hna-quo-no U-gv-wi-yu-hi hi-a ni-do-da-ga-we-se-li a-ga-ti-si i-di-tlv a-ni-do-na-i; E-tse-na, E-do-da I-tsi-lv-quo-ta-nv-hi, i-tsa-tse-li wi-ni-ga-li-s-da u-tse-li-go-hi e-tsa-li-s-go-lv-da-ne-lv-hi e-lo-hi tsu-do-tlv-nv nv-da-gv-wa-da-le-nv-dv."
        intervals [69]:
            xmin = 514.130
            xmax = 515.460
            text = ""
        intervals [70]:
            xmin = 515.460
            xmax = 528.335
            text = "012535: A-go-nu-ye-no a-gi-yo-si-s-gv-gi, v-s-gi-ye-la-s-ta-nv-no; a-gi-ta-de-gi-s-gv-gi, v-s-gi-u-nv-no; nv-gi-ga-ta-hv-na ge-sv-gi, v-s-gi-yv-ta-nv-gi;"
        intervals [71]:
            xmin = 528.335
            xmax = 529.030
            text = ""
        intervals [72]:
            xmin = 529.030
            xmax = 542.600
            text = "012536: A-gi-ye-lv-ha ge-sv-gi, do-s-gi-nu-wo-v-gi-no; a-gi-tlv-gv-gi, v-s-gi-ya-ga-ta-ni-lv-gi-no; di-da-s-du-di-yi v-gi-s-du-hv-gi, v-s-gi-wa-dv-hi-lv-gi-no."
        intervals [73]:
            xmin = 542.600
            xmax = 543.530
            text = ""
        intervals [74]:
            xmin = 543.530
            xmax = 560.455
            text = "012537: Hna-quo-no u-na-da-nv-ti dv-ni-ne-tsi hi-a nv-da-gv-wa-we-se-li; Tsa-gv-wi-yu-hi, i-la-gi-yu i-tsv-go-sv tsa-yo-si-s-ge-i, i-tsv-ye-la-s-ta-ne-no; a-le tsa-ta-de-gi-s-ge-i, i-tsv-u-ne-no;"
        intervals [75]:
            xmin = 560.455
            xmax = 561.310
            text = ""
        intervals [76]:
            xmin = 561.310
            xmax = 572.970
            text = "012538: I-la-gi-yu i-tsv-go-e ne-tsa-ga-ta-hv-na, i-tsv-yv-ta-ne-no; a-le tsa-ye-lv-ha ge-se-i, i-tsv-nu-wo-e-no;"
        intervals [77]:
            xmin = 572.970
            xmax = 574.390
            text = ""
        intervals [78]:
            xmin = 574.390
            xmax = 585.440
            text = "012539: A-le i-la-gi-yu i-tsv-go-e tsa-tlv-ge-i, a-le di-da-s-du-di-yi e-tsa-s-du-he-i, i-tsv-ya-ga-ta-ni-le-no?"
        intervals [79]:
            xmin = 585.440
            xmax = 586.780
            text = ""
        intervals [80]:
            xmin = 586.780
            xmax = 604.430
            text = "012540: U-gv-wi-yu-hi-no da-ka-ne-tsi hi-a ni-do-da-ga-we-se-li; U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, Na-s-gi-ye-no tsi-ne-tsa-dv-ne-lv u-s-di-ka-ni hi-a na-s-gi o-tsa-li-nv-tli, a-yv ni-s-gi-ya-dv-ne-lv-gi."
        intervals [81]:
            xmin = 604.430
            xmax = 605.490
            text = ""
        intervals [82]:
            xmin = 605.490
            xmax = 627.110
            text = "012541: Hi-a-no na-s-quo ni-do-da-ga-we-se-li a-ga-s-ga-ni i-di-tlv a-ni-do-na-i; S-gi-ya-da-nv-si, e-tsi-s-ga-tsv-hi, wi-na-s-dv-na a-tsi-lv-yi di-ge-sv wi-tsi-lo-hi, na-s-gi a-s-gi-na a-le tsu-tse-li di-ni-ka-hna-wa-di-do-hi ge-go-tlv-na-ne-lv-hi."
        intervals [83]:
            xmin = 627.110
            xmax = 628.510
            text = ""
        intervals [84]:
            xmin = 628.510
            xmax = 638.000
            text = "012542: A-go-nu-ye-no a-gi-yo-si-s-gv-gi, v-tla-no yi-s-gi-ye-la-s-ta-ne-i; a-gi-ta-de-gi-s-gv-gi, v-tla-no yi-s-gi-u-ne-i;"
        intervals [85]:
            xmin = 638.000
            xmax = 638.890
            text = ""
        intervals [86]:
            xmin = 638.890
            xmax = 657.115
            text = "012543: Nv-gi-ga-ta-hv-na ge-sv-gi, v-tla-no yi-s-gi-yv-ta-ne-i; a-gi-ye-lv-ha ge-sv-gi, v-tla-no yi-di-s-gi-nu-wo-e-i; a-gi-tlv-gv-gi, a-le di-da-s-du-di-yi v-gi-s-du-hv-gi, v-tla-no yi-s-gi-wa-dv-hi-le-i."
        intervals [87]:
            xmin = 657.115
            xmax = 657.900
            text = ""
        intervals [88]:
            xmin = 657.900
            xmax = 683.060
            text = "012544: Na-s-quo-no na-s-gi dv-ni-ne-tsi, hi-a nv-da-gv-wa-we-se-li, Tsa-gv-wi-yu-hi, i-la-gi-yu i-tsv-go-e tsa-yo-si-s-ge-i, a-le tsa-ta-de-gi-s-ge-i, a-le ne-tsa-ga-ta-hv-na ge-se-i, a-le tsa-ye-lv-ha ge-se-i, a-le tsa-tlv-ge-i, a-le di-da-s-du-di-yi e-tsa-s-du-he-i, ni-tsv-s-de-lv-hv-na-no ge-se-i?"
        intervals [89]:
            xmin = 683.060
            xmax = 683.810
            text = ""
        intervals [90]:
            xmin = 683.810
            xmax = 699.395
            text = "012545: Hna-quo-no da-ka-ne-tsi hi-a ni-do-da-ga-we-se-li; u-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, na-s-gi-ye-no ne-tsa-dv-ne-lv-na ge-sv u-s-di-ka-ni hi-a na-s-gi, a-yv v-tla yi-ni-s-gi-ya-dv-ne-le-i."
        intervals [91]:
            xmin = 699.395
            xmax = 700.200
            text = ""
        intervals [92]:
