File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 930.740
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 930.740
        intervals: size = 132
        intervals [1]:
            xmin = 0.000
            xmax = 4.485
            text = ""
        intervals [2]:
            xmin = 4.485
            xmax = 17.445
            text = "012701: Su-na-le-no nu-li-s-ta-nv, ni-ga-dv nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le di-ni-la-wi-gi a-ne-hv a-wi u-ni-no-he-le i-yu-na-dv-ne-di-yi Tsi-sa u-ni-hi-s-di-yi."
        intervals [3]:
            xmin = 17.445
            xmax = 18.240
            text = ""
        intervals [4]:
            xmin = 18.240
            xmax = 27.930
            text = "012702: Hna-quo-no u-na-lv-lv u-ne-li-sa-na-wi-dv-he-i, Qua-ni-dv Qua-le-di u-gv-wi-yu-hi wi-du-ni-yo-hi-se-le-i."
        intervals [5]:
            xmin = 27.930
            xmax = 29.150
            text = ""
        intervals [6]:
            xmin = 29.150
            xmax = 50.630
            text = "012703: Hna-quo-no Tsu-da-si na-s-gi u-lo-nu-he-lv-hi u-do-le-ho-sv da-gu-go-da-ne-lv-i u-ne-tli-yv-se u-da-nv-dv-i, a-le nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le tsu-na-dv-so-nv-hi do-u-yo-he-le tso-a-s-go-hi a-ye-li--a-de-lv tsu-na-gv-wa-lo-di,"
        intervals [7]:
            xmin = 50.630
            xmax = 51.290
            text = ""
        intervals [8]:
            xmin = 51.290
            xmax = 65.720
            text = "012704: Hi-a nu-we-se-i; tsi-s-ga-nv-gi nu-s-ga-nv-tsv-na gi-gv tsi-ga-tlu-da.  Hi-a-no nu-ni-we-se-i; Ga-do na-s-gi a-yv o-gv-do-di?  Tsv-sv na-s-gi di-tsa-lv-wi-s-da-si."
        intervals [9]:
            xmin = 65.720
            xmax = 66.760
            text = ""
        intervals [10]:
            xmin = 66.760
            xmax = 76.740
            text = "012705: A-le du-di-nv a-de-lv na-hna di-ga-la-wi-i-s-di-yi, a-le u-nu-go-tse-i, a-le i-yv-dv wu-lo-sv, u-wa-sv wu-da-dv-ne-i."
        intervals [11]:
            xmin = 76.740
            xmax = 77.670
            text = ""
        intervals [12]:
            xmin = 77.670
            xmax = 91.915
            text = "012706: Nu-ni-gv-wi-yu-sv-no a-tsi-lv--a-ne-lo-hi du-ni-gi-sv a-de-lv hi-a nu-ni-we-se-i; v-tla du-yu-go-dv yi-ga-gi a-de-lv--di-di-yi yi-di-di-hv-s-ga, gi-gv-ye-no tsu-gv-wa-la-nv-hi."
        intervals [13]:
            xmin = 91.915
            xmax = 92.810
            text = ""
        intervals [14]:
            xmin = 92.810
            xmax = 104.245
            text = "012707: U-ni-no-he-lv-no, u-ni-wa-hi-s-ta-ne v-ti di-go-tlv-s-gi u-lo-ge-sv-i na-hna a-ne-do-hi di-ge-tsi-ni-so-di-yi."
        intervals [15]:
            xmin = 104.245
            xmax = 105.080
            text = ""
        intervals [16]:
            xmin = 105.080
            xmax = 111.190
            text = "012708: Na-s-gi i-yu-s-di na-s-gi tlo-ge-si gi-gv u-lo-ge-sv a-no-se-ha go-hi tsi-gi."
        intervals [17]:
            xmin = 111.190
            xmax = 112.445
            text = ""
        intervals [18]:
            xmin = 112.445
            xmax = 132.080
            text = "012709: Hna-quo-no u-do-hi-yu-ne tsu-ne-tse Tse-li-ma-ya a-do-le-ho-s-gi, hi-a tsi-nu-we-se-i; A-le du-ni-gi-sv-gi tso-a-s-go-hi a-ye-li--a-de-lv na-s-gi na tsu-gv-wa-ta-nv-hi, na-s-gi tsa-tsi-gv-wa-lo-ta-nv-hi, I-si-li tsu-we-tsi tsu-ni-gv-wa-lo-ta-nv-hi,"
        intervals [19]:
            xmin = 132.080
            xmax = 133.465
            text = ""
        intervals [20]:
            xmin = 133.465
            xmax = 141.710
            text = "012710: A-le u-ni-wa-hi-s-ta-nv-gi v-ti di-go-tlv-s-gi u-lo-ge-sv-i, na-s-gi-ya Yi-ho-wa a-que-yo-nv-i."
        intervals [21]:
            xmin = 141.710
            xmax = 142.540
            text = ""
        intervals [22]:
            xmin = 142.540
            xmax = 159.965
            text = "012711: Tsi-sa-no ga-do-ge i-gv-yi-di-tlv u-gv-wi-yu-hi u-wo-lv-i.  U-gv-wi-yu-hi-no u-dv-dv-ne-i, hi-a nu-we-se-i; ni-hi-s-go Tsa-gv-wi-yu-hi A-ni-tsu-si u-na-tse-li-ga?  Tsi-sa-no hi-a nu-we-se-le-i; Ye-li-ni-wi."
        intervals [23]:
            xmin = 159.965
            xmax = 161.170
            text = ""
        intervals [24]:
            xmin = 161.170
            xmax = 169.700
            text = "012712: Nu-ni-gv-wi-yu-sv-no a-tsi-lv--a-ne-lo-hi a-le di-ni-la-wi-gi gv-wa-yi-li-do-lv v-tla yu-ne-tse-i."
        intervals [25]:
            xmin = 169.700
            xmax = 171.425
            text = ""
        intervals [26]:
            xmin = 171.425
            xmax = 182.630
            text = "012713: Hna-quo-no Qua-le-di hi-a nu-we-se-le-i; Tla-s-go ya-dv-gi-ha ni-ga-v gv-ni-ge-sv na-nv-ne-hv a-ni-ga-ta-hi ge-tsa-tlu-di-s-gv-i?"
        intervals [27]:
            xmin = 182.630
            xmax = 183.575
            text = ""
        intervals [28]:
            xmin = 183.575
            xmax = 192.790
            text = "012714: A-se-no v-tla sa-quo-u-nv yi-nu-ne-tse-i, na-s-gi i-yu-s-di u-gv-wi-yu-hi u-tsa-ti u-s-qua-ni-go-se-i."
        intervals [29]:
            xmin = 192.790
            xmax = 193.680
            text = ""
        intervals [30]:
            xmin = 193.680
            xmax = 204.700
            text = "012715: Di-li-s-da-yv-di-yi-no ge-sv i-yu-i u-gv-wi-yu-hi tsu-yo-hi-se-di ge-so sa-quo a-yv-gi, hi-a-quo a-ne-la yv-wi."
        intervals [31]:
            xmin = 204.700
            xmax = 205.610
            text = ""
        intervals [32]:
            xmin = 205.610
            xmax = 213.295
            text = "012716: Na-hi-yu-no di-ga-no-tsa-li a-yv-gi u-ni-ka-he Qua-la-qua tsu-do-i-dv."
        intervals [33]:
            xmin = 213.295
            xmax = 214.180
            text = ""
        intervals [34]:
            xmin = 214.180
            xmax = 229.990
            text = "012717: Na-s-gi i-yu-s-di hna-quo du-ni-la-wi-tsv Qua-le-di hi-a ni-du-we-se-le-i; Ga-go i-tsa-du-li di-tsv-yo-hi-se-di-yi?  Qua-la-qua-s-go?  Tsi-sa-ge Ga-lo-ne-dv tsa-no-se-ho-i?"
        intervals [35]:
            xmin = 229.990
            xmax = 231.160
            text = ""
        intervals [36]:
            xmin = 231.160
            xmax = 237.780
            text = "012718: A-ga-ta-he-ye-no a-nv-yu-gv-quo nv-di-ga-li-s-do-di-s-gv du-ni-yo-sv-i."
        intervals [37]:
            xmin = 237.780
            xmax = 238.835
            text = ""
        intervals [38]:
            xmin = 238.835
            xmax = 264.810
            text = "012719: U-wo-lv-no di-gu-go-do-di-yi ga-s-gi-lv-i u-da-li-i tsu-da-nv-se-i, hi-a nv-tsu-we-se-le-i; Tle-s-di ni-hi go-hu-s-di na na-s-ga-nv-na a-s-ga-ya u-gv-wa-li yi-di-tsa-lv-wi-s-da-ne-le-s-di, u-tsa-ti-ye-no tsi-gi-li-yo-gi go-hi i-ga ga-s-gi-da-s-gv-i na-s-gi nv-di-ga-li-s-do-di-s-gv-i."
        intervals [39]:
            xmin = 264.810
            xmax = 266.145
            text = ""
        intervals [40]:
            xmin = 266.145
            xmax = 282.070
            text = "012720: A-se-no nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le di-ni-la-wi-gi du-ni-s-di-ye-ta-ne u-ni-tsa-ti ge-sv Qua-la-qua u-ni-ta-yo-se-di-yi, Tsi-sa-no u-ni-hi-s-di-yi."
        intervals [41]:
            xmin = 282.070
            xmax = 283.110
            text = ""
        intervals [42]:
            xmin = 283.110
            xmax = 295.210
            text = "012721: U-gv-wi-yu-hi-no u-ne-tsv hi-a ni-du-we-se-le-i; Ga-go hi-a a-ni-ta-li ge-sv i-tsa-du-li di-tsv-yo-hi-se-di-yi?  Qua-la-qua, u-na-dv-ne-i."
        intervals [43]:
            xmin = 295.210
            xmax = 296.190
            text = ""
        intervals [44]:
            xmin = 296.190
            xmax = 308.070
            text = "012722: Qua-le-di hi-a ni-du-we-se-le-i; Ga-do-no da-tsi-yv-ne-li Tsi-sa, Ga-lo-ne-dv tsa-no-se-ho-i?  Wa-ga-dv-v-ga, gv-wo-se-le ni-ga-dv."
        intervals [45]:
            xmin = 308.070
            xmax = 309.010
            text = ""
        intervals [46]:
            xmin = 309.010
            xmax = 323.320
            text = "012723: U-gv-wi-yu-hi-no hi-a nu-we-se-i; Ga-do-no, ga-do u-dv-ne-lv u-s-ga-nv-tsv?  A-se-no u-tli-quo ni-ga-e u-ne-lu-ne-i, wa-ga-dv-v-ga, a-na-di-s-gv-i."
        intervals [47]:
            xmin = 323.320
            xmax = 324.230
            text = ""
        intervals [48]:
            xmin = 324.230
            xmax = 352.165
            text = "012724: Qua-le-di u-do-le-ho-sv di-gv-wa-se-go-gi-s-di ni-ge-sv-na ge-sv-i, a-le u-na-da-su-ye-dv u-na-li-ta-lv-nv-gi, a-ma wo-ne-gi-se-i, a-le du-su-le-he u-ni-tsa-ti a-ni-ga-ta-hv-i, hi-a nu-we-se-i; A-yv v-tla a-gi-s-ga-nv-tsv-hi yi-gi hi-a nu-s-ga-nv-tsv-na yv-wi u-gi-gv.  Ni-hi i-tsa-ga-sa-ya-s-da."
        intervals [49]:
            xmin = 352.165
            xmax = 353.050
            text = ""
        intervals [50]:
            xmin = 353.050
            xmax = 362.255
            text = "012725: Ni-ga-dv-no yv-wi u-ni-ne-tse-i, hi-a nu-ni-we-se-i; U-gi-gv a-yv a-le tso-ge-tsi o-gi-nv-ga-le-s-di."
        intervals [51]:
            xmin = 362.255
            xmax = 363.060
            text = ""
        intervals [52]:
            xmin = 363.060
            xmax = 372.070
            text = "012726: Hna-quo-no Qua-la-qua de-u-yo-hi-se-le-i; u-li-v-no-nv-no Tsi-sa du-yo-se a-ga-dv-di-yi."
        intervals [53]:
            xmin = 372.070
            xmax = 372.960
            text = ""
        intervals [54]:
            xmin = 372.960
            xmax = 388.260
            text = "012727: Hna-quo-no a-ni-ya-wi-s-gi u-gv-wi-yu-hi tsu-tse-li-ga u-gv-wi-yu-hi ga-ne-lv u-ni-yv-ta-ne Tsi-sa, a-le na-hna de-gv-wa-du-wi-s-ta-ne ni-ga-dv su-na-da-tlu-gi a-ni-ya-wi-s-gi."
        intervals [55]:
            xmin = 388.260
            xmax = 389.125
            text = ""
        intervals [56]:
            xmin = 389.125
            xmax = 393.630
            text = "012728: Du-ni-nu-we-sv-no, gi-ga-ge ga-sa-le-na u-ni-nu-wo-e-i."
        intervals [57]:
            xmin = 393.630
            xmax = 394.570
            text = ""
        intervals [58]:
            xmin = 394.570
            xmax = 418.850
            text = "012729: A-le u-ni-s-de-yo-nv a-li-s-du-lo tsu-tsa-yo-s-di go-tlv-ta-nv-hi, u-ni-s-du-la-ne-i, a-le ga-na-s-da a-ga-ti-si i-di-tlv u-na-sv-ga-la-di-s-ta-ne-i; a-le da-na-li-ni-qua-nv-ne-he a-le a-na-de-ho-di-s-ge-i, hi-a na-ni-we-s-ge-i; I-tsv-yo-li-ga, Tsa-gv-wi-yu-hi A-ni-tsu-si u-na-tse-li-ga."
        intervals [59]:
            xmin = 418.850
            xmax = 419.840
            text = ""
        intervals [60]:
            xmin = 419.840
            xmax = 426.015
            text = "012730: Du-na-li-tsi-que-no a-le u-ni-yv-e-le ga-na-s-da a-le u-ni-s-qua-lv-ni-s-ta-ne-i."
        intervals [61]:
            xmin = 426.015
            xmax = 427.200
            text = ""
        intervals [62]:
            xmin = 427.200
            xmax = 439.270
            text = "012731: U-na-de-ho-ta-no-nv-no u-ni-nu-we-se ga-sa-le-na, a-le u-wa-sv tsu-nu-we du-ni-nu-wo-e-i; a-le u-na-dv-di-yi wu-na-ti-nv-s-ta-ne-i."
        intervals [63]:
            xmin = 439.270
            xmax = 440.275
            text = ""
        intervals [64]:
            xmin = 440.275
            xmax = 455.170
            text = "012732: U-ni-nu-go-tsv-no u-ni-wa-dv-he a-s-ga-ya Sa-li-ni e-hi Sa-wa-ni tsu-do-i-dv; na-s-gi gv-s-ga-i-s-da-gi nu-nv-ne-le u-we-nv-s-di-yi tsu-da-hna-wa-dv."
        intervals [65]:
            xmin = 455.170
            xmax = 456.330
            text = ""
        intervals [66]:
            xmin = 456.330
            xmax = 463.250
            text = "012733: Wu-ni-lu-tsv-no Go-li-ga-da du-do-v-i, na-s-gi u-s-qua-lu-go-i tsi-ga-dv-ga,"
        intervals [67]:
            xmin = 463.250
            xmax = 464.015
            text = ""
        intervals [68]:
            xmin = 464.015
            xmax = 475.985
            text = "012734: Tsu-ni-tso-ya-s-di u-di-ta-s-di a-da-ga a-su-yi u-ni-ne-ne-le-i, u-ne-lv-ta-nv-no v-tla yu-du-lv-he u-di-ta-s-di-yi."
        intervals [69]:
            xmin = 475.985
            xmax = 476.700
            text = ""
        intervals [70]:
            xmin = 476.700
            xmax = 495.360
            text = "012735: U-na-dv-ne-no a-le du-ni-ya-do-le tsu-nu-wo a-na-sa-s-di-s-ge-i; na-s-gi-no u-do-hi-yu-ne a-do-le-ho-s-gi tsu-ne-tse-i, hi-a tsi-nu-we-se-i; Di-qua-nu-wo du-ni-ya-do-lv-gi, a-le a-qua-nu-wo u-na-sa-s-ta-nv-gi."
        intervals [71]:
            xmin = 495.360
            xmax = 496.450
            text = ""
        intervals [72]:
            xmin = 496.450
            xmax = 499.700
            text = "012736: U-na-nv-ne-no a-le u-ni-ya-wi-se."
        intervals [73]:
            xmin = 499.700
            xmax = 500.630
            text = ""
        intervals [74]:
            xmin = 500.630
            xmax = 516.430
            text = "012737: U-ni-ya-lv-ne-no ga-lv-la-di-tlv u-li-s-da-dv-i i-yu-s-di ge-sv u-li-yi-li-de-hv-i, hi-a ni-gv-ne go-we-le-i; Hi-A-Yo Tsi-Sa U-Gv-Wi-Yu-Hi A-Ni-Tsu-Si U-Na-Tse-Li-Ga."
        intervals [75]:
            xmin = 516.430
            xmax = 517.340
            text = ""
        intervals [76]:
            xmin = 517.340
            xmax = 528.590
            text = "012738: Na-s-quo-no i-tsu-la-ha de-ge-ga-dv-ne a-ni-ta-li a-ni-no-s-gi-s-gi, sa-quo a-ga-ti-si i-di-tlv, so-i-no a-ga-s-ga-ni i-di-tlv."
        intervals [77]:
            xmin = 528.590
            xmax = 529.670
            text = ""
        intervals [78]:
            xmin = 529.670
            xmax = 536.915
            text = "012739: Na-v-no a-ni-lo-s-gi ga-gv-wa-so-tlv-de-i, a-le da-na-li-s-dv-ne-he-i,"
        intervals [79]:
            xmin = 536.915
            xmax = 537.690
            text = ""
        intervals [80]:
            xmin = 537.690
            xmax = 556.395
            text = "012740: Hi-a na-ni-we-s-ge-i; u-dv-na--di-ga-la-wi-i-s-di-yi hi-yo-s-di-s-gi, tso-i-quo-no i-ga hi-ye-i-li-do-hi ha-ne-s-ge-s-gi, ha-li-s-de-lv tsv-sv; i-yu-no ni-hi U-ne-la-nv-hi U-we-tsi ge-se-s-di, da-da-hna-wa-s-dv e-ha-tlo-a-hi."
        intervals [81]:
            xmin = 556.395
            xmax = 557.680
            text = ""
        intervals [82]:
            xmin = 557.680
            xmax = 568.230
            text = "012741: Na-s-quo-no nu-ni-gv-wi-yu-sv a-tsi-lv-a-ne-lo-hi a-le di-no-we-li-s-gi a-le di-ni-la-wi-gi a-ni-ye-li-s-gv-i hi-a na-ni-we-s-ge-i;"
        intervals [83]:
            xmin = 568.230
            xmax = 569.440
            text = ""
        intervals [84]:
            xmin = 569.440
            xmax = 585.770
            text = "012742: A-ni-so-i da-s-de-li-s-gv-gi, u-wa-sv-s-gi-ni v-tla yv-gv-li-s-de-lv.  I-yu-no U-gv-wi-yu-hi I-si-li u-na-tse-li ge-se-s-di, hna-quo da-da-hna-wa-s-dv e-a-tlo-a-hi, gi-la-no da-ye-do-i-yu-ni."
        intervals [85]:
            xmin = 585.770
            xmax = 586.700
            text = ""
        intervals [86]:
            xmin = 586.700
            xmax = 597.895
            text = "012743: U-ne-la-nv-hi u-li-s-ga-s-do-dv-gi; hna-quo wu-s-de-lv i-yu-no u-lv-quo-de-s-di; hi-a-ye-no tsi-ni-ga-we-s-gv-gi, U-ne-la-nv-hi E-do-da."
        intervals [87]:
            xmin = 597.895
            xmax = 599.150
            text = ""
        intervals [88]:
            xmin = 599.150
            xmax = 605.620
            text = "012744: A-ni-no-s-gi-s-gi-no na-s-gi i-tsu-la-ha di-ge-ga-dv-nv-hi na-s-quo ga-gv-wa-so-tlv-de-i."
        intervals [89]:
            xmin = 605.620
            xmax = 606.370
            text = ""
        intervals [90]:
            xmin = 606.370
            xmax = 618.900
            text = "012745: Hna-quo-no i-ga u-da-le-nv-dv tso-i-ne i-yu-tli-lo-dv ka-la-wa-di-sv i-ya-s-ti u-sv-hi-ye-yi i-di-tlv u-li-si-hv-sv-gi ni-gv na-s-gi ga-do-hi."
        intervals [91]:
            xmin = 618.900
            xmax = 619.560
            text = ""
        intervals [92]:
            xmin = 619.560
            xmax = 644.070
            text = "012746: Tso-i-ne-no i-yu-tli-lo-dv i-yv ka-ta-wa-di-sv u-sv-hi-ye-yi i-di-tlv Tsi-sa u-ne-tse a-s-da-ya, hi-a nu-we-se-i; I-la, I-la, la-ma sa-qua-da-ni?  Na-s-gi hi-a nu-s-di ga-dv-gv-i, U-ne-la-nv-hi a-qua-tse-li-ga, U-ne-la-nv-hi a-qua-tse-li-ga, ga-do-no i-s-quv-de-tsv-quo?"
        intervals [93]:
            xmin = 644.070
            xmax = 645.100
            text = ""
        intervals [94]:
            xmin = 645.100
            xmax = 653.410
            text = "012747: I-ga-dv-no na-hna a-ni-do-na-i na-s-gi u-na-dv-ga-nv, I-la-ya a-ya-ni-ha hi-a, u-na-dv-ne-i."
        intervals [95]:
            xmin = 653.410
            xmax = 654.485
            text = ""
        intervals [96]:
            xmin = 654.485
            xmax = 672.095
            text = "012748: Gi-la-quo-no i-yv-dv a-si-yv-wi du-s-qua-lv-ta-ne-i, a-le wu-ne-se du-wo-li, a-le tsu-ni-tso-ya-s-di u-ka-li-i-s-ta-ne-i, ga-na-s-do-hi-no u-we-qua-do-ta-nv wu-nv-ne-le na-s-gi u-di-ta-s-di."
        intervals [97]:
            xmin = 672.095
            xmax = 673.190
            text = ""
        intervals [98]:
            xmin = 673.190
            xmax = 682.290
            text = "012749: I-ga-dv-no hi-a nu-ni-we-se-i; U-ne-la-gi, i-da-do-le-ho-hi, tsi-go-no I-la-ya da-ga-lu-tsi da-yu-s-de-lv-hi-li."
        intervals [99]:
            xmin = 682.290
            xmax = 683.100
            text = ""
        intervals [100]:
            xmin = 683.100
            xmax = 689.780
            text = "012750: Tsi-sa-no ta-li-ne a-s-da-ya u-ne-tsv de-u-yo-se u-da-nv-do."
        intervals [101]:
            xmin = 689.780
            xmax = 690.575
            text = ""
        intervals [102]:
            xmin = 690.575
            xmax = 710.440
            text = "012751: Gv-ni-yu-quo-no a-nu-wo a-ye-do-la-dv u-dv-na--di-ga-la-wi-i-s-di-yi du-li-s-tlu-ye-i, ga-lv-la-di tsu-le-nv-he e-la-di wu-s-qua-di-s-ta-ne-i; a-le ga-do-hi u-li-te-lv-ne-i, a-le nv-ya du-na-li-s-tlu-ye-i."
        intervals [103]:
            xmin = 710.440
            xmax = 711.430
            text = ""
        intervals [104]:
            xmin = 711.430
            xmax = 721.395
            text = "012752: Da-tse-li-s-dv-no du-li-s-du-i-se-i, a-le u-ni-tsa-ti u-na-da-nv-ti u-ni-li-nv-tsv-hi u-na-di-da-ne-se-i,"
        intervals [105]:
            xmin = 721.395
            xmax = 722.335
            text = ""
        intervals [106]:
            xmin = 722.335
            xmax = 734.670
            text = "012753: A-le da-tse-li-s-dv du-ni-nu-go-tse tsu-le-nv-hi ni-ge-se-i, a-le ga-lv-quo-di-yu ga-du-hv u-ni-yv-le-i, a-le u-ni-tsa-te gv-ni-ge-sv ni-du-na-dv-ne-le-i."
        intervals [107]:
            xmin = 734.670
            xmax = 735.180
            text = ""
        intervals [108]:
            xmin = 735.180
            xmax = 758.745
            text = "012754: Hna-quo-no a-s-go-hi-tsu-qui di-da-ti-ni-do-hi a-le na-s-gi na i-tsu-la-ha Tsi-sa gv-wa-ya-wi-s-gi, u-na-do-le-ho-sv ga-do-hi a-li-te-lv-hv-s-gv-i, a-le na-s-gi nu-li-s-ta-ni-do-lv-i, u-tsa-te u-ni-s-ga-le-i, hi-a nu-ni-we-se-i; U-do-hi-yu-hi-ya U-ne-la-nv-hi U-we-tsi ge-se hi-a."
        intervals [109]:
            xmin = 758.745
            xmax = 759.550
            text = ""
        intervals [110]:
            xmin = 759.550
            xmax = 772.695
            text = "012755: Na-hna-no a-ni-do-na-e u-ni-tsa-te a-ni-ge-yv ge i-yv-dv do-di-ni-ka-ne-i, na-s-gi Tsi-sa Ge-li-li nv-da-gv-wa-s-da-wa-dv-dv gv-wa-s-de-lv-hi-do-lv-hi,"
        intervals [111]:
            xmin = 772.695
            xmax = 773.500
            text = ""
        intervals [112]:
            xmin = 773.500
            xmax = 785.080
            text = "012756: Na-hna u-na-da-su-ye Me-li Ma-gi-de-li e-hi, a-le Me-li Tsi-mi a-le Tso-si u-ni-tsi, a-le Tse-qui-di tsu-we-tsi u-ni-tsi."
        intervals [113]:
            xmin = 785.080
            xmax = 785.720
            text = ""
        intervals [114]:
            xmin = 785.720
            xmax = 799.930
            text = "012757: U-sv-no nu-li-s-ta-nv u-lu-tse u-we-hna-i a-s-ga-ya A-li-ma-di-yi e-hi Tso-wa tsu-do-i-dv, na-s-quo na-s-gi Tsi-sa u-s-da-wa-di-do-hi ge-se-i;"
        intervals [115]:
            xmin = 799.930
            xmax = 800.920
            text = ""
        intervals [116]:
            xmin = 800.920
            xmax = 812.770
            text = "012758: Qua-le-di-yi u-we-nv-se-i, Tsi-sa a-ye-lv-i wu-ta-yo-le-i.  Hna-quo-no Qua-le-di u-ne-tse a-ye-lv-i tsu-ni-yo-hi-se-di-yi."
        intervals [117]:
            xmin = 812.770
            xmax = 813.750
            text = ""
        intervals [118]:
            xmin = 813.750
            xmax = 820.420
            text = "012759: Tso-wa-no a-ye-lv u-ne-sv u-we-tsa-nu-lo-ta-ne ga-da-ha ni-ge-sv-na a-nu-wo u-ne-gv;"
        intervals [119]:
            xmin = 820.420
            xmax = 821.185
            text = ""
        intervals [120]:
            xmin = 821.185
            xmax = 837.585
            text = "012760: A-le u-nv-ne u-wa-sv u-tse-li i-tse di-da-ni-so-di-yi, na-s-gi u-yo-hi u-ta-le-sv-i; e-qua-no nv-ya ga-lo-hi-s-di-yi a-tse-li-s-dv wu-we-sa-qua-le-lv u-da-nv-se-i."
        intervals [121]:
            xmin = 837.585
            xmax = 838.670
            text = ""
        intervals [122]:
            xmin = 838.670
            xmax = 847.575
            text = "012761: Na-hna-no i-gv-yi-di-tlv di-da-ni-so-di-yi du-no-le Me-li Ma-gi-de-li e-hi a-le so-i Me-li."
        intervals [123]:
            xmin = 847.575
            xmax = 848.215
            text = ""
        intervals [124]:
            xmin = 848.215
            xmax = 861.970
            text = "012762: A-le u-gi-tsv-dv, a-dv-nv-i-s-do-di-yi i-ga u-lo-so-nv-hi, nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le A-ni-qua-li-si de-gv-wa-la-wi-tse Qua-le-di,"
        intervals [125]:
            xmin = 861.970
            xmax = 862.840
            text = ""
        intervals [126]:
            xmin = 862.840
            xmax = 877.095
            text = "012763: Hi-a nu-ni-we-se-i; Tsa-gv-wi-yu-hi, o-ga-nv-ta na-s-gi na a-da-lo-nu-he-s-gi, a-si-quo tsi-gv-nv-gi, hi-a tsi-nu-we-sv-gi; Tso-i-ne-quo i-ga do-dv-ga-le-ni."
        intervals [127]:
            xmin = 877.095
            xmax = 877.690
            text = ""
        intervals [128]:
            xmin = 877.690
            xmax = 905.150
            text = "012764: Na-s-gi i-yu-s-di hi-ne-gi a-s-da-ya i-yu-nv-ne-di-yi a-tse-li-s-dv-i tso-i-ne i-ga i-go-hi-dv, gv-wa-s-da-wa-di-do-hi-ye-no sv-no-yi ya-ni-lu-gi yi-gv-wa-no-s-gi, hi-a-no yi-ni-da-ni-we-si yv-wi; Tsu-yo-hu-sv do-u-le-nv; o-ni-yi-no u-na-tlo-nu-he-lv-i u-tli u-yo-i-yu yi-gi e-s-ga-quo i-gv-yi-yi."
        intervals [129]:
            xmin = 905.150
            xmax = 905.890
            text = ""
        intervals [130]:
            xmin = 905.890
            xmax = 915.800
            text = "012765: Qua-le-di hi-a ni-du-we-se-le-i; A-ni-ya-wi-s-gi de-tsi-ka-ha, i-tse-na na-s-da-yv i-ge-tsv-ne-di ge-e wi-ni-tsv-ga."
        intervals [131]:
            xmin = 915.800
            xmax = 916.750
            text = ""
        intervals [132]:
            xmin = 916.750
            xmax = 930.740
            text = "012766: Ho-wa-no u-ne-nv-se a-s-da-yi-yu wi-nu-nv-ne-le a-tse-li-s-dv-i, u-ni-ye-lv-ta-ne nv-yo-hi, a-le du-ni-ka-ne a-ni-ga-ti-di-s-gi."
