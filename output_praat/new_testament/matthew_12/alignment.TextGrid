File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 794.810
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 794.810
        intervals: size = 100
        intervals [1]:
            xmin = 0.000
            xmax = 3.900
            text = ""
        intervals [2]:
            xmin = 3.900
            xmax = 22.965
            text = "011201: Na-hi-yu Tsi-sa a-i-sv-gi a-wi-sv u-tsa-le-s-di u-na-do-da-qua-s-gv i-ga; gv-wa-s-da-wa-di-do-hi-no a-go-nu du-ni-yo-si-s-gv-gi, a-le u-na-le-nv-hv-gi u-ni-s-gu-de-sv-gi u-tsa-le-s-di a-le u-ni-s-di-gv-gi."
        intervals [3]:
            xmin = 22.965
            xmax = 23.960
            text = ""
        intervals [4]:
            xmin = 23.960
            xmax = 39.740
            text = "011202: A-se-no A-ni-qua-li-si u-na-do-le-ho-sv hi-a nv-gv-wa-we-se-lv-gi; Gv-ni-yu-quo i-gv-dv-ne-di ni-ge-sv-na u-na-do-da-qua-s-gv i-ga na-na-dv-ne ge-tsa-s-da-wa-di-do-hi."
        intervals [5]:
            xmin = 39.740
            xmax = 40.610
            text = ""
        intervals [6]:
            xmin = 40.610
            xmax = 51.670
            text = "011203: A-se-no hi-a ni-du-we-se-lv-gi; Tla-s-go yi-tsi-go-li-ye-o De-wi nu-dv-ne-lv a-go-nu tsu-yo-si-s-ge, a-le na-s-gi a-ne-hi,"
        intervals [7]:
            xmin = 51.670
            xmax = 52.570
            text = ""
        intervals [8]:
            xmin = 52.570
            xmax = 69.525
            text = "011204: U-ne-la-nv-hi u-tse-li a-da-ne-lv tsu-yv-le-i, a-le a-ga-do-di ga-du tsu-ge-i, ye-li gv-wa-gi-s-di ni-ge-sv-na tsi-ge-se-i, a-le na-s-gi a-ne-hi, a-tsi-lv-s-gi-ni--a-ne-lo-hi u-nv-sv?"
        intervals [9]:
            xmin = 69.525
            xmax = 70.700
            text = ""
        intervals [10]:
            xmin = 70.700
            xmax = 90.030
            text = "011205: Tla-s-go na-s-quo yi-tsi-go-li-ye-o di-ka-hna-wa-dv-s-di-yi na-s-gi u-na-do-da-qua-s-gv i-ga u-dv-na di-ga-ta-wi-i-s-di-yi a-tsi-lv--a-ne-lo-hi u-na-do-da-qua-s-gv a-ni-yo-s-di-s-gv, a-le u-ni-s-ga-nv-tsv-hi ni-ge-sv-na ge-sv-i?"
        intervals [11]:
            xmin = 90.030
            xmax = 91.270
            text = ""
        intervals [12]:
            xmin = 91.270
            xmax = 101.340
            text = "011206: A-se-no hi-a ni-tsv-we-se-ha; a-ni e-do-ha u-tli a-tsi-lv-quo-di-yu e-s-ga-quo u-dv-na di-ga-la-wi-i-s-di-yi."
        intervals [13]:
            xmin = 101.340
            xmax = 102.510
            text = ""
        intervals [14]:
            xmin = 102.510
            xmax = 123.740
            text = "011207: Yi-tsi-ga-do-v-se-s-gi-ni ga-dv-gv hi-a na-s-gi tsi-ni-ga-we-a, a-da-do-li-s-di ge-sv a-qua-du-li-ha, v-tla-no a-tsi-lv--ge-la-s-di-yi ge-sv-i, v-tla u-ni-s-ga-nv-tsv-hi yi-do-ge-tsi-ye-lv-ne nu-ni-s-ga-nv-tsv-na."
        intervals [15]:
            xmin = 123.740
            xmax = 125.000
            text = ""
        intervals [16]:
            xmin = 125.000
            xmax = 129.400
            text = "011208: Yv-wi-ye-no U-we-tsi U-gv-wi-yu-hi na-s-quo u-na-do-da-qua-s-gv i-ga."
        intervals [17]:
            xmin = 129.400
            xmax = 130.845
            text = ""
        intervals [18]:
            xmin = 130.845
            xmax = 135.820
            text = "011209: Na-hna-no i-u-da-nv-sv, tsu-ni-la-wi-i-s-di-yi wu-yv-lv-gi."
        intervals [19]:
            xmin = 135.820
            xmax = 136.800
            text = ""
        intervals [20]:
            xmin = 136.800
            xmax = 153.915
            text = "011210: Gv-ni-yu-quo-no e-do-hv-gi a-s-ga-ya u-wo-ye-ni u-wa-i-se-lv-hi.  Gv-wa-dv-dv-nv-gi-no hi-a nu-ni-we-sv-gi; tsi-go ye-li-quo gv-da-nv-wo-di u-na-do-da-qua-s-gv-i; gv-wa-yi-li-da-s-di-yi u-na-du-li-s-gv-gi."
        intervals [21]:
            xmin = 153.915
            xmax = 154.860
            text = ""
        intervals [22]:
            xmin = 154.860
            xmax = 174.470
            text = "011211: Hi-a-no ni-du-we-se-lv-gi; Tsi-go a-s-ga-ya u-da-su-ya i-tse-hv-i, i-yu-no sa-quo a-wi u-no-de-na yu-na-tla-a, a-ta-le-sv-no yu-lv-tsv u-na-do-da-qua-s-gv-i, na-s-gi wu-ni-yv-di a-le wu-le-s-di ni-ge-sv-na?"
        intervals [23]:
            xmin = 174.470
            xmax = 175.020
            text = ""
        intervals [24]:
            xmin = 175.020
            xmax = 189.520
            text = "011212: Ni-ga-v-s-gi-ni u-tli-hi-yu a-tsi-lv-quo-di-yu yv-wi e-s-ga-quo a-wi u-no-de-na.  Na-s-gi-s-gi-ni i-yu-s-di ye-li-quo o-s-dv di-ga-lv-wi-s-da-ne-di u-na-do-da-qua-s-gv i-ga."
        intervals [25]:
            xmin = 189.520
            xmax = 190.700
            text = ""
        intervals [26]:
            xmin = 190.700
            xmax = 203.200
            text = "011213: Hna-quo-no hi-a nu-we-se-lv a-s-ga-ya; Ha-do-ya-nv-hi-da; u-do-ya-nv-hi-dv-gi-no.  A-le u-di-wa-sv-gi, na-s-gi-ya so-i nu-s-dv nu-li-s-ta-nv-gi."
        intervals [27]:
            xmin = 203.200
            xmax = 204.250
            text = ""
        intervals [28]:
            xmin = 204.250
            xmax = 211.855
            text = "011214: Hna-quo-no A-ni-qua-li-si u-ni-nu-go-tsv u-ni-no-he-lv i-yu-nv-ne-di-yi u-ni-hi-s-di-yi."
        intervals [29]:
            xmin = 211.855
            xmax = 212.695
            text = ""
        intervals [30]:
            xmin = 212.695
            xmax = 223.080
            text = "011215: A-se-no Tsi-sa u-do-le-ho-sv na-hna u-da-nv-sv-gi; u-ni-tsa-ti-no gv-wa-s-da-wa-dv-sv-gi; a-le ni-ga-dv du-nv-wa-nv-gi,"
        intervals [31]:
            xmin = 223.080
            xmax = 224.090
            text = ""
        intervals [32]:
            xmin = 224.090
            xmax = 228.160
            text = "011216: A-le du-nv-s-da-de-lv gv-ni-ge-sv i-gv-wa-ne-di-yi."
        intervals [33]:
            xmin = 228.160
            xmax = 229.370
            text = ""
        intervals [34]:
            xmin = 229.370
            xmax = 237.240
            text = "011217: U-do-hi-yu-di-yi a-ye-lv-sv-gi I-sa-ya a-do-le-ho-s-gi tsu-ne-tse-i, hi-a tsi-nu-we-se-i;"
        intervals [35]:
            xmin = 237.240
            xmax = 238.250
            text = ""
        intervals [36]:
            xmin = 238.250
            xmax = 257.820
            text = "011218: Gv-ni-yu-quo tsi-nv-si-da-s-di tsi-ya-su-ye-dv tsi-ge-yu-i di-qua-da-nv-dv i-yv-dv o-s-dv tsi-ye-lv-i; da-tsi-ne-li a-qua-da-nv-do, a-le Tsu-na-da-le-nv-dv yv-wi du-yu-go-dv tsu-na-nu-go-wi-se-di ge-se-s-di."
        intervals [37]:
            xmin = 257.820
            xmax = 258.720
            text = ""
        intervals [38]:
            xmin = 258.720
            xmax = 270.210
            text = "011219: V-tla tsu-ti-yo-s-di a-le u-we-lu-di yi-ge-se-s-di, v-tla a-le gi-lo u-dv-ga-ne-di yi-ge-se-s-di ka-ne-gv de-ga-la-nv-dv-i."
        intervals [39]:
            xmin = 270.210
            xmax = 271.080
            text = ""
        intervals [40]:
            xmin = 271.080
            xmax = 286.405
            text = "011220: Wa-so-na u-ye-da-wo-tsv-hi v-tla tsu-s-qua-li-s-di yi-ge-se-s-di, a-le do-le-dv tsu-ga-sv-s-di v-tla u-wa-dla-di-s-di yi-ge-se-s-di, gv-ni a-da-li-ne-hi-do-nv-ha du-yu-go-dv ge-sv da-ye-li-hi-s-di-s-gv-i."
        intervals [41]:
            xmin = 286.405
            xmax = 287.060
            text = ""
        intervals [42]:
            xmin = 287.060
            xmax = 291.915
            text = "011221: A-le du-do-v Tsu-na-da-le-nv-dv yv-wi a-na-li-s-ga-s-do-di-s-ge-s-di."
        intervals [43]:
            xmin = 291.915
            xmax = 292.660
            text = ""
        intervals [44]:
            xmin = 292.660
            xmax = 308.820
            text = "011222: Hna-quo-no a-ga-ti-no-he-lv-gi a-s-gi-na u-ya-i di-ge-wi a-le u-wa-ge-wi, a-le u-nv-wa-nv-gi; na-s-gi-no di-ge-wi a-le u-wa-ge-wi u-wo-ni-sv-gi a-le u-go-hv-gi."
        intervals [45]:
            xmin = 308.820
            xmax = 310.230
            text = ""
        intervals [46]:
            xmin = 310.230
            xmax = 317.460
            text = "011223: Ni-ga-dv-no yv-wi u-ni-s-qua-ni-go-sv-gi, hi-a nu-ni-we-sv-gi; Tla-s-go hi-a De-wi U-we-tsi yi-gi?"
        intervals [47]:
            xmin = 317.460
            xmax = 318.450
            text = ""
        intervals [48]:
            xmin = 318.450
            xmax = 334.945
            text = "011224: A-se-no A-ni-qua-li-si u-na-dv-ga-nv, hi-a nu-ni-we-sv-gi; Hi-a v-tla a-ni-s-gi-na yi-di-ga-nu-go-wi-s-ga gv-ni tsu-s-de-li-s-go Que-li-tsi-qua u-gv-wi-yu-hi a-ni-s-gi-na u-na-tse-li-ga."
        intervals [49]:
            xmin = 334.945
            xmax = 335.740
            text = ""
        intervals [50]:
            xmin = 335.740
            xmax = 363.895
            text = "011225: A-le tsi-sa a-ga-ta-hv nu-s-dv a-na-da-nv-te-s-gv-i, hi-a ni-du-we-se-lv-gi; Ni-ga-v a-ye-li go-tlv-sv-i ta-li tsi-na-da-di-s-go u-wa-sv-quo tsa-da-tlu-di-s-go a-yo-go-quo; a-le ni-ga-v ga-du-hv a-le a-da-ne-lv ta-li tsi-na-da-di-s-go u-wa-sv-quo tsa-da-tlu-di-s-go v-tla yi-ni-gv-wa-s-do-quo."
        intervals [51]:
            xmin = 363.895
            xmax = 364.860
            text = ""
        intervals [52]:
            xmin = 364.860
            xmax = 379.270
            text = "011226: I-yu a-le Se-da-ni Se-da-ni yi-ga-nu-go-wi-s-ga, ta-li na-da-di-s-go-i u-wa-sv-quo a-da-tlu-di-s-go-i; ga-do-no yi-ga-li-s-do-da yi-ni-gv-wa-s-di-quo u-tse-li-go-hi?"
        intervals [53]:
            xmin = 379.270
            xmax = 380.400
            text = ""
        intervals [54]:
            xmin = 380.400
            xmax = 395.070
            text = "011227: I-yu-no a-yv Que-li-tsi-qua ya-gi-s-de-li a-ni-s-gi-na yi-di-tsi-nu-go-wi-s-ga, ga-go u-ni-s-de-li-s-go di-tse-tsi tsi-da-ni-nu-go-wi-s-go-i?  Na-s-gi-s-gi-ni di-ge-tsu-go-da-ne-hi ge-se-s-di."
        intervals [55]:
            xmin = 395.070
            xmax = 396.125
            text = ""
        intervals [56]:
            xmin = 396.125
            xmax = 410.410
            text = "011228: I-yu-s-gi-ni a-yv U-ne-la-nv-hi U-da-nv-do yi-gv-di a-ni-s-gi-na yi-di-tsi-nu-go-wi-s-ga, hna-quo-s-gi-ni ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv i-tsi-lu-tse-lv."
        intervals [57]:
            xmin = 410.410
            xmax = 411.480
            text = ""
        intervals [58]:
            xmin = 411.480
            xmax = 431.630
            text = "011229: A-le ga-do ya-dv-ga gi-lo u-li-ni-gi-dv a-s-ga-ya ga-ne-lv ya-yv-ha a-le u-hna-v ya-wo-nv, i-yu-no i-gv-yi nu-lv-lv-na yi-gi na-s-gi u-li-ni-gi-dv a-s-ga-ya?  Gi-la hna-quo ya-wo-nv ga-ne-lv-i u-hna-v-i."
        intervals [59]:
            xmin = 431.630
            xmax = 432.730
            text = ""
        intervals [60]:
            xmin = 432.730
            xmax = 442.470
            text = "011230: Gi-lo na-qua-li-go-ne-hv-na, na-s-gi a-qua-tlu-di-ha; gi-lo-no no-s-di-tli-si-s-gv-na, na-s-gi ya-di-ga-le-ya-s-ga."
        intervals [61]:
            xmin = 442.470
            xmax = 443.340
            text = ""
        intervals [62]:
            xmin = 443.340
            xmax = 464.600
            text = "011231: Na-s-gi i-yu-s-di hi-a ni-tsv-we-se-ha; ni-ga-v nu-da-le-sv a-s-ga-nv-i-s-di ge-sv a-le a-so-tlv-do-di ge-sv ge-tsi-do-li-s-di-quo ge-se-s-di yv-wi; Ga-lv-quo-di-yu-s-gi-ni A-da-nv-do a-so-tlv-do-di ge-sv v-tla ge-tsi-do-li-s-di yi-ge-se-s-di yv-wi."
        intervals [63]:
            xmin = 464.600
            xmax = 465.975
            text = ""
        intervals [64]:
            xmin = 465.975
            xmax = 486.990
            text = "011232: A-le gi-lo ga-wo-ni-s-gv a-tlu-di-s-ge-s-di yv-wi U-we-tsi, a-tsi-do-li-s-di-quo ge-se-s-di; gi-lo-s-gi-ni ga-wo-ni-s-gv a-tlu-di-s-ge-s-di Ga-lv-quo-di-yu A-da-nv-do, v-tla a-tsi-do-li-s-di yi-ge-se-s-di go-hi ge-sv a-le na-s-quo so-i-yi di-ge-sv-i."
        intervals [65]:
            xmin = 486.990
            xmax = 487.960
            text = ""
        intervals [66]:
            xmin = 487.960
            xmax = 503.670
            text = "011233: Tlu-gv o-s-dv ni-tsv-ga u-dv-no o-s-dv, a-le tlu-gv u-so-nv ni-tsv-ga u-dv-no u-so-nv-i; tlu-gv-ye-no go-li-s-do-di ge-so nu-s-dv u-dv-i."
        intervals [67]:
            xmin = 503.670
            xmax = 505.910
            text = ""
        intervals [68]:
            xmin = 505.910
            xmax = 522.115
            text = "011234: Yo i-na-dv tsu-ne-tsi ni-hi!  Tsi-ni-tsi-yo-i-yv ga-do yi-ga-li-s-do-da o-s-dv yi-tsi-wo-ni-hi?  U-tsa-dv-ye-no o-na-wi-yi o-we-hv-i v-ho-li ga-wo-ni-s-go-i."
        intervals [69]:
            xmin = 522.115
            xmax = 523.470
            text = ""
        intervals [70]:
            xmin = 523.470
            xmax = 536.060
            text = "011235: O-s-dv yv-wi, o-s-dv u-s-qua-ni-go-dv u-na-wi-yi, o-s-dv ga-na-nu-go-wi-s-go-i.  U-yo-no yv-wi, u-yo u-s-qua-ni-go-dv u-yo ga-na-nu-go-wi-s-go-i."
        intervals [71]:
            xmin = 536.060
            xmax = 537.480
            text = ""
        intervals [72]:
            xmin = 537.480
            xmax = 548.120
            text = "011236: Hi-a-no ni-tsv-we-se-ha; Ni-ga-v u-yo a-ni-wo-ni-s-gv yv-wi, u-ni-no-he-di ge-se-s-di di-gu-go-do-di-yi i-ga ge-sv-i."
        intervals [73]:
            xmin = 548.120
            xmax = 549.115
            text = ""
        intervals [74]:
            xmin = 549.115
            xmax = 557.750
            text = "011237: Hi-ne-gv-ye-no tsa-du-da-le-s-do-di ge-se-s-di, a-le hi-ne-gv tsa-s-ga-nv-tsv di-tsa-du-go-da-ne-di ge-se-s-di."
        intervals [75]:
            xmin = 557.750
            xmax = 558.480
            text = ""
        intervals [76]:
            xmin = 558.480
            xmax = 571.490
            text = "011238: Hna-quo-no gi-lo i-yu-na-s-di di-no-we-li-s-gi a-le A-ni-qua-li-si u-ni-ne-tsv, hi-a nu-ni-we-sv-gi; Ta-de-yo-hv-s-gi, u-ye-lv-dv o-ga-du-li i-tsv-go-wa-dv-e-di-yi."
        intervals [77]:
            xmin = 571.490
            xmax = 572.080
            text = ""
        intervals [78]:
            xmin = 572.080
            xmax = 591.190
            text = "011239: U-ne-tsv-no hi-a ni-du-we-se-lv-gi; Go-hi tsa-ne-ha u-ni-yo a-le di-na-da-yo-ne-hi u-ye-lv-dv u-ni-yo-ho-i; a-se-no u-ye-lv-dv v-tla ge-tsi-ne-di yi-ge-se-s-di, Tso-na a-do-le-ho-s-gi u-tse-li-ga u-ye-lv-dv u-wa-sv."
        intervals [79]:
            xmin = 591.190
            xmax = 592.390
            text = ""
        intervals [80]:
            xmin = 592.390
            xmax = 609.400
            text = "011240: Tso-na-ye-no tso-i i-ga a-le tso-i sv-no-yi a-tsa-di e-qua u-s-quo-li-yi tsa-ya-e-i, na-s-quo-s-gi-ni yv-wi U-we-tsi tso-i i-ga a-le tso-i sv-no-yi ga-do-hi ha-wi-ni a-ya-e-s-di."
        intervals [81]:
            xmin = 609.400
            xmax = 610.525
            text = ""
        intervals [82]:
            xmin = 610.525
            xmax = 640.180
            text = "011241: Yv-wi Ni-ni-wi tsa-ne-hv-gi do-dv-na-le-ni da-gv-wa-na-tlu-ta-ni go-hi tsa-ne-ha, di-gu-go-do-di-yi i-ga ge-sv-i, a-le u-ni-s-ga-nv-tsv gv-ni-ge-sv u-dv-nv-ne-li; na-s-gi-ye-no du-na-da-nv-dv du-ni-ne-tli-yv-sv-gi Tso-na a-li-tsi-do-hv-s-gv nu-wa-ni-sa-nv-gi, gv-ni-yu-quo-no a-ni e-do-ha u-tli a-tsi-lv-quo-di-yu e-s-ga-quo Tso-na."
        intervals [83]:
            xmin = 640.180
            xmax = 641.390
            text = ""
        intervals [84]:
            xmin = 641.390
            xmax = 674.830
            text = "011242: U-gv-wi-yu-hi a-ge-yv tsu-ga-na-wv tse-he-i do-dv-le-ni da-yu-na-tlu-ta-ni go-hi tsa-ne-ha di-gu-go-do-di-yi i-ga ge-sv-i, a-le u-ni-s-ga-nv-tsv gv-ni-ge-sv nv-da-gv-ne-li; na-s-gi-ye-no ga-do-hi wa-s-dv i-yv-dv tsu-we-nv-se u-dv-ga-ni-le So-li-mo-nv a-ga-ta-hna-i-yu ge-sv-i, gv-ni-yu-quo-no a-ni e-do-ha u-tli a-tsi-lv-quo-di-yu e-s-ga-quo So-li-mo-nv."
        intervals [85]:
            xmin = 674.830
            xmax = 675.820
            text = ""
        intervals [86]:
            xmin = 675.820
            xmax = 689.390
            text = "011243: I-yu-no ga-da-ha a-da-nv-do yv-wi-hi ga-nu-go-i, u-ka-yo-dv-hi e-do-ho-i u-ya-we-so-lv-s-di-yi u-yo-ho-i, a-se-no v-tla ya-wa-ti-s-go-i."
        intervals [87]:
            xmin = 689.390
            xmax = 690.220
            text = ""
        intervals [88]:
            xmin = 690.220
            xmax = 707.970
            text = "011244: Hna-quo-no hi-a ni-ga-we-s-go-i; di-tsi-ne-lv di-gi-nu-go-tsv yv-dv-tsi-lo-si.  Hna-quo-no wi-ga-lu-gi a-wa-ti-s-go u-si-wa ge-so a-le gv-no-sa-dv-hi a-le go-du-i-s-do-i."
        intervals [89]:
            xmin = 707.970
            xmax = 708.980
            text = ""
        intervals [90]:
            xmin = 708.980
            xmax = 736.720
            text = "011245: Hna-quo-no i-e-go-i wi-da-ya-ni-s-go u-wa-na-da-le ga-li-quo-gi a-ni-s-gi-na u-tli i-yu-ni-ne-gu-tsi-dv e-s-ga-quo u-wa-sv, na-hna-no a-ni-yv-hi-ho-i a-le a-na-ne-la-di-s-go-i, o-ni-no nu-s-dv na a-s-ga-ya u-tli u-yo-i-yu ge-so-i e-s-ga-quo i-gv-yi-yi.  Na-s-gi-s-gi-ni nu-na-s-de-s-di go-hi u-ni-ne-gu-tsi-dv tsa-ne-ha."
        intervals [91]:
            xmin = 736.720
            xmax = 737.180
            text = ""
        intervals [92]:
            xmin = 737.180
            xmax = 750.340
            text = "011246: A-si-quo de-ga-wo-ne-di-s-gv yv-wi, gv-ni-yu-quo u-tsi a-le a-na-li-nv-tli do-yi-tlv a-ni-do-na-v-gi, u-na-du-li-s-gv-gi gv-wa-li-no-he-do-di-yi."
        intervals [93]:
            xmin = 750.340
            xmax = 751.060
            text = ""
        intervals [94]:
            xmin = 751.060
            xmax = 764.030
            text = "011247: Gi-lo-no hi-a nu-we-se-lv-gi; Gv-ni-yu-quo tsa-tsi a-le i-tsa-li-nv-tli do-yi a-ni-do-na-a, ge-tsa-li-no-he-do-di-yi u-na-du-li-ha."
        intervals [95]:
            xmin = 764.030
            xmax = 765.040
            text = ""
        intervals [96]:
            xmin = 765.040
            xmax = 773.655
            text = "011248: U-ne-tsv-no hi-a nu-we-se-lv u-no-ne-lv-hi; Ga-go e-tsi?  A-le ga-go o-tsa-li-nv-tli?"
        intervals [97]:
            xmin = 773.655
            xmax = 774.710
            text = ""
        intervals [98]:
            xmin = 774.710
            xmax = 781.870
            text = "011249: Wi-du-so-nv-no gv-wa-s-da-wa-di-do-hi hi-a nu-we-sv-gi; Gv-ni-yu-quo e-tsi a-le o-tsa-li-nv-tli."
        intervals [99]:
            xmin = 781.870
            xmax = 782.530
            text = ""
        intervals [100]:
            xmin = 782.530
            xmax = 794.810
            text = "011250: Gi-lo-ye-no na-dv-ne-he-s-di nu-s-dv u-du-li-s-gv E-do-da ga-lv-la-di e-hi, na-s-gi v-gi-nv-tli a-le v-gi-do a-le e-tsi."
    item [2]:
