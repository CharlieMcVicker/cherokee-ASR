item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 413.540
        intervals: size = 54
        intervals [1]:
            xmin = 0.000
            xmax = 5.495
            text = ""
        intervals [2]:
            xmin = 5.495
            xmax = 18.860
            text = "011701: Su-da-li-no wi-nu-sv-lv Tsi-sa du-ti-nv-sv-gi Qui-da, a-le Tsi-mi a-le Tsa-ni Tsi-mi di-na-da-nv-tli, a-le du-hna-lu-ta-nv-gi i-nv i-ga-ti o-da-lv u-nv-sv ge-sv-i,"
        intervals [3]:
            xmin = 18.860
            xmax = 19.790
            text = ""
        intervals [4]:
            xmin = 19.790
            xmax = 33.335
            text = "011702: A-le u-da-ne-tli-yv-se da-ni-ka-nv-i, a-le u-ka-dv di-gv-wa-lv-sa-da nu-li-s-ta-ne-i nv-do i-digv-tse-li-dv, a-le u-nu-wa-v i-ga--ga-dv tsi-nu-ne-gi-yv nu-ne-gi-ye-i."
        intervals [5]:
            xmin = 33.335
            xmax = 34.110
            text = ""
        intervals [6]:
            xmin = 34.110
            xmax = 42.940
            text = "011703: A-le gv-ni-yu-quo na-hna gv-ni-ge-sv ni-gv-wa-na-dv-ne-le Mo-si a-le I-la-ya gv-wa-li-no-he-di-s-ge-i."
        intervals [7]:
            xmin = 42.940
            xmax = 43.670
            text = ""
        intervals [8]:
            xmin = 43.670
            xmax = 67.505
            text = "011704: Qui-da-no u-ne-tsv hi-a nu-we-se-le Tsi-sa; Tsa-gv-wi-yu-hi, o-si-yu a-ni tsi-de-do-ha, i-yu-no o-si-yu yi-tsa-ye-lv-nv, a-ni tso-i yi-do-tsi-li-tso-dv-ga, sa-quo ni-hi tsa-tse-li-ga, so-i-no Mo-si u-tse-li-ga, so-i-no I-la-ya u-tse-li-ga."
        intervals [9]:
            xmin = 67.505
            xmax = 68.980
            text = ""
        intervals [10]:
            xmin = 68.980
            xmax = 93.580
            text = "011705: A-si-quo-no ga-wo-ni-s-ge-i, gv-ni-yu-quo u-s-go-s-dv u-lo-gi-la u-na-da-wa-di-s-ta-ne-i, a-le gv-ni-yu-quo na-hna u-lo-gi-lv tsu-ne-tse-i, Hi-a nv-tsu-we-se-i; hi-a na-s-gi A-que-tsi tsi-ge-yu-i, na-s-gi o-si-yu tsi-ye-lv-i, na-s-gi e-tsa-dv-da-s-da-ne-he-s-di."
        intervals [11]:
            xmin = 93.580
            xmax = 94.710
            text = ""
        intervals [12]:
            xmin = 94.710
            xmax = 103.200
            text = "011706: Gv-wa-s-da-wa-di-do-hi-no u-na-dv-ga-nv du-ni-nv-tse du-ni-ya-s-du-se-i, u-tsa-ti u-ni-s-ga-le-i."
        intervals [13]:
            xmin = 103.200
            xmax = 104.680
            text = ""
        intervals [14]:
            xmin = 104.680
            xmax = 113.150
            text = "011707: Tsi-sa-no u-lu-tse du-sv-ni-le-i, hi-a nu-we-se-i; Di-tsa-le-hv-ga, a-le tle-s-di yi-tsi-s-ga-i-he-s-di."
        intervals [15]:
            xmin = 113.150
            xmax = 114.240
            text = ""
        intervals [16]:
            xmin = 114.240
            xmax = 119.410
            text = "011708: Du-na-ka-na-nv-no v-tla gi-lo yu-ni-go-he Tsi-sa u-wa-sv."
        intervals [17]:
            xmin = 119.410
            xmax = 120.550
            text = ""
        intervals [18]:
            xmin = 120.550
            xmax = 137.885
            text = "011709: Tsu-ni-ga-so-a-si-di-sv-no o-da-lv-i tsi-sa du-nv-s-da-de-le-i, hi-a nu-we-se-i; Tle-s-di gi-lo e-tsi-no-ne-lv-ha na-s-gi tsi-tsi-go-wa-dv gv-ni yv-wi U-we-tsi u-yo-hu-sv du-le-ne-s-di."
        intervals [19]:
            xmin = 137.885
            xmax = 138.975
            text = ""
        intervals [20]:
            xmin = 138.975
            xmax = 150.055
            text = "011710: Gv-wa-s-da-wa-di-do-hi-no gv-wa-dv-dv-ne-i, hi-a nu-ni-we-se-i; Ga-do-no di-no-we-li-s-gi, I-la-ya i-gv-yi da-ga-lu-tsi, tsa-na-di-s-go-i?"
        intervals [21]:
            xmin = 150.055
            xmax = 151.525
            text = ""
        intervals [22]:
            xmin = 151.525
            xmax = 162.205
            text = "011711: Tsi-sa-no u-ne-tsv hi-a ni-du-we-se-le-i; U-do-hi-yu-hi I-la-ya i-gv-yi u-lu-hi-s-di a-le u-wo-tlv-hi-so-di ni-ga-v go-hu-s-di."
        intervals [23]:
            xmin = 162.205
            xmax = 163.430
            text = ""
        intervals [24]:
            xmin = 163.430
            xmax = 183.735
            text = "011712: A-se-no hi-a ni-tsv-we-se-ha; I-la-ya ga-yu-la u-lu-tsv, a-le v-tla yi-gv-wo-li-tso-i, a-se-no ni-ga-v u-na-du-li-s-gv-i ni-gv-wa-ne-lv.  Na-s-quo-s-gi-ni yv-wi U-we-tsi na-s-gi-ya nv-da-gv-wa-ne-li."
        intervals [25]:
            xmin = 183.735
            xmax = 185.110
            text = ""
        intervals [26]:
            xmin = 185.110
            xmax = 191.955
            text = "011713: Hna-quo-no gv-wa-s-da-wa-di-do-hi u-no-li-tse Tsa-ni Di-da-wo-s-gi ka-ne-i-s-di-s-gv-i."
        intervals [27]:
            xmin = 191.955
            xmax = 192.760
            text = ""
        intervals [28]:
            xmin = 192.760
            xmax = 203.405
            text = "011714: Hna-quo-no u-ni-tsa-ti a-ne-do-hv u-ni-lu-tsv, u-lu-tse-lv-gi a-s-ga-ya du-li-ni-qua-nv-ne-lv-gi hi-a nu-we-sv-gi;"
        intervals [29]:
            xmin = 203.405
            xmax = 204.545
            text = ""
        intervals [30]:
            xmin = 204.545
            xmax = 221.790
            text = "011715: Tsa-gv-wi-yu-hi, hi-ya-do-li-gi a-tsu-tsa a-que-tsi, gv-li-ye-no gv-wa-hi-ha, a-le u-tsa-ti a-gi-li-yo-ga, ya-no-gi-yu-ye-no a-tsi-lv-yi gv-dv-go-i a-le a-ma-yi a-gv-go-i."
        intervals [31]:
            xmin = 221.790
            xmax = 222.670
            text = ""
        intervals [32]:
            xmin = 222.670
            xmax = 230.195
            text = "011716: Ga-tsi-ya-ti-no-he-lv-gi-no ge-tsa-s-da-wa-di-do-hi, a-se-no u-ni-nu-lv-nv-gi u-ni-nv-wo-di-yi."
        intervals [33]:
            xmin = 230.195
            xmax = 231.050
            text = ""
        intervals [34]:
            xmin = 231.050
            xmax = 252.020
            text = "011717: Tsi-sa-no u-ne-tsv hi-a nu-we-sv-gi; Ni-tso-hi-yu-sv-na a-le i-tsa-ga-ta-hv-dv go-hi tsi-tse-ha, i-la-go ni-go-hi-le-s-di i-tsv-ye-la-di-do-he-s-di?  I-la-go ni-go-hi-le-s-di u-na-ne-la-gi i-tsv-ye-li-se-he-s-di?  S-gi-ya-ti-no-hi-si."
        intervals [35]:
            xmin = 252.020
            xmax = 252.990
            text = ""
        intervals [36]:
            xmin = 252.990
            xmax = 262.485
            text = "011718: Tsi-sa-no a-s-gi-na u-s-ga-tsv-gi; a-s-gi-na-no u-nu-go-tsv-gi a-tsu-tsa, a-le na-hi-yu-quo u-di-wa-sv-gi."
        intervals [37]:
            xmin = 262.485
            xmax = 263.260
            text = ""
        intervals [38]:
            xmin = 263.260
            xmax = 274.780
            text = "011719: Hna-quo-no gv-wa-s-da-wa-di-do-hi Tsi-sa gv-wa-lu-tse-lv-gi u-nv-sv ge-sv-i, hi-a nu-ni-we-sv-gi; Ga-do-no tso-gi-nu-lv-nv-gi o-tsi-nu-go-wi-s-di-yi?"
        intervals [39]:
            xmin = 274.780
            xmax = 275.690
            text = ""
        intervals [40]:
            xmin = 275.690
            xmax = 306.190
            text = "011720: Tsi-sa-no hi-a ni-du-we-se-lv-gi; nv-di-ga-li-s-do-di-ha ni-tso-hi-yu-sv-na ge-sv-i.  U-do-hi-yu-hi-ya-ye-no hi-a ni-tsv-we-se-ha; I-yu-no yi-tso-hi-yu-ha na-s-quo a-tsi-lv-quo u-ga-ta i-gi-dv, hi-a yi-ni-tsi-we-si hi-a tso-da-lv, ha-da-nv-na i-tlv wi-lo-hi, a-ha u-da-nv-s-di; v-tla a-le go-hu-s-di yi-ge-tsi-nu-lv-hv-s-ga."
        intervals [41]:
            xmin = 306.190
            xmax = 306.780
            text = ""
        intervals [42]:
            xmin = 306.780
            xmax = 316.200
            text = "011721: Hi-a-s-gi-ni-no-nv i-yu-s-di v-tla u-nu-go-i-s-di yi-gi, gv-ni yv-da-do-li-s-di-ha a-le a-ma-tli ya-gv-s-ga."
        intervals [43]:
            xmin = 316.200
            xmax = 317.545
            text = ""
        intervals [44]:
            xmin = 317.545
            xmax = 326.715
            text = "011722: A-si-no Ge-li-li a-ne-do-hv-i Tsi-sa hi-a ni-du-we-se-lv-gi; yv-wi U-we-tsi yv-wi do-da-ge-tsi-yo-hi-se-li,"
        intervals [45]:
            xmin = 326.715
            xmax = 327.680
            text = ""
        intervals [46]:
            xmin = 327.680
            xmax = 336.350
            text = "011723: A-le na-s-gi da-gv-wa-li, a-le tso-i-ne i-ga do-dv-a-le-ni.  U-tsa-ta-nv-hi-no u-yo u-ni-ye-lv-nv-gi."
        intervals [47]:
            xmin = 336.350
            xmax = 337.455
            text = ""
        intervals [48]:
            xmin = 337.455
            xmax = 352.360
            text = "011724: Ge-qua-ni-no u-ni-lu-tsv a-ye-li a-de-lv a-ni-gi-si-do-hi gv-wa-lu-tse-le Qui-da, hi-a nu-ni-we-se-i; Tla-s-go di-tse-yo-hv-s-gi a-ye-li ya-gu-yi-s-go-i?"
        intervals [49]:
            xmin = 352.360
            xmax = 353.315
            text = ""
        intervals [50]:
            xmin = 353.315
            xmax = 376.910
            text = "011725: V-v, u-dv-ne-i.  A-da-ne-lv-no u-lu-tsv Tsi-sa u-yo-s-do-da-ne-lv-gi, hi-a nu-we-sv-gi; Ga-do he-li-ha, Sa-wa-ni; ga-go a-ye-li gv-wa-na-gu-yv-e-ho u-ni-gv-wi-yu-hi e-lo-hi a-ne-hi; tsu-ne-tsi-s-go, nv-wa-na-da-le-ge?"
        intervals [51]:
            xmin = 376.910
            xmax = 378.130
            text = ""
        intervals [52]:
            xmin = 378.130
            xmax = 387.840
            text = "011726: Nv-wa-na-da-le-i, u-da-do-se-lv-gi Qui-da.  Tsi-sa-no hi-a nu-we-se-lv-gi; Tsu-ne-tsi-s-gi-ni-ge-no u-na-ne-la-gi-quo."
        intervals [53]:
            xmin = 387.840
            xmax = 388.735
            text = ""
        intervals [54]:
            xmin = 388.735
            xmax = 413.540
            text = "011727: A-se-no di-ni-hna-lv-do-s-di-yi ni-ge-sv-na, v-da-li he-na, a-su-di-no wi-tsa-da-e-sv-ha, i-gv-yi-yi-no hi-yv-gi-dv a-tsa-di hi-ne-sv-ha, a-le hi-s-du-i-sv a-ho-li a-ye-li--a-de-lv ti-wa-dv-hi; na-s-gi hi-gi-sv-ha a-le de-hi-ne-lv-ha a-yv gi-na-gu-yv-di."
