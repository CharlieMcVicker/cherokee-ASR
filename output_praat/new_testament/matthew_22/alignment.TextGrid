            xmax = 11.630
            text = ""
        intervals [12]:
            xmin = 11.630
            xmax = 12.270
            text = "Ga-lv-la-di"
        intervals [13]:
            xmin = 12.270
            xmax = 12.750
            text = ""
        intervals [14]:
            xmin = 12.750
            xmax = 13.550
            text = "u-tse-li-go-hi"
        intervals [15]:
            xmin = 13.550
            xmax = 13.810
            text = ""
        intervals [16]:
            xmin = 13.810
            xmax = 14.630
            text = "na-s-gi-ya-quo"
        intervals [17]:
            xmin = 14.630
            xmax = 14.910
