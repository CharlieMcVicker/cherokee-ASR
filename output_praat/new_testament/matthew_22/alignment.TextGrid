File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 630.650
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 630.650
        intervals: size = 92
        intervals [1]:
            xmin = 0.000
            xmax = 4.115
            text = ""
        intervals [2]:
            xmin = 4.115
            xmax = 10.335
            text = "012201: Tsi-sa-no u-ne-tsv ta-li-ne du-tli-lo-s-da-ne-lv-gi, hi-a nu-we-sv-gi;"
        intervals [3]:
            xmin = 10.335
            xmax = 11.630
            text = ""
        intervals [4]:
            xmin = 11.630
            xmax = 21.140
            text = "012202: Ga-lv-la-di u-tse-li-go-hi na-s-gi-ya-quo gi-lo u-gv-wi-yu-hi tsu-dv-nv-i-s-ta-ne tsa-ga-tsv-s-do-di-yi u-we-tsi a-wi-nv,"
        intervals [5]:
            xmin = 21.140
            xmax = 22.180
            text = ""
        intervals [6]:
            xmin = 22.180
            xmax = 36.760
            text = "012203: A-le tsi-du-nv-se tsu-nv-si-da-s-di tsu-ni-ya-nv-hv-s-di-yi wi-ge-tsi-ya-nv-dv de-ge-ga-tsv-s-di-s-gv u-ni-lu-hi-s-di-yi; a-se-no di-u-ni-yu-lv-ne-quo nv-da-yu-ne-nv-s-di-yi."
        intervals [7]:
            xmin = 36.760
            xmax = 37.830
            text = ""
        intervals [8]:
            xmin = 37.830
            xmax = 65.320
            text = "012204: Ta-li-ne-no nv-wa-na-da-le tsu-nv-si-da-s-di du-nv-se-i, hi-a ni-du-we-se-le-i; Hi-a wi-ni-di-tsi-we-si wi-ge-tsi-ya-nv-dv; Gv-ni-yu-quo a-qua-dv-nv-i-s-di a-li-s-da-yv-di, di-qua-tse-li wa-ga a-le di-ga-li-tso-ta-nv-hi du-ni-lv, ni-ga-di-yu-no a-dv-nv-i-s-ta-no-nv-hi; de-ge-ga-tsv-s-di-s-gv i-tsi-lu-gi."
        intervals [9]:
            xmin = 65.320
            xmax = 66.350
            text = ""
        intervals [10]:
            xmin = 66.350
            xmax = 79.430
            text = "012205: A-se-no nv-li-sa-li-quo di-u-ni-ye-lv-ne-i, a-le u-tsa-ti-ni-quo wu-ni-lo-se-i, a-si-yv-wi tsu-lo-ge-sv-i, so-i-no u-no-do-di-yi."
        intervals [11]:
            xmin = 79.430
            xmax = 80.070
            text = ""
        intervals [12]:
            xmin = 80.070
            xmax = 88.125
            text = "012206: A-ni-so-i-no du-ni-ni-yv-he tsu-nv-si-da-s-di, a-le di-gv-wa-ni-so-tlv-ta-ne-i, a-le du-ni-le-i."
        intervals [13]:
            xmin = 88.125
            xmax = 89.325
            text = ""
        intervals [14]:
            xmin = 89.325
            xmax = 106.275
            text = "012207: Hna-quo-no u-gv-wi-yu-hi u-dv-ga-nv u-ta-la-wo-se-i, a-le du-nv-se tsu-tse-li a-ni-ya-wi-s-gi, a-le wi-du-ni-le na-s-gi tsu-na-da-lv-hi, a-le wu-na-go-hv-s-ta-ne u-ni-du-hv-i."
        intervals [15]:
            xmin = 106.275
            xmax = 107.680
            text = ""
        intervals [16]:
            xmin = 107.680
            xmax = 122.975
            text = "012208: Hna-quo-no hi-a ni-du-we-se-le tsu-nv-si-da-s-di; di-ge-ga-tsv-s-do-di-yi a-dv-nv-i-s-di, a-se-no wi-ge-tsi-ya-nv-dv v-tla ye-li yi-na-no-se u-ni-lu-hi-s-yi."
        intervals [17]:
            xmin = 122.975
            xmax = 124.270
            text = ""
        intervals [18]:
            xmin = 124.270
            xmax = 138.500
            text = "012209: Na-s-gi-no i-yu-s-di de-ga-nv-hna-wa-di-sv wi-tsi-lo-hi, na-ni-v-no de-tsi-wa-ti-s-ge-s-di de-tsi-ne-tse-he-s-di u-ni-lu-hi-s-di-yi a-ni do-di-ge-ga-tsv-s-ta-ni-sv-i."
        intervals [19]:
            xmin = 138.500
            xmax = 140.060
            text = ""
        intervals [20]:
            xmin = 140.060
            xmax = 163.490
            text = "012210: Ho-wa-no na-s-gi tsu-nv-si-da-s-di de-ga-nv-hna-wa-di-sv wu-ni-lo-se-i, a-le u-ni-tli-sa-ne na-ni-v du-ni-wa-dv-hv u-ni-yo a-le a-no-s-dv; hna-quo-no do-di-ge-ga-tsv-s-ta-ni-sv ye-li nu-li-s-ta-ni-le a-na-li-s-da-yv-hv-s-gi."
        intervals [21]:
            xmin = 163.490
            xmax = 164.390
            text = ""
        intervals [22]:
            xmin = 164.390
            xmax = 179.410
            text = "012211: Hna-quo-no u-yv-lv u-gv-wi-yu-hi du-ga-ta-ni-lv a-na-li-s-da-yv-hv-s-gi, u-go-he na-hna a-si-yv-wi nu-nu-wa-v-na ge-se de-ge-ga-tsv-s-di-s-gv a-nu-wo-s-di."
        intervals [23]:
            xmin = 179.410
            xmax = 180.540
            text = ""
        intervals [24]:
            xmin = 180.540
            xmax = 193.760
            text = "012212: Hi-a-no nu-we-se-le-i; Gi-na-li-i, ga-do-no a-ni v-hi-yv-li-ga ni-tsa-nu-wa-v-na i-gi de-ge-ga-tsv-s-di-s-gv a-nu-wo-s-di?  E-la-we-yi-quo-no ge-se-i."
        intervals [25]:
            xmin = 193.760
            xmax = 195.030
            text = ""
        intervals [26]:
            xmin = 195.030
            xmax = 215.990
            text = "012213: Hna-quo-no u-gv-wi-yu-hi hi-a ni-du-we-se-le ge-tsi-nv-si-da-s-di; E-tsa-lv-tsa tsu-wo-ye-ni a-le tsu-la-si-de-ni; a-le e-tsi-na-wi-dv, a-le v-do-yi-di-tlv tsu-li-si-gv we-tsa-da-u-ga.  Na-hna da-ni-yv-ge-s-di a-le da-ni-lv-da-gi-s-ge-s-di da-ni-nu-do-gv-i."
        intervals [27]:
            xmin = 215.990
            xmax = 217.050
            text = ""
        intervals [28]:
            xmin = 217.050
            xmax = 223.990
            text = "012214: U-ni-tsa-ti-ye-no ge-tsi-ya-nv-dv, a-se-no a-ni-gi-yo-li-yu ge-ga-su-ye-dv."
        intervals [29]:
            xmin = 223.990
            xmax = 224.910
            text = ""
        intervals [30]:
            xmin = 224.910
            xmax = 233.950
            text = "012215: Hna-quo-no A-ni-qua-li-si u-ne-nv-sv-gi wu-ni-no-he-lv-gi i-yu-na-dv-ne-di-yi u-ni-sa-dv-di-yi ga-wo-ni-s-gv-i."
        intervals [31]:
            xmin = 233.950
            xmax = 234.600
            text = ""
        intervals [32]:
            xmin = 234.600
            xmax = 265.350
            text = "012216: Du-ni-nv-sv-gi-no tse-do-hv gv-wa-ni-s-da-wa-di-do-hi a-le E-lo-dv gv-wa-s-de-li-s-gi, hi-a nu-ni-we-sv-gi; Ta-de-yo-hv-s-gi, o-tsi-ga-ta-ha u-do-hi-yu-gi-ya ge-sv ni-hi, a-le U-ne-la-nv-hi u-tse-li-ga du-yu-go-dv de-ha-de-yo-hv-s-gv-i, v-tla a-le yv-wi yi-ti-na-ye-s-ga, v-tla-ye-no nu-na-s-dv-quo yv-wi yi-ti-lv-quo-do-i."
        intervals [33]:
            xmin = 265.350
            xmax = 266.450
            text = ""
        intervals [34]:
            xmin = 266.450
            xmax = 279.970
            text = "012217: Na-s-gi i-yu-s-di s-gi-no-hv-si, Ga-do he-li-ha?  Tsi-sa du-yu-go-di Si-sa a-gu-yv-e-di-yi a-ye-li a-gu-yv-di ge-sv-i; tla-ge?"
        intervals [35]:
            xmin = 279.970
            xmax = 281.055
            text = ""
        intervals [36]:
            xmin = 281.055
            xmax = 293.955
            text = "012218: A-se-no Tsi-sa u-do-le-ho-sv-gi u-yo-quo a-na-da-nv-te-s-gv-i, a-le hi-a ni-du-we-se-lv-gi; Ga-do-no i-s-gi-sa-dv-v-s-ga, i-tsa-tlo-na-s-di?"
        intervals [37]:
            xmin = 293.955
            xmax = 295.150
            text = ""
        intervals [38]:
            xmin = 295.150
            xmax = 302.515
            text = "012219: Tsi-go-wa-dv a-de-lv a-ye-li a-gu-yv-do-di.  A-gi-si-no tsu-gv-wa-lo-di gv-wa-yo-he-lv-gi."
        intervals [39]:
            xmin = 302.515
            xmax = 303.720
            text = ""
        intervals [40]:
            xmin = 303.720
            xmax = 312.570
            text = "012220: Hi-a-no ni-du-we-ha-lv-gi; Ga-go hi-a da-ga-tli-lo-s-di, a-le Ga-go a-tsi-no-he-ha hi-a tsi-go-we-la?"
        intervals [41]:
            xmin = 312.570
            xmax = 313.460
            text = ""
        intervals [42]:
            xmin = 313.460
            xmax = 327.265
            text = "012221: Si-sa, u-na-dv-nv-gi.  Hi-a-no ni-du-we-se-lv-gi; Si-sa a-di-na e-tsi-hv-si Si-sa u-tse-li-ga, U-ne-la-nv-hi-no U-ne-la-nv-hi u-tse-li-ga."
        intervals [43]:
            xmin = 327.265
            xmax = 328.360
            text = ""
        intervals [44]:
            xmin = 328.360
            xmax = 333.530
            text = "012222: U-na-dv-ga-nv-no u-ni-s-qua-ni-go-sv-gi, a-le u-na-da-nv-e-lv-gi."
        intervals [45]:
            xmin = 333.530
            xmax = 334.600
            text = ""
        intervals [46]:
            xmin = 334.600
            xmax = 344.015
            text = "012223: Na-hi-yu i-ga A-ni-sa-du-si di-le-hi-so-di ge-sv u-na-dla-si-dv-e-hi gv-wa-lu-tse-lv-gi, a-le gv-wa-dv-dv-nv-gi,"
        intervals [47]:
            xmin = 344.015
            xmax = 344.740
            text = ""
        intervals [48]:
            xmin = 344.740
            xmax = 366.010
            text = "012224: Hi-a nu-ni-we-sv-gi; Ta-de-yo-hv-s-gi, Mo-si u-ne-tse hi-a nu-we-se-i; I-yu-no a-s-ga-ya a-yo-hu-s-ge-s-di tsu-we-tsi na-ne-hv-na ge-se-s-di, di-na-da-nv-tli a-da-ye-ge-s-di u-da-yv-dv, na-s-gi-no da-dv-hi-s-da-ne-he-s-di di-ni-yo-li di-na-da-nv-tli."
        intervals [49]:
            xmin = 366.010
            xmax = 367.355
            text = ""
        intervals [50]:
            xmin = 367.355
            xmax = 389.520
            text = "012225: Na-s-gi-no a-yv o-tse-hv a-ne-hv-gi ga-li-quo-gi i-ya-ni-dv a-na-da-nv-tli; u-da-ni-li-ge-no u-de-sv-nv u-yo-hu-sv-quo, tsu-we-tsi-no na-ne-hv-na ge-sv i-yu-s-di u-da-li-i u-we-go-da-ne-lv u-nv-tli."
        intervals [51]:
            xmin = 389.520
            xmax = 390.760
            text = ""
        intervals [52]:
            xmin = 390.760
            xmax = 398.675
            text = "012226: Na-s-gi-ya na-s-quo ta-li-ne-i, a-le tso-i-ne-i, ga-li-quo-gi-ne wi-gv-di-s-gi."
        intervals [53]:
            xmin = 398.675
            xmax = 399.590
            text = ""
        intervals [54]:
            xmin = 399.590
            xmax = 402.840
            text = "012227: U-li-s-qua-lv-di-no a-ge-yv na-s-quo u-yo-hu-sv-gi."
        intervals [55]:
            xmin = 402.840
            xmax = 403.900
            text = ""
        intervals [56]:
            xmin = 403.900
            xmax = 414.640
            text = "012228: Na-s-gi i-yu-s-di hna-quo tsu-ni-yo-hu-sv-hi da-na-le-hi-sa-nv-ha, ga-go u-da-li-i ge-se-s-di na-s-gi ga-li-quo-gi i-ya-ni-dv ge-sv-i?"
        intervals [57]:
            xmin = 414.640
            xmax = 415.230
            text = ""
        intervals [58]:
            xmin = 415.230
            xmax = 427.810
            text = "012229: Tsi-sa u-ne-tsv hi-a ni-du-we-se-lv-gi; I-tsi-li-da-s-di-ha ni-tsi-ga-ta-v-na ge-sv i-yu-s-di nu-s-dv go-we-lv-i, a-le nu-li-ni-gv-gv U-ne-la-nv-hi."
        intervals [59]:
            xmin = 427.810
            xmax = 428.960
            text = ""
        intervals [60]:
            xmin = 428.960
            xmax = 445.975
            text = "012230: Tsu-ni-yo-hu-sv-hi-ye-no da-na-le-hi-sa-nv-ha, v-tla yi-da-na-de-sv-hv-s-go-i, v-tla a-le yi-di-ge-tsi-ye-go-i; di-ni-ka-hna-wa-di-do-hi-s-gi-ni ga-lv-la-di a-ne-hi U-ne-la-nv-hi tsu-tse-li na-s-gi-ya ge-so-i."
        intervals [61]:
            xmin = 445.975
            xmax = 446.880
            text = ""
        intervals [62]:
            xmin = 446.880
            xmax = 460.960
            text = "012231: Tsu-ni-yo-hu-sv-hi-s-gi-ni-no-nv u-na-le-hi-so-di ge-sv tsi-tsi-ne-i-s-di-ha, tla-s-go yi-tsi-go-li-ye-o U-ne-la-nv-hi i-tsi-ne-tse-lv-hi, hi-a tsi-ni-ga-we-ha?"
        intervals [63]:
            xmin = 460.960
            xmax = 461.890
            text = ""
        intervals [64]:
            xmin = 461.890
            xmax = 480.690
            text = "012232: A-yv U-ne-la-nv-hi E-qua-ha-mi u-tse-li-ga, a-le U-ne-la-nv-hi E-si-gi u-tse-li-ga, a-le U-ne-la-nv-hi Tse-ga-qui u-tse-li-ga.  V-tla U-ne-la-nv-hi tsu-ni-yo-hu-sv-hi u-na-tse-li yi-gi, di-nv-no-dv-quo-s-gi-ni u-nv-sv."
        intervals [65]:
            xmin = 480.690
            xmax = 482.375
            text = ""
        intervals [66]:
            xmin = 482.375
            xmax = 489.310
            text = "012233: U-ni-tsa-ti-no u-na-dv-ga-nv u-ni-s-qua-ni-go-sv-gi nu-s-dv da-de-yo-hv-s-gv-i."
        intervals [67]:
            xmin = 489.310
            xmax = 490.150
            text = ""
        intervals [68]:
            xmin = 490.150
            xmax = 497.740
            text = "012234: A-ni-qua-li-si-s-gi-ni u-na-dv-ga-nv e-la-we-yi du-wa-nv A-ni-sa-du-si, na-s-gi du-ni-la-wi-tsv-gi."
        intervals [69]:
            xmin = 497.740
            xmax = 498.550
            text = ""
        intervals [70]:
            xmin = 498.550
            xmax = 510.210
            text = "012235: A-si-yv-wi-no na-hna u-da-su-yv-gi di-ka-hna-wa-dv-s-di di-go-si-si-s-gi, u-dv-dv-nv-gi u-sa-dv-v-s-gv-i, hi-a nu-we-sv-gi;"
        intervals [71]:
            xmin = 510.210
            xmax = 510.855
            text = ""
        intervals [72]:
            xmin = 510.855
            xmax = 517.690
            text = "012236: Ta-de-yo-hv-s-gi, ga-do u-s-di u-tli ga-lv-quo-di-yu u-li-ne-tsv di-ka-hna-wa-dv-s-di?"
        intervals [73]:
            xmin = 517.690
            xmax = 518.440
            text = ""
        intervals [74]:
            xmin = 518.440
            xmax = 532.190
            text = "012237: Tsi-sa-no hi-a nu-we-se-lv-gi; Yi-ho-wa Tsa-ne-la-nv-hi hi-ge-yu-se-s-di ni-ga-v tsa-na-wi hv-di-s-ge-s-di, a-le ni-ga-v tsa-da-nv-do, a-le ni-ga-v tsa-da-nv-te-di-yi."
        intervals [75]:
            xmin = 532.190
            xmax = 532.860
            text = ""
        intervals [76]:
            xmin = 532.860
            xmax = 537.710
            text = "012238: Na-s-gi hi-a i-gv-yi-yi a-le u-tsa-ti ga-lv-quo-di di-ka-hna-wa-dv-s-di."
        intervals [77]:
            xmin = 537.710
            xmax = 538.530
            text = ""
        intervals [78]:
            xmin = 538.530
            xmax = 548.140
            text = "012239: Ta-li-ne-no na-s-gi-ya-quo na-s-quo; tsv-sv tsi-ni-tsa-da-ge-yu-sv ni-ge-yu-se-s-di na-v i-di-s-da-da-la."
        intervals [79]:
            xmin = 548.140
            xmax = 549.350
            text = ""
        intervals [80]:
            xmin = 549.350
            xmax = 559.130
            text = "012240: Na-s-gi hi-a ta-li nu-li-ne-tsv du-li-s-da-yi-di-s-di ni-ga-di-yu di-ka-hna-wa-dv-s-di a-le u-na-do-le-ho-sv-i."
        intervals [81]:
            xmin = 559.130
            xmax = 560.320
            text = ""
        intervals [82]:
            xmin = 560.320
            xmax = 566.280
            text = "012241: A-si-quo da-ni-la-wi-v A-ni-qua-li-si, Tsi-sa du-dv-dv-nv-gi,"
        intervals [83]:
            xmin = 566.280
            xmax = 566.940
            text = ""
        intervals [84]:
            xmin = 566.940
            xmax = 577.160
            text = "012242: Hi-a nu-we-sv-gi; Ga-do i-tse-li e-tsa-da-nv-te-s-gv Ga-lo-ne-dv, Ga-go u-we-tsi?  De-wi, v-gv-wo-se-lv-gi."
        intervals [85]:
            xmin = 577.160
            xmax = 578.135
            text = ""
        intervals [86]:
            xmin = 578.135
            xmax = 591.445
            text = "012243: Hi-a ni-du-we-se-lv-gi; Ga-do-no di-ga-li-s-do-di-ha, De-wi a-da-nv-do u-we-yo-hv-s-gv-i, Tsa-gv-wi-yu-hi, tsi-go-se-ha?  Hi-a tsi-ni-ga-we-ha;"
        intervals [87]:
            xmin = 591.445
            xmax = 592.320
            text = ""
        intervals [88]:
            xmin = 592.320
            xmax = 608.420
            text = "012244: Yi-ho-wa hi-a nu-we-se-lv-gi U-gv-wi-yu-hi a-qua-tse-li-ga; Tsi-ga-ti-si i-di-tlv tso-le-s-di, gv-ni ge-tsa-s-ga-gi di-tsa-la-si-di-yi ga-s-gi-lo ni-ga-tsi-yv-ne-lv-ha;"
        intervals [89]:
            xmin = 608.420
            xmax = 609.400
            text = ""
        intervals [90]:
            xmin = 609.400
            xmax = 616.750
            text = "012245: I-yu-ye-no De-wi, Tsa-gv-wi-yu-hi, yi-go-se-ha, Ga-do yi-ga-li-s-do-da u-we-tsi yi-gi?"
        intervals [91]:
            xmin = 616.750
            xmax = 618.090
            text = ""
        intervals [92]:
            xmin = 618.090
            xmax = 630.650
            text = "012246: Tla hna-quo ye-li gi-lo s-ga-ne-tsv-hi gv-wa-ne-tse-di yi-ge-se-i; tla a-le gi-lo na-hi-yu i-yu-da-le-nv-dv ye-li ga-gv-wa-dv-dv-di yi-ge-se-i."
    item [2]:
        class = "IntervalTier"
