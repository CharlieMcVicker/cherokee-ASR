item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 620.600
        intervals: size = 76
        intervals [1]:
            xmin = 0.000
            xmax = 3.400
            text = ""
        intervals [2]:
            xmin = 3.400
            xmax = 11.340
            text = "010901: Tsi-yu-hi-no u-tsa-nv, du-we-so-tse-i, u-wa-sv-no u-we-du-hv wu-lu-tse-i."
        intervals [3]:
            xmin = 11.340
            xmax = 12.350
            text = ""
        intervals [4]:
            xmin = 12.350
            xmax = 36.270
            text = "010902: Gv-ni-yu-quo-no gv-wa-ti-no-he-le a-s-ga-ya u-tlv-gi u-lv-da-lv-v-s-gi ga-nv-ge a-tse-s-do-gi-hi; Tsi-sa-no u-do-le-ho-sv a-no-hi-yu-hv-s-gv-i, hi-a nu-we-se-le u-lv-da-lv-v-s-gi; A-que-tsi, u-ga-li-s-di-yu-quo ha-da-nv-da-da, tsa-s-ga-nv-tsv e-tsa-do-li-gi."
        intervals [5]:
            xmin = 36.270
            xmax = 37.000
            text = ""
        intervals [6]:
            xmin = 37.000
            xmax = 48.815
            text = "010903: Gv-ni-yu-quo-no i-ga-dv di-no-we-li-s-gi hi-a nu-ni-we-se du-na-da-nv-dv-i; hi-a a-s-ga-ya Ga-lv-la-di e-hi a-so-tlv-i-s-di-ha."
        intervals [7]:
            xmin = 48.815
            xmax = 50.550
            text = ""
        intervals [8]:
            xmin = 50.550
            xmax = 61.080
            text = "010904: Tsi-sa-no a-ga-ta-he nu-s-dv a-na-da-nv-te-s-gv-i, hi-a-no ni-du-we-se-le-i; Ga-do-no u-yo i-tsa-da-nv-te-ha di-tsi-na-wi-yi?"
        intervals [9]:
            xmin = 61.080
            xmax = 62.430
            text = ""
        intervals [10]:
            xmin = 62.430
            xmax = 76.575
            text = "010905: Ga-do-ge u-s-di u-tli a-hi-di-yu ka-ne-i-s-di-yi, tsi-go hi-a yi-na-ga-we-a, tsa-s-ga-nv-tsv e-tsa-do-li-gi?  Hi-a-ge yi-na-ga-we-a, ta-le-hv-ga a-le ge-da?"
        intervals [11]:
            xmin = 76.575
            xmax = 77.770
            text = ""
        intervals [12]:
            xmin = 77.770
            xmax = 97.840
            text = "010906: A-di-na i-tsa-do-le-ho-hi-s-di-yi yv-wi U-we-tsi a-s-ga-nv-tsv gv-wa-da-do-li-s-di ge-sv a-ni e-lo-hi, hna-quo hi-a nu-we-se-le u-lv-da-lv-v-s-gi; Ta-le-hv-ga, tsa-tse-s-do hi-na-gi, a-le di-tse-nv-sv he-na."
        intervals [13]:
            xmin = 97.840
            xmax = 98.840
            text = ""
        intervals [14]:
            xmin = 98.840
            xmax = 101.825
            text = "010907: Du-le-nv-no tsu-we-nv-sv wu-lo-se-i."
        intervals [15]:
            xmin = 101.825
            xmax = 103.000
            text = ""
        intervals [16]:
            xmin = 103.000
            xmax = 117.430
            text = "010908: U-ni-tsa-ti-no u-ni-go-hv, u-ni-s-qua-ni-go-se-i, a-le u-ni-lv-quo-ta-ne U-ne-la-nv-hi na-s-gi tsu-li-s-go-lv-da-ne-lv-hi na-s-gi i-yu-s-di tsu-ni-lv-wi-s-da-ne-di-yi yv-wi."
        intervals [17]:
            xmin = 117.430
            xmax = 118.730
            text = ""
        intervals [18]:
            xmin = 118.730
            xmax = 135.200
            text = "010909: Tsi-sa-no na-hna u-da-nv-sv, u-go-hv-gi a-s-ga-ya Ma-du tsu-do-i-dv, u-wo-lv-gi a-ye-li a-gu-yv-di-yi.  Hi-a-no nu-we-se-lv-gi; S-gi-s-da-wa-du-ga.  Du-le-nv-no u-s-da-wa-dv-sv-gi."
        intervals [19]:
            xmin = 135.200
            xmax = 136.610
            text = ""
        intervals [20]:
            xmin = 136.610
            xmax = 156.630
            text = "010910: Hi-a-no nu-li-s-ta-nv-gi, ga-nv-gv [a-li-s-da-yv-hv-s-gv] ga-li-tso-de, gv-ni-yu-quo u-ni-tsa-dv-gi a-de-lv a-ni-gi-si-do-hi a-le a-ni-s-ga-na u-ni-lu-tsv u-na-ni-tlv-nv-gi a-ni-nv-dla-v Tsi-sa a-le gv-wa-s-da-wa-di-do-hi."
        intervals [21]:
            xmin = 156.630
            xmax = 157.740
            text = ""
        intervals [22]:
            xmin = 157.740
            xmax = 174.960
            text = "010911: A-ni-qua-li-si-no u-na-do-le-ho-sv, hi-a ni-du ni-we-se-lv gv-wa-s-da-wa-di-do-hi; Ga-do-no Di-tse-yo-hv-s-gi a-de-lv a-ni-gi-si-do-hi a-le a-ni-s-ga-na i-tsu-la-ha i-a-na-li-s-da-yv-hv-s-ga?"
        intervals [23]:
            xmin = 174.960
            xmax = 175.950
            text = ""
        intervals [24]:
            xmin = 175.950
            xmax = 188.340
            text = "010912: Tsi-sa-no u-dv-ga-nv hi-a ni-du-we-se-lv-gi; Ni-du-ni-tlv-gv-na v-tla u-du-lv-di yi-nu-na-li-s-da-ne-ho di-da-nv-wi-s-gi, tsu-ni-tlv-gi-s-gi-ni."
        intervals [25]:
            xmin = 188.340
            xmax = 189.360
            text = ""
        intervals [26]:
            xmin = 189.360
            xmax = 216.540
            text = "010913: I-tse-na-s-gi-ni, wi-tsa-de-lo-qua ga-dv-gv hi-a na-s-gi tsi-ni-ga-we-ha; a-da-do-li-s-di ge-sv a-qua-du-li-ha, v-tla-no a-tsi-lv--ge-la-s-di-yi ge-sv-i.  V-tla-ye-no na-ni-s-ga-nv-na yi-di-tsi-ya-nv-hi-lv, a-ni-s-ga-na-s-gi-ni tsu-ni-ne-tli-yv-s-di-yi du-na-da-nv-dv-i."
        intervals [27]:
            xmin = 216.540
            xmax = 217.850
            text = ""
        intervals [28]:
            xmin = 217.850
            xmax = 238.480
            text = "010914: Hna-quo-no Tsa-ni gv-wa-s-da-wa-di-do-hi [Tsi-sa] gv-wa-lu-tse-lv-gi, hi-a ni-gv-wa-we-se-lv-gi; Ga-do-no a-yv A-ni-qua-li-si-no ya-no a-ma-tli tso-tsv-s-ga, ni-hi-no ge-tsa-s-da-wa-di-do-hi a-ma-tli na-nv-s-gv-na tsi-gi?"
        intervals [29]:
            xmin = 238.480
            xmax = 239.610
            text = ""
        intervals [30]:
            xmin = 239.610
            xmax = 263.120
            text = "010915: Tsi-sa-no hi-a ni-du-we-se-lv-gi; Tsi-go ye-li de-ge-ga-tsv-s-di-s-gv a-ni-ga-ta-hi yi-da-na-tlo-yi-ga a-si-quo u-de-sv-ni-lv-hi u-ne-la-di-do-hv-i?  A-se-no i-ga dv-li-yi-lo-li da-ge-tsi-ya-nv-e-li u-de-sv-ni-lv-hi, gi-la hna-quo a-ma-tli dv-nv-ni."
        intervals [31]:
            xmin = 263.120
            xmax = 264.500
            text = ""
        intervals [32]:
            xmin = 264.500
            xmax = 281.340
            text = "010916: V-tla a-le gi-lo i-tse yi-ga-la-s-tlv-di-s-go u-we-ti a-nu-wo-gi-hi, ga-la-s-tlv-dv-ye-no yv-ga-tsa-ga-lv-da a-nu-wo, u-da-tsa-ga-lv-hv-no u-tli e-quo-hi-yu yi-ni-ga-li-s-da."
        intervals [33]:
            xmin = 281.340
            xmax = 282.400
            text = ""
        intervals [34]:
            xmin = 282.400
            xmax = 312.270
            text = "010917: V-tla a-le i-tse gi-ga-ge--a-di-ta-s-di tsu-we-ti di-su-tlv-dv yi-da-ni-tli-s-di-s-go-i; di-su-tlv-dv-ye-no yi-da-da-tsa-ga-lv, a-le gi-ga-ge--a-di-ta-s-di ya-tse-wo-gi, di-su-tlv-dv-no yi-da-yo-gi.  I-tse-s-gi-ni gi-ga-ge--a-di-ta-s-di di-tse di-su-tlv-dv da-ni-tli-s-di-s-go-i, i-tsu-la-no du-ni-s-qua-ni-go-do-i."
        intervals [35]:
            xmin = 312.270
            xmax = 313.820
            text = ""
        intervals [36]:
            xmin = 313.820
            xmax = 338.570
            text = "010918: A-si-quo na-s-gi ni-de-ga-we-se-hv-gi, gv-ni-yu-quo gi-lo i-yu-s-di nu-gv-wi-yu-sa-de-gi u-lu-tsv u-da-do-li-s-da-ne-lv-gi, hi-a nu-we-sv-gi; A-que-tsi a-ge-yu-tsa ga-yu-la u-yo-hu-si-de-na.  A-di-na he-na, hi-ya-sv-ni-lv-ha, a-ha dv-a-dv-ni-di-quo."
        intervals [37]:
            xmin = 338.570
            xmax = 339.840
            text = ""
        intervals [38]:
            xmin = 339.840
            xmax = 346.035
            text = "010919: Tsi-sa-no du-le-nv u-s-da-wa-dv-sv-gi, a-le na-s-quo gv-wa-s-da-wa-di-do-hi."
        intervals [39]:
            xmin = 346.035
            xmax = 347.360
            text = ""
        intervals [40]:
            xmin = 347.360
            xmax = 363.820
            text = "010920: Gv-ni-yu-quo-no a-ge-yv u-tlv-gi gi-gv u-we-nv-e-hi ta-la-du tsu-de-ti-yv-da i-gv-wa-li-s-ta-nv-hi, o-ni-di-tlv u-lu-hi-s-da-ne-lv-gi, ga-da-lu-ya-dv u-nu-wa-v u-sv-ne-lv-gi."
        intervals [41]:
            xmin = 363.820
            xmax = 365.160
            text = ""
        intervals [42]:
            xmin = 365.160
            xmax = 373.555
            text = "010921: Hi-a-ye-no nu-we-se u-da-nv-dv-i; i-yu-no u-nu-wa-v-quo ya-qua-sv-ni-lv, a-se ya-qua-di-wi."
        intervals [43]:
            xmin = 373.555
            xmax = 374.410
            text = ""
        intervals [44]:
            xmin = 374.410
            xmax = 390.295
            text = "010922: Tsi-sa-no u-ga-ta-hv-sv a-le u-go-hv, hi-a nu-we-sv-gi; A-que-tsi, u-ga-li-s-di-quo ha-da-nv-da-da.  Tso-hi-yu-sv tsa-di-wi-s-da.  A-ge-yv-no na-hi-yu-quo u-di-wa-sv-gi."
        intervals [45]:
            xmin = 390.295
            xmax = 391.975
            text = ""
        intervals [46]:
            xmin = 391.975
            xmax = 402.320
            text = "010923: Tsi-sa-no nu-gv-wi-yu-sa-de-gi ga-ne-lv u-lu-tsv, a-le du-go-hv di-ni-tse-lu-hi-s-gi, a-le yv-wi da-ni-yv-gv-i,"
        intervals [47]:
            xmin = 402.320
            xmax = 403.540
            text = ""
        intervals [48]:
            xmin = 403.540
            xmax = 414.560
            text = "010924: Hi-a ni-du-we-se-lv-gi; I-tsa-da-nv-na, na-go-no u-yo-hu-sv-hi yi-gi a-ge-yu-tsa; ga-li-ha-quo-s-gi-ni.  V-gv-wa-ye-tsa-s-ta-nv-quo-no."
        intervals [49]:
            xmin = 414.560
            xmax = 415.460
            text = ""
        intervals [50]:
            xmin = 415.460
            xmax = 425.360
            text = "010925: Ge-tsi-nu-go-wi-sv-no yv-wi, u-yv-lv-gi u-wo-ye-ni u-ni-yv-hv-gi, a-ge-yu-tsa-no du-le-nv-gi."
        intervals [51]:
            xmin = 425.360
            xmax = 426.080
            text = ""
        intervals [52]:
            xmin = 426.080
            xmax = 433.360
            text = "010926: Na-s-gi-no hi-a du-no-tsa-lo-tsi-do-lv-i na-hna ni-gv-na-dv du-ye-li-si-do-lv-gi."
        intervals [53]:
            xmin = 433.360
            xmax = 434.320
            text = ""
        intervals [54]:
            xmin = 434.320
            xmax = 448.760
            text = "010927: Tsi-sa-no na-hna u-da-nv-sv, a-ni-ta-li di-ni-ge-wi a-ni-s-ga-ya gv-wa-s-da-wa-dv-sv-gi, u-ne-lu-gv-gi hi-a na-ni-we-s-gv-gi, s-gi-ni-do-li-gi ni-hi De-wi U-we-tsi."
        intervals [55]:
            xmin = 448.760
            xmax = 449.700
            text = ""
        intervals [56]:
            xmin = 449.700
            xmax = 468.770
            text = "010928: Ga-li-tso-de-no u-yv-lv, di-ni-ge-wi gv-wa-lu-tse-lv-gi, tsi-sa-no hi-a ni-du-we-se-lv-gi; I-s-do-hi-yu-hv-s-ga-s-go ye-li na-s-gi i-gv-qua-dv-ne-di ge-sv-i?  Hi-a ni-gv-wa-we-se-lv-gi; V-v, Tsa-gv-wi-yu-hi."
        intervals [57]:
            xmin = 468.770
            xmax = 469.760
            text = ""
        intervals [58]:
            xmin = 469.760
            xmax = 479.410
            text = "010929: Hna-quo-no du-sv-ne-lv di-ni-ga-do-li, hi-a nu-we-sv-gi; Nu-s-dv i-s-do-hi-yu-hv-s-gv na-s-gi-ya ni-s-da-li-s-da-si."
        intervals [59]:
            xmin = 479.410
            xmax = 480.210
            text = ""
        intervals [60]:
            xmin = 480.210
            xmax = 490.560
            text = "010930: Di-ni-ga-do-li-no du-li-s-du-gi-sv-gi.  Tsi-sa-no du-nv-s-da-de-lv-gi, hi-a ni-du-we-se-lv-gi; Tle-s-di gi-lo u-do-le-ho-sv-gi."
        intervals [61]:
            xmin = 490.560
            xmax = 491.710
            text = ""
        intervals [62]:
            xmin = 491.710
            xmax = 497.020
            text = "010931: A-se-no u-na-da-nv-sv-quo du-ni-no-tsa-la-nv-gi na-hna ni-gv-na-dv-i."
        intervals [63]:
            xmin = 497.020
            xmax = 497.650
            text = ""
        intervals [64]:
            xmin = 497.650
            xmax = 507.800
            text = "010932: Hna-quo-no a-ni-nu-go-gv-i gv-ni-yu-quo gi-lo gv-wa-ti-no-he-lv-gi a-s-ga-ya u-wa-ge-wi, a-s-gi-na u-ya-i."
        intervals [65]:
            xmin = 507.800
            xmax = 508.640
            text = ""
        intervals [66]:
            xmin = 508.640
            xmax = 525.210
            text = "010933: A-s-gi-na-no a-tsi-nu-go-wi-sv u-wa-ge-wi u-wo-ni-sv-gi.  U-ni-tsa-ti-no u-ni-s-qua-ni-go-sv-gi, hi-a nu-ni-we-sv-gi; v-tla i-lv-hi-yu na-s-gi i-yu-s-di a-go-hv-hi yi-gi i-si-li-yi."
        intervals [67]:
            xmin = 525.210
            xmax = 526.590
            text = ""
        intervals [68]:
            xmin = 526.590
            xmax = 539.055
            text = "010934: A-se-no A-ni-qua-li-si hi-a nu-ni-we-sv-gi; A-ni-s-gi-na u-na-tse-li u-gv-wi-yu-hi gv-di-ha tsi-de-ga-nu-go-wi-s-ga a-ni-s-gi-na."
        intervals [69]:
            xmin = 539.055
            xmax = 540.290
            text = ""
        intervals [70]:
            xmin = 540.290
            xmax = 568.510
            text = "010935: Tsi-sa-no ni-ga-v tsu-dv-na de-ga-du-hv a-le tsu-s-di de-ga-du-hv u-we-do-lv-gi, da-de-yo-hv-s-gv-gi tsu-ni-la-wi-i-s-di-yi, a-le a-li-tsi-do-hv-s-gv-gi o-s-dv ka-no-he-dv ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv ka-no-he-s-gv-gi, a-le de-ka-nv-wi-s-gv ni-ga-v du-ni-tlv-gv a-le ni-ga-v v-yu-gi yv-wi u-ni-yi-li-de-hv-i."
        intervals [71]:
            xmin = 568.510
            xmax = 576.805
            text = ""
        intervals [72]:
            xmin = 576.805
            xmax = 595.670
            text = "010936: Du-go-hv-no u-ni-tsa-ti yv-wi, du-we-do-li-tsv-gi, u-da-ga-li-s-do-di-s-gv-gi wa-na-quo da-ni-lo-gv-i, a-le u-na-di-ga-le-yo-tsv-hi ge-sv-i, na-s-gi-ya a-wi u-ni-no-de-na ne-hv-na tsi-ge-so u-ni-ga-ti-ya."
        intervals [73]:
            xmin = 595.670
            xmax = 596.990
            text = ""
        intervals [74]:
            xmin = 596.990
            xmax = 610.230
            text = "010937: Hna-quo hi-a ni-du-we-ha-lv gv-wa-s-da-wa-di-do-hi; E-quo-hi-yu tlo-ge-si u-ga-dv-na-tsv-hi, a-se-no a-ni-ga-yo-li-yu tsu-ni-lv-wi-s-da-ne-hi."
        intervals [75]:
            xmin = 610.230
            xmax = 611.000
            text = ""
        intervals [76]:
            xmin = 611.000
            xmax = 620.600
            text = "010938: Na-s-gi i-yu-s-di e-tsi-ta-yo-si u-lo-ge-dv tsu-nv-s-di-yi tsu-ni-lv-wi-s-da-ne-hi u-ga-dv-na-tse-lv-i."
