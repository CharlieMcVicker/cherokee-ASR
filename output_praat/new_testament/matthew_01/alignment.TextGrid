        intervals [1]:
            xmin = 0.000
            xmax = 10.270
            text = ""
        intervals [2]:
            xmin = 10.270
            xmax = 19.995
            text = "010101: Hi-a go-we-li ka-no-he-ha tsu-ne-tlv-ta-nv-sv Tsi-sa Ga-lo-ne-dv, De-wi u-we-tsi, E-qua-ha-mi u-we-tsi."
        intervals [3]:
            xmin = 19.995
            xmax = 21.480
            text = ""
        intervals [4]:
            xmin = 21.480
            xmax = 35.350
            text = "010102: E-qua-ha-mi E-si-gi u-de-ne-le-i; E-si-gi-no Tse-ga-qui u-de-ne-le-i, Tse-ga-qui-no Tsu-da a-le na-s-gi a-na-da-nv-tli gv-wa-de-ne-le-i;"
        intervals [5]:
            xmin = 35.350
            xmax = 36.640
            text = ""
        intervals [6]:
            xmin = 36.640
            xmax = 55.030
            text = "010103: Tsu-da-no Que-li-si a-le Se-la gv-wa-de-ne-le-i Te-ma du-na-nu-go-wi-se-i; Que-li-si-no I-si-la-mi u-de-ne-le-i; I-si-la-mi-no E-li-mi u-de-ne-le-i;"
        intervals [7]:
            xmin = 55.030
            xmax = 56.090
            text = ""
        intervals [8]:
            xmin = 56.090
            xmax = 68.995
            text = "010104: E-li-mi-no E-mi-ni-da-qui u-de-ne-le-i; E-mi-ni-da-qui-no Na-so-ni u-de-ne-le-i; Na-so-ni-no Sa-li-ma u-de-ne-le-i;"
        intervals [9]:
            xmin = 68.995
            xmax = 70.450
            text = ""
        intervals [10]:
            xmin = 70.450
            xmax = 88.500
            text = "010105: Sa-li-ma-no Quo-si u-de-ne-le-i Le-ha-wi u-na-lv-go-wi-se-i; Quo-si-no O-que-di u-de-ne-le-i Lu-si u-na-nu-go-wi-se-i; O-que-di-no Tse-si u-de-ne-le-i;"
        intervals [11]:
            xmin = 88.500
            xmax = 89.590
            text = ""
        intervals [12]:
            xmin = 89.590
            xmax = 103.740
            text = "010106: Tse-si-no De-wi u-gv-wi-yu-hi u-de-ne-le-i; De-wi-no u-gv-wi-yu-hi So-li-ma-nv u-de-ne-le-i Yu-la-ya u-da-yv-dv u-na-nu-go-wi-se-i;"
        intervals [13]:
            xmin = 103.740
            xmax = 105.140
            text = ""
        intervals [14]:
            xmin = 105.140
            xmax = 119.640
            text = "010107: So-li-ma-nv-no Lo-quo-ma u-de-ne-le-i; Lo-quo-ma-no E-qua-ya u-de-ne-le-i; E-qua-ya-no E-si u-de-ne-le-i;"
        intervals [15]:
            xmin = 119.640
            xmax = 120.880
            text = ""
        intervals [16]:
            xmin = 120.880
            xmax = 133.640
            text = "010108: E-si-no Tso-si-qua u-de-ne-le-i.  Tso-si-qua-no Tso-la-mi u-de-ne-le-i; Tso-la-mi-no O-sa-ya u-de-ne-le-i;"
        intervals [17]:
            xmin = 133.640
            xmax = 134.780
            text = ""
        intervals [18]:
            xmin = 134.780
            xmax = 148.470
            text = "010109: O-sa-ya-no Tso-da-mi u-de-ne-le-i; Tso-da-mi-no E-ha-si u-de-ne-le-i; E-ha-si-no He-si-ga-ya u-de-ne-le-i;"
        intervals [19]:
            xmin = 148.470
            xmax = 149.980
            text = ""
        intervals [20]:
            xmin = 149.980
            xmax = 161.980
            text = "010110: He-si-ga-ya-no Ma-na-si u-de-ne-le-i; Ma-na-si-no A-mo-ni u-de-ne-le-i; A-mo-ni-no Tso-sa-ya u-de-ne-le-i;"
        intervals [21]:
            xmin = 161.980
            xmax = 162.850
            text = ""
        intervals [22]:
            xmin = 162.850
            xmax = 173.650
            text = "010111: Tso-sa-ya-no Tse-go-na-ya a-le a-na-da-nv-tli gv-wa-de-ne-le-i; na-hi-yu Da-di-lo-ni tsi-wi-di-ge-ga-ti-nv-s-ta-ne-i;"
        intervals [23]:
            xmin = 173.650
            xmax = 174.790
            text = ""
        intervals [24]:
            xmin = 174.790
            xmax = 186.760
            text = "010112: Da-di-lo-ni-no wi-di-ge-ga-ti-no-lv Tse-go-na-ya Sa-la-da-yi-li u-de-ne-le-i; Sa-la-da-yi-li-no Tsi-la-que-li u-de-ne-le-i;"
        intervals [25]:
            xmin = 186.760
            xmax = 187.470
            text = ""
        intervals [26]:
            xmin = 187.470
            xmax = 201.400
            text = "010113: Tsi-la-que-li-no A-qua-ya-di u-de-ne-le-i, A-qua-ya-di-no I-la-ya-gi-mi u-de-ne-le-i; I-la-ya-gi-mi-no E-so u-de-ne-le-i;"
        intervals [27]:
            xmin = 201.400
            xmax = 205.160
            text = ""
        intervals [28]:
            xmin = 205.160
            xmax = 216.435
            text = "010114: E-so-no Se-do-gi u-de-ne-le-i; Se-do-gi-no E-gi-mi u-de-ne-le-i; E-gi-mi-no I-la-ya-di u-de-ne-le-i;"
        intervals [29]:
            xmin = 216.435
            xmax = 217.560
            text = ""
        intervals [30]:
            xmin = 217.560
            xmax = 231.145
            text = "010115: I-la-ya-di-no I-li-e-sa u-de-ne-le-i; I-li-e-sa-no Ma-da-ni u-de-ne-le-i; Ma-da-ni-no Tse-ga-qui u-de-ne-le-i;"
        intervals [31]:
            xmin = 231.145
            xmax = 231.780
            text = ""
        intervals [32]:
            xmin = 231.780
            xmax = 242.480
            text = "010116: Tse-ga-qui-no Tso-wa u-de-ne-le-i, na-s-gi Me-li u-ye-hi na-s-gi tsu-na-nu-go-wi-se Tsi-sa Ga-lo-ne-dv tsa-no-ha-ho-i."
        intervals [33]:
            xmin = 242.480
            xmax = 243.660
            text = ""
        intervals [34]:
            xmin = 243.660
            xmax = 288.020
            text = "010117: Na-s-gi-no ni-ga-dv nu-na-da-ne-tli-yv-sv E-qua-ha-mi tse-he na-hi-yu nv-da-gv-wa-da-le-nv-dv De-wi-no tse-he nv-dv-s-ti ni-ga-du nu-na-da-ne-tli-yv-se-i; De-wi-no tse-he na-hi-yu nv-li-gv-wa-da-le-nv-dv Da-di-lo-ni-no tsi-wi-di-ge-ga-ti-nv-s-ta-ne na-hi-yu nv-dv-s-ti ni-ga-du nu-na-da-ne-tli-yv-se-i; Da-di-lo-ni-no na-hi-yu tsi-wi-di-ge-ga-ti-nv-s-ta-ne u-da-yu-da-le-nv-dv Tsi-sa-no tsu-de-ne na-hi-yu nv-dv-s-ti ni-ga-du nu-na-da-ne-tli-yv-se-i."
        intervals [35]:
            xmin = 288.020
            xmax = 289.130
            text = ""
        intervals [36]:
            xmin = 289.130
            xmax = 309.080
            text = "010118: Na-s-gi-no hi-a nu-li-s-ta-ni-do-le u-de-nv Tsi-sa Ga-lo-ne-dv.  Na-s-gi Me-li Tsi-sa u-tsi Tso-wa u-da-yv-s-di, a-si-quo ni-da-na-tse-gv-na ge-se-i, u-ne-li-tse Ga-lv-quo-di-yu A-da-nv-do u-da-nv-te-lv-hi."
        intervals [37]:
            xmin = 309.080
            xmax = 310.420
            text = ""
        intervals [38]:
            xmin = 310.420
            xmax = 328.100
            text = "010119: Tso-wa na-s-gi na tsu-na-tsv-s-di u-da-nv-ti-yu ge-sv i-yu-s-di, a-le nu-du-li-s-gv-na ge-sv i-yu-s-di gv-ni-ge-sv u-de-ho-hi-s-do-di-yi, u-de-li-dv-quo i-yv-dv wv-da-tsi-ya-ka-ni, u-we-li-se-i."
        intervals [39]:
            xmin = 328.100
            xmax = 329.080
            text = ""
        intervals [40]:
            xmin = 329.080
            xmax = 360.610
            text = "010120: A-se-no a-si-quo hi-a na-s-gi nu-s-de-a-da-nv-te-s-ge-i, gv-ni-yu-quo di-ka-hna-wa-di-do-hi Yi-ho-wa u-nv-si-dv gv-ni-ge-sv nu-dv-ne-le a-s-gi-da-s-gv-i, hi-a ni-ga-we-s-ge-i; Tso-wa, De-wi u-we-tsi, tle-s-di tsa-s-ga-lv hi-ya-nv-di-yi Me-li tsa-da-yv-s-di, na-s-gi-ye-no na tsi-ga-ne-li Ga-lv-quo-di-yu A-da-nv-do u-da-nv-te-lv-hi;"
        intervals [41]:
            xmin = 360.610
            xmax = 362.380
            text = ""
        intervals [42]:
            xmin = 362.380
            xmax = 376.390
            text = "010121: A-le da-ga-na-nu-go-wi-si a-tsu-tsa, na-s-gi-no Tsi-Sa de-hi-yo-v-ha, tsu-tse-li-ye-no yv-wi do-dv-s-de-lv-hi do-da-gu-da-le-si u-ni-s-ga-nv-tsv-i."
        intervals [43]:
            xmin = 376.390
            xmax = 377.800
            text = ""
        intervals [44]:
            xmin = 377.800
            xmax = 389.590
            text = "010122: Na-s-gi-no hi-a ni-ga-di-yu nu-li-s-ta-ni-do-le u-do-hi-yu-di-yi a-ye-lv-sv-i hi-a tsi-nu-we-se Yi-ho-wa a-do-le-ho-s-gi a-gv-di-s-gv-i;"
        intervals [45]:
            xmin = 389.590
            xmax = 390.940
            text = ""
        intervals [46]:
            xmin = 390.940
            xmax = 415.300
            text = "010123: Gv-ni-yu-quo a-dv na-tsi-ye-hv-na ga-ne-li-dv ge-se-s-di, a-le da-ga-na-nu-go-wi-si a-tsu-tsa, na-s-gi-no I-ma-nu-e-li a-no-se-he-s-di, na-s-gi a-ne-tlv-ta-nv-hi ge-sv hi-a nu-s-di ga-dv-ga, U-ne-la-nv-hi i-ge-la-di-do-ha."
        intervals [47]:
            xmin = 415.300
            xmax = 416.430
            text = ""
        intervals [48]:
            xmin = 416.430
            xmax = 429.250
            text = "010124: Tso-wa-no u-ye-tsv u-lv-nv-i di-ka-hna-wa-di-do-hi Yi-ho-wa nv-da-yu-nv-si-dv nu-we-se-lv nu-dv-ne-le-i, u-ya-nv-ge-quo u-da-yv-s-di."
        intervals [49]:
            xmin = 429.250
            xmax = 429.860
            text = ""
        intervals [50]:
            xmin = 429.860
            xmax = 441.120
            text = "010125: A-le v-tla yu-ga-do-v-se-i gv-ni u-na-nu-go-wi-sv i-gv-yi e-hi u-we-tsi a-tsu-tsa, Tsi-sa-no su-wo-e-i."
