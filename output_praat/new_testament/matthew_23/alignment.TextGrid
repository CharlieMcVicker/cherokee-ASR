item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 700.270
        intervals: size = 78
        intervals [1]:
            xmin = 0.000
            xmax = 4.315
            text = ""
        intervals [2]:
            xmin = 4.315
            xmax = 9.400
            text = "012301: Hna-quo-no Tsi-sa du-wo-ne-ta-nv-gi u-ni-tsa-ti a-le gv-wa-s-da-wa-di-do-hi,"
        intervals [3]:
            xmin = 9.400
            xmax = 10.310
            text = ""
        intervals [4]:
            xmin = 10.310
            xmax = 19.720
            text = "012302: Hi-a nu-we-sv-gi; di-no-we-li-s-gi a-le A-ni-qua-li-si Mo-si u-we-s-gi-lv a-ni-na;"
        intervals [5]:
            xmin = 19.720
            xmax = 20.860
            text = ""
        intervals [6]:
            xmin = 20.860
            xmax = 43.865
            text = "012303: Na-s-gi hi-yu-s-di ni-ga-v go-hu-s-di di-tsi-ka-hna-wa-du-ga ge-tso-se-he-s-di de-tsi-ka-hna-wa-de-ge-s-di a-le na-s-gi ni-tsa-dv-ne-he-s-di; a-se-no na-s-gi na-na-dv-ne-hv-i tle-s-di yi-ni-tsa-dv-ne-he-s-di; a-ni-ne-go-ye-no a-se-no v-tla na-s-gi yi-na-na-dv-ne-ho-i."
        intervals [7]:
            xmin = 43.865
            xmax = 44.910
            text = ""
        intervals [8]:
            xmin = 44.910
            xmax = 64.220
            text = "012304: Da-na-da-li-tlv-s-go-ye-no di-ga-ge-dv di-li-sv-s-di a-le u-de-ya-do-di di-li-sv-s-di-yi, na-s-gi-no yv-wi da-ni-no-ha-tla-hv-s-go-i; a-se-no u-nv-sv v-tla sa-quo a-ni-ye-sa-dv yv-gv-nv-da yi-do-gv-ni-te-lv-hv-ga."
        intervals [9]:
            xmin = 64.220
            xmax = 64.990
            text = ""
        intervals [10]:
            xmin = 64.990
            xmax = 82.695
            text = "012305: Ni-ga-di-yu-s-gi-ni du-ni-lv-wi-s-da-ne-hv yv-wi-quo gv-wa-ni-go-wa-dv-di-yi u-ni-ye-lv-so-i.  Di-ya-te-na ni-da-nv-ne-ho tsu-na-gv-da-no-s-di, a-le da-ni-ya-dv-v-s-di-s-go de-ga-da-lu-ya-dv tsu-na-nu-wo;"
        intervals [11]:
            xmin = 82.695
            xmax = 83.440
            text = ""
        intervals [12]:
            xmin = 83.440
            xmax = 94.160
            text = "012306: A-le u-ni-lv-quo-do nu-gv-wi-yu-sv tsu-na-ni-tlv-di-yi da-na-li-s-da-yv-hv-s-gv-i, a-le nu-gv-wi-yu-sv de-ga-s-gi-lv di-ga-la-wi-i-s-di-yi,"
        intervals [13]:
            xmin = 94.160
            xmax = 95.120
            text = ""
        intervals [14]:
            xmin = 95.120
            xmax = 103.570
            text = "012307: A-le ge-tsi-yo-li-s-di-yi di-ga-no-do-di-yi, a-le Ta-de-yo-hv-s-gi, Ta-de-yo-hv-s-gi, gv-wa-no-se-di-yi yv-wi."
        intervals [15]:
            xmin = 103.570
            xmax = 104.610
            text = ""
        intervals [16]:
            xmin = 104.610
            xmax = 118.190
            text = "012308: Ni-hi-s-gi-ni tle-s-di Ta-de-yo-hv-s-gi, ye-tso-se-he-s-di; a-si-yv-wi-ye-no Di-tse-yo-hv-s-gi, na-s-gi Ga-lo-ne-dv; ni-ga-dv-no ni-hi i-tsa-li-nv-tli-quo."
        intervals [17]:
            xmin = 118.190
            xmax = 119.360
            text = ""
        intervals [18]:
            xmin = 119.360
            xmax = 130.535
            text = "012309: A-le tle-s-di gi-lo e-do-da e-tso-se-lv-gi a-ni e-lo-hi; a-si-yv-wi-quo-ye-no I-tsi-do-da, na-s-gi ga-lv-la-di tsv-tse-ha."
        intervals [19]:
            xmin = 130.535
            xmax = 131.540
            text = ""
        intervals [20]:
            xmin = 131.540
            xmax = 141.520
            text = "012310: A-le tle-s-di S-qua-ti-ni-do-hi ye-tso-se-he-s-di ni-hi, a-si-yv-wi-quo-ye-no Di-tsa-ti-ni-do-hi, na-s-gi Ga-lo-ne-dv."
        intervals [21]:
            xmin = 141.520
            xmax = 142.340
            text = ""
        intervals [22]:
            xmin = 142.340
            xmax = 150.570
            text = "012311: Gi-lo-s-gi-ni u-tli a-tsi-lv-quo-di-yu ge-se-s-di ni-hi i-tse-hv-i, na-s-gi e-tsi-nv-si-da-s-di ge-se-s-di."
        intervals [23]:
            xmin = 150.570
            xmax = 151.540
            text = ""
        intervals [24]:
            xmin = 151.540
            xmax = 165.730
            text = "012312: Gi-lo-no u-wa-sv-quo i-a-da-sa-la-di-s-ge-s-di e-la-di i-ya-gv-ne-di ge-se-s-di; gi-lo-no u-wa-sv-quo e-la-di na-da-dv-ne-he-s-di a-tsi-sa-la-do-di ge-se-s-di."
        intervals [25]:
            xmin = 165.730
            xmax = 166.610
            text = ""
        intervals [26]:
            xmin = 166.610
            xmax = 190.785
            text = "012313: Ni-hi-s-gi-ni u-yo-i-yu i-tsa-li-s-da-ne-di di-tso-we-li-s-gi a-le I-tsi-qua-li-si i-tsa-tlo-na-s-di!  de-tsi-s-du-ne-ho-ye-no yv-wi ga-lv-la-di u-tse-li-go-hi; v-tla-ye-no i-tsv-sv yi-tsi-yv-hi-ho-i, a-le v-tla u-na-ne-la-gi wa-ni-yv-ha yi-di-tse-li-se-ho wa-ni-yv-hi-hi."
        intervals [27]:
            xmin = 190.785
            xmax = 191.800
            text = ""
        intervals [28]:
            xmin = 191.800
            xmax = 215.970
            text = "012314: U-yo-i-yu i-tsa-li-s-da-ne-di di-tso-we-li-s-gi a-le I-tsi-qua-li-si i-tsa-tlo-na-s-di!  de-tsi-sv-ne-ho-ye-no tsu-no-su-lo-tsv-hi da-ni-ne-lv-i, a-le i-tsa-tlo-na-s-dv go-hi-di-yu i-tsa-da-do-li-s-di-s-go-i.  Na-s-gi i-yu-s-di u-tli-hi-yu i-ga-i i-tsi-gi-li-yo-i-s-di ge-se-s-di."
        intervals [29]:
            xmin = 215.970
            xmax = 217.510
            text = ""
        intervals [30]:
            xmin = 217.510
            xmax = 247.610
            text = "012315: U-yo-i-yu i-tsa-li-s-da-ne-di di-tso-we-li-s-gi a-le I-tsi-qua-li-si i-tsa-tlo-na-s-di!  de-tsa-de-yo-ho-ye-no a-me-quo-hi a-le ga-do-hi e-tsi-yo-ho a-si-yv-wi nu-s-dv i-tso-hi-yu-sv go-hi-yu-hv-s-gi i-ye-tsv-ne-di-yi, a-le na-s-gi ne-tsv-ga ta-li i-yu-wa-gu-di u-tli tsv-s-gi-no-i u-we-tsi ne-tsv-ne-ho e-s-ga-quo i-tsv-sv."
        intervals [31]:
            xmin = 247.610
            xmax = 248.280
            text = ""
        intervals [32]:
            xmin = 248.280
            xmax = 276.570
            text = "012316: U-yo-i-yu i-tsa-li-s-da-ne-di, di-tsi-ge-wi di-tsa-da-ti-ni-do-hi!  hi-a i-tsi-we-s-gi; Gi-lo i-a-se-li-dv-s-ge-s-di i-ka-ne-i-s-di-s-ge-s-di u-dv-nv--di-ga-la-wi-i-s-di-yi, a-se-quo-quo na-s-gi; gi-lo-s-gi-ni i-ka-ne-i-s-di-s-ge-s-di a-de-lv da-lo-ni-ge u-dv-na--di-ga-la-wi-i-s-di-yi a-hv-i, na-s-gi a-s-da-yi-yu u-du-da-la."
        intervals [33]:
            xmin = 276.570
            xmax = 277.780
            text = ""
        intervals [34]:
            xmin = 277.780
            xmax = 295.340
            text = "012317: I-tsi-ne-gu a-le di-tsi-ge-wi!  ga-do u-s-di u-tli ga-lv-quo-di-yu, a-de-lv-s-go da-lo-ni-ge-i, u-dv-na--di-ga-la-wi-i-s-di-yi-ge na-s-gi ga-lv-quo-di-yu tsi-ni-gv-ne-ha a-de-lv da-lo-ni-ge-i?"
        intervals [35]:
            xmin = 295.340
            xmax = 296.410
            text = ""
        intervals [36]:
            xmin = 296.410
            xmax = 313.595
            text = "012318: A-le, gi-lo i-ka-ne-i-s-di-s-ge-s-di a-tsi-lv--ge-la-s-di-yi, a-se-quo-quo na-s-gi; gi-lo-s-gi-ni i-ka-ne-i-s-di-s-ge-s-di a-li-s-go-lv-ta-nv-hi na-hna a-hv-i, na-s-gi a-s-da-yi-yu u-du-da-la."
        intervals [37]:
            xmin = 313.595
            xmax = 314.750
            text = ""
        intervals [38]:
            xmin = 314.750
            xmax = 329.530
            text = "012319: I-tsi-ne-gu a-le di-tsi-ge-wi!  ga-do u-s-di u-tli ga-lv-quo-di-yu, a-li-s-go-lv-ta-nv-hi-s-go, a-tsi-lv-ge--ge-la-s-di-yi, na-s-gi ga-lv-quo-di-yu tsi-ni-gv-ne-ha a-li-s-go-lv-ta-nv-hi?"
        intervals [39]:
            xmin = 329.530
            xmax = 330.470
            text = ""
        intervals [40]:
            xmin = 330.470
            xmax = 344.810
            text = "012320: Na-s-gi i-yu-s-di gi-lo i-a-se-li-dv-s-ge-s-di i-ka-ne-i-s-di-s-ge-s-di a-tsi-lv-ge-la-s-di-yi, ka-ne-i-s-di-s-ge-s-di na-s-gi a-le ni-ga-v go-hu-s-di na-hna a-hv-i."
        intervals [41]:
            xmin = 344.810
            xmax = 345.770
            text = ""
        intervals [42]:
            xmin = 345.770
            xmax = 354.850
            text = "012321: A-le gi-lo i-ka-ne-i-s-di-s-ge-s-di u-dv-nv--di-ga-la-wi-i-s-di-yi, ka-ne-i-s-di-s-ge-s-di na-s-gi a-le na-hna ga-ne-la."
        intervals [43]:
            xmin = 354.850
            xmax = 356.420
            text = ""
        intervals [44]:
            xmin = 356.420
            xmax = 365.590
            text = "012322: A-le gi-lo i-ka-ne-i-s-di-s-ge-s-di ga-lv-la-di, ka-ne-i-s-di-s-ge-s-di U-ne-la-nv-hi u-we-di-yi a-le na-hna u-wo-li."
        intervals [45]:
            xmin = 365.590
            xmax = 366.825
            text = ""
        intervals [46]:
            xmin = 366.825
            xmax = 407.775
            text = "012323: U-yo-i-yu i-tsa-li-s-da-ne-di di-tso-we-li-s-gi a-le I-tsi-qua-li-si i-tsa-tlo-na-s-di!  a-s-go-hi-ne-ye-no i-tsa-gu-yi-s-go sv-tli a-le e-sv a-le ga-mi-ni; de-tsi-no-hi-ya-s-go-no u-tli u-li-s-ge-dv-ya ge-sv di-ka-hna-wa-dv-s-di, du-yu-go-dv ge-sv-i, a-le a-da-do-li-s-di-yi, a-le go-hi-yu-di-yi.  Na-s-gi-s-gi-ni hi-a yi-ni-tsa-dv-ne-le-i, a-le so-i ni-tsi-no-hi-yv-na-quo yi-ge-se-i."
        intervals [47]:
            xmin = 407.775
            xmax = 409.500
            text = ""
        intervals [48]:
            xmin = 409.500
            xmax = 418.885
            text = "012324: Di-tsi-ge-wi di-tsa-da-ti-ni-do-hi!  do-sv i-tsi-hna-so-lv-s-di-s-gi ge-mi-li-no i-tsi-gi-s-gi."
        intervals [49]:
            xmin = 418.885
            xmax = 420.190
            text = ""
        intervals [50]:
            xmin = 420.190
            xmax = 443.835
            text = "012325: U-yo-i-yu i-tsa-li-s-da-ne-di di-tso-we-li-s-gi a-le I-tsi-qua-li-si i-tsa-tlo-na-s-di!  i-tso-su-le-s-go-ye-no ga-du-i-di-tlv u-li-s-qui-di a-le a-te-li-do, a-se-no a-wi-ni-di-tlv u-ka-li-tsv-hi ge-so a-se-quo a-da-gi-e-di ge-sv-i a-le du-yu-go-dv ni-ge-sv-na."
        intervals [51]:
            xmin = 443.835
            xmax = 445.170
            text = ""
        intervals [52]:
            xmin = 445.170
            xmax = 458.570
            text = "012326: Hi-qua-li-si ti-ge-wi!  i-gv-yi hi-nv-ga-lv a-wi-ni-di-tlv u-li-s-qui-di a-le a-te-li-do, ga-du-i-di-tlv-no na-s-quo tsu-da-nv-ga-lv-dv ge-se-s-di."
        intervals [53]:
            xmin = 458.570
            xmax = 460.840
            text = ""
        intervals [54]:
            xmin = 460.840
            xmax = 492.050
            text = "012327: U-yo-i-yu i-tsa-li-s-da-ne-di di-tso-we-li-s-gi a-le I-tsi-qua-li-si i-tsa-tlo-na-s-di!  na-s-gi-ya-quo-ye-no ni-hi tsu-ne-gv i-di-gv-ne-lv-hi da-tse-li-s-dv-i, na-s-gi ga-du-i-di-tlv u-do-hi-yu-hi tsu-wo-du-hi-yu tsi-ge-so-i, a-se-no a-wi-ni-di-tlv tsu-ka-li-tsv-hi tsi-ge-so tsu-ni-yo-hu-sv-hi tsu-ni-go-la a-le ni-ga-v ga-da-ha ge-sv-i"
        intervals [55]:
            xmin = 492.050
            xmax = 493.975
            text = ""
        intervals [56]:
            xmin = 493.975
            xmax = 511.410
            text = "012328: Na-s-gi-ya-quo-s-gi-ni na-s-quo ni-hi ga-du-i-di-tlv i-tsa-da-nv-ti-yu nv-wa-s-do-i yv-wi di-ge-tsa-ka-no-di-yi, a-se-no a-wi-ni-di-tlv i-tsi-ka-li-tsv-hi ge-so i-tsa-tlo-na-s-dv-i a-le u-yo-i."
        intervals [57]:
            xmin = 511.410
            xmax = 513.380
            text = ""
        intervals [58]:
            xmin = 513.380
            xmax = 532.160
            text = "012329: U-yo-i-yu i-tsa-li-s-da-ne-di di-tso-we-li-s-gi a-le I-tsi-qua-li-si i-tsa-tlo-na-s-di!  de-tso-tlv-hi-si-s-go-ye-no de-ga-ni-sa-hv a-na-do-le-ho-s-gi, a-le de-tso-du-i-s-di-s-go da-tse-li-s-dv u-na-da-nv-ti;"
        intervals [59]:
            xmin = 532.160
            xmax = 533.600
            text = ""
        intervals [60]:
            xmin = 533.600
            xmax = 548.700
            text = "012330: Hi-a-no ni-tsi-we-s-go-i; I-yu-no a-yv yo-tse-he na-hi-yu tso-gi-do-da tsa-ne-he-i, v-tla yi-do-ga-yo-tsa-li-go-ne-le gi-gv du-na-tse-we-lv a-na-do-le-ho-s-gi."
        intervals [61]:
            xmin = 548.700
            xmax = 549.670
            text = ""
        intervals [62]:
            xmin = 549.670
            xmax = 559.210
            text = "012331: Na-s-gi i-yu-s-di i-tsv-sv gv-ni-ge-sv ni-tsa-da-dv-ne na-s-gi di-tsi-do-da ge-sv a-na-do-le-ho-s-gi tsu-ni-lv-hi."
        intervals [63]:
            xmin = 559.210
            xmax = 560.680
            text = ""
        intervals [64]:
            xmin = 560.680
            xmax = 565.550
            text = "012332: I-tsi-ka-li-tsa-go-ga di-tsi-do-da u-na-tli-lo-v-i."
        intervals [65]:
            xmin = 565.550
            xmax = 566.360
            text = ""
        intervals [66]:
            xmin = 566.360
            xmax = 578.890
            text = "012333: I-na-dv ni-hi!  u-ni-s-ga-se-di i-na-dv tsu-ne-tsi ni-hi!  ga-do-no yi-ga-li-s-do-da ye-tsa-di-wi-si a-gi-li-yo-i-s-di di-ge-sv tsv-s-gi-no-i?"
        intervals [67]:
            xmin = 578.890
            xmax = 579.800
            text = ""
        intervals [68]:
            xmin = 579.800
            xmax = 606.740
            text = "012334: Na-s-gi i-yu-s-di gv-ni-yu-quo de-tsi-nv-li na-hna di-tse-hv a-na-do-le-ho-s-gi a-le a-ni-ga-ta-hna-i a-le di-no-we-li-s-gi; i-ga-dv-no do-da-tsi-li a-le do-da-tsa-dv-ni da-da-hna-wa-s-dv-i, i-ga-dv-no do-da-tsi-li-v-ni-li di-tsi-la-wi-i-s-di-yi, a-le u-yo ni-do-da-tsv-ne-li de-ga-du-hna-v-i;"
        intervals [69]:
            xmin = 606.740
            xmax = 608.300
            text = ""
        intervals [70]:
            xmin = 608.300
            xmax = 636.440
            text = "012335: Na-s-gi i-tsi-lu-tse-di-yi ni-ga-dv o-s-dv gi-gv e-lo-hi u-tse-wo-tsv-hi, u-da-nv-ti E-qui-li u-gi-gv nv-da-gv-wa-da-le-nv-dv, Tse-ga-la-ya u-gi-gv Que-li-ga-ya u-we-tsi nv-dv-s-di, na-s-gi tse-tsi-lv u-dla-nv-dv u-dv-na--di-ga-la-wi-i-s-di-yi a-tsi-lv-no--ge-la-s-di-yi."
        intervals [71]:
            xmin = 636.440
            xmax = 637.820
            text = ""
        intervals [72]:
            xmin = 637.820
            xmax = 646.940
            text = "012336: U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha; hi-a na-s-gi ni-ga-dv da-yu-na-li-yi-lo-he-li hi-a go-hi tsa-ne-ha."
        intervals [73]:
            xmin = 646.940
            xmax = 647.900
            text = ""
        intervals [74]:
            xmin = 647.900
            xmax = 676.520
            text = "012337: Tsi-lu-si-li-mi!  Tsi-lu-si-li-mi!  a-na-do-le-ho-s-gi ti-hi-hi, a-le ge-tsa-lu-tse-di-yi ge-tsi-nv-sv-hi nv-ya dv-ni-s-di-s-gi!  ya-no-gi-yu a-qua-du-li-s-gv ga-tsi-ya-tli-so-di-yi di-tse-tsi, na-s-gi-ya tsa-ta-ga tsi-de-ga-tli-si-s-go tsu-we-tsi a-ni-dv di-ka-no-ge-ni ha-wi-ni-di-tlv; a-se-no v-tla yi-tsa-du-li-s-ge-i."
        intervals [75]:
            xmin = 676.520
            xmax = 677.130
            text = ""
        intervals [76]:
            xmin = 677.130
            xmax = 683.440
            text = "012338: Gv-ni-yu-quo i-tsa-tse-li ga-li-tso-de nv-ta ne-tsv-ne-lv."
        intervals [77]:
            xmin = 683.440
            xmax = 684.070
            text = ""
        intervals [78]:
            xmin = 684.070
            xmax = 700.270
            text = "012339: Hi-a-ye-no ni-tsv-we-se-ha; v-tla yv-ge-s-gi-go-wa-dv go-hi i-yu-da-le-nv-dv, gv-ni hi-a ni-tsi-we-sv-ha; A-tsi-lv-quo-di-yu na-s-gi Yi-ho-wa de-u-do-v tsi-ga-lu-hi-s-di-ha."
