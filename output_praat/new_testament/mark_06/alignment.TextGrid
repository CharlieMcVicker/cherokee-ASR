File type = "ooTextFile"
Object class = "TextGrid"

xmin = 0
xmax = 835.490
tiers? <exists>
size = 5
item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 835.490
        intervals: size = 112
        intervals [1]:
            xmin = 0.000
            xmax = 4.320
            text = ""
        intervals [2]:
            xmin = 4.320
            xmax = 13.840
            text = "020601: U-nu-go-tse-no na-hna-ni, a-le u-wa-sv u-tse-li-go-hi wu-lu-tse-i; gv-wa-s-da-wa-di-do-hi-no gv-wa-s-da-wa-dv-se-i."
        intervals [3]:
            xmin = 13.840
            xmax = 15.150
            text = ""
        intervals [4]:
            xmin = 15.150
            xmax = 45.730
            text = "020602: U-na-do-da-qua-s-gv-no u-li-ye-lo-lv, u-le-nv-he du-de-yo-ne di-ga-la-wi-i-s-di-yi; u-ni-tsa-ti-no gv-wa-dv-ga-ne-lv u-ni-s-qua-ni-go-se-i, hi-a na-ni-we-s-ge-i, Ha-tlv a-gi-ha hi-a a-s-ga-ya hi-a na-s-gi i-gv-wa-dv-ne-di tsi-gi?  A-le ga-do u-s-di a-ga-do-v-hi-s-di na-s-gi a-tsi-ne-lv-hi tsi-gi, na-s-gi i-yu-s-di u-s-qua-ni-go-di tsi-du-lv-wi-s-da-ne-ha?"
        intervals [5]:
            xmin = 45.730
            xmax = 46.800
            text = ""
        intervals [6]:
            xmin = 46.800
            xmax = 65.685
            text = "020603: Tla-s-go na-s-gi hi-a di-ne-s-ge-s-gi yi-gi, Me-li u-we-tsi, Tsi-mi, a-le Tso-si, a-le Tsu-da, a-le Sa-wa-ni a-na-li-nv-tli?  A-le tsu-do tla-s-go a-ni yi-ge-ga-da-su-ya?  V-gv-wa-so-nv-tse-lv-gi-no."
        intervals [7]:
            xmin = 65.685
            xmax = 66.770
            text = ""
        intervals [8]:
            xmin = 66.770
            xmax = 82.585
            text = "020604: Tsi-sa-no hi-a ni-du-we-se-le-i; a-do-le-ho-s-gi v-tla na-tsi-lv-quo-dv-na yi-ge-so-i, u-tse-li-go-hi-s-gi-ni-no-nv u-wa-sv, a-le tsu-yv-wi a-ne-hv-i, a-le u-wa-sv ga-ne-lv-i."
        intervals [9]:
            xmin = 82.585
            xmax = 83.250
            text = ""
        intervals [10]:
            xmin = 83.250
            xmax = 97.355
            text = "020605: A-le na-hna v-tla go-hu-s-di u-s-qua-ni-go-di di-gv-wa-lv-wi-s-da-ne-di yi-ge-se-i, u-wa-sv-s-gi-ni-no-nv i-lv-s-gi i-ya-ni-dv tsu-ni-tlv-gi du-si-ta-dv a-le du-nv-wa-nv-i."
        intervals [11]:
            xmin = 97.355
            xmax = 98.130
            text = ""
        intervals [12]:
            xmin = 98.130
            xmax = 108.890
            text = "020606: A-le u-s-qua-ni-go-se na-no-hi-yu-hv-s-gv-na ge-sv-i.  A-le u-we-do-le u-du-wi-dv de-ga-du-wa-di-sv-i da-de-yo-hv-s-ge-i."
        intervals [13]:
            xmin = 108.890
            xmax = 110.200
            text = ""
        intervals [14]:
            xmin = 110.200
            xmax = 123.815
            text = "020607: Ta-la-du-no i-ya-ni-dv wi-du-ya-nv-he-i, a-le du-nv-si-do-le ta-li-ha tsu-li-go-nv-dv, a-le du-li-s-go-lv-da-ne-le tsu-ni-nu-go-wi-s-di-yi di-ga-da-ha di-da-nv-do;"
        intervals [15]:
            xmin = 123.815
            xmax = 124.520
            text = ""
        intervals [16]:
            xmin = 124.520
            xmax = 142.445
            text = "020608: A-le du-ne-tse-le na-s-gi go-hu-s-di u-ni-yv-s-di-yi ni-ge-sv-na u-na-li-s-de-lv-do-di a-ne-do-hv-i, a-do-la-nv-s-di u-wa-sv; v-tla de-ga-lo-di, a-le ga-du, a-le v-tsa-yi du-na-da-tlo-hv-i;"
        intervals [17]:
            xmin = 142.445
            xmax = 143.430
            text = ""
        intervals [18]:
            xmin = 143.430
            xmax = 149.595
            text = "020609: Tsu-na-la-su-lv-di-yi-s-gi-ni; a-le tle-s-di ta-li yi-di-tsa-nu-wo-s-ge-s-di."
        intervals [19]:
            xmin = 149.595
            xmax = 150.905
            text = ""
        intervals [20]:
            xmin = 150.905
            xmax = 161.375
            text = "020610: A-le hi-a ni-du-we-se-le-i, a-da-ne-lv i-lv-hi-tlv i-tsi-yv-hi-he-s-di, na-hna-quo i-tsa-nv-v-s-ge-s-di gv-ni v-tsa-ni-gi na-hna-ni."
        intervals [21]:
            xmin = 161.375
            xmax = 162.190
            text = ""
        intervals [22]:
            xmin = 162.190
            xmax = 196.525
            text = "020611: A-le gi-lo ni-di-tsa-da-ni-lv-gv-na a-le ni-tsa-dv-da-s-da-ne-hv-na i-ge-se-s-di, hna-quo na-hna i-tsa-ni-gi-s-ge-s-di, di-tsa-la-si-de-ni go-s-du de-tsi-nv-go-v-di-s-ge-s-di, na-s-gi go-hi-yu-di-s-gi u-na-tlu-di-s-gi.  U-do-hi-yu-hi-ya hi-a ni-tsv-we-se-ha, e-s-ga-quo i-ga-i u-ni-gi-li-yo-i-s-di ge-se-s-di So-da-mi, a-le Go-ma-li, di-gu-go-do-di-yi i-ga ge-se-s-di, u-tli-hi-yu na-hna ga-du-hv-i."
        intervals [23]:
            xmin = 196.525
            xmax = 197.360
            text = ""
        intervals [24]:
            xmin = 197.360
            xmax = 205.280
            text = "020612: U-ni-nu-go-tse-no, wu-na-li-tsi-do-ne na-s-gi yv-wi a-se tsu-ni-ne-tli-yv-s-di ge-sv du-na-da-nv-dv-i."
        intervals [25]:
            xmin = 205.280
            xmax = 206.740
            text = ""
        intervals [26]:
            xmin = 206.740
            xmax = 217.460
            text = "020613: U-ni-tsa-ti-no du-ni-nu-go-wi-se a-ni-s-gi-na, a-le go-i du-ni-lo-ne-ta-ne u-ni-tsa-ti tsu-ni-tlv-gi, a-le du-ni-nv-wa-ne-i."
        intervals [27]:
            xmin = 217.460
            xmax = 218.210
            text = ""
        intervals [28]:
            xmin = 218.210
            xmax = 240.890
            text = "020614: E-lo-dv-no u-gv-wi-yu-hi u-dv-ga-ne na-s-gi a-tsi-no-he-s-gv-i; du-no-tsa-lo-tse-ye-no na-s-gi du-do-v-i; a-le hi-a nu-we-se E-lo-dv, Tsa-ni Di-da-wo-s-gi da-le-hi-sa u-yo-hu-sv-i, a-le na-s-gi nv-di-ga-li-s-do-di-ha u-s-qua-ni-go-di tsi-de-u-lv-wi-s-da-ne-ha."
        intervals [29]:
            xmin = 240.890
            xmax = 241.730
            text = ""
        intervals [30]:
            xmin = 241.730
            xmax = 254.780
            text = "020615: I-ga-dv-no hi-a na-ni-we-s-ge-i, I-la-ya hi-a.  I-ga-dv-no hi-a na-ni-we-s-ge-i, a-do-le-ho-s-gi hi-a, a-le gi-lo a-na-do-le-ho-s-gi ge-sv na-s-gi-ya-i."
        intervals [31]:
            xmin = 254.780
            xmax = 255.770
            text = ""
        intervals [32]:
            xmin = 255.770
            xmax = 267.810
            text = "020616: E-lo-dv-s-gi-ni u-dv-ga-nv, hi-a nu-we-se-i; Tsa-ni hi-a, na-s-gi a-yv tsi-tsi-s-gu-de-sv-gi; na-s-gi du-le-hi-sa-nv u-yo-hu-sv-i."
        intervals [33]:
            xmin = 267.810
            xmax = 268.640
            text = ""
        intervals [34]:
            xmin = 268.640
            xmax = 289.410
            text = "020617: E-lo-dv-ye-no u-wa-sv u-da-nv-sv-hi ge-se wu-ni-yv-hv-hi ge-se Tsa-ni, a-le di-da-s-du-di-yi u-lv-lv-hi ge-se-i, a-s-dv-di-s-di-s-ge E-lo-di-si, u-nv-tli Qui-li-gi u-da-li-i; na-s-gi-ye-no a-da-ye-he-i."
        intervals [35]:
            xmin = 289.410
            xmax = 290.385
            text = ""
        intervals [36]:
            xmin = 290.385
            xmax = 299.860
            text = "020618: Tsa-ni-ye-no hi-a i-yu-we-se-lv-hi ge-se E-lo-dv, v-tla yi-du-yu-go-di e-tsa-nv-tli u-da-li-i tsa-da-ye-ha."
        intervals [37]:
            xmin = 299.860
            xmax = 300.760
            text = ""
        intervals [38]:
            xmin = 300.760
            xmax = 310.290
            text = "020619: Na-s-gi i-yu-s-di E-lo-di-si a-s-ga-ge [Tsa-ni] a-le yu-le-i; a-se-no v-tla na-s-gi i-gv-wa-dv-ne-di yi-ge-se-i."
        intervals [39]:
            xmin = 310.290
            xmax = 311.070
            text = ""
        intervals [40]:
            xmin = 311.070
            xmax = 334.155
            text = "020620: E-lo-dv-ye-no u-lv-quo-di-yu ge-se Tsa-ni, a-ga-ta-he-ye-no u-da-nv-ti-yu a-le na-s-ga-nv-na ge-sv a-s-ga-ya, a-le u-ga-sa-ya-s-di-yu ge-se-i; na-s-gi-no u-dv-ga-nv [a-li-tsi-do-hv-s-gv,] u-tsa-te du-lv-wi-s-da-ne-le-i, a-le u-li-he-li-tsv-hi a-dv-da-s-da-ne-he-i."
        intervals [41]:
            xmin = 334.155
            xmax = 335.180
            text = ""
        intervals [42]:
            xmin = 335.180
            xmax = 355.215
            text = "020621: A-hi-dv-no na-s-gi i-gv-dv-ne-di ge-sv u-s-qua-lv-hv, na-s-gi E-lo-dv u-de-nv i-yu i-ga u-dv-nv-i-s-ta-ne gv-wa-li-s-da-yv-na-ne-di-yi tsu-tse-li u-ni-gv-wi-yu-hi, a-le a-ni-s-ga-ye-gv-s-da, a-le di-ge-ga-ne-lo-di Ge-li-li a-ne-hi,"
        intervals [43]:
            xmin = 355.215
            xmax = 355.950
            text = ""
        intervals [44]:
            xmin = 355.950
            xmax = 375.695
            text = "020622: Na-s-gi-no E-lo-di-si u-we-tsi a-dv u-yv-li-lv, a-le u-li-s-gi-sv, a-le E-lo-dv a-le na-s-gi i-tsu-la-ha a-ni-ni-dla-i o-si-yu u-ni-ye-lv-nv, u-gv-wi-yu-hi hi-a nu-we-se-le a-dv, S-gi-ta-yo-si i-yu-s-di-quo he-li-s-gv-i, da-gv-ne-li-no."
        intervals [45]:
            xmin = 375.695
            xmax = 376.440
            text = ""
        intervals [46]:
            xmin = 376.440
            xmax = 390.045
            text = "020623: U-se-li-da-ne-le-no [hi-a nu-we-se-i,] I-yu-s-di-quo he-li-s-gv s-gi-ta-yo-si, da-gv-ne-li-no, na-s-quo a-ye-li i-yv-dv yi-gi na-hna a-gi-gv-wi-yu-hi ge-sv-i."
        intervals [47]:
            xmin = 390.045
            xmax = 390.670
            text = ""
        intervals [48]:
            xmin = 390.670
            xmax = 400.775
            text = "020624: U-nu-go-tsv-no hi-a wi-nu-we-se-le u-tsi, ga-do da-tsi-ta-yo-li?  Hi-a-no nu-we-se-le-i, Tsa-ni Di-da-wo-s-gi a-s-go-li."
        intervals [49]:
            xmin = 400.775
            xmax = 401.580
            text = ""
        intervals [50]:
            xmin = 401.580
            xmax = 417.845
            text = "020625: I-gv-we-nv-dv-quo-no u-li-s-di u-yv-li-le u-gv-wi-yu-hi a-ya-v-i, a-le u-ta-yo-le hi-a nu-we-se-i, A-qua-du-li gi-la-quo i-yv-dv s-gi-ne-di-yi, a-te-li-do-gi-hi, Tsa-ni di-da-wo-s-gi u-s-go."
        intervals [51]:
            xmin = 417.845
            xmax = 418.820
            text = ""
        intervals [52]:
            xmin = 418.820
            xmax = 433.330
            text = "020626: U-gv-wi-yu-hi-no u-tsa-ti tla-quo u-ye-lv-ne-i; a-se-no u-se-li-ta-nv-i, a-le na-s-gi i-tsu-la-ha u-na-ni-dla-nv-hi nv-tsu-li-s-do-ta-ne, v-tla gv-wa-ge-yu-do-di yi-ge-se-i."
        intervals [53]:
            xmin = 433.330
            xmax = 434.290
            text = ""
        intervals [54]:
            xmin = 434.290
            xmax = 449.165
            text = "020627: Gi-la-quo-no i-yv-dv u-gv-wi-yu-hi u-nv-se a-ya-wi-s-gi, a-le u-ne-tse u-s-go u-ni-yo-hi-s-di-yi; u-we-nv-se-no, a-le wu-s-gu-de-se di-da-s-du-di-yi a-ya-v-i,"
        intervals [55]:
            xmin = 449.165
            xmax = 449.820
            text = ""
        intervals [56]:
            xmin = 449.820
            xmax = 458.340
            text = "020628: A-le u-yo-le u-s-go a-te-li-do-gi-hi ga-lo-de-i, a-le a-dv u-ne-le-i; a-dv-no u-tsi u-ne-le-i."
        intervals [57]:
            xmin = 458.340
            xmax = 459.180
            text = ""
        intervals [58]:
            xmin = 459.180
            xmax = 468.615
            text = "020629: Gv-wa-s-da-wa-di-do-hi-no u-na-dv-ga-nv, u-ni-lu-tse a-le u-ni-ne-se a-ye-lv-i, a-le a-tse-li-s-dv u-ni-nv-ne-i."
        intervals [59]:
            xmin = 468.615
            xmax = 469.570
            text = ""
        intervals [60]:
            xmin = 469.570
            xmax = 482.370
            text = "020630: Ge-tsi-nv-si-dv-no u-na-da-tli-sa-ne Tsi-sa e-do-hv-i, a-le gv-wa-no-ne-le ni-ga-dv nu-na-dv-ne-li-do-lv, a-le na-s-quo nu-s-dv du-na-de-yo-nv-i."
        intervals [61]:
            xmin = 482.370
            xmax = 483.110
            text = ""
        intervals [62]:
            xmin = 483.110
            xmax = 503.830
            text = "020631: Hi-a-no ni-du-we-se-le-i, I-de-na i-tsv-sv-quo i-yv-dv wi-di-lo-hi i-na-ge di-ge-sv-i, a-le tle-ga i-tsa-tsa-we-so-lv-s-da; u-ni-tsa-te-ye-no a-ni-lu-ge a-le da-ne-ge-i, v-tle-no ya-dla-nv-da-di-s-ge na-s-quo u-na-li-s-da-yv-di-yi i-go-hi-dv."
        intervals [63]:
            xmin = 503.830
            xmax = 504.510
            text = ""
        intervals [64]:
            xmin = 504.510
            xmax = 510.545
            text = "020632: Tsi-yu-hi-no u-na-tsa-e-i, u-na-ni-gi-se i-na-ge wu-ni-lo-se u-de-li-dv."
        intervals [65]:
            xmin = 510.545
            xmax = 511.410
            text = ""
        intervals [66]:
            xmin = 511.410
            xmax = 532.920
            text = "020633: Yv-wi-no gv-wa-ni-go-he a-na-ni-gi-s-gv-i, a-le u-ni-tsa-te gv-wo-li-ge-i, a-le e-la-di-quo du-ni-s-qua-lv-ta-ne na-hna i-di-tlv wu-ni-lo-se de-ga-du-wa-di-sv ni-do-da-yu-ni-lo-sv-hi, de-gv-wa-ni-gi-ye-no, a-le wi-gv-wa-da-tli-sa-ne-le-i."
        intervals [67]:
            xmin = 532.920
            xmax = 533.820
            text = ""
        intervals [68]:
            xmin = 533.820
            xmax = 555.750
            text = "020634: Tsi-sa-no u-tsa-i-sv, du-go-he u-ni-tsa-ti yv-wi, a-le du-we-do-li-tse-i, nv-di-ga-li-s-do-di-s-ge a-wi u-ni-no-de-na da-na-tse-la-gv ne-hv-na tsi-ge-so u-ni-ga-ti-ya; u-le-nv-he-no u-tsa-ti tsu-da-le-nv-dv du-we-yo-ne-i."
        intervals [69]:
            xmin = 555.750
            xmax = 556.740
            text = ""
        intervals [70]:
            xmin = 556.740
            xmax = 568.810
            text = "020635: Hna-quo-no u-lo-so-ni-de-na ge-se i-ga, gv-wa-s-da-wa-di-do-hi gv-wa-lu-tse-le, hi-a nu-ni-we-se-i, A-ni i-na-ge-i, a-le hna-quo u-lo-so-ni-di i-ga."
        intervals [71]:
            xmin = 568.810
            xmax = 569.800
            text = ""
        intervals [72]:
            xmin = 569.800
            xmax = 585.930
            text = "020636: Ti-ye-li-hi-s-da, na-s-gi da-da-ne-la-di-sv gv-wa-du-wi-dv wa-ni-lo-hi, a-le de-ga-du-wa-di-sv-i, a-le wu-ni-wa-hi ga-du, v-tle-ye-no go-hu-s-di ya-ni-ye u-na-li-s-da-yv-di."
        intervals [73]:
            xmin = 585.930
            xmax = 586.650
            text = ""
        intervals [74]:
            xmin = 586.650
            xmax = 603.730
            text = "020637: Du-ne-tse-le-no hi-a ni-du-we-se-le-i, Ni-hi di-tse-la-s-da.  Hi-a-no ni-gv-wa-we-se-le-i, Tsi-go da-yo-tse-si ta-li-tsu-qui a-ni-gi-si tsu-gv-wa-lo-di ga-du wv-da-yo-gi-wa-si, a-le do-da-yo-tse-la-s-ta-ni?"
        intervals [75]:
            xmin = 603.730
            xmax = 604.520
            text = ""
        intervals [76]:
            xmin = 604.520
            xmax = 615.220
            text = "020638: Hi-a-no ni-du-we-se-le-i, I-la-go ga-du de-tsi-ye-ha?  Wi-tsa-ga-ta.  U-na-do-le-ho-sv-no, hi-a nu-hi-we-se-i, Hi-s-gi, ta-li-no a-tsa-di."
        intervals [77]:
            xmin = 615.220
            xmax = 616.340
            text = ""
        intervals [78]:
            xmin = 616.340
            xmax = 624.150
            text = "020639: Du-ne-tse-le-no u-na-ni-tlv-di-yi ni-ga-dv i-tse ka-ne-s-go-hi ge-sv tsu-na-da-tlu-nv-dv."
        intervals [79]:
            xmin = 624.150
            xmax = 624.720
            text = ""
        intervals [80]:
            xmin = 624.720
            xmax = 632.955
            text = "020640: U-na-ni-tlv-ne-no o-s-dv du-na-da-nv-hna-ne-i a-s-go-hi-tsu-qui, a-le hi-s-ga-s-go-hi tsu-na-da-tlu-nv-dv."
        intervals [81]:
            xmin = 632.955
            xmax = 633.835
            text = ""
        intervals [82]:
            xmin = 633.835
            xmax = 653.760
            text = "020641: Hi-s-gi-no ga-du du-gi-sv a-le ta-li a-tsa-di du-ne-sv, ga-lv-la-di wi-du-ka-hna-ne-i, a-le u-li-he-li-tse-i, a-le du-gv-ha-lu-ye ga-du, a-le gv-wa-s-da-wa-di-do-hi du-ne-le tsu-ni-ne-di-yi; ta-li-no a-tsa-di ni-ga-dv du-ya-do-he-le-i."
        intervals [83]:
            xmin = 653.760
            xmax = 654.840
            text = ""
        intervals [84]:
            xmin = 654.840
            xmax = 658.260
            text = "020642: Ni-ga-dv-no u-na-li-s-da-yv-ne-i; a-le du-no-lv-se-i."
        intervals [85]:
            xmin = 658.260
            xmax = 659.460
            text = ""
        intervals [86]:
            xmin = 659.460
            xmax = 667.010
            text = "020643: U-nu-te-se-no u-li-gv-ha-lu-yv-hi ta-la-du di-ka-li-i ta-lu-tsa, a-le na-s-quo a-tsa-di."
        intervals [87]:
            xmin = 667.010
            xmax = 668.130
            text = ""
        intervals [88]:
            xmin = 668.130
            xmax = 675.660
            text = "020644: Na-s-gi-no na ga-du tsu-ni-gv-hi hi-s-gi i-ya-ga-yv-li i-yv-dv na-ni-e a-ni-s-ga-ya."
        intervals [89]:
            xmin = 675.660
            xmax = 676.970
            text = ""
        intervals [90]:
            xmin = 676.970
            xmax = 693.640
            text = "020645: Gi-la-quo-no i-yv-dv du-nv-wi-s-ta-ne gv-wa-s-da-wa-di-do-hi tsi-yu-hi u-na-tso-di-yi, a-le i-gv-yi tsu-ni-so-hi-s-di-yi, Que-tsa-yi-di wu-ni-lu-hi-s-di-yi, a-si-quo u-wa-sv da-ye-li-hi-s-di-s-gv u-ni-tsa-ti."
        intervals [91]:
            xmin = 693.640
            xmax = 694.650
            text = ""
        intervals [92]:
            xmin = 694.650
            xmax = 700.240
            text = "020646: Du-ye-li-hi-s-ta-nv-no, o-da-lv wu-lo-se u-da-do-li-s-ta-nv-se-i."
        intervals [93]:
            xmin = 700.240
            xmax = 701.670
            text = ""
        intervals [94]:
            xmin = 701.670
            xmax = 710.630
            text = "020647: U-sv-no nu-li-s-ta-nv tsi-yu v-da-li a-ye-li a-ni-ni-se-i, u-wa-sv-no do-yi e-do-he-i."
        intervals [95]:
            xmin = 710.630
            xmax = 711.440
            text = ""
        intervals [96]:
            xmin = 711.440
            xmax = 730.150
            text = "020648: Du-go-he-no a-ni-gi-li-yo-gv a-ni-ga-we-hi-hv-i; wa-ni-ga-dv-no i-di-si di-ga-no-lv-di-s-ge-i.  Nv-gi-ne-no i-yv-dv a-ni-ya-wi-s-gv sv-no-yi du-lu-tse-le-i, v-da-li ga-du-i a-i-se-i, a-le yi-du-lo-hi-se-le-i."
        intervals [97]:
            xmin = 730.150
            xmax = 731.090
            text = ""
        intervals [98]:
            xmin = 731.090
            xmax = 739.370
            text = "020649: A-se-no wi-gv-wa-go-hv v-da-li ga-du-i a-i-sv-i, u-tse-lv-nv-hi u-ne-li-se-i, a-le u-ne-lu-ne-i."
        intervals [99]:
            xmin = 739.370
            xmax = 740.220
            text = ""
        intervals [100]:
            xmin = 740.220
            xmax = 755.450
            text = "020650: (Ni-ga-dv-ye-no gv-wa-go-he-i, a-le u-na-de-ya-ta-ne-le-i.)  Gi-la-quo-no i-yv-dv du-li-no-he-ta-ne-i, a-le hi-a ni-du-we-se-le-i, U-ga-li-s-di-quo i-tsa-da-nv-da-da; a-yv-quo; tle-s-di yi-tsi-s-ga-i-he-s-di."
        intervals [101]:
            xmin = 755.450
            xmax = 756.690
            text = ""
        intervals [102]:
            xmin = 756.690
            xmax = 772.480
            text = "020651: U-gi-la-wi-se-no wi-du-tsa-ne-le tsi-yu-hi; ga-no-lv-v-s-gv-no u-se-li-go-tse-i; a-le u-lo-sv-s-ta-nv-hi u-na-da-nv-te-ta-ne do-tsu-na-da-nv-dv-i, a-le u-ni-s-qua-ni-go-se-i."
        intervals [103]:
            xmin = 772.480
            xmax = 773.540
            text = ""
        intervals [104]:
            xmin = 773.540
            xmax = 780.420
            text = "020652: V-tla-ye-no yi-du-na-da-nv-te-le ga-du; tsu-ni-na-wi-ye-no di-s-da-yi-yu ge-se-i."
        intervals [105]:
            xmin = 780.420
            xmax = 781.120
            text = ""
        intervals [106]:
            xmin = 781.120
            xmax = 787.420
            text = "020653: Du-ni-so-tsv-no, Ge-ni-si-la-di wu-ni-lu-tse-i, a-le u-ni-ta-la-de-i."
        intervals [107]:
            xmin = 787.420
            xmax = 788.060
            text = ""
        intervals [108]:
            xmin = 788.060
            xmax = 792.820
            text = "020654: Tsi-yu-hi-no u-na-tsa-i-sv gi-la-quo i-yv-dv gv-wo-li-tse-i."
        intervals [109]:
            xmin = 792.820
            xmax = 793.920
            text = ""
        intervals [110]:
            xmin = 793.920
            xmax = 807.380
            text = "020655: A-le na-hna gv-wa-du-wi-dv u-ne-do-le-i, a-le tsu-ni-tlv-gi du-ni-ni-do-le di-tse-s-do-gi-hi du-ni-tlv-de, wi-da-ni-no-hi-he a-na-dv-gv-ga na-hna e-do-hv-i."
        intervals [111]:
            xmin = 807.380
            xmax = 808.230
            text = ""
        intervals [112]:
            xmin = 808.230
            xmax = 835.490
            text = "020656: A-le i-lv-hi-tlv wi-ga-lu-gi, tsu-s-di de-ga-du-hv, a-le tsu-dv-na de-ga-du-hv, a-le i-yv-dv di-da-ne-lo-hi ge-sv-i, tsu-ni-tlv-gi de-ga-la-nv-dv da-ni-nv-v-s-ge-i, a-le gv-wa-ta-yo-se-he u-na-sv-ni-s-di-yi, ga-da-lu-ya-dv-quo na-s-quo u-nu-wv-i; na-ni-v-no na-s-gi gv-wa-sv-ni-lv-hi du-na-di-wa-s-ge-i."
