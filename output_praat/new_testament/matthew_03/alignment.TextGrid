item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 286.910
        intervals: size = 34
        intervals [1]:
            xmin = 0.000
            xmax = 3.960
            text = ""
        intervals [2]:
            xmin = 3.960
            xmax = 10.230
            text = "010301: Na-hi-yu u-lu-tse Tsa-ni Di-da-wo-s-gi a-li-tsi-do-hv-s-ge i-na-ge Tsu-di-yi,"
        intervals [3]:
            xmin = 10.230
            xmax = 11.250
            text = ""
        intervals [4]:
            xmin = 11.250
            xmax = 22.325
            text = "010302: Hi-a ni-ga-we-s-ge-i; Di-tsi-ne-tli-yv-na de-tsa-da-nv-dv-i, hna-quo-ye-no ga-lv-la-di e-hi u-gv-wi-yu-hi ge-sv e-s-ga-ni-yu da-ya-i."
        intervals [5]:
            xmin = 22.325
            xmax = 24.265
            text = ""
        intervals [6]:
            xmin = 24.265
            xmax = 44.545
            text = "010303: Na-s-gi hi-a na tsi-ka-ne-i-s-di-s-ge a-do-le-ho-s-gi I-sa-ya, hi-a tsi-ni-ga-we-s-ge-i; U-we-lu-ga gi-lo i-na-ge-i, hi-a ni-ga-we-ha; O-s-dv ni-tsv-ga Yi-ho-wa u-lo-hi-s-di-yi, du-nv-nv di-tsi-tsi-no-hi-s-da."
        intervals [7]:
            xmin = 44.545
            xmax = 46.860
            text = ""
        intervals [8]:
            xmin = 46.860
            xmax = 63.350
            text = "010304: Na-s-gi-no hi-a Tsa-ni u-nu-we ge-mi-li u-s-ti-ye-nv-hi, ga-no-tsi-no u-da-tlo-s-de-i, u-li-s-da-yv-di-no v-le ge-se i-na-ge-no e-hi wa-du-li-si."
        intervals [9]:
            xmin = 63.350
            xmax = 64.970
            text = ""
        intervals [10]:
            xmin = 64.970
            xmax = 74.200
            text = "010305: Na-quo-no wi-gv-wa-lu-tse-le Tsi-lu-si-li-mi a-le ni-ga-dv Tsu-di-yi, a-le ni-ga-dv na-nv-na-dv Tso-da-ni,"
        intervals [11]:
            xmin = 74.200
            xmax = 75.180
            text = ""
        intervals [12]:
            xmin = 75.180
            xmax = 80.730
            text = "010306: Tso-da-ni-no de-u-wo-e-i, a-ni-no-hv-s-ge u-ni-s-ga-nv-tsv-i."
        intervals [13]:
            xmin = 80.730
            xmax = 81.825
            text = ""
        intervals [14]:
            xmin = 81.825
            xmax = 103.510
            text = "010307: A-se-no du-go-hv u-ni-tsa-ti A-ni-qua-li-si a-le A-ni-sa-du-si a-ni-lu-gv da-da-wo-s-gv-i, hi-a ni-du-we-ha-le-i; Yo! i-na-dv tsu-ne-tsi ni-hi! Ga-go i-tse-ya-ta-nv e-tsa-li-e-di-yi u-ta-la-wo-hi-s-di tsv-tsa-i?"
        intervals [15]:
            xmin = 103.510
            xmax = 105.700
            text = ""
        intervals [16]:
            xmin = 105.700
            xmax = 112.415
            text = "010308: I-tsi-na-nu-go-wa-yo-go a-do-le-ho-hi-s-do-di de-tsi-ne-tli-yv-sv de-tsa-da-nv-dv-i;"
        intervals [17]:
            xmin = 112.415
            xmax = 113.815
            text = ""
        intervals [18]:
            xmin = 113.815
            xmax = 134.055
            text = "010309: A-le tla-s-di hi-a nv-da-yo-tsi-we-si i-tse-li-sv-gi do-di-tsa-da-nv-dv-i; E-qua-ha-mi o-gi-do-da; i-tsv-yo-se-ye-no U-ne-la-nv-hi ye-li-quo hi-a nv-ya yi-de-gv-da yi-de-go-tlv-na E-qua-ha-mi tsu-we-tsi."
        intervals [19]:
            xmin = 134.055
            xmax = 135.215
            text = ""
        intervals [20]:
            xmin = 135.215
            xmax = 153.595
            text = "010310: A-le na-s-quo ga-yu-la ga-lu-ya-s-di a-ha du-hna-s-de-tlv de-tlu-gv-i; na-s-gi-no ni-ga-dv de-tlu-gv a-no-s-dv na-na-da-dv-s-gv-na di-ga-le-yv-s-do-di a-le a-tsi-lv-yi wi-da-di-nv-di ge-se-s-di."
        intervals [21]:
            xmin = 153.595
            xmax = 155.130
            text = ""
        intervals [22]:
            xmin = 155.130
            xmax = 184.730
            text = "010311: A-yv u-do-hi-yu-hi a-ma de-tsv-ya-wo-s-di-ha di-tsi-ne-tli-yv-s-di-yi de-tsa-da-nv-dv u-gv-wa-li; a-se-no na-s-gi na o-ni tsv-da-ya-i u-tli-hi-yu u-li-ni-gi-di-yu e-s-ga-quo a-yv, tsu-la-su-lo v-tla ye-li yi-ni-go-i di-gi-ni-da-s-di-yi; na-s-gi-s-gi-ni Ga-lv-quo-di-yu A-da-nv-do a-le a-tsi-lv do-da-tsa-wo-s-ta-ni."
        intervals [23]:
            xmin = 184.730
            xmax = 185.480
            text = ""
        intervals [24]:
            xmin = 185.480
            xmax = 207.120
            text = "010312: Na-s-gi ga-la-so-wi-s-di u-tse-li-ga a-ye-ha, a-le ni-ga-dv da-ga-la-so-wi-si, u-tse-li-no u-ga-ta-ta-nv-hi da-ga-tli-sa-ni dv-ni a-da-na-nv-di-yi u-ti-yv-hi-s-gi-ni dv-go-hv-s-ta-ni ni-gv-tlo-s-gv-na a-tsi-lv-yi."
        intervals [25]:
            xmin = 207.120
            xmax = 208.700
            text = ""
        intervals [26]:
            xmin = 208.700
            xmax = 219.070
            text = "010313: Hna-quo-no Tsi-sa Ge-li-li tsu-lo-se-i, Tso-da-ni u-lu-tse Tsa-ni e-do-hv-i a-ga-wo-s-di-yi u-ye-lv-se-i."
        intervals [27]:
            xmin = 219.070
            xmax = 220.140
            text = ""
        intervals [28]:
            xmin = 220.140
            xmax = 230.070
            text = "010314: A-se-no Tsa-ni du-tlv-wi-se-le-quo, hi-a nu-we-se-i; A-yv-s-gi-ni yi-s-qua-wo-v; tsi-go-no i-s-gi-lu-tse-ha?"
        intervals [29]:
            xmin = 230.070
            xmax = 231.095
            text = ""
        intervals [30]:
            xmin = 231.095
            xmax = 249.450
            text = "010315: Tsi-sa-no tsu-ne-tsv hi-a nu-we-se-le-i; U-ne-la-gi he-la go-hi ge-sv-i, o-si-yu-ye-no na-s-gi i-gi-na-dv-ne-di-yi gi-ni-s-qua-di-s-di-yi ni-ga-v du-yu-go-dv ge-sv-i.  Gi-la u-ne-la-gi u-we-li-se-le-i."
        intervals [31]:
            xmin = 249.450
            xmax = 250.290
            text = ""
        intervals [32]:
            xmin = 250.290
            xmax = 276.050
            text = "010316: Tsi-sa-no a-ga-wo-v, gi-la-quo i-yv-dv u-hna-lu-se-i, a-ma-yi u-da-nv-se-i, a-le gv-ni-yu-quo ga-lv-la-di tsa-tsi-s-du-gi-e-le-i, a-le wu-go-he U-ne-la-nv-hi U-da-nv-do e-la-di nv-tsu-dv-hna-di-se gu-le--di-s-go-ni-hi di-tse-li-dv; a-le u-we-ya-lv-tse-i."
        intervals [33]:
            xmin = 276.050
            xmax = 277.035
            text = ""
        intervals [34]:
            xmin = 277.035
            xmax = 286.910
            text = "010317: A-le gv-ni-yu-quo hi-a nv-tsu-we-se ga-lv-la-di; Hi-a tsi-ge-yu-i A-que-tsi, na-s-gi o-si-yu tsi-tsi-ye-lv-a."
