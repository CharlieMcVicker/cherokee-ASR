item []:
    item [1]:
        class = "IntervalTier"
        name = "Verses"
        xmin = 0
        xmax = 541.780
        intervals: size = 68
        intervals [1]:
            xmin = 0.000
            xmax = 3.490
            text = ""
        intervals [2]:
            xmin = 3.490
            xmax = 18.960
            text = "012001: Ga-lv-la-di-ye-no u-tse-li-go-hi na-s-gi-ya-quo a-s-ga-ya ga-ne-la, su-na-le-i-yu tsu-we-nv-se tsi-du-nv-sv-se go-hu-s-di a-na-dv-ne-hi te-lv-la-di du-wi-sv tsu-ni-lv-wi-s-da-ne-di-yi."
        intervals [3]:
            xmin = 18.960
            xmax = 20.230
            text = ""
        intervals [4]:
            xmin = 20.230
            xmax = 34.325
            text = "012002: Hna-quo-no na-s-gi a-s-ga-ya go-hu-s-di a-na-dv-ne-hi du-nu-go-ta-nv a-gi-si tsu-gv-wa-lo-di tsu-gu-yv-e-di-yi si-ga, te-lv-la-di do-tsu-wi-sv du-nv-se-i."
        intervals [5]:
            xmin = 34.325
            xmax = 35.670
            text = ""
        intervals [6]:
            xmin = 35.670
            xmax = 50.740
            text = "012003: U-we-nv-se-no so-o-ne-li-ne i-yu-tli-lo-dv ka-la-wa-di-sv-i, a-le du-go-he nv-wa-na-da-le ga-no-do-di-yi a-ni-do-na-e go-hu-s-di na-na-dv-hv-na,"
        intervals [7]:
            xmin = 50.740
            xmax = 51.765
            text = ""
        intervals [8]:
            xmin = 51.765
            xmax = 63.630
            text = "012004: A-le hi-a ni-du-we-se-le-i; I-tse-na na-s-quo ni-hi te-lv-la-di do-di-wi-sv-i, du-yu-go-dv-no ge-sv da-tsv-ya-gu-yv-e-li.  U-ne-nv-se-no."
        intervals [9]:
            xmin = 63.630
            xmax = 64.450
            text = ""
        intervals [10]:
            xmin = 64.450
            xmax = 77.675
            text = "012005: Ta-li-ne i-ga i-u-we-nv-se a-le na-s-quo tso-i-ne i-yu-tli-lo-dv ka-la-wa-di-sv u-sv-hi-ye-yi, na-s-gi-ya ni-u-dv-ne-le-i."
        intervals [11]:
            xmin = 77.675
            xmax = 78.865
            text = ""
        intervals [12]:
            xmin = 78.865
            xmax = 99.705
            text = "012006: Hi-s-gi-ne-no i-yu-tli-lo-dv ka-la-wa-di-sv ta-li-ne i-u-we-nv-se-i, a-le du-wa-dv-he nv-wa-na-da-le a-ni-do-na-e go-hu-s-di na-na-dv-ne-hv-na, hi-a-no ni-du-we-se-le-i; Ga-do-no a-ni i-tsi-do-na-a u-do-da-qua-dv go-hu-s-di ni-tsa-dv-ne-hv-na?"
        intervals [13]:
            xmin = 99.705
            xmax = 100.310
            text = ""
        intervals [14]:
            xmin = 100.310
            xmax = 113.970
            text = "012007: Tla-ye-na gi-lo yo-gi-nv-sv, u-na-dv-ne-i.  Hi-a-no ni-du-we-se-le-i; Ni-hi na-s-quo i-tse-na te-lv-la-di do-di-wi-sv-i; du-yu-go-dv-no ge-sv da-tsv-ya-gu-yv-e-li."
        intervals [15]:
            xmin = 113.970
            xmax = 115.315
            text = ""
        intervals [16]:
            xmin = 115.315
            xmax = 139.920
            text = "012008: U-sv-no nu-li-s-ta-nv, te-lv-la-di da-wi-sv u-tse-li-ga hi-a nu-we-se-le a-de-lv u-ga-ti-de-hi, Wi-ti-ya-nv go-hu-s-di a-na-dv-ne-hi a-le ta-gu-yv-si du-ni-lv-wi-s-da-ne-lv-i, o-ni-yi ge-tsi-nv-sv-hi ta-le-nv-da i-gv-yi-yi-no ge-tsi-nv-sv-hi ti-s-qua-lv-da"
        intervals [17]:
            xmin = 139.920
            xmax = 140.640
            text = ""
        intervals [18]:
            xmin = 140.640
            xmax = 151.740
            text = "012009: Hi-s-gi-ne-no i-yu-tli-lo-dv ka-la-wa-di-sv ge-tsi-nv-sv-hi u-ni-lu-tsv, a-ni-si-yv-wi-ha a-gi-si tsu-gv-wa-lo-di ge-ga-gu-yv-e-le-i."
        intervals [19]:
            xmin = 151.740
            xmax = 152.410
            text = ""
        intervals [20]:
            xmin = 152.410
            xmax = 167.290
            text = "012010: I-gv-yi-yi-no ge-tsi-nv-sv-hi u-ni-lu-tsv u-tli i-ga-i da-yo-ga-gu-yv-e-li u-ne-li-se-i.  A-se-no na-s-quo a-gi-si-quo tsu-gv-wa-lo-di a-ni-si-yv-wi-ha i-ge-ga-gu-yv-e-le-i."
        intervals [21]:
            xmin = 167.290
            xmax = 168.100
            text = ""
        intervals [22]:
            xmin = 168.100
            xmax = 174.945
            text = "012011: Ge-ga-gu-yv-e-lv-no, u-ni-go-ne-lo-hi-se-le-quo a-s-ga-ya ga-ne-la,"
        intervals [23]:
            xmin = 174.945
            xmax = 175.900
            text = ""
        intervals [24]:
            xmin = 175.900
            xmax = 195.240
            text = "012012: Hi-a nu-ni-we-se-i; Hi-a o-ni-yi u-ni-lu-tsv-hi sa-quo-quo i-yu-tli-lo-dv du-ni-lv-wi-s-da-si, i-tsu-la-ha-quo-no nv-s-gi-yv-ga a-yv na-s-gi ga-ge-sv a-le u-di-le-gv i-ga tso-gi-lv-wi-s-da-ne-lv-hi."
        intervals [25]:
            xmin = 195.240
            xmax = 196.270
            text = ""
        intervals [26]:
            xmin = 196.270
            xmax = 212.290
            text = "012013: A-se-no a-si-yv-wi u-ne-tse-le hi-a nu-we-se-le-i; Gi-na-li-i, v-tla u-tsa-ti-ni yi-ni-gv-yv-ne-ha.  Tla-s-go o-si yi-tsa-ye-lv-ne a-gi-si tsu-gv-wa-lo-di gv-ya-gu-yv-e-di-yi?"
        intervals [27]:
            xmin = 212.290
            xmax = 213.210
            text = ""
        intervals [28]:
            xmin = 213.210
            xmax = 227.175
            text = "012014: Hi-gi tsa-tse-li-ga a-le tsi-he-na.  O-si a-gi-ye-lv tsi-ya-gu-yv-e-di-yi hi-a o-ni-yi u-lu-tsv-hi ni-hi gv-ya-gu-yv-e-lv i-ga-i."
        intervals [29]:
            xmin = 227.175
            xmax = 227.795
            text = ""
        intervals [30]:
            xmin = 227.795
            xmax = 245.095
            text = "012015: Tla-s-go du-yu-go-dv yi-gi nu-s-dv ga-da-nv-te-s-gv i-ya-quv-ne-di-yi a-qua-tse-li ge-sv-i?  Tsi-sa hi-ga-do-li u-yo-i-yu i-gi nv-di-ga-li-s-do-di a-yv a-qua-da-nv-ti-yu ge-sv-i?"
        intervals [31]:
            xmin = 245.095
            xmax = 246.680
            text = ""
        intervals [32]:
            xmin = 246.680
            xmax = 263.305
            text = "012016: Ho-wa-no o-ni-yi tsi-gi i-gv-yi ge-se-s-di, i-gv-yi-no tsi-gi o-ni-yi ge-se-s-di.  U-ni-tsa-ta-ye-no ge-tsi-ya-nv-hv, a-se-no a-ni-ga-yo-li-yu ge-ga-su-ye-sv."
        intervals [33]:
            xmin = 263.305
            xmax = 264.250
            text = ""
        intervals [34]:
            xmin = 264.250
            xmax = 278.200
            text = "012017: Tsi-sa-no Tsi-lu-si-li-mi wa-ga-dv-i, ta-la-du i-ya-ni-dv a-na-da-s-da-wa-di-do-hi u-na-ne-la-gi i-yv-dv wi-du-ti-nv-s-ta-nv-gi, a-le hi-a ni-du-we-se-lv-gi;"
        intervals [35]:
            xmin = 278.200
            xmax = 278.990
            text = ""
        intervals [36]:
            xmin = 278.990
            xmax = 295.030
            text = "012018: Gv-ni-yu-quo Tsi-lu-si-li-mi wi-di-ga-ti, a-le yv-wi U-we-tsi do-da-ye-tsi-yo-si do-da-ge-tso-yo-hi-se-li nu-ni-gv-wi-yu-sv a-tsi-lv--a-ne-lo-hi a-le di-no-we-li-s-gi, na-s-gi-no do-dv-nu-go-la-ni u-yo-hu-hi-s-di-yi,"
        intervals [37]:
            xmin = 295.030
            xmax = 296.380
            text = ""
        intervals [38]:
            xmin = 296.380
            xmax = 312.360
            text = "012019: A-le gu-na-si-le-nv-dv yv-wi do-dv-ni-yo-hi-se-li u-ni-we-tlv-na-ne-di-yi, a-le u-ni-li-v-ni-s-di-yi, a-le u-na-dv-di-yi tsu-da-hna-wa-dv ge-dv-i; a-le tso-i-ne i-ga do-dv-a-le-ni."
        intervals [39]:
            xmin = 312.360
            xmax = 313.580
            text = ""
        intervals [40]:
            xmin = 313.580
            xmax = 328.285
            text = "012020: Hna-quo-no u-lu-tse-lv-gi Tse-qui-ti tsu-we-tsi u-ni-tsi, da-ti-ne-hv-gi tsu-we-tsi a-ni-wi-nv, e-la-di u-da-nv-nv-gi, a-le a-hu-s-di u-ta-yo-se-hv-gi."
        intervals [41]:
            xmin = 328.285
            xmax = 329.765
            text = ""
        intervals [42]:
            xmin = 329.765
            xmax = 351.020
            text = "012021: Hi-a-no nu-we-se-lv-gi; Ga-do tsa-du-li-ha?  Hi-a nv-da-yu-we-se-lv-gi; Ha-li-s-go-lv-da hi-a a-ni-ta-li di-que-tsi tsu-ni-di-yi tsa-tse-li-go-hi ge-sv-i, sa-quo hi-ga-ti-si i-di-tlv, so-i-no hi-ga-s-ga-ni."
        intervals [43]:
            xmin = 351.020
            xmax = 352.210
            text = ""
        intervals [44]:
            xmin = 352.210
            xmax = 376.370
            text = "012022: Tsi-sa-no u-ne-tsv hi-a nu-we-sv-gi; Tla yi-tsi-ga-ta-ha nu-s-dv i-tsi-ta-yo-hi-hv-i.  Tsi-go ye-li-quo ge-tsa-di-ta-s-di u-li-s-qui-di a-tli-s-dv a-yv tsv-da-ga-di-ta-hi, a-le-s-go ye-li-quo yi-de-tsa-wo-s-da a-yv na-s-gi tsv-da-yv-qua-wo-s-ta-ni?  Ye-li-quo, u-na-dv-nv-gi."
        intervals [45]:
            xmin = 376.370
            xmax = 377.240
            text = ""
        intervals [46]:
            xmin = 377.240
            xmax = 404.840
            text = "012023: Hi-a-no ni-du-we-se-lv-gi; U-do-hi-yu-hi a-qua-tse-li u-li-s-qui-di a-tli-s-dv da-tsa-di-ta-hi, a-le a-yv v-qua-wo-s-do-di ge-sv do-da-ye-tsa-wo-s-ta-ni.  Tsi-ga-ti-si-s-gi-ni a-le tsi-ga-s-ga-ni gi-lo u-we-di-yi v-tla a-yv a-qua-da-ne-di yi-gi, ge-tsi-ne-di-s-gi-ni-no-nv ge-se-s-di na-s-gi E-do-da tsu-da-ne-la-ne-lv-hi."
        intervals [47]:
            xmin = 404.840
            xmax = 405.880
            text = ""
        intervals [48]:
            xmin = 405.880
            xmax = 414.080
            text = "012024: A-s-go-hi-no i-ya-ni-dv u-na-dv-ga-nv u-tsa-ti u-ni-ta-la-wo-sv-gi du-ni-ni-qua-ti-lv a-ni-ta-li di-na-da-nv-tli."
        intervals [49]:
            xmin = 414.080
            xmax = 414.945
            text = ""
        intervals [50]:
            xmin = 414.945
            xmax = 433.405
            text = "012025: Tsi-sa-no wi-du-ya-nv-hv hi-a nu-we-sv-gi; I-tsi-ga-ta-ha a-ye-li de-go-tlv-wa-di-sv nu-ni-gv-wi-yu-sa-de-gi a-ni-ne-go i-yu-na-dv-ne-li-da-s-di-yi yv-wi, a-le ge-tsi-lv-quo-di a-ni-ne-tsi-do-hv na-na-dv-ne-ho-i."
        intervals [51]:
            xmin = 433.405
            xmax = 434.400
            text = ""
        intervals [52]:
            xmin = 434.400
            xmax = 446.610
            text = "012026: Ni-hi-s-gi-ni tle-s-di na-s-gi yi-ni-tsv-ne-s-di; gi-lo-s-gi-ni a-tsi-lv-quo-di i-yu-li-s-do-di-yi u-du-li-s-ge-s-di na-s-gi e-tsi-nv-si-da-s-di ge-se-s-di."
        intervals [53]:
            xmin = 446.610
            xmax = 447.700
            text = ""
        intervals [54]:
            xmin = 447.700
            xmax = 454.765
            text = "012027: A-le gi-lo u-gv-wi-yu-hi i-yu-li-s-do-di-yi u-du-li-s-ge-s-di na-s-gi e-tsi-na-tla-i ge-se-s-di."
        intervals [55]:
            xmin = 454.765
            xmax = 455.960
            text = ""
        intervals [56]:
            xmin = 455.960
            xmax = 469.760
            text = "012028: Na-s-gi-ya-quo yv-wi U-we-tsi u-da-nv-si-da-s-di-yi nu-yo-li-lv-na tsi-gi, a-tsi-nv-si-da-s-di-yi-quo-s-gi-ni, a-le gv-nv-i u-li-s-go-lv-do-di-yi u-ni-tsa-ti di-gu-yv-do-di."
        intervals [57]:
            xmin = 469.760
            xmax = 470.450
            text = ""
        intervals [58]:
            xmin = 470.450
            xmax = 475.450
            text = "012029: Tse-li-go-no u-na-ni-gi-sv u-ni-tsa-ti yv-wi gv-wa-s-da-wa-dv-sv-gi."
        intervals [59]:
            xmin = 475.450
            xmax = 476.190
            text = ""
        intervals [60]:
            xmin = 476.190
            xmax = 492.925
            text = "012030: Gv-ni-yu-quo-no a-ni-ta-li di-ni-ge-wi u-no-hu-lo-di du-no-lv-gi, u-na-dv-ga-nv-no tsi-sa u-lo-sv-i u-ne-lu-nv-gi, hi-a nu-ni-we-sv-gi; S-gi-ni-do-li-gi, Tsa-gv-wi-yu-hi De-wi u-we-tsi."
        intervals [61]:
            xmin = 492.925
            xmax = 493.810
            text = ""
        intervals [62]:
            xmin = 493.810
            xmax = 508.590
            text = "012031: U-ni-tsa-ti-no du-ni-ne-tse-lv-gi e-la-we-yi u-nv-di-yi.  A-se-no u-tli-quo i-ga-i u-ne-lu-nv-gi, hi-a nu-ni-we-sv-gi, S-gi-ni-do-li-gi, Tsa-gv-wi-yu-hi De-wi u-we-tsi."
        intervals [63]:
            xmin = 508.590
            xmax = 509.470
            text = ""
        intervals [64]:
            xmin = 509.470
            xmax = 519.125
            text = "012032: Tsi-sa-no u-le-wi-s-ta-nv wi-du-ya-nv-hv-gi, a-le hi-a ni-du-we-se-lv-gi; Ga-do i-s-da-du-li a-yv i-s-dv-ya-dv-ne-di-yi?"
        intervals [65]:
            xmin = 519.125
            xmax = 519.980
            text = ""
        intervals [66]:
            xmin = 519.980
            xmax = 527.665
            text = "012033: Hi-a nu-ni-we-sv-gi:  Tsa-gv-wi-yu-hi, tso-s-di-ga-do-li tsu-li-s-du-i-s-di-yi o-gi-na-du-li-ha."
        intervals [67]:
            xmin = 527.665
            xmax = 528.680
            text = ""
        intervals [68]:
            xmin = 528.680
            xmax = 541.780
            text = "012034: Tsi-sa-no du-we-do-li-tsv di-ni-ga-do-li du-sv-ne-lv-gi, gi-la-quo-no i-yv-dv gv-wa-ni-go-wa-dv-di nu-li-s-ta-nv-gi; a-le gv-wa-s-da-wa-dv-sv-gi."
